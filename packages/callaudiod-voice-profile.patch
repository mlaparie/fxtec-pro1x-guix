+/*
+ * PipeWire names a card's UCM profiles after the verb and the devices, one
+ * profile per output: "HiFi (Mic, Speaker)", "Voice Call (Earpiece, Mic)".  So
+ * a verb is a prefix of the name here, and the profile to select is the best
+ * one for that verb: a plugged headset first, otherwise the highest priority.
+ */
+static gboolean profile_has_verb(const char *name, const char *verb)
+{
+    size_t len = strlen(verb);
+
+    return strncmp(name, verb, len) == 0 && (name[len] == '\0' || name[len] == ' ');
+}
+
+static const char *best_profile(const pa_card_info *info, const char *verb)
+{
+    const pa_card_profile_info2 *best = NULL;
+    uint32_t i;
+
+    for (i = 0; i < info->n_profiles; i++) {
+        const pa_card_profile_info2 *profile = info->profiles2[i];
+
+        if (!profile_has_verb(profile->name, verb) || !profile->available)
+            continue;
+
+        if (strstr(profile->name, "Headphones") != NULL) {
+            for (uint32_t j = 0; j < info->n_ports; j++) {
+                if (strstr(info->ports[j]->name, "Headphones") != NULL &&
+                    info->ports[j]->available == PA_PORT_AVAILABLE_YES)
+                    return profile->name;
+            }
+            continue;
+        }
+
+        if (!best || profile->priority > best->priority)
+            best = profile;
+    }
+
+    return best ? best->name : NULL;
+}
