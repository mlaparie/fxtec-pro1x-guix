+  [ELEMENT_V4L2H264] = "v4l2h264enc",
   [ELEMENT_VIDEO_NONE] = NULL,
 
   [ELEMENT_AAC_FDK] = "fdkaacenc",
@@ -226,6 +227,15 @@
 
       break;
 
+    case ELEMENT_V4L2H264:
+      /* Controls are set in wfd_configure_media_element, before the
