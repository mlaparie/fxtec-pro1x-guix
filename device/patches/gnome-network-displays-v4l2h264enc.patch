+      encoder = gst_element_factory_make ("v4l2h264enc", "wfd-encoder");
+      encoder_elem = encoder;
+      success &= gst_bin_add (bin, encoder);
+      break;
+
     case ELEMENT_VAAPIH264:
       {
         GstElement *vaapi_encoder;
@@ -594,6 +604,24 @@
                     NULL);
       break;
 
+    case ELEMENT_V4L2H264:
+      {
+        g_autoptr(GstStructure) controls = NULL;
+
+        /* Constant bit rate, its peak the rate itself, and a keyframe
+         * every GOP.  Baseline (the codecfilter's caps). */
+        profile = WFD_H264_PROFILE_BASE;
+        controls = gst_structure_new ("controls",
+                                      "video_bitrate_mode", G_TYPE_INT, 1,
+                                      "video_bitrate", G_TYPE_INT, (gint) bitrate_kbit * 1000,
+                                      "video_peak_bitrate", G_TYPE_INT, (gint) bitrate_kbit * 1000,
+                                      "video_gop_size", G_TYPE_INT, (gint) gop_size,
+                                      "h264_i_frame_period", G_TYPE_INT, (gint) gop_size,
+                                      NULL);
+        g_object_set (encoder, "extra-controls", controls, NULL);
+        break;
+      }
