+/// Emit every device heard in the current discovery (BlueZ keeps an RSSI
+/// only for those; it clears them all when discovery stops).
+async fn emit_heard_devices(
+    bluez: &BlueZ,
+    tx: &tokio::sync::mpsc::Sender<(u32, AdvSnapshot)>,
+    scan_policy: &ScanPolicy,
+) -> bool {
+    let Ok(adapter) = bluez.adapter().await else {
+        return true;
+    };
+    let Ok(addrs) = adapter.device_addresses().await else {
+        return true;
+    };
+    for addr in addrs {
+        if scan_policy.is_empty() {
+            break;
+        }
+        let heard = match adapter.device(addr) {
+            Ok(d) => d.rssi().await.ok().flatten().is_some(),
+            Err(_) => false,
+        };
+        if heard && !emit_adv_to_sessions(bluez, addr, tx, scan_policy).await {
+            return false;
+        }
+    }
+    true
+}
