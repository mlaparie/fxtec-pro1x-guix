+/// `client` gives up its links: those it was the last owner of, to drop
+/// (pure helper — unit tested).
+pub(crate) fn release_owner(owned: &mut HashMap<String, HashSet<u64>>, client: u64) -> Vec<String> {
+    let mut last = Vec::new();
+    for dev in links_owned_by(owned, client) {
+        if let Some(set) = owned.get_mut(&dev) {
+            set.remove(&client);
+            if set.is_empty() {
+                owned.remove(&dev);
+                last.push(dev);
+            }
+        }
+    }
+    last
+}
