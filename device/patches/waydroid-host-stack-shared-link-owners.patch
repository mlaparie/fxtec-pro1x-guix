+/// The clients owning a link: one, or several sharing it.
+pub(crate) trait Owners {
+    fn has(&self, client: u64) -> bool;
+}
+impl Owners for u64 {
+    fn has(&self, client: u64) -> bool {
+        *self == client
+    }
+}
+impl Owners for HashSet<u64> {
+    fn has(&self, client: u64) -> bool {
+        self.contains(&client)
+    }
+}
