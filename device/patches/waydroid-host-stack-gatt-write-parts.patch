+/// How a GATT value of `len` bytes goes out on a link whose ATT MTU is
+/// `mtu`: one write when it fits (or the MTU is unknown, 0), else
+/// consecutive writes of at most ATT_MTU - 3 bytes, as `(start, end)`
+/// ranges.  BlueZ refuses a write command above that size and turns a
+/// write request into a prepared long write, which the Tesla VCSEC does
+/// not take; a client that negotiated this MTU would write in parts.
+pub fn gatt_write_chunks(len: usize, mtu: usize) -> Vec<(usize, usize)> {
+    let part = mtu.saturating_sub(3);
+    if len == 0 || part == 0 || len <= part {
+        return vec![(0, len)];
+    }
+    (0..len)
+        .step_by(part)
+        .map(|start| (start, (start + part).min(len)))
+        .collect()
+}
