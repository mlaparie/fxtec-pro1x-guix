+        assert_eq!(gatt_write_chunks(0, 23), vec![(0, 0)]);
+        assert_eq!(gatt_write_chunks(20, 23), vec![(0, 20)]);
+        assert_eq!(gatt_write_chunks(51, 110), vec![(0, 51)]);
+        // Unknown MTU: one write, BlueZ decides.
+        assert_eq!(gatt_write_chunks(114, 0), vec![(0, 114)]);
+        // The Tesla add-key message at the car's MTU.
+        assert_eq!(gatt_write_chunks(114, 110), vec![(0, 107), (107, 114)]);
+        assert_eq!(gatt_write_chunks(214, 110), vec![(0, 107), (107, 214)]);
