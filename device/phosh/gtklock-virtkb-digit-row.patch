From: fxtec-pro1x-guix
Subject: [PATCH] Add a digit row to the landscape layout

The landscape layout, the only one this module shows, had no digits:
a numeric password could not be typed.  1-0 (shifted !@#$%^&*()) above
q-p.
---
--- a/layout.mobintl.h
+++ b/layout.mobintl.h
@@ -1102,6 +1102,20 @@
 };
 
 static struct key keys_landscape[] = {
+  {"", "", 1.5, Pad, .scheme = 1},
+  {"1", "!", 1.0, Code, KEY_1},
+  {"2", "@", 1.0, Code, KEY_2},
+  {"3", "#", 1.0, Code, KEY_3},
+  {"4", "$", 1.0, Code, KEY_4},
+  {"5", "%", 1.0, Code, KEY_5},
+  {"6", "^", 1.0, Code, KEY_6},
+  {"7", "&", 1.0, Code, KEY_7},
+  {"8", "*", 1.0, Code, KEY_8},
+  {"9", "(", 1.0, Code, KEY_9},
+  {"0", ")", 1.0, Code, KEY_0},
+  {"", "", 1.5, Pad, .scheme = 1},
+  {"", "", 0.0, EndRow},
+
   {"Esc", "Esc", 1.0, Code, KEY_ESC, .scheme = 1},
   {"", "", 0.5, Pad, .scheme = 1},
   {"q", "Q", 1.0, Code, KEY_Q, &layouts[Emoji]},
