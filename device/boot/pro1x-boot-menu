#!/bin/sh
# pro1x-boot-menu — what U-Boot needs from Guix's extlinux.conf.
#
#   pro1x-boot-menu [--plain-area ROOT] SRC DIR N DELAY
#
# Writes into DIR, from SRC, Guix's extlinux.conf (current system first, then
# older generations, newest first):
#   prev1.conf .. prevN.conf  one previous generation each, for U-Boot's menu
#   menu.env                  that menu's labels and countdown, loaded by
#                             U-Boot with `env import -t' (see packages/uboot.scm)
#
# With --plain-area (encrypted system), ROOT is the plain ext4 that U-Boot reads
# and SRC's store paths are out of its reach, on the encrypted root.  Copies the
# kernel, initrd and device tree of the current system and N previous ones under
# ROOT/files, and first writes DIR/extlinux.conf with those paths.  An entry that
# does not fit is left out, with the ones after it.  U-Boot reads
# /boot/extlinux/extlinux.conf in that file system, so with ROOT mounted at /boot
# Guix's own file, /boot/extlinux/extlinux.conf there, is /extlinux/extlinux.conf
# to U-Boot, and U-Boot never reads it.  DIR is ROOT/boot/extlinux.
#
# Environment: PRO1X_SYSTEM_LINK, the current generation's profile link (default
# /var/guix/profiles/system), for its number and date.
#
# State: tested in QEMU; on the encrypted phone (2026-11-06) a deploy's kernel
# and initrd went to the plain area and the menu listed both generations.

set -eu

root=
if [ "${1:-}" = --plain-area ]; then
    root=$2
    shift 2
fi
src=$1 dir=$2 n=$3 delay=$4
link=${PRO1X_SYSTEM_LINK:-/var/guix/profiles/system}
dtb=qcom/sm6115-fxtec-pro1x.dtb

# Files from the flash carry the PC user's uid, the phone user's too: U-Boot boots
# whatever is here, so only root may write.
[ -z "$root" ] || chown -R 0:0 "$root"

[ -f "$src" ] || exit 0
mkdir -p "$dir"

# The Nth LABEL block of a configuration, on standard output.
entry() {                       # entry FILE N
    awk -v want="$2" '
        /^[[:space:]]*LABEL[[:space:]]/ { e++ }
        e == want' "$1"
}

entries() {                     # entries FILE: how many
    awk '/^[[:space:]]*LABEL[[:space:]]/ { e++ } END { print e + 0 }' "$1"
}

# Store paths an entry needs, one per line: KERNEL and INITRD files, FDTDIR.
store_files() {
    awk '$1 == "KERNEL" || $1 == "INITRD" || $1 == "FDTDIR" { print $2 }'
}

# In the plain area, /gnu/store/HASH-NAME/PATH is /files/HASH-NAME/PATH, except
# that /lib/dtbs is /dtbs, with only this phone's tree (the whole is 124 MiB).
plain_path() {
    printf '%s\n' "$1" | sed 's|^/gnu/store/|/files/|; s|/lib/dtbs$|/dtbs|'
}

copy_file() {                   # copy_file STORE-PATH TARGET
    [ -s "$2" ] && return 0
    mkdir -p "${2%/*}"
    cp --no-preserve=mode "$1" "$2.tmp" && mv -f "$2.tmp" "$2"
}

copy_entry() {                  # copy_entry ENTRY-TEXT
    for path in $(printf '%s\n' "$1" | store_files); do
        target=$root$(plain_path "$path")
        case "$path" in
            */lib/dtbs) copy_file "$path/$dtb" "$target/$dtb" || return 1 ;;
            *) copy_file "$path" "$target" || return 1 ;;
        esac
    done
}

remove_unwanted() {             # remove_unwanted WANTED-DIRS
    [ -d "$root/files" ] || return 0
    for d in "$root"/files/*; do
        [ -e "$d" ] || continue
        case " $1 " in
            *" ${d##*/} "*) ;;
            *) rm -rf "$d" ;;
        esac
    done
}

if [ -n "$root" ]; then
    wanted=$(i=1; while [ "$i" -le $((n + 1)) ]; do
                 entry "$src" "$i" | store_files
                 i=$((i + 1))
             done | sed -n 's|^/gnu/store/\([^/]*\).*|\1|p' | tr '\n' ' ')
    tmp="$dir/.extlinux.conf.tmp"
    # The header, then each entry whose files are in place.
    awk '/^[[:space:]]*LABEL[[:space:]]/ { exit } { print }' "$src" > "$tmp"
    i=1 kept=0
    while [ "$i" -le $((n + 1)) ]; do
        text=$(entry "$src" "$i")
        [ -n "$text" ] || break
        if ! copy_entry "$text"; then
            # Room is the likely reason: drop what no wanted entry uses, retry.
            remove_unwanted "$wanted"
            copy_entry "$text" || break
        fi
        printf '%s\n' "$text" | sed 's#\(KERNEL\|INITRD\|FDTDIR\) */gnu/store/#\1 /files/#; s#/lib/dtbs$#/dtbs#' >> "$tmp"
        kept=$((kept + 1))
        i=$((i + 1))
    done
    if [ "$kept" = 0 ]; then
        echo "pro1x-boot-menu: no room for the current system; kept the old menu" >&2
        rm -f "$tmp"
        exit 1
    fi
    sync
    mv -f "$tmp" "$dir/extlinux.conf"
    remove_unwanted "$wanted"
    sync
    src="$dir/extlinux.conf"
fi

# #209, Linux 7.3.0, 2026-11-03 18:33
menu_label() {                  # menu_label LABEL-LINE
    printf '%s\n' "$1" | sed -n \
        's/^.*Linux-Pro1X \([^ ]*\) (\(#[0-9]*\), \(.*\))$/\2, Linux \1, \3/p'
}

current_label() {               # current_label LABEL-LINE
    version=$(printf '%s\n' "$1" | sed -n 's/^.*Linux-Pro1X \([^ ]*\).*/\1/p')
    target=$(readlink "$link" 2>/dev/null || true)
    number=$(printf '%s\n' "${target##*/}" | sed -n 's/^system-\([0-9]*\)-link$/\1/p')
    # The link's own time: its target, in the store, is dated 1970.
    when=$(date -d "@$(stat -c %Y "${link%/*}/${target##*/}" 2>/dev/null)" \
                '+%Y-%m-%d %H:%M' 2>/dev/null || true)
    if [ -n "$number" ]; then
        echo "#$number, Linux $version, $when"
    else
        echo "Linux $version"
    fi
}

env_tmp="$dir/.menu.env.tmp"
{
    echo "menu_delay=$delay"
    first=$(entry "$src" 1 | head -n 1 | sed 's/^[[:space:]]*LABEL[[:space:]]*//')
    if [ -n "$first" ]; then
        echo "bootmenu_0=$(current_label "$first" | tr -d =)=sysboot scsi 0#userdata any \${scriptaddr} /boot/extlinux/extlinux.conf; pause"
    fi
} > "$env_tmp"

i=1
while [ "$i" -le "$n" ]; do
    text=$(entry "$src" $((i + 1)))
    if [ -z "$text" ]; then
        rm -f "$dir/prev$i.conf"
        i=$((i + 1))
        continue
    fi
    label=$(printf '%s\n' "$text" | head -n 1 | sed 's/^[[:space:]]*LABEL[[:space:]]*//')
    {
        echo "TIMEOUT 0"
        echo "PROMPT 0"
        echo "DEFAULT $label"
        printf '%s\n' "$text"
    } > "$dir/.prev$i.tmp"
    mv -f "$dir/.prev$i.tmp" "$dir/prev$i.conf"
    title=$(menu_label "$label" | tr -d =)
    [ -n "$title" ] || title=$(printf '%s\n' "$label" | tr -d =)
    echo "bootmenu_$i=$title=sysboot scsi 0#userdata any \${scriptaddr} /boot/extlinux/prev$i.conf; pause" >> "$env_tmp"
    i=$((i + 1))
done
for f in "$dir"/prev*.conf; do
    [ -e "$f" ] || continue
    nn=${f##*/prev}; nn=${nn%.conf}
    [ "$nn" -le "$n" ] || rm -f "$f"
done
mv -f "$env_tmp" "$dir/menu.env"
sync
