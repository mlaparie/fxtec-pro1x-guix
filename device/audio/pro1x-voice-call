#!/usr/bin/env bash
# Voice call session, started and stopped by the "Voice Call" UCM verb.
#   start   start the session in the background
#   stop    stop it
#   run     the session itself (foreground)
#
pidfile="${XDG_RUNTIME_DIR:-/tmp}/pro1x-voice-call.pid"

case "${1:-run}" in
start)
  systemctl --user start pro1x-voicepcm.service 2>/dev/null && exit 0
  setsid -f pro1x-voice-call run >/dev/null 2>&1
  exit 0
  ;;
stop)
  systemctl --user stop pro1x-voicepcm.service 2>/dev/null && exit 0
  [ -f "$pidfile" ] && kill "$(cat "$pidfile")" 2>/dev/null
  exit 0
  ;;
run) ;;
*)
  echo "usage: $0 start|stop|run" >&2
  exit 1
  ;;
esac

# One session at most: PipeWire's profile probe at every login enables the
# Voice Call verb too, which started a new copy each time (they piled up,
# held the card in the Voice Call profile and their keep-alive streams
# power-cycled the codec: the pops at login, 2026-10-30).
if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
  exit 0
fi
echo $$ >"$pidfile"
kp=""
cur=""
vp=""
sig=""
pick() { pactl list short "$1" | awk -v pat="$2" '$2 ~ pat && $2 !~ /monitor/ { print $2; exit }'; }

start_keepers() {
  sink=$(pick sinks 'platform.sound.*Voice_Call')
  src=$(pick sources 'platform.sound.*Voice_Call')
  cur="$sink $src"
  [ -n "$sink" ] || return 1
  echo "keep-alive on $sink / $src"
  paplay --raw --device="$sink" --rate=48000 --format=s16le --channels=2 /dev/zero &
  kp="$!"
  if [ -n "$src" ]; then
    parec --device="$src" --rate=48000 --format=s16le --channels=1 >/dev/null &
    kp="$kp $!"
  fi
}

# Mute: in a call the microphone reaches the modem through the DSP, not
# through PipeWire, so muting the PipeWire source (Calls' mute button, via
# callaudiod) changed nothing.  Follow the Voice Call source's mute state
# with the codec-to-DSP capture route instead.
muted=""
follow_mute() {
  [ -n "$src" ] || return 0
  m=$(pactl get-source-mute "$src" 2>/dev/null | awk '{print $2}')
  [ -n "$m" ] && [ "$m" != "$muted" ] || return 0
  muted=$m
  if [ "$m" = yes ]; then
    amixer -c0 -q cset name='VoiceMMode1 Capture Mixer VA_CODEC_DMA_TX_0' 0
  else
    amixer -c0 -q cset name='VoiceMMode1 Capture Mixer VA_CODEC_DMA_TX_0' 1
  fi
  echo "microphone muted: $m"
}

# Speaker: PipeWire (1.2+) gives one card profile per output, so
# callaudiod's port switch does nothing here; upstream has no speaker
# switching during calls yet (pipewire issue 4868).  callaudiod still
# records Calls' speaker button ("Speaker enabled"); follow it by switching
# between the Voice Call profiles of the card.
speaker=""
follow_speaker() {
  s=$(callaudiocli -S 2>/dev/null | awk '/Speaker enabled/ {print $3}')
  [ -n "$s" ] && [ "$s" != "$speaker" ] || return 0
  card=$(pactl list short cards 2>/dev/null | awk '$2 ~ /platform.sound/ {print $2; exit}')
  [ -n "$card" ] || return 0
  speaker=$s
  if [ "$s" = CALL_AUDIO_SPEAKER_ON ]; then
    pactl set-card-profile "$card" "Voice Call (Mic, Speaker)" && echo "speaker on"
  else
    pactl set-card-profile "$card" "Voice Call (Earpiece, Mic)" && echo "speaker off"
  fi
}

stop_keepers() {
  [ -z "$kp" ] || kill $kp 2>/dev/null
  kp=""
}

alive() {
  [ -n "$kp" ] || return 1
  for p in $kp; do kill -0 $p 2>/dev/null || return 1; done
  [ "$cur" = "$(pick sinks 'platform.sound.*Voice_Call') $(pick sources 'platform.sound.*Voice_Call')" ]
}

# The DSP voice session (pro1x-voicepcm) is tied to the call: it was found to work when
# it starts while a call exists and not when it was started beforehand (the same order
# as postmarketOS' q6voiced). So it is started when ModemManager reports a new call and
# stopped when the last one is over. The codec keep-alive streams run for as long as the
# profile is active. PRO1X_VOICE_ALWAYS=1 (or no mmcli) starts it right away instead.
calls() { # object paths of the calls that are not over, on one line
  mmcli -m any --voice-list-calls 2>/dev/null |
    awk '/\((dialing|ringing-in|ringing-out|active|held|waiting)\)/ { print $1 }' | sort | tr '\n' ' '
}

start_pcm() {
  pro1x-voicepcm &
  vp="$!"
  echo "voice session started"
}

stop_pcm() {
  if [ -n "$vp" ]; then
    kill "$vp" 2>/dev/null
    wait "$vp" 2>/dev/null
    echo "voice session stopped"
  fi
  vp=""
}

trap 'stop_keepers; stop_pcm; rm -f "$pidfile"; exit 0' TERM INT

always=0
if [ "${PRO1X_VOICE_ALWAYS:-0}" = 1 ] || ! command -v mmcli >/dev/null 2>&1; then
  always=1
fi

# After the last call: stop, put the card back on HiFi (otherwise
# WirePlumber saves the Voice Call profile and restores it at every login),
# and exit.
finish() {
  stop_keepers
  stop_pcm
  card=$(pactl list short cards 2>/dev/null | awk '$2 ~ /platform.sound/ {print $2; exit}')
  [ -n "$card" ] && pactl set-card-profile "$card" "HiFi (Mic, Speaker)" 2>/dev/null &&
    echo "card back on HiFi"
  rm -f "$pidfile"
  exit 0
}

started=$(date +%s)
incall=0
while :; do
  if [ "$always" = 1 ]; then
    now=always
  else
    now=$(calls)
  fi

  if [ -n "$now" ]; then
    incall=1
    # Keep-alives only during a call.
    if ! alive; then
      stop_keepers
      sleep 1
      start_keepers || true
    fi
  elif [ "$incall" = 1 ]; then
    finish # the last call ended
  elif [ $(( $(date +%s) - started )) -ge 20 ]; then
    # Started without a call (the profile probe at login): leave the card
    # alone and go.
    rm -f "$pidfile"
    exit 0
  fi

  added=0
  for c in $now; do
    case " $sig " in *" $c "*) ;; *) added=1 ;; esac
  done
  if [ "$added" = 1 ]; then
    stop_pcm
    start_pcm # a new call: (re)start the session
  elif [ -z "$now" ] && [ -n "$vp" ]; then
    stop_pcm # the last call ended
  fi
  sig=$now

  if [ -n "$vp" ]; then
    follow_speaker
    follow_mute
  fi

  if [ -n "$vp" ] && ! kill -0 "$vp" 2>/dev/null; then
    wait "$vp" 2>/dev/null
    vp=""
    echo "voice session ended on its own"
    # no PCM to open (q6voice missing): nothing more to do in the always mode
    [ "$always" = 1 ] && exit 1
  fi
  sleep 1
done
