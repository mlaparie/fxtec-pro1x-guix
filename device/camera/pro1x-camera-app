        self.lens_scale.connect("value-changed", self.on_lens)
        far, near = Gtk.Label(label="∞"), Gtk.Label(label="min")
        for label in (far, near):
            label.get_style_context().add_class("status")
        self.lens_row.pack_start(far, False, False, 0)
        self.lens_row.pack_start(self.lens_scale, True, True, 0)
        self.lens_row.pack_start(near, False, False, 0)
        self.lens_row.pack_start(self.button("AF", self.on_focus_mode),
                                 False, False, 0)
        self.overlay.add_overlay(self.lens_row)
        # EV compensation: a vertical slider beside the side bar, +2 at the
        # top, applied as it moves.
        self.ev_row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL,
                              spacing=6, halign=Gtk.Align.START,
                              valign=Gtk.Align.CENTER)
        self.ev_scale = Gtk.Scale.new_with_range(
            Gtk.Orientation.VERTICAL, -2.0, 2.0, 1 / 3)
        self.ev_scale.set_inverted(True)
        self.ev_scale.set_value_pos(Gtk.PositionType.LEFT)
        self.ev_scale.connect("format-value", lambda _s, v: ev_text(v))
        self.ev_scale.add_mark(0.0, Gtk.PositionType.LEFT, None)
        self.ev_scale.set_value(self.ev)
        self.ev_scale.connect("value-changed", self.on_ev_scale)
        plus, minus = Gtk.Label(label="+2"), Gtk.Label(label="−2")
        for label in (plus, minus):
            label.get_style_context().add_class("status")
        self.ev_row.pack_start(plus, False, False, 0)
        self.ev_row.pack_start(self.ev_scale, True, True, 0)
        self.ev_row.pack_start(minus, False, False, 0)
        self.overlay.add_overlay(self.ev_row)
        # The menus above the sliders: the MF button lay under the focus
        # slider and could not be pressed (author, 2026-11-17).
        for menu in (self.panel, self.zoom_panel):
            self.overlay.reorder_overlay(menu, -1)
        self.show_zoom()
        self.show_outputs()

        # Pinch to zoom, from the window's own touch events: the view gets
        # no touches of its own (below), and a GestureZoom on the window
        # never zoomed (author, 2026-11-16).
        self.touches = {}               # touch → (x, y)
        self.win.connect("touch-event", self.on_win_touch)

        # A way out: fullscreen, there was none without a keyboard (author,
        # 2026-11-02).
        close = Gtk.Box(halign=Gtk.Align.END, valign=Gtk.Align.START,
                        margin_top=16, margin_end=16)
        close.pack_start(self.button("✕", lambda *_: self.quit_now()),
                         False, False, 0)
        self.overlay.add_overlay(close)

        top = Gtk.Box(spacing=12, halign=Gtk.Align.CENTER,
                      valign=Gtk.Align.START, margin_top=16)
        self.status = Gtk.Label(label="")
        self.status.get_style_context().add_class("status")
        self.b_last = self.button("Last photo", self.on_last)
        top.pack_start(self.status, False, False, 0)
        top.pack_start(self.b_last, False, False, 0)
        self.overlay.add_overlay(top)

        self.win.connect("size-allocate", self.on_size)
        # Diagnosis (2026-11-02): no tap reached the view; what does the
        # window itself get?
        self.win.add_events(Gdk.EventMask.BUTTON_PRESS_MASK |
                            Gdk.EventMask.TOUCH_MASK)
        # The window gets the taps the view does not (2026-11-02: presses
        # and touches logged on the window, none on the view, an overlay
        # layer in between); buttons take theirs before it.
        self.win.connect("button-press-event", self.on_win_press)
        self.win.fullscreen()
        self.win.connect("destroy", lambda *_: (self.stop(), self.led(False)))
        self.win.show_all()
        self.b_last.hide()
        self.lens_row.hide()
        self.ev_row.hide()
        self.panel.hide()
        self.zoom_panel.hide()
        self.layout()

        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1,
                             self.on_signal)
        self.cams = cameras()
        if not self.cams:
            self.say("No camera found")
            return
        self.start()

    def button(self, label, handler):
        b = Gtk.Button(label=label)
        b.connect("clicked", handler)
        return b

    def say(self, text, seconds=0):
        self.status.set_text(text)
        self.status.set_visible(bool(text))
        if seconds:
            GLib.timeout_add_seconds(seconds, lambda: self.say("") and False)

    # ── the pipeline ───────────────────────────────────────────────────
    # ── output settings ────────────────────────────────────────────────
    @staticmethod
    def load_settings():
        try:
            with open(SETTINGS) as f:
                s = json.load(f)
            return s if isinstance(s, dict) else {}
        except (OSError, ValueError):
            return {}

    def save_settings(self):
        try:
            os.makedirs(os.path.dirname(SETTINGS), exist_ok=True)
            with open(SETTINGS + ".new", "w") as f:
                json.dump(self.settings, f, indent=1)
            os.replace(SETTINGS + ".new", SETTINGS)
        except OSError as e:
            print("settings: %s" % e, flush=True)

    def stored(self):
        """This camera's saved settings for the current mode."""
        mode = "video" if self.video else "photo"
        cam = self.settings.setdefault("rear" if self.cam == 0 else "front", {})
        return cam.setdefault(mode, dict(DEFAULTS[mode]))

    def out(self):
        """The saved settings, or defaults where they are not offered now
        (full without the 48 MP mode); the saved ones stay as they are."""
        mode = "video" if self.video else "photo"
        o = dict(self.stored())
        shapes, sizes = self.choices()
        if o.get("shape") not in shapes:
            o["shape"] = DEFAULTS[mode]["shape"]
        if o.get("size") not in sizes:
            o["size"] = DEFAULTS[mode]["size"] if DEFAULTS[mode]["size"] in sizes \
                else sizes[0]
        return o

    def choices(self):
        """The shapes and resolutions offered now."""
        if self.video:
            return VIDEO_SHAPES, list(VIDEO_SIZES)
        if self.cam != 0:
            return PHOTO_SHAPES, ["full", "half"]
        return PHOTO_SHAPES, (["full"] if self.wide else []) + ["binned", "half"]

    def scale(self):
        return 0.5 if self.out()["size"] == "half" else 1.0

    def view_size(self):
        o = self.out()
        if self.video:
            h = VIDEO_SIZES[o["size"]]
            return (int(h * RATIOS[o["shape"]]) // 16 * 16, h)
        return VIEWS[o["shape"]]

    def start(self, size=None):
        """The viewfinder (videos are a branch added to it later)."""
        name, dev = self.cams[self.cam]
        self.wide = self.cam == 0 and max_width(dev) >= STILL_48[0]
        self.show_outputs()
        size = size or self.view_size()
        self.src = dev.create_element("src")
        self.caps = Gst.ElementFactory.make("capsfilter")
        self.caps.set_property(
            "caps", Gst.Caps.from_string(
                "video/x-raw,width=%d,height=%d" % size))
        # The zoom, before the tee: what the view shows is what is kept.
        self.crop = Gst.ElementFactory.make("videocrop")
        self.flip = Gst.ElementFactory.make("videoflip")
        self.tee = tee = Gst.ElementFactory.make("tee")
        q1 = Gst.ElementFactory.make("queue")
        # Only the newest frame waits: the view never falls behind.
        q1.set_property("leaky", 2)
        q1.set_property("max-size-buffers", 1)
        # A photo's frames stay out of the view: GTK scaled each 12 or
        # 48 MP frame on the CPU while the photo was saved.
        q1.get_static_pad("sink").add_probe(Gst.PadProbeType.BUFFER,
                                            self.on_view_buffer)
        # Only the view's frames are converted, for the sink; the photo's
        # stay as libcamera made them (RGBA).
        convert = Gst.ElementFactory.make("videoconvert")
        sink = Gst.ElementFactory.make("gtksink")
        sink.set_property("sync", False)
        # No wait for a first frame at a state change: during a photo the
        # view gets none.
        sink.set_property("async", False)
        q2 = Gst.ElementFactory.make("queue")
        q2.set_property("leaky", 2)
        q2.set_property("max-size-buffers", 1)
        # The photo's branch holds libcamera's own buffers, uncopied: it
        # takes frames only during a photo, and keeps none after it, or
        # libcamera runs short of buffers and stops (2026-11-17).
        q2.get_static_pad("sink").add_probe(Gst.PadProbeType.BUFFER,
                                            self.on_snap_buffer)
        self.snap = Gst.ElementFactory.make("appsink")
        for k, v in (("drop", True), ("max-buffers", 1), ("sync", False),
                     ("emit-signals", False), ("enable-last-sample", False)):
            self.snap.set_property(k, v)

        self.pipeline = Gst.Pipeline.new("camera")
        for e in (self.src, self.caps, self.crop, tee, q1,
                  self.flip, convert, sink, q2, self.snap):
            self.pipeline.add(e)
        self.raw_sink = self.raw_branch() if self.raw_mode() else None
        self.src.link(self.caps)
        self.caps.link(self.crop)
        self.crop.link(tee)
        tee.link(q1)
        q1.link(self.flip)
        self.flip.link(convert)
        convert.link(sink)
        tee.link(q2)
        q2.link(self.snap)
        bus = self.pipeline.get_bus()
        bus.add_signal_watch()
        bus.connect("message", self.on_message)

        widget = sink.get_property("widget")
        child = self.view.get_child()
        if child:
            self.view.remove(child)
        self.view.add(widget)
        widget.show()
        self.area = active_area(dev)
        self.size = size
        self.orient()
        self.apply_zoom()
        self.apply_controls()
        self.pipeline.set_state(Gst.State.PLAYING)
        self.say(name.split(" ")[0], 2)

    def raw_mode(self):
        """Photos from the raw stream (RAW): photo mode, not the 48 MP."""
        return (not self.video and not self.no_raw and self.cam in RAW
                and os.access(DEVELOP, os.X_OK)
                and not (self.cam == 0 and self.out()["size"] == "full"))

    def raw_branch(self):
        """The raw stream, from a pad of libcamerasrc's own, to an appsink
        holding the newest frame.  Its size makes libcamera choose the
        photo's sensor mode for both streams."""
        pad = self.src.request_pad_simple("src_%u")
        Gst.util_set_object_arg(pad, "stream-role", "raw")
        caps = Gst.ElementFactory.make("capsfilter")
        caps.set_property("caps", Gst.Caps.from_string(
            "video/x-bayer,width=%d,height=%d" % RAW[self.cam]))
        q = Gst.ElementFactory.make("queue")
        q.set_property("leaky", 2)
        q.set_property("max-size-buffers", 1)
        sink = Gst.ElementFactory.make("appsink")
        for k, v in (("drop", True), ("max-buffers", 1), ("sync", False),
                     ("async", False), ("enable-last-sample", False)):
            sink.set_property(k, v)
        for e in (caps, q, sink):
            self.pipeline.add(e)
        pad.link(caps.get_static_pad("sink"))
        caps.link(q)
        q.link(sink)
        return sink

    def recording_branch(self, path):
        """Frames at a steady size (the zoom changes the crop's), turned as
        the photos are, to the encoder; the microphone beside them.  The
        encoder is never asked to drain: the end of stream is sent after it
        (stop_recording).  A drain stuck with the viewfinder's other branches
        attached, and stopping the pipeline then froze the phone (2026-11-16,
        twice; stopping without a drain never did).  libcamera's buffers come
        straight from the tee, so the first step copies them (to NV12) and
        holds one at most: holding more (a queue of 4, videorate's previous
        frame) stopped the camera, which has four.  The file sink does not
        wait for a preroll: added to a playing pipeline, it never got one
        and the muxer stalled (2026-11-17)."""
        # Turned as a photo taken now would be (turn()): as the view, then
        # as held when the display stayed portrait (author, 2026-11-17:
        # videos played the wrong way round).
        turn = {90: "counterclockwise", 270: "clockwise", 180: "rotate-180"
                }.get(self.turn(self.held(), self.method()), "none")
        width, height = self.view_size()
        desc = (
            "queue max-size-buffers=1 leaky=downstream ! "
            "videoconvert ! video/x-raw,format=NV12 ! videoscale ! "
            "videorate drop-only=true max-rate=%d ! "
            "video/x-raw,width=%d,height=%d,framerate=%d/1 ! "
            "videoflip method=%s ! "
            'v4l2h264enc extra-controls="controls,video_gop_size=%d,'
            "h264_i_frame_period=%d,h264_minimum_qp_value=%d,"
            'h264_i_frame_minimum_qp_value=%d,h264_p_frame_minimum_qp_value=%d;" ! '
            "h264parse name=parse ! queue ! matroskamux name=mux ! "
            "filesink name=file async=false "
            "pulsesrc name=mic ! queue ! audioconvert ! audioresample ! opusenc ! "
            "queue name=aq ! mux."
            % (VIDEO_RATE, width, height, VIDEO_RATE, turn, VIDEO_RATE,
               VIDEO_RATE, VIDEO_MIN_QP, VIDEO_MIN_QP, VIDEO_MIN_QP))
        branch = Gst.parse_bin_from_description(desc, True)
        branch.get_by_name("file").set_property("location", path)
        return branch

    def on_view_buffer(self, pad, info):
        return Gst.PadProbeReturn.DROP if self.shooting else Gst.PadProbeReturn.OK

    def on_snap_buffer(self, pad, info):
        return Gst.PadProbeReturn.OK if self.shooting else Gst.PadProbeReturn.DROP

    def on_message(self, bus, msg):
        if msg.type == Gst.MessageType.ERROR:
            err, debug = msg.parse_error()
            print("pipeline: %s (%s)" % (err.message, debug), flush=True)
            if self.raw_sink is not None and not self.no_raw:
                # Photos by the mode switch again, until the app restarts.
                print("raw stream: failed, photos by a mode switch", flush=True)
                self.no_raw = True
                GLib.idle_add(self.restart)
                return
            if self.recording:
                self.say("Video stopped: %s" % err.message, 4)
                self.recorded()

    @staticmethod
    def locked_flag():
        """There while this is open over the lock screen (pro1x-lock
        --app-unlock)."""
        return os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "pro1x-locked-app")

    def quit_now(self):
        """Out at once, always: closing could hang (author, 2026-11-03, with no
        camera found), and over the lock screen a window left behind is a way
        in.  At most 1.5 s for the pipeline and LED, then the process ends.
        Over the lock screen, the lock comes first, and pro1x-open closes this
        behind it, so the session never shows (author, 2026-11-03)."""
        if os.path.exists(self.locked_flag()):
            subprocess.Popen(["swaymsg", "exec", "pro1x-lock"],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            threading.Timer(5, os._exit, (0,)).start()
            return
        threading.Timer(1.5, os._exit, (0,)).start()
        self.win.hide()
        if self.rec:
            # The video's end first, so its file is whole.
            self.close_branch()
            self.rec_closed.wait(1)
        self.stop()
        self.led(False)
        os._exit(0)

    def restart(self):
        self.stop()
        self.start()
        return False

    def stop(self):
        if self.pipeline:
            self.pipeline.get_bus().remove_signal_watch()
            self.pipeline.set_state(Gst.State.NULL)
            self.pipeline = None

    def resize(self, size, carry=None):
        """The same camera at another sensor mode (a state cycle).  CARRY:
        (exposure time, analogue gain, lens position) to hold during it,
        else automatic again.  READY keeps the camera open; NULL closed
        it, and libcamera started over without the viewfinder's state."""
        self.pipeline.set_state(Gst.State.READY)
        self.caps.set_property(
            "caps", Gst.Caps.from_string(
                "video/x-raw,width=%d,height=%d" % size))
        self.size = size
        self.apply_zoom()
        self.apply_controls(carry)
        self.pipeline.set_state(Gst.State.PLAYING)

    def current(self):
        """The viewfinder's exposure time (µs) and gain, from the last
        frame's metadata (libcamerasrc reads them back: moWerk's patch
        0014), or None."""
        try:
            exp = self.src.get_property("exposure-time")
            gain = self.src.get_property("analogue-gain")
        except TypeError:
            return None
        print("viewfinder: exposure %s µs, gain %s" % (exp, gain), flush=True)
        return (exp, gain) if exp and exp > 0 else None

    def focus_controls(self):
        """Manual: the lens where the slider is.  Auto: one scan, then the
        focus is held until the next tap (AfModeAuto, moWerk's patch 0015).
        Manual mode used to hold it, but kept scanning: libcamera had no
        manual focus before patch 0020 (author: taps did not refocus, a
        video focused again at its start)."""
        if self.manual:
            self.src.set_property("af-mode", 0)
            self.src.set_property("lens-position", self.lens)
            self.lens_at = self.lens
        else:
            self.src.set_property("af-mode", 1)

    def wb_controls(self):
        """The white balance automatic, or kept at the gains it found last
        (AwbEnable, libcamera patch 0022), photos included."""
        try:
            self.src.set_property("awb-enable", not self.wb_locked)
        except TypeError:
            pass

    def apply_controls(self, carry=None):
        # The same focus for the photo: libcamera keeps a found one over the
        # mode switch (moWerk's patch 0017).
        self.focus_controls()
        self.wb_controls()
        if carry:
            # The photo: exposure and gain as in the viewfinder.  At the mode
            # switch the automatic exposure started from its minimum, and
            # the photo was black (seen, 2026-11-01).
            exp, gain = carry
            if self.night:
                # Two stops more light for a dark scene: four times the
                # viewfinder's exposure (which stops at 66 ms), at most
                # 0.5 s, the gain unchanged.  Possible since libcamera
                # raises the blanking (patch 0018); hold the phone still.
                exp = min(exp * 4, 500000)
            self.src.set_property("exposure-time-mode", 1)      # manual
            self.src.set_property("exposure-time", int(exp))
            self.src.set_property("analogue-gain-mode", 1)
            self.src.set_property("analogue-gain",
                                  self.iso / 100.0 if self.iso else gain)
            return
        self.src.set_property("exposure-time-mode", 0)          # auto
        if self.iso:
            self.src.set_property("analogue-gain-mode", 1)       # manual
            self.src.set_property("analogue-gain", self.iso / 100.0)
        else:
            self.src.set_property("analogue-gain-mode", 0)       # auto
        self.src.set_property("exposure-value", self.ev)

    # ── orientation ────────────────────────────────────────────────────
    def on_size(self, win, rect):
        transform = display_transform()
        if transform != getattr(self, "transform", None):
            self.transform = transform
            self.portrait = transform in ("normal", "180")
            self.orient()
        size = (rect.width, rect.height)
        if size != getattr(self, "laid_out", None):
            self.laid_out = size
            GLib.idle_add(self.layout)

    def layout(self):
        """Landscape: the controls in a column at the right edge, the
        shutter in its middle, the focus slider beside it.  Portrait: rows
        at the bottom, the slider at the right edge.  The slider is about
        the short edge long either way (author, 2026-11-17)."""
        w, h = self.win.get_size()
        wide = w > h
        vertical, horizontal = Gtk.Orientation.VERTICAL, Gtk.Orientation.HORIZONTAL
        for box in (self.top, self.main, self.side, self.marks):
            box.set_orientation(vertical if wide else horizontal)
        self.main.set_spacing(20 if wide else 28)
        if wide:
            self.controls.set_halign(Gtk.Align.END)
            self.controls.set_valign(Gtk.Align.CENTER)
            self.controls.set_margin_end(16)
            self.controls.set_margin_bottom(0)
            self.side.set_halign(Gtk.Align.START)
            self.side.set_valign(Gtk.Align.CENTER)
            self.side.set_margin_start(16)
            self.side.set_margin_top(0)
        else:
            self.controls.set_halign(Gtk.Align.CENTER)
            self.controls.set_valign(Gtk.Align.END)
            self.controls.set_margin_end(0)
            self.controls.set_margin_bottom(16)
            self.side.set_halign(Gtk.Align.START)
            self.side.set_valign(Gtk.Align.START)
            self.side.set_margin_start(16)
            self.side.set_margin_top(16)
        # The menus open beside the control bar.
        bar_w = self.controls.get_allocated_width()
        bar_h = self.controls.get_allocated_height()
        for menu in (self.panel, self.zoom_panel):
            if wide:
                menu.set_halign(Gtk.Align.END)
                menu.set_valign(Gtk.Align.CENTER)
                menu.set_margin_end(bar_w + 24)
                menu.set_margin_bottom(0)
            else:
                menu.set_halign(Gtk.Align.CENTER)
                menu.set_valign(Gtk.Align.END)
                menu.set_margin_end(0)
                menu.set_margin_bottom(bar_h + 24)
        self.lens_row.set_margin_end(bar_w + 24 if wide else 12)
        side_w = self.side.get_allocated_width() if wide else 0
        self.ev_row.set_margin_start(side_w + 24 if wide else 12)
        for scale in (self.lens_scale, self.ev_scale):
            scale.set_size_request(-1, int(min(w, h) * 0.7))
        return False

    def marks_wanted(self):
        """(label, reset) for each setting away from its default."""
        marks = []
        if self.flash != "off":
            marks.append(("TORCH" if self.flash == "torch" else
                          "FLASH " + self.flash.upper(),
                          lambda: self.reset_cycle("flash", FLASH_MODES, self.on_flash)))
        if self.night:
            marks.append(("NIGHT", self.on_night))
        if round(self.ev * 3):
            marks.append(("EV " + ev_text(self.ev), lambda: self.ev_scale.set_value(0.0)))
        if self.manual:
            marks.append(("MF " + lens_text(self.lens),
                          lambda: self.lens_row.set_visible(not self.lens_row.get_visible())))
        if self.iso:
            marks.append(("ISO %d" % self.iso,
                          lambda: self.reset_cycle("iso", ISOS, self.on_iso)))
        if self.timer:
            marks.append(("TIMER %dS" % self.timer,
                          lambda: self.reset_cycle("timer", TIMERS, self.on_timer)))
        if self.wb_locked:
            marks.append(("WB LOCK", self.on_wb))
        mode = "video" if self.video else "photo"
        shapes, sizes = self.choices()
        o = self.out()
        default_size = DEFAULTS[mode]["size"] if DEFAULTS[mode]["size"] in sizes \
            else sizes[0]
        if o["shape"] != DEFAULTS[mode]["shape"]:
            marks.append((o["shape"], lambda: self.reset_output(
                "shape", DEFAULTS[mode]["shape"])))
        if o["size"] != default_size:
            marks.append((self.b_res.get_label().replace(" ", ""),
                          lambda: self.reset_output("size", default_size)))
        return marks

    def update_marks(self):
        marks = self.marks_wanted()
        labels = [m[0] for m in marks]
        if labels != self.marked:
            self.marked = labels
            for child in self.marks.get_children():
                self.marks.remove(child)
            for label, reset in marks:
                b = Gtk.Button(label=label)
                b.get_style_context().add_class("mark")
                b.connect("clicked", lambda _b, r=reset: r())
                self.marks.pack_start(b, False, False, 0)
            self.marks.show_all()
        return True

    def reset_cycle(self, attr, values, handler):
        """A cycling setting back to its first value, by its own handler."""
        setattr(self, attr, values[-1])
        handler()

    def reset_output(self, key, value):
        if self.busy or self.recording:
            return
        self.stored()[key] = value
        self.save_settings()
        self.outputs_changed()

    def toggle_menu(self, menu):
        """One menu open at a time."""
        show = not menu.get_visible()
        for m in (self.panel, self.zoom_panel):
            m.hide()
        menu.set_visible(show)

    def pick_zoom(self, z):
        self.set_zoom(z)
        self.zoom_panel.hide()

    def method(self):
        rear, front = VIEW_TURN.get(getattr(self, "transform", "normal"),
                                    VIEW_TURN["normal"])
        return front if self.cam != 0 else rear

    def orient(self):
        """The rear sensor's frames are landscape with the phone's top to
        their left (seen on the phone, 2026-11-01); the front one is
        mirrored."""
        if not self.pipeline:
            return
        self.flip.set_property("method", self.method())
        print("orient: display %s, %s camera, turn %s"
              % (getattr(self, "transform", "?"),
                 "front" if self.cam != 0 else "rear", self.method()),
              flush=True)

    # ── controls ───────────────────────────────────────────────────────
    def on_switch(self, *_):
        if self.busy or self.recording or len(self.cams) < 2:
            return
        self.stop()
        self.cam = (self.cam + 1) % len(self.cams)
        self.zoom = 1.0
        self.show_zoom()
        self.start()

    def on_flash(self, *_):
        self.flash = FLASH_MODES[(FLASH_MODES.index(self.flash) + 1)
                                 % len(FLASH_MODES)]
        self.b_flash.set_label("Flash %s" % self.flash)
        self.lit(self.b_flash, self.flash != "off")
        if not self.busy and not self.recording:
            self.led(self.flash == "torch")

    def on_timer(self, *_):
        self.timer = TIMERS[(TIMERS.index(self.timer) + 1) % len(TIMERS)]
        self.b_timer.set_label("Timer %s" % ("%d s" % self.timer
                                             if self.timer else "off"))
        self.lit(self.b_timer, bool(self.timer))

    def on_mode(self, *_):
        """Photos or videos: the shutter turns red for videos."""
        if self.busy or self.recording or self.countdown:
            return
        self.video = not self.video
        self.lit(self.b_mode, self.video)
        ctx = self.b_shutter.get_style_context()
        (ctx.add_class if self.video else ctx.remove_class)("video")
        # Night lengthens a photo's exposure; a video has none to lengthen.
        self.b_night.set_sensitive(not self.video)
        self.outputs_changed()

    # ── zoom ───────────────────────────────────────────────────────────
    def set_zoom(self, z):
        self.zoom = min(MAX_ZOOM, max(1.0, z))
        self.apply_zoom()
        self.show_zoom()

    def show_zoom(self):
        """The zoom on its menu's button; the preset that is on."""
        for z, b in self.b_zooms:
            self.lit(b, abs(z - self.zoom) < 0.05)
        self.b_zoom.set_label("%g×" % round(self.zoom, 1))

    def photo_region(self):
        """The photo's part of the still frame, before its size scale."""
        shape = self.out()["shape"]
        ratio = RATIOS[shape]
        w, h = self.still()
        if shape == "16:9" and self.cam == 0 and not self.raw_mode():
            w = w * VIEW_REGION_WIDTH
            h = w * 9 / 16
        return min(w, h * ratio), min(h, w / ratio)

    def region(self):
        """The part of the frame at the current size that the viewfinder's
        shape shows: in the viewfinder, the largest part in the shape; in a
        photo's frame, the same part of the scene."""
        if self.size != self.view_size():
            return self.photo_region()
        ratio = RATIOS[self.out()["shape"]]
        w, h = self.size
        return min(w, h * ratio), min(h, w / ratio)

    def apply_zoom(self):
        """The crop for the frames at the current size: the shape's region,
        a centred part 1/zoom of it wide and high, even sizes for the video
        formats."""
        if not self.pipeline:
            return
        w, h = self.size
        rw, rh = self.region()
        x = max(0, int((w - rw / self.zoom) / 4) * 2)
        y = max(0, int((h - rh / self.zoom) / 4) * 2)
        for side, v in (("left", x), ("right", x), ("top", y), ("bottom", y)):
            self.crop.set_property(side, v)
        self.cropped = (w - 2 * x, h - 2 * y)

    def on_shape(self, *_):
        self.cycle("shape", 0)

    def on_res(self, *_):
        self.cycle("size", 1)

    def cycle(self, key, which):
        """The next shape or resolution for this camera and mode, saved."""
        if self.busy or self.recording:
            return
        options = self.choices()[which]
        now = self.out()[key]
        self.stored()[key] = options[(options.index(now) + 1) % len(options)]
        self.save_settings()
        self.outputs_changed()

    def outputs_changed(self):
        """Another sensor mode or stream size if the viewfinder's changed
        (a restart), else only the crop."""
        self.show_outputs()
        if not self.pipeline or self.busy:
            return
        if self.raw_mode() != (self.raw_sink is not None):
            self.restart()
        elif self.view_size() != self.size:
            self.resize(self.view_size())
        else:
            self.apply_zoom()

    def show_outputs(self):
        """4:3 and 12 MP, or 16:9 and 1080p: what will be saved."""
        o = self.out()
        self.b_shape.set_label(o["shape"])
        if self.video:
            self.b_res.set_label(o["size"])
            return
        pw, ph = (v * self.scale() for v in self.photo_region())
        mp = pw * ph / 1e6
        self.b_res.set_label(("%.0f MP" if mp >= 1.5 else "%.1f MP") % mp)

    def on_wb(self, *_):
        """Lock the colours as they are now (mixed light, a subject that
        fills the frame), or let them follow the scene again.  Presets
        would need calibrated gains (TODO.org)."""
        self.wb_locked = not self.wb_locked
        self.b_wb.set_label("WB lock" if self.wb_locked else "WB auto")
        self.lit(self.b_wb, self.wb_locked)
        if self.pipeline and not self.busy:
            self.wb_controls()

    def on_focus_mode(self, *_):
        """Autofocus, or the lens where the slider puts it."""
        if not self.manual:
            # From where the autofocus left the lens (patch 0020 reports it).
            try:
                lens = float(self.src.get_property("lens-position"))
            except (TypeError, ValueError, AttributeError):
                lens = self.lens
            self.lens = min(LENS_MAX, max(0.0, lens))
            self.lens_scale.set_value(self.lens)
        self.manual = not self.manual
        self.b_focus.set_label("MF" if self.manual else "AF")
        self.lit(self.b_focus, self.manual)
        self.lens_row.set_visible(self.manual)
        if self.pipeline and not self.busy:
            self.focus_controls()

    def on_lens(self, scale):
        """The lens follows the slider at a capped speed: jumps of the
        voice coil clack, and could wear it (author, 2026-11-17)."""
        self.lens = scale.get_value()
        if self.lens_step is None:
            self.lens_step = GLib.timeout_add(LENS_TICK_MS, self.step_lens)

    def step_lens(self):
        if not (self.manual and self.pipeline) or self.busy:
            self.lens_step = None
            return False
        delta = self.lens - self.lens_at
        if abs(delta) < 1e-3:
            self.lens_step = None
            return False
        self.lens_at += max(-LENS_MAX_STEP, min(LENS_MAX_STEP, delta))
        self.src.set_property("lens-position", self.lens_at)
        return True

    def on_win_touch(self, win, event):
        """Two fingers: the zoom follows their distance from where they
        started.  Touches are told apart by their sequence's address (the
        Python wrapper differs from event to event)."""
        seq = repr(event.get_event_sequence()).rsplit("0x", 1)[-1]
        ok, x, y = event.get_root_coords()
        t = event.type
        if t in (Gdk.EventType.TOUCH_BEGIN, Gdk.EventType.TOUCH_UPDATE):
            self.touches[seq] = (x, y)
        else:
            self.touches.pop(seq, None)
        if t == Gdk.EventType.TOUCH_BEGIN:
            print("pinch: touch down, %d fingers" % len(self.touches), flush=True)
        if len(self.touches) == 2:
            (x1, y1), (x2, y2) = self.touches.values()
            d = max(1.0, ((x1 - x2) ** 2 + (y1 - y2) ** 2) ** 0.5)
            if self.pinch_from is None:
                self.pinch_from = (self.zoom, d)
            else:
                z0, d0 = self.pinch_from
                z = min(MAX_ZOOM, max(1.0, z0 * d / d0))
                # Each change renegotiates the crop: not for every pixel.
                if abs(z - self.zoom) > 0.03:
                    self.set_zoom(z)
        elif self.pinch_from is not None:
            print("pinch: zoom %.2f" % self.zoom, flush=True)
            self.pinch_from = None
            self.pinched = time.monotonic()
        return False

    def on_iso(self, *_):
        self.iso = ISOS[(ISOS.index(self.iso) + 1) % len(ISOS)]
        self.b_iso.set_label("ISO %s" % (self.iso or "auto"))
        if not self.busy:
            self.apply_controls()

    def on_night(self, *_):
        self.night = not self.night
        self.lit(self.b_night, self.night)

    def lit(self, button, on):
        """A toggle that is on stands out (author: Night on and off looked
        the same)."""
        ctx = button.get_style_context()
        (ctx.add_class if on else ctx.remove_class)("on")

    def on_ev(self, *_):
        """The EV slider shown or hidden."""
        self.ev_row.set_visible(not self.ev_row.get_visible())

    def on_ev_scale(self, scale):
        self.ev = round(scale.get_value() * 3) / 3
        self.b_ev.set_label("EV " + ev_text(self.ev))
        self.lit(self.b_ev, self.ev != 0)
        if self.pipeline and not self.busy:
            self.src.set_property("exposure-value", self.ev)

    def on_win_press(self, win, event):
        """A press on the window: a tap on the view, in its coordinates."""
        got = win.translate_coordinates(self.view, int(event.x), int(event.y))
        if not got:
            return False
        x, y = got
        alloc = self.view.get_allocation()
        if not (0 <= x < alloc.width and 0 <= y < alloc.height):
            return False

        class Tap:
            pass
        tap = Tap()
        tap.x, tap.y, tap.type = x, y, event.type
        return self.on_tap(self.view, tap)

    def on_touch(self, widget, event):
        print("tap: touch %s at %.0f %.0f" % (event.type, event.x, event.y),
              flush=True)
        if event.type == Gdk.EventType.TOUCH_BEGIN:
            return self.on_tap(widget, event)
        return False

    def on_tap(self, widget, event):
        """Focus where tapped: the point in the viewfinder, in frame
        coordinates (undoing the rotation), then in pixel array
        coordinates, as moWerk's camerabin patch maps it."""
        print("tap: %s at %.0f %.0f, busy %s" % (event.type, event.x, event.y,
                                                 self.busy), flush=True)
        if self.panel.get_visible() or self.zoom_panel.get_visible():
            # A tap beside a menu closes it, and focuses nowhere.
            self.panel.hide()
            self.zoom_panel.hide()
            return False
        if self.busy:
            return False
        # The picture inside the view, with bars around it in other shapes.
        alloc = widget.get_allocation()
        rw, rh = self.region()
        aspect = rw / rh
        if self.method() in ("clockwise", "counterclockwise"):
            aspect = 1 / aspect
        dw, dh = alloc.width, alloc.height
        if dw / dh > aspect:
            dw = dh * aspect
        else:
            dh = dw / aspect
        x = (event.x - (alloc.width - dw) / 2) / dw
        y = (event.y - (alloc.height - dh) / 2) / dh
        if not (0 <= x <= 1 and 0 <= y <= 1):
            return False
        # A first finger may be the start of a pinch: focus only if no
        # second one came within 250 ms.
        GLib.timeout_add(250, self.focus_at, event.x, event.y, x, y)
        return True

    def focus_at(self, px, py, x, y):
        """Focus and expose for (x, y), a fraction of the picture, drawn at
        (PX, PY); in manual focus, exposure only."""
        if self.busy or self.pinch_from is not None \
           or time.monotonic() - self.pinched < 0.4:
            return False
        # The square first: a tap did nothing visible while the active
        # area was unknown (author, 2026-11-02: no focus indicator).
        self.mark = (px, py, (1.0, 0.8, 0.0))
        self.marker.queue_draw()
        x, y = TAP_BACK[self.method()](x, y)
        # The picture is the centre of the frame: the shape's region, 1/zoom
        # of it.
        rw, rh = self.region()
        sw, sh = self.size
        x = 0.5 + (x - 0.5) * rw / self.zoom / sw
        y = 0.5 + (y - 0.5) * rh / self.zoom / sh
        # libcamerasrc may not publish the active area: the still size, a
        # little short of the IMX582's 4000x3000 array, does for a window.
        ax, ay, aw, ah = self.area or (0, 0) + self.still()
        print("focus: area %s, tap %.2f %.2f" % (self.area, x, y), flush=True)
        vw, vh = self.size
        fw = max(vw, vh * aw / ah)
        fh = fw * ah / aw
        scale = aw / fw
        half = 0.08 / self.zoom        # a window 16 % of the view wide
        wx = ax + ((fw - vw) / 2 + max(0.0, x - half) * vw) * scale
        wy = ay + ((fh - vh) / 2 + max(0.0, y - half) * vh) * scale
        ww = 2 * half * vw * scale + (8 if self.toggle else 0)
        wh = 2 * half * vh * scale
        self.toggle = not self.toggle  # the same spot again restarts it
        # A new window restarts the scan (moWerk's patch 0013), and the
        # exposure is measured there (patch 0021).
        Gst.util_set_object_arg(
            self.src, "af-windows",
            "<<%d, %d, %d, %d>>" % (wx, wy, ww, wh))
        self.src.set_property("ae-metering-mode", 1)            # spot
        if self.manual:
            GLib.timeout_add(800, self.clear_mark)
            return False
        self.af_polls = 0
        GLib.timeout_add(150, self.poll_focus)
        return False

    def poll_focus(self):
        """The marker's colour after libcamera's AfState (0 idle,
        1 scanning, 2 focused, 3 failed; moWerk's patch exposes it)."""
        if not self.mark or not self.pipeline:
            return False
        try:
            state = int(self.src.get_property("af-state"))
        except (TypeError, ValueError):
            state = 0
        self.af_polls += 1
        x, y, _ = self.mark
        colour = {2: (0.3, 0.9, 0.3), 3: (0.95, 0.3, 0.3)}.get(state, (1.0, 0.8, 0.0))
        self.mark = (x, y, colour)
        self.marker.queue_draw()
        if state in (2, 3) or self.af_polls > 30:
            GLib.timeout_add(1200, self.clear_mark)
            return False
        return True

    def clear_mark(self):
        self.mark = None
        self.marker.queue_draw()
        return False

    def shutter_blink(self):
        """The view dims and comes back in 0.15 s when a photo's frame is
        kept, so the photo is seen to be taken: not black or white, which
        dazzle or vanish at night."""
        self.blink = time.monotonic()
        self.marker.add_tick_callback(self.on_blink_tick)

    def on_blink_tick(self, area, clock):
        area.queue_draw()
        if self.blink and time.monotonic() - self.blink < BLINK_SECONDS:
            return True
        self.blink = None
        return False

    def on_draw_marker(self, area, cr):
        if self.blink:
            left = 1 - (time.monotonic() - self.blink) / BLINK_SECONDS
            if left > 0:
                cr.set_source_rgba(0, 0, 0, 0.6 * left)
                cr.paint()
        if not self.mark:
            return False
        x, y, (r, g, b) = self.mark
        side = min(area.get_allocated_width(), area.get_allocated_height()) * 0.16
        cr.set_source_rgb(r, g, b)
        cr.set_line_width(3)
        cr.rectangle(x - side / 2, y - side / 2, side, side)
        cr.stroke()
        return False

    # ── photos ─────────────────────────────────────────────────────────
    def on_signal(self):
        self.on_shutter()
        return True

    def on_shutter(self, *_):
        """A photo, or a video started or stopped; after the timer, if set.
        The shutter during the countdown cancels it."""
        if self.countdown:
            GLib.source_remove(self.countdown[1])
            self.countdown = None
            self.say("")
            return
        if self.recording:
            self.stop_recording()
            return
        if self.busy or not self.pipeline:
            return
        if self.timer:
            self.countdown = (self.timer, GLib.timeout_add_seconds(1, self.tick))
            self.say("%d" % self.timer)
            return
        self.shoot()

    def tick(self):
        left = self.countdown[0] - 1
        if left > 0:
            self.countdown = (left, self.countdown[1])
            self.say("%d" % left)
            return True
        self.countdown = None
        self.say("")
        self.shoot()
        return False

    def shoot(self):
        if self.video:
            self.start_recording()
            return
        self.busy = True
        self.b_shutter.set_sensitive(False)
        self.say("Taking a photo")
        self.t0 = time.monotonic()
        self.fired = self.flash == "on" or (self.flash == "auto" and self.dark())
        if self.fired:
            # A pre-flash, without blocking the window: the exposure then
            # settles on the lit scene before it is carried over.
            self.led(True)
            GLib.timeout_add(600, self.to_still)
        else:
            self.to_still()

    def dark(self):
        """For the automatic flash: the viewfinder's exposure is near its
        longest and its gain high."""
        cur = self.current()
        return bool(cur) and cur[0] >= AUTO_FLASH_EXPOSURE \
            and cur[1] >= AUTO_FLASH_GAIN

    # ── videos ─────────────────────────────────────────────────────────
    def start_recording(self):
        """A recording branch on the running viewfinder's tee, its
        timestamps from 0; the LED on for Flash on or torch."""
        os.makedirs(VIDEOS, exist_ok=True)
        path = os.path.join(VIDEOS, time.strftime("VID_%Y%m%d_%H%M%S.mkv"))
        self.rec = self.recording_branch(path)
        self.rec_closed.clear()
        # The file is whole once the end of stream reaches the file sink.
        self.rec.get_by_name("file").get_static_pad("sink").add_probe(
            Gst.PadProbeType.EVENT_DOWNSTREAM, self.on_rec_event)
        self.pipeline.add(self.rec)
        clock = self.pipeline.get_clock()
        now = clock.get_time() - self.pipeline.get_base_time() if clock else 0
        sink = self.rec.get_static_pad("sink")
        sink.set_offset(-now)
        self.rec.get_by_name("mic").get_static_pad("src").set_offset(-now)
        # Playing before it is linked: a frame pushed into a stopped branch
        # came back as flushing, and libcamerasrc stopped for good.
        self.rec.sync_state_with_parent()
        self.rec_pad = self.tee.request_pad_simple("src_%u")
        self.rec_pad.link(sink)
        self.led(self.flash in ("on", "torch"))
        self.recording = (path, time.monotonic(),
                          GLib.timeout_add(500, self.show_recording))
        self.b_shutter.get_style_context().add_class("recording")
        self.show_recording()
        print("video: recording %s" % path, flush=True)

    def on_rec_event(self, pad, info):
        if info.get_event().type == Gst.EventType.EOS:
            self.rec_closed.set()
            GLib.idle_add(self.recorded)
        return Gst.PadProbeReturn.OK

    def show_recording(self):
        if not self.recording:
            return False
        secs = int(time.monotonic() - self.recording[1])
        self.say("● %d:%02d" % (secs // 60, secs % 60))
        return True

    def close_branch(self):
        """The branch off the tee, then the end of stream after the encoder
        and after the microphone's encoder: the frames still in the video
        encoder are lost, but it never drains (recording_branch)."""
        pad, sink = self.rec_pad, self.rec.get_static_pad("sink")
        self.rec_pad = None
        if pad:
            def unlink(tpad, info):
                tpad.unlink(sink)
                self.tee.release_request_pad(tpad)
                return Gst.PadProbeReturn.REMOVE
            pad.add_probe(Gst.PadProbeType.IDLE, unlink)
        for name in ("parse", "aq"):
            self.rec.get_by_name(name).get_static_pad("sink").send_event(
                Gst.Event.new_eos())

    def stop_recording(self):
        """The file is closed when the end of stream reaches the file sink
        (on_rec_event), or given up on after 3 s."""
        if not self.recording or self.busy:
            return
        self.busy = True
        self.b_shutter.set_sensitive(False)
        self.say("Saving the video")
        self.close_branch()
        self.rec_timer = GLib.timeout_add_seconds(3, self.timed_out)

    def timed_out(self):
        self.rec_timer = None
        return self.recorded()

    def recorded(self):
        """The video is closed: the branch goes, the viewfinder runs on."""
        if not self.recording:
            return False
        path, _, timer = self.recording
        GLib.source_remove(timer)
        if self.rec_timer:
            GLib.source_remove(self.rec_timer)
            self.rec_timer = None
        self.recording = None
        self.b_shutter.get_style_context().remove_class("recording")
        if self.rec:
            if self.rec_pad:
                self.close_branch()
            self.rec.set_state(Gst.State.NULL)
            self.pipeline.remove(self.rec)
            self.rec = None
        self.led(self.flash == "torch")
        self.busy = False
        self.b_shutter.set_sensitive(True)
        if os.path.exists(path):
            print("video: saved %s (%s)" % (path, "closed" if self.rec_closed.is_set()
                                           else "not closed in 3 s"), flush=True)
            self.last_photo = path
            self.b_last.set_label("Last video")
            self.b_last.show()
            self.say("Saved", 2)
        return False

    def to_still(self):
        if self.raw_sink is not None:
            return self.take_raw()
        self.shooting = True
        self.resize(self.still(), self.current())
        held, front, portrait = self.held(), self.cam != 0, self.method()
        threading.Thread(target=self.capture, args=(held, front, portrait),
                         daemon=True).start()
        return False

    def still(self):
        if self.cam != 0:
            return STILL_FRONT
        return STILL_48 if self.out()["size"] == "full" else STILL

    def since(self):
        return "%.2f s" % (time.monotonic() - self.t0)

    def capture(self, held, front, portrait):
        """Frames at 12 MP, then the viewfinder back at once, and the photo
        turned and written meanwhile (author: saving should be snappier)."""
        sample, got = None, 0
        # The photo's frames as the crop leaves them (the shape, the zoom):
        # compared with the uncropped size, a 16:9 48 MP frame (7680x4320)
        # was never taken (2026-11-17).
        want = self.cropped
        # A 48 MP frame comes later: the first 4.6 s after the switch
        # headless (STILL_48), and once none within 15 s in the app.
        wait = 30 if self.still() == STILL_48 else 5
        deadline = time.monotonic() + wait
        while got < SETTLE_FRAMES + 1 and time.monotonic() < deadline:
            s = self.snap.try_pull_sample(wait * Gst.SECOND)
            if not s:
                break
            # The appsink may still hold a viewfinder frame.
            c = s.get_caps().get_structure(0)
            if (c.get_value("width"), c.get_value("height")) == want:
                sample, got = s, got + 1
            # Not held while waiting for the next: 48 MP has two buffers
            # (libcamera patch 0025), and libcamera stopped with one here.
            s = None
        if sample:
            caps = sample.get_caps().get_structure(0)
            print("capture: %d frames, last %dx%d" % (
                got, caps.get_value("width"), caps.get_value("height")),
                flush=True)
        else:
            print("capture: no frame at %dx%d" % self.still(), flush=True)
        pix, error = None, None
        if sample:
            try:
                pix = self.frame(sample)
            except Exception as e:      # shown, not fatal
                error = e
        print("capture: frame at %s" % self.since(), flush=True)
        GLib.idle_add(self.resume, pix is not None)
        path = None
        if pix:
            try:
                path = self.write(pix, held, front, portrait)
            except Exception as e:
                error = e
        GLib.idle_add(self.saved, path, error, sample is not None)

    def take_raw(self):
        """The photo from the newest raw frame; the viewfinder runs on.
        Night first sets its longer exposure (apply_controls)."""
        held, method = self.held(), self.method()
        want = None
        if self.night:
            cur = self.current()
            if cur:
                self.apply_controls(cur)
                want = min(cur[0] * 4, 500000)
        threading.Thread(target=self.raw_capture, args=(held, method, want),
                         daemon=True).start()
        return False

    def raw_capture(self, held, method, want):
        """The newest raw frame (with Night, the first one at its exposure,
        within 4 s), its metadata, a file; then the developer, while the
        shutter is free again."""
        sample, deadline = None, time.monotonic() + 4
        while time.monotonic() < deadline:
            sample = self.raw_sink.try_pull_sample(2 * Gst.SECOND)
            if not sample or not want:
                break
            exp = self.src.get_property("exposure-time")
            if exp and abs(exp - want) < want * 0.1:
                break
        if not sample:
            print("capture: no raw frame", flush=True)
            GLib.idle_add(self.raw_taken, None, None)
            return
        try:
            meta = self.raw_meta(sample)
        except ValueError as e:
            print("capture: %s" % e, flush=True)
            GLib.idle_add(self.raw_taken, None, None)
            return
        print("capture: raw frame at %s, %s" % (self.since(), meta["order"]), flush=True)
        raw = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"),
                           "pro1x-camera-%d.raw" % threading.get_ident())
        buf = sample.get_buffer()
        ok, mapping = buf.map(Gst.MapFlags.READ)
        try:
            with open(raw, "wb") as f:
                f.write(mapping.data)
            meta["stride"] = mapping.size // meta["height"]
        finally:
            buf.unmap(mapping)
        del sample, buf
        path = self.photo_path()
        GLib.idle_add(self.raw_taken, path, meta)
        error = None
        try:
            self.develop(raw, path, meta, held, method)
            print("capture: saved %s at %s" % (path, self.since()), flush=True)
        except (OSError, subprocess.SubprocessError, ValueError) as e:
            error, path = e, None
        finally:
            try:
                os.remove(raw)
            except OSError:
                pass
        GLib.idle_add(self.raw_saved, path, error)

    def raw_meta(self, sample):
        """What the developer needs: the frame's Bayer order and size, and
        the white balance, colour matrix, gamma and contrast libcamera gave
        it (the viewfinder's)."""
        c = sample.get_caps().get_structure(0)
        fmt = c.get_string("format") or ""
        if not re.fullmatch(r"[rgb]{4}10p", fmt):
            raise ValueError("raw format %s" % fmt)

        def array(name, default):
            try:
                ok, arr = Gst.util_get_object_array(self.src, name)
                vals = [float(arr.get_nth(i)) for i in range(arr.n_values)] if ok else []
            except (TypeError, ValueError):
                vals = []
            return vals if len(vals) == len(default) else default
        gains = array("colour-gains", [1.0, 1.0])
        ccm = array("colour-correction-matrix", [1, 0, 0, 0, 1, 0, 0, 0, 1])
        try:
            gamma = float(self.src.get_property("gamma")) or 2.2
            contrast = float(self.src.get_property("contrast"))
        except (TypeError, ValueError):
            gamma, contrast = 2.2, 1.0
        return {"order": fmt[:4].upper(), "width": c.get_value("width"),
                "height": c.get_value("height"), "gains": gains, "ccm": ccm,
                "gamma": 1 / gamma,
                # The software ISP's contrast exponent (ipa simple adjust).
                "contrast": math.tan(min(max(contrast * math.pi / 4, 0.0),
                                         math.pi / 2 - 0.00001))}

    def develop(self, raw, path, meta, held, method):
        """pro1x-develop: the photo's part of the frame (its shape, the
        zoom), turned as write() turns frames, in JPEG."""
        rw, rh = meta["width"], meta["height"]
        w, h = self.photo_region()
        w, h = int(w / self.zoom) // 2 * 2, int(h / self.zoom) // 2 * 2
        x, y = (rw - w) // 4 * 2, (rh - h) // 4 * 2
        r, b = meta["gains"]
        args = [DEVELOP, raw, path, rw, rh, meta["stride"], meta["order"],
                BLACK_LEVEL, r, 1.0, b] + meta["ccm"] + [
                meta["gamma"], meta["contrast"], x, y, w, h,
                self.turn(held, method), 2 if self.scale() < 1 else 1,
                jpeg_quality()]
        if self.cam == 0 and os.access(SHADING, os.R_OK):
            args.append(SHADING)
        subprocess.run([str(a) for a in args], check=True, timeout=60,
                       stdout=subprocess.DEVNULL)

    def photo_path(self):
        """IMG_date_time.jpg, or with _2, _3 when one is already there or
        being written (photos less than a second apart)."""
        os.makedirs(PHOTOS, exist_ok=True)
        base = os.path.join(PHOTOS, time.strftime("IMG_%Y%m%d_%H%M%S"))
        path, n = base + ".jpg", 1
        while path in self.reserved or os.path.exists(path):
            n += 1
            path = "%s_%d.jpg" % (base, n)
        self.reserved.add(path)
        return path

    def raw_taken(self, path, meta):
        """The frame is kept: the shutter is free, Night's exposure and the
        flash end."""
        if self.fired:
            self.led(False)
        if self.night:
            self.apply_controls()
        self.busy = False
        self.b_shutter.set_sensitive(True)
        if path:
            self.shutter_blink()
        self.say("Saving" if path else "No frame from the camera", 0 if path else 4)
        return False

    def raw_saved(self, path, error):
        if path:
            self.reserved.discard(path)
            self.last_photo = path
            self.b_last.set_label("Last photo")
            self.b_last.show()
            self.say("Saved", 2)
        elif error:
            print("capture: not saved: %s" % error, flush=True)
            self.say("Not saved: %s" % error, 4)
        return False

    def resume(self, taken):
        if self.fired:
            self.led(False)
        if taken:
            self.shutter_blink()
        self.shooting = False
        self.resize(self.view_size())
        self.say("Saving")
        return False

    def saved(self, path, error, had_frame):
        self.busy = False
        self.b_shutter.set_sensitive(True)
        if path:
            print("capture: saved at %s" % self.since(), flush=True)
            self.last_photo = path
            self.b_last.set_label("Last photo")
            self.b_last.show()
            self.say("Saved", 2)
        elif error:
            print("capture: not saved: %s" % error, flush=True)
            self.say("Not saved: %s" % error, 4)
        elif not had_frame:
            self.say("No frame from the camera", 4)
        return False

    def frame(self, sample):
        """The 12 MP frame as a pixbuf of its own (before the pipeline
        lets the buffer go)."""
        info = GstVideo.VideoInfo.new_from_caps(sample.get_caps())
        buf = sample.get_buffer()
        ok, mapping = buf.map(Gst.MapFlags.READ)
        if not ok:
            raise RuntimeError("cannot read the frame")
        try:
            # GLib.Bytes holds its own copy of the data.  libcamera's RGBA
            # (or RGBx) keeps its fourth byte; the JPEG drops it.
            alpha = info.stride[0] >= 4 * info.width
            pix = GdkPixbuf.Pixbuf.new_from_bytes(
                GLib.Bytes.new(mapping.data), GdkPixbuf.Colorspace.RGB,
                alpha, 8, info.width, info.height, info.stride[0])
        finally:
            buf.unmap(mapping)
        return pix

    def write(self, pix, held, front, method):
        """Turned as the viewfinder, without its mirror (a photo is not a
        mirror image), then as the phone was held; a JPEG.  (The
        2026-11-01 finding that photos needed the opposite turn came from a
        viewfinder that was itself upside down in portrait, unnoticed.)"""
        # Both turns in one: a 12 MP turn takes seconds (7.7 s to save with
        # two, 3.2 s with none; 2026-11-16).
        degrees = self.turn(held, method)
        if degrees:
            pix = pix.rotate_simple(GdkPixbuf.PixbufRotation(degrees))
        scale = self.scale()
        if scale != 1.0:
            pix = pix.scale_simple(int(pix.get_width() * scale),
                                   int(pix.get_height() * scale),
                                   GdkPixbuf.InterpType.BILINEAR)
        os.makedirs(PHOTOS, exist_ok=True)
        path = os.path.join(PHOTOS, time.strftime("IMG_%Y%m%d_%H%M%S.jpg"))
        pix.savev(path, "jpeg", ["quality"], [str(jpeg_quality())])
        print("capture: saved %s" % path, flush=True)
        return path

    @staticmethod
    def turn(held, method):
        """Degrees counterclockwise: as the viewfinder turns the frames,
        then as held, when the display stayed portrait (the keyboard
        closed).  right-up is the keyboard landscape here (sway-autorotate's
        naming, swapped from Phosh's).  right-up needs the counterclockwise
        turn: the clockwise one gave an upside down photo, held as one taken
        right in the keyboard landscape (author, 2026-11-16)."""
        degrees = {"counterclockwise": 90, "clockwise": 270, "rotate-180": 180,
                   "vertical-flip": 180}.get(method, 0)
        portrait = method in ("counterclockwise", "clockwise")
        turn = {"right-up": 90, "left-up": 270, "bottom-up": 180}.get(held)
        print("capture: held %s" % held, flush=True)
        if portrait and turn is not None:
            degrees += turn
        return degrees % 360

    def led(self, on):
        try:
            level = "0"
            if on:
                with open(os.path.join(FLASH_LED, "max_brightness")) as f:
                    level = f.read().strip()
            with open(os.path.join(FLASH_LED, "brightness"), "w") as f:
                f.write(level)
        except OSError as e:
            print("flash: %s" % e, flush=True)

    def on_last(self, *_):
        """The last photo in a tab next to the camera (author): the camera
        leaves fullscreen, its container turns tabbed, and the viewer opens
        as the next tab; when the viewer closes, fullscreen again."""
        if not self.last_photo:
            return
        # Over the lock screen no other app may open (pro1x-lock --app-unlock).
        if os.path.exists(self.locked_flag()):
            return
        me = '[app_id="^org.pro1x.Camera$"]'
        subprocess.run(["swaymsg", me + " fullscreen disable, layout tabbed"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        video = self.last_photo.endswith(".mkv")
        try:
            viewer = subprocess.Popen(["mpv" if video else "loupe",
                                       self.last_photo])
        except OSError:
            Gtk.show_uri_on_window(self.win, "file://" + self.last_photo,
                                   Gdk.CURRENT_TIME)
            return

        app = "mpv" if video else "org.gnome.Loupe"

        def viewers():
            tree = subprocess.run(["swaymsg", "-t", "get_tree", "-r"],
                                  capture_output=True, text=True).stdout
            return tree.count('"app_id": "%s"' % app)

        def back():
            # Fullscreen again once the viewer's window has come and gone.
            # Not when its process ends: Loupe hands the photo to another
            # instance and exits at once, and the camera came back over it
            # (author, 2026-11-17).  Loupe takes over 10 s to open here.
            for _ in range(60):
                if viewers() or viewer.poll() not in (None, 0):
                    break
                time.sleep(0.5)
            while viewers():
                time.sleep(0.5)
            subprocess.run(["swaymsg", me + " focus, fullscreen enable"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        threading.Thread(target=back, daemon=True).start()


if __name__ == "__main__":
    # The Wayland app_id GTK 3 gives: Sway's rules (fullscreen, portrait,
    # the camera button) match org.pro1x.Camera.
    GLib.set_prgname("org.pro1x.Camera")
    Camera().run(None)
