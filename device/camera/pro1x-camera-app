    def claim_accelerometer(self):
        """How the phone is held, for the photo's turn (author: a photo
        taken in landscape was saved as portrait).  iio-sensor-proxy keeps
        the accelerometer while the app runs; the claim ends with it."""
        try:
            self.accel = Gio.DBusProxy.new_for_bus_sync(
                Gio.BusType.SYSTEM, Gio.DBusProxyFlags.NONE, None,
                "net.hadess.SensorProxy", "/net/hadess/SensorProxy",
                "net.hadess.SensorProxy", None)
            self.accel.call_sync("ClaimAccelerometer", None,
                                 Gio.DBusCallFlags.NONE, 2000, None)
        except GLib.Error as e:
            print("accelerometer: %s" % e.message, flush=True)
            self.accel = None

    def held(self):
        """normal, left-up, right-up, bottom-up or undefined."""
        v = self.accel.get_cached_property("AccelerometerOrientation") \
            if self.accel else None
