    # ── the pipeline ───────────────────────────────────────────────────
    # ── output settings ────────────────────────────────────────────────
    @staticmethod
    def load_settings():
        try:
            with open(SETTINGS) as f:
                s = json.load(f)
            return s if isinstance(s, dict) else {}
        except (OSError, ValueError):
            return {}

    def save_settings(self):
        try:
            os.makedirs(os.path.dirname(SETTINGS), exist_ok=True)
            with open(SETTINGS + ".new", "w") as f:
                json.dump(self.settings, f, indent=1)
            os.replace(SETTINGS + ".new", SETTINGS)
        except OSError as e:
            print("settings: %s" % e, flush=True)

    def stored(self):
        """This camera's saved settings for the current mode."""
        mode = "video" if self.video else "photo"
        cam = self.settings.setdefault("rear" if self.cam == 0 else "front", {})
        return cam.setdefault(mode, dict(DEFAULTS[mode]))

    def out(self):
        """The saved settings, or defaults where they are not offered now
        (full without the 48 MP mode); the saved ones stay as they are."""
        mode = "video" if self.video else "photo"
        o = dict(self.stored())
        shapes, sizes = self.choices()
        if o.get("shape") not in shapes:
            o["shape"] = DEFAULTS[mode]["shape"]
        if o.get("size") not in sizes:
            o["size"] = DEFAULTS[mode]["size"] if DEFAULTS[mode]["size"] in sizes \
                else sizes[0]
        return o

    def choices(self):
        """The shapes and resolutions offered now."""
        if self.video:
            return VIDEO_SHAPES, list(VIDEO_SIZES)
        if self.cam != 0:
            return PHOTO_SHAPES, ["full", "half"]
        return PHOTO_SHAPES, (["full"] if self.wide else []) + ["binned", "half"]

    def scale(self):
        return 0.5 if self.out()["size"] == "half" else 1.0

    def view_size(self):
        o = self.out()
        if self.video:
            h = VIDEO_SIZES[o["size"]]
            return (int(h * RATIOS[o["shape"]]) // 16 * 16, h)
        return VIEWS[o["shape"]]

    def start(self, size=None):
        """The viewfinder (videos are a branch added to it later)."""
        name, dev = self.cams[self.cam]
        self.wide = self.cam == 0 and max_width(dev) >= STILL_48[0]
        self.show_outputs()
        size = size or self.view_size()
        self.src = dev.create_element("src")
        self.caps = Gst.ElementFactory.make("capsfilter")
        self.caps.set_property(
            "caps", Gst.Caps.from_string(
                "video/x-raw,width=%d,height=%d" % size))
        convert = Gst.ElementFactory.make("videoconvert")
        # The zoom, before the tee: what the view shows is what is kept.
        self.crop = Gst.ElementFactory.make("videocrop")
        self.flip = Gst.ElementFactory.make("videoflip")
        self.tee = tee = Gst.ElementFactory.make("tee")
        q1 = Gst.ElementFactory.make("queue")
        # Only the newest frame waits: the view never falls behind.
        q1.set_property("leaky", 2)
        q1.set_property("max-size-buffers", 1)
        sink = Gst.ElementFactory.make("gtksink")
        sink.set_property("sync", False)
        q2 = Gst.ElementFactory.make("queue")
        q2.set_property("leaky", 2)
        q2.set_property("max-size-buffers", 1)
        convert2 = Gst.ElementFactory.make("videoconvert")
        rgb = Gst.ElementFactory.make("capsfilter")
        rgb.set_property("caps", Gst.Caps.from_string("video/x-raw,format=RGB"))
        self.snap = Gst.ElementFactory.make("appsink")
        for k, v in (("drop", True), ("max-buffers", 1), ("sync", False),
                     ("emit-signals", False)):
            self.snap.set_property(k, v)

        self.pipeline = Gst.Pipeline.new("camera")
        for e in (self.src, self.caps, convert, self.crop, tee, q1,
                  self.flip, sink, q2, convert2, rgb, self.snap):
            self.pipeline.add(e)
        self.src.link(self.caps)
        self.caps.link(convert)
        convert.link(self.crop)
        self.crop.link(tee)
        tee.link(q1)
        q1.link(self.flip)
        self.flip.link(sink)
        tee.link(q2)
        q2.link(convert2)
        convert2.link(rgb)
        rgb.link(self.snap)
        bus = self.pipeline.get_bus()
        bus.add_signal_watch()
        bus.connect("message", self.on_message)

        widget = sink.get_property("widget")
        child = self.view.get_child()
        if child:
            self.view.remove(child)
        self.view.add(widget)
        widget.show()
        self.area = active_area(dev)
        self.size = size
        self.orient()
        self.apply_zoom()
        self.apply_controls()
        self.pipeline.set_state(Gst.State.PLAYING)
        self.say(name.split(" ")[0], 2)

    def recording_branch(self, path):
        """Frames at a steady size (the zoom changes the crop's), turned as
        the photos are, to the encoder; the microphone beside them.  The
        encoder is never asked to drain: the end of stream is sent after it
        (stop_recording).  A drain stuck with the viewfinder's other branches
        attached, and stopping the pipeline then froze the phone (2026-11-16,
        twice; stopping without a drain never did)."""
        turn = {"counterclockwise": "counterclockwise", "clockwise": "clockwise",
                "rotate-180": "rotate-180", "vertical-flip": "rotate-180"
                }.get(self.method(), "none")
        width, height = self.view_size()
        desc = (
            "queue max-size-buffers=4 leaky=downstream ! videoscale ! "
            "videorate drop-only=true max-rate=%d ! "
            "video/x-raw,width=%d,height=%d,framerate=%d/1 ! "
            "videoflip method=%s ! videoconvert ! video/x-raw,format=NV12 ! "
            'v4l2h264enc extra-controls="controls,video_gop_size=%d,'
            "h264_i_frame_period=%d,h264_minimum_qp_value=%d,"
            'h264_i_frame_minimum_qp_value=%d,h264_p_frame_minimum_qp_value=%d;" ! '
            "h264parse name=parse ! queue ! matroskamux name=mux ! "
            "filesink name=file "
            "pulsesrc name=mic ! queue ! audioconvert ! audioresample ! opusenc ! "
            "queue name=aq ! mux."
            % (VIDEO_RATE, width, height, VIDEO_RATE, turn, VIDEO_RATE,
               VIDEO_RATE, VIDEO_MIN_QP, VIDEO_MIN_QP, VIDEO_MIN_QP))
        branch = Gst.parse_bin_from_description(desc, True)
        branch.get_by_name("file").set_property("location", path)
        return branch

    def on_message(self, bus, msg):
        if msg.type == Gst.MessageType.ERROR:
            err, debug = msg.parse_error()
            print("pipeline: %s (%s)" % (err.message, debug), flush=True)
            if self.recording:
                self.say("Video stopped: %s" % err.message, 4)
                self.recorded()

    @staticmethod
    def locked_flag():
        """There while this is open over the lock screen (pro1x-lock
        --app-unlock)."""
        return os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "pro1x-locked-app")

    def quit_now(self):
        """Out at once, always: closing could hang (author, 2026-11-03, with no
        camera found), and over the lock screen a window left behind is a way
        in.  At most 1.5 s for the pipeline and LED, then the process ends.
        Over the lock screen, the lock comes first, and pro1x-open closes this
        behind it, so the session never shows (author, 2026-11-03)."""
        if os.path.exists(self.locked_flag()):
            subprocess.Popen(["swaymsg", "exec", "pro1x-lock"],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            threading.Timer(5, os._exit, (0,)).start()
            return
        threading.Timer(1.5, os._exit, (0,)).start()
        self.win.hide()
        if self.rec:
            # The video's end first, so its file is whole.
            self.close_branch()
            self.rec_closed.wait(1)
        self.stop()
        self.led(False)
        os._exit(0)

    def stop(self):
        if self.pipeline:
            self.pipeline.get_bus().remove_signal_watch()
            self.pipeline.set_state(Gst.State.NULL)
            self.pipeline = None

    def resize(self, size, carry=None):
        """The same camera at another sensor mode (a state cycle).  CARRY:
        (exposure time, analogue gain, lens position) to hold during it,
        else automatic again.  READY keeps the camera open; NULL closed
        it, and libcamera started over without the viewfinder's state."""
        self.pipeline.set_state(Gst.State.READY)
        self.caps.set_property(
            "caps", Gst.Caps.from_string(
                "video/x-raw,width=%d,height=%d" % size))
        self.size = size
        self.apply_zoom()
        self.apply_controls(carry)
        self.pipeline.set_state(Gst.State.PLAYING)

    def current(self):
        """The viewfinder's exposure time (µs) and gain, from the last
        frame's metadata (libcamerasrc reads them back: moWerk's patch
        0014), or None."""
        try:
            exp = self.src.get_property("exposure-time")
            gain = self.src.get_property("analogue-gain")
        except TypeError:
            return None
        print("viewfinder: exposure %s µs, gain %s" % (exp, gain), flush=True)
        return (exp, gain) if exp and exp > 0 else None

    def focus_controls(self):
        """Manual: the lens where the slider is.  Auto: one scan, then the
        focus is held until the next tap (AfModeAuto, moWerk's patch 0015).
        Manual mode used to hold it, but kept scanning: libcamera had no
        manual focus before patch 0020 (author: taps did not refocus, a
        video focused again at its start)."""
        if self.manual:
            self.src.set_property("af-mode", 0)
            self.src.set_property("lens-position", self.lens)
        else:
            self.src.set_property("af-mode", 1)

    def wb_controls(self):
        """The white balance automatic, or kept at the gains it found last
        (AwbEnable, libcamera patch 0022), photos included."""
        try:
            self.src.set_property("awb-enable", not self.wb_locked)
        except TypeError:
            pass

    def apply_controls(self, carry=None):
        # The same focus for the photo: libcamera keeps a found one over the
        # mode switch (moWerk's patch 0017).
        self.focus_controls()
        self.wb_controls()
        if carry:
            # The photo: exposure and gain as in the viewfinder.  At the mode
            # switch the automatic exposure started from its minimum, and
            # the photo was black (seen, 2026-11-01).
            exp, gain = carry
            if self.night:
                # Two stops more light for a dark scene: four times the
                # viewfinder's exposure (which stops at 66 ms), at most
                # 0.5 s, the gain unchanged.  Possible since libcamera
                # raises the blanking (patch 0018); hold the phone still.
                exp = min(exp * 4, 500000)
            self.src.set_property("exposure-time-mode", 1)      # manual
            self.src.set_property("exposure-time", int(exp))
            self.src.set_property("analogue-gain-mode", 1)
            self.src.set_property("analogue-gain",
                                  self.iso / 100.0 if self.iso else gain)
            return
        self.src.set_property("exposure-time-mode", 0)          # auto
        if self.iso:
            self.src.set_property("analogue-gain-mode", 1)       # manual
            self.src.set_property("analogue-gain", self.iso / 100.0)
        else:
            self.src.set_property("analogue-gain-mode", 0)       # auto
        self.src.set_property("exposure-value", EVS[self.ev])

    # ── orientation ────────────────────────────────────────────────────
    def on_size(self, win, rect):
        transform = display_transform()
        if transform != getattr(self, "transform", None):
            self.transform = transform
            self.portrait = transform in ("normal", "180")
            self.orient()

    def method(self):
        rear, front = VIEW_TURN.get(getattr(self, "transform", "normal"),
                                    VIEW_TURN["normal"])
        return front if self.cam != 0 else rear

    def orient(self):
        """The rear sensor's frames are landscape with the phone's top to
        their left (seen on the phone, 2026-11-01); the front one is
        mirrored."""
        if not self.pipeline:
            return
        self.flip.set_property("method", self.method())
        print("orient: display %s, %s camera, turn %s"
              % (getattr(self, "transform", "?"),
                 "front" if self.cam != 0 else "rear", self.method()),
              flush=True)

    # ── controls ───────────────────────────────────────────────────────
    def on_switch(self, *_):
        if self.busy or self.recording or len(self.cams) < 2:
            return
        self.stop()
        self.cam = (self.cam + 1) % len(self.cams)
        self.zoom = 1.0
        self.show_zoom()
        self.start()

    def on_flash(self, *_):
        self.flash = FLASH_MODES[(FLASH_MODES.index(self.flash) + 1)
                                 % len(FLASH_MODES)]
        self.b_flash.set_label("Flash %s" % self.flash)
        self.lit(self.b_flash, self.flash != "off")
        if not self.busy and not self.recording:
            self.led(self.flash == "torch")

    def on_timer(self, *_):
        self.timer = TIMERS[(TIMERS.index(self.timer) + 1) % len(TIMERS)]
        self.b_timer.set_label("Timer %s" % ("%d s" % self.timer
                                             if self.timer else "off"))
        self.lit(self.b_timer, bool(self.timer))

    def on_mode(self, *_):
        """Photos or videos: the shutter turns red for videos."""
        if self.busy or self.recording or self.countdown:
            return
        self.video = not self.video
        self.lit(self.b_mode, self.video)
        ctx = self.b_shutter.get_style_context()
        (ctx.add_class if self.video else ctx.remove_class)("video")
        # Night lengthens a photo's exposure; a video has none to lengthen.
        self.b_night.set_sensitive(not self.video)
        self.outputs_changed()

    # ── zoom ───────────────────────────────────────────────────────────
    def set_zoom(self, z):
        self.zoom = min(MAX_ZOOM, max(1.0, z))
        self.apply_zoom()
        self.show_zoom()

    def show_zoom(self):
        """The preset that is on, or the zoom in figures after a pinch."""
        for z, b in self.b_zooms:
            self.lit(b, abs(z - self.zoom) < 0.05)
        if not any(abs(z - self.zoom) < 0.05 for z in ZOOMS):
            self.say("%.1f×" % self.zoom, 2)

    def photo_region(self):
        """The photo's part of the still frame, before its size scale."""
        shape = self.out()["shape"]
        ratio = RATIOS[shape]
        w, h = self.still()
        if shape == "16:9" and self.cam == 0:
            w = w * VIEW_REGION_WIDTH
            h = w * 9 / 16
        return min(w, h * ratio), min(h, w / ratio)

    def region(self):
        """The part of the frame at the current size that the viewfinder's
        shape shows: in the viewfinder, the largest part in the shape; in a
        photo's frame, the same part of the scene."""
        if self.size != self.view_size():
            return self.photo_region()
        ratio = RATIOS[self.out()["shape"]]
        w, h = self.size
        return min(w, h * ratio), min(h, w / ratio)

    def apply_zoom(self):
        """The crop for the frames at the current size: the shape's region,
        a centred part 1/zoom of it wide and high, even sizes for the video
        formats."""
        if not self.pipeline:
            return
        w, h = self.size
        rw, rh = self.region()
        x = max(0, int((w - rw / self.zoom) / 4) * 2)
        y = max(0, int((h - rh / self.zoom) / 4) * 2)
        for side, v in (("left", x), ("right", x), ("top", y), ("bottom", y)):
            self.crop.set_property(side, v)

    def on_shape(self, *_):
        self.cycle("shape", 0)

    def on_res(self, *_):
        self.cycle("size", 1)

    def cycle(self, key, which):
        """The next shape or resolution for this camera and mode, saved."""
        if self.busy or self.recording:
            return
        options = self.choices()[which]
        now = self.out()[key]
        self.stored()[key] = options[(options.index(now) + 1) % len(options)]
        self.save_settings()
        self.outputs_changed()

    def outputs_changed(self):
        """Another sensor mode or stream size if the viewfinder's changed
        (a restart), else only the crop."""
        self.show_outputs()
        if not self.pipeline or self.busy:
            return
        if self.view_size() != self.size:
            self.resize(self.view_size())
        else:
            self.apply_zoom()

    def show_outputs(self):
        """4:3 and 12 MP, or 16:9 and 1080p: what will be saved."""
        o = self.out()
        self.b_shape.set_label(o["shape"])
        if self.video:
            self.b_res.set_label(o["size"])
            return
        pw, ph = (v * self.scale() for v in self.photo_region())
        mp = pw * ph / 1e6
        self.b_res.set_label(("%.0f MP" if mp >= 1.5 else "%.1f MP") % mp)

    def on_wb(self, *_):
        """Lock the colours as they are now (mixed light, a subject that
        fills the frame), or let them follow the scene again.  Presets
        would need calibrated gains (TODO.org)."""
        self.wb_locked = not self.wb_locked
        self.b_wb.set_label("WB lock" if self.wb_locked else "WB auto")
        self.lit(self.b_wb, self.wb_locked)
        if self.pipeline and not self.busy:
            self.wb_controls()

    def on_focus_mode(self, *_):
        """Autofocus, or the lens where the slider puts it."""
        if not self.manual:
            # From where the autofocus left the lens (patch 0020 reports it).
            try:
                lens = float(self.src.get_property("lens-position"))
            except (TypeError, ValueError, AttributeError):
                lens = self.lens
            self.lens = min(LENS_MAX, max(0.0, lens))
            self.lens_scale.set_value(self.lens)
        self.manual = not self.manual
        self.b_focus.set_label("MF" if self.manual else "AF")
        self.lit(self.b_focus, self.manual)
        self.lens_row.set_visible(self.manual)
        if self.pipeline and not self.busy:
            self.focus_controls()
        if self.manual:
            self.show_lens()

    def on_lens(self, scale):
        self.lens = scale.get_value()
        if self.manual and self.pipeline and not self.busy:
            self.src.set_property("lens-position", self.lens)
        self.show_lens()

    def show_lens(self):
        self.say("Focus %s" % ("∞" if self.lens < 0.05 else
                               "%.2f m" % (1 / self.lens)), 2)

    def on_win_touch(self, win, event):
        """Two fingers: the zoom follows their distance from where they
        started.  Touches are told apart by their sequence's address (the
        Python wrapper differs from event to event)."""
        seq = repr(event.get_event_sequence()).rsplit("0x", 1)[-1]
        ok, x, y = event.get_root_coords()
        t = event.type
        if t in (Gdk.EventType.TOUCH_BEGIN, Gdk.EventType.TOUCH_UPDATE):
            self.touches[seq] = (x, y)
        else:
            self.touches.pop(seq, None)
        if t == Gdk.EventType.TOUCH_BEGIN:
            print("pinch: touch down, %d fingers" % len(self.touches), flush=True)
        if len(self.touches) == 2:
            (x1, y1), (x2, y2) = self.touches.values()
            d = max(1.0, ((x1 - x2) ** 2 + (y1 - y2) ** 2) ** 0.5)
            if self.pinch_from is None:
                self.pinch_from = (self.zoom, d)
            else:
                z0, d0 = self.pinch_from
                z = min(MAX_ZOOM, max(1.0, z0 * d / d0))
                # Each change renegotiates the crop: not for every pixel.
                if abs(z - self.zoom) > 0.03:
                    self.set_zoom(z)
        elif self.pinch_from is not None:
            print("pinch: zoom %.2f" % self.zoom, flush=True)
            self.pinch_from = None
            self.pinched = time.monotonic()
        return False

    def on_iso(self, *_):
        self.iso = ISOS[(ISOS.index(self.iso) + 1) % len(ISOS)]
        self.b_iso.set_label("ISO %s" % (self.iso or "auto"))
        if not self.busy:
            self.apply_controls()

    def on_night(self, *_):
        self.night = not self.night
        self.lit(self.b_night, self.night)

    def lit(self, button, on):
        """A toggle that is on stands out (author: Night on and off looked
        the same)."""
        ctx = button.get_style_context()
        (ctx.add_class if on else ctx.remove_class)("on")

    def on_ev(self, *_):
        self.ev = (self.ev + 1) % len(EVS)
        v = EVS[self.ev]
        self.b_ev.set_label("EV %+.1f" % v if v else "EV 0")
        if not self.busy:
            self.apply_controls()

    def on_win_press(self, win, event):
        """A press on the window: a tap on the view, in its coordinates."""
        got = win.translate_coordinates(self.view, int(event.x), int(event.y))
        if not got:
            return False
        x, y = got
        alloc = self.view.get_allocation()
        if not (0 <= x < alloc.width and 0 <= y < alloc.height):
            return False

        class Tap:
            pass
        tap = Tap()
        tap.x, tap.y, tap.type = x, y, event.type
        return self.on_tap(self.view, tap)

    def on_touch(self, widget, event):
        print("tap: touch %s at %.0f %.0f" % (event.type, event.x, event.y),
              flush=True)
        if event.type == Gdk.EventType.TOUCH_BEGIN:
            return self.on_tap(widget, event)
        return False

    def on_tap(self, widget, event):
        """Focus where tapped: the point in the viewfinder, in frame
        coordinates (undoing the rotation), then in pixel array
        coordinates, as moWerk's camerabin patch maps it."""
        print("tap: %s at %.0f %.0f, busy %s" % (event.type, event.x, event.y,
                                                 self.busy), flush=True)
        if self.busy:
            return False
        # The picture inside the view, with bars around it in other shapes.
        alloc = widget.get_allocation()
        rw, rh = self.region()
        aspect = rw / rh
        if self.method() in ("clockwise", "counterclockwise"):
            aspect = 1 / aspect
        dw, dh = alloc.width, alloc.height
        if dw / dh > aspect:
            dw = dh * aspect
        else:
            dh = dw / aspect
        x = (event.x - (alloc.width - dw) / 2) / dw
        y = (event.y - (alloc.height - dh) / 2) / dh
        if not (0 <= x <= 1 and 0 <= y <= 1):
            return False
        # A first finger may be the start of a pinch: focus only if no
        # second one came within 250 ms.
        GLib.timeout_add(250, self.focus_at, event.x, event.y, x, y)
        return True

    def focus_at(self, px, py, x, y):
        """Focus and expose for (x, y), a fraction of the picture, drawn at
        (PX, PY); in manual focus, exposure only."""
        if self.busy or self.pinch_from is not None \
           or time.monotonic() - self.pinched < 0.4:
            return False
        # The square first: a tap did nothing visible while the active
        # area was unknown (author, 2026-11-02: no focus indicator).
        self.mark = (px, py, (1.0, 0.8, 0.0))
        self.marker.queue_draw()
        x, y = TAP_BACK[self.method()](x, y)
        # The picture is the centre of the frame: the shape's region, 1/zoom
        # of it.
        rw, rh = self.region()
        sw, sh = self.size
        x = 0.5 + (x - 0.5) * rw / self.zoom / sw
        y = 0.5 + (y - 0.5) * rh / self.zoom / sh
        # libcamerasrc may not publish the active area: the still size, a
        # little short of the IMX582's 4000x3000 array, does for a window.
        ax, ay, aw, ah = self.area or (0, 0) + self.still()
        print("focus: area %s, tap %.2f %.2f" % (self.area, x, y), flush=True)
        vw, vh = self.size
        fw = max(vw, vh * aw / ah)
        fh = fw * ah / aw
        scale = aw / fw
        half = 0.08 / self.zoom        # a window 16 % of the view wide
        wx = ax + ((fw - vw) / 2 + max(0.0, x - half) * vw) * scale
        wy = ay + ((fh - vh) / 2 + max(0.0, y - half) * vh) * scale
        ww = 2 * half * vw * scale + (8 if self.toggle else 0)
        wh = 2 * half * vh * scale
        self.toggle = not self.toggle  # the same spot again restarts it
        # A new window restarts the scan (moWerk's patch 0013), and the
        # exposure is measured there (patch 0021).
        Gst.util_set_object_arg(
            self.src, "af-windows",
            "<<%d, %d, %d, %d>>" % (wx, wy, ww, wh))
        self.src.set_property("ae-metering-mode", 1)            # spot
        if self.manual:
            GLib.timeout_add(800, self.clear_mark)
            return False
        self.af_polls = 0
        GLib.timeout_add(150, self.poll_focus)
        return False

    def poll_focus(self):
        """The marker's colour after libcamera's AfState (0 idle,
        1 scanning, 2 focused, 3 failed; moWerk's patch exposes it)."""
        if not self.mark or not self.pipeline:
            return False
        try:
            state = int(self.src.get_property("af-state"))
        except (TypeError, ValueError):
            state = 0
        self.af_polls += 1
        x, y, _ = self.mark
        colour = {2: (0.3, 0.9, 0.3), 3: (0.95, 0.3, 0.3)}.get(state, (1.0, 0.8, 0.0))
        self.mark = (x, y, colour)
        self.marker.queue_draw()
        if state in (2, 3) or self.af_polls > 30:
            GLib.timeout_add(1200, self.clear_mark)
            return False
        return True

    def clear_mark(self):
        self.mark = None
        self.marker.queue_draw()
        return False

    def on_draw_marker(self, area, cr):
        if not self.mark:
            return False
        x, y, (r, g, b) = self.mark
        side = min(area.get_allocated_width(), area.get_allocated_height()) * 0.16
        cr.set_source_rgb(r, g, b)
        cr.set_line_width(3)
        cr.rectangle(x - side / 2, y - side / 2, side, side)
        cr.stroke()
        return False

    # ── photos ─────────────────────────────────────────────────────────
    def on_signal(self):
        self.on_shutter()
        return True

    def on_shutter(self, *_):
        """A photo, or a video started or stopped; after the timer, if set.
        The shutter during the countdown cancels it."""
        if self.countdown:
            GLib.source_remove(self.countdown[1])
            self.countdown = None
            self.say("")
            return
        if self.recording:
            self.stop_recording()
            return
        if self.busy or not self.pipeline:
            return
        if self.timer:
            self.countdown = (self.timer, GLib.timeout_add_seconds(1, self.tick))
            self.say("%d" % self.timer)
            return
        self.shoot()

    def tick(self):
        left = self.countdown[0] - 1
        if left > 0:
            self.countdown = (left, self.countdown[1])
            self.say("%d" % left)
            return True
        self.countdown = None
        self.say("")
        self.shoot()
        return False

    def shoot(self):
        if self.video:
            self.start_recording()
            return
        self.busy = True
        self.b_shutter.set_sensitive(False)
        self.say("Taking a photo")
        self.t0 = time.monotonic()
        self.fired = self.flash == "on" or (self.flash == "auto" and self.dark())
        if self.fired:
            # A pre-flash, without blocking the window: the exposure then
            # settles on the lit scene before it is carried over.
            self.led(True)
            GLib.timeout_add(600, self.to_still)
        else:
            self.to_still()

    def dark(self):
        """For the automatic flash: the viewfinder's exposure is near its
        longest and its gain high."""
        cur = self.current()
        return bool(cur) and cur[0] >= AUTO_FLASH_EXPOSURE \
            and cur[1] >= AUTO_FLASH_GAIN

    # ── videos ─────────────────────────────────────────────────────────
    def start_recording(self):
        """A recording branch on the running viewfinder's tee, its
        timestamps from 0; the LED on for Flash on or torch."""
        os.makedirs(VIDEOS, exist_ok=True)
        path = os.path.join(VIDEOS, time.strftime("VID_%Y%m%d_%H%M%S.mkv"))
        self.rec = self.recording_branch(path)
        self.rec_closed.clear()
        # The file is whole once the end of stream reaches the file sink.
        self.rec.get_by_name("file").get_static_pad("sink").add_probe(
            Gst.PadProbeType.EVENT_DOWNSTREAM, self.on_rec_event)
        self.pipeline.add(self.rec)
        clock = self.pipeline.get_clock()
        now = clock.get_time() - self.pipeline.get_base_time() if clock else 0
        sink = self.rec.get_static_pad("sink")
        sink.set_offset(-now)
        self.rec.get_by_name("mic").get_static_pad("src").set_offset(-now)
        self.rec_pad = self.tee.request_pad_simple("src_%u")
        self.rec_pad.link(sink)
        self.rec.sync_state_with_parent()
        self.led(self.flash in ("on", "torch"))
        self.recording = (path, time.monotonic(),
                          GLib.timeout_add(500, self.show_recording))
        self.b_shutter.get_style_context().add_class("recording")
        self.show_recording()
        print("video: recording %s" % path, flush=True)

    def on_rec_event(self, pad, info):
        if info.get_event().type == Gst.EventType.EOS:
            self.rec_closed.set()
            GLib.idle_add(self.recorded)
        return Gst.PadProbeReturn.OK

    def show_recording(self):
        if not self.recording:
            return False
        secs = int(time.monotonic() - self.recording[1])
        self.say("● %d:%02d" % (secs // 60, secs % 60))
        return True

    def close_branch(self):
        """The branch off the tee, then the end of stream after the encoder
        and after the microphone's encoder: the frames still in the video
        encoder are lost, but it never drains (recording_branch)."""
        pad, sink = self.rec_pad, self.rec.get_static_pad("sink")
        self.rec_pad = None
        if pad:
            def unlink(tpad, info):
                tpad.unlink(sink)
                self.tee.release_request_pad(tpad)
                return Gst.PadProbeReturn.REMOVE
            pad.add_probe(Gst.PadProbeType.IDLE, unlink)
        for name in ("parse", "aq"):
            self.rec.get_by_name(name).get_static_pad("sink").send_event(
                Gst.Event.new_eos())

    def stop_recording(self):
        """The file is closed when the end of stream reaches the file sink
        (on_rec_event), or given up on after 3 s."""
        if not self.recording or self.busy:
            return
        self.busy = True
        self.b_shutter.set_sensitive(False)
        self.say("Saving the video")
        self.close_branch()
        self.rec_timer = GLib.timeout_add_seconds(3, self.timed_out)

    def timed_out(self):
        self.rec_timer = None
        return self.recorded()

    def recorded(self):
        """The video is closed: the branch goes, the viewfinder runs on."""
        if not self.recording:
            return False
        path, _, timer = self.recording
        GLib.source_remove(timer)
        if self.rec_timer:
            GLib.source_remove(self.rec_timer)
            self.rec_timer = None
        self.recording = None
        self.b_shutter.get_style_context().remove_class("recording")
        if self.rec:
            if self.rec_pad:
                self.close_branch()
            self.rec.set_state(Gst.State.NULL)
            self.pipeline.remove(self.rec)
            self.rec = None
        self.led(self.flash == "torch")
        self.busy = False
        self.b_shutter.set_sensitive(True)
        if os.path.exists(path):
            print("video: saved %s (%s)" % (path, "closed" if self.rec_closed.is_set()
                                           else "not closed in 3 s"), flush=True)
            self.last_photo = path
            self.b_last.set_label("Last video")
            self.b_last.show()
            self.say("Saved", 2)
        return False

    def to_still(self):
        self.resize(self.still(), self.current())
        held, front, portrait = self.held(), self.cam != 0, self.method()
        threading.Thread(target=self.capture, args=(held, front, portrait),
                         daemon=True).start()
        return False

    def still(self):
        if self.cam != 0:
            return STILL_FRONT
        return STILL_48 if self.out()["size"] == "full" else STILL

    def since(self):
        return "%.2f s" % (time.monotonic() - self.t0)

    def capture(self, held, front, portrait):
        """Frames at 12 MP, then the viewfinder back at once, and the photo
        turned and written meanwhile (author: saving should be snappier)."""
        sample, got = None, 0
        want = self.still()
        # A 48 MP frame comes later: the first 9 s after the switch
        # headless, and in a dark room none within 15 s in the app.
        wait = 30 if want == STILL_48 else 5
        deadline = time.monotonic() + wait
        while got < SETTLE_FRAMES + 1 and time.monotonic() < deadline:
            s = self.snap.try_pull_sample(wait * Gst.SECOND)
            if not s:
                break
            # The appsink may still hold a viewfinder frame.
            c = s.get_caps().get_structure(0)
            if (c.get_value("width"), c.get_value("height")) == want:
                sample, got = s, got + 1
        if sample:
            caps = sample.get_caps().get_structure(0)
            print("capture: %d frames, last %dx%d" % (
                got, caps.get_value("width"), caps.get_value("height")),
                flush=True)
        else:
            print("capture: no frame at %dx%d" % self.still(), flush=True)
        pix, error = None, None
        if sample:
            try:
                pix = self.frame(sample)
            except Exception as e:      # shown, not fatal
                error = e
        print("capture: frame at %s" % self.since(), flush=True)
        GLib.idle_add(self.resume)
        path = None
        if pix:
            try:
                path = self.write(pix, held, front, portrait)
            except Exception as e:
                error = e
        GLib.idle_add(self.saved, path, error, sample is not None)

    def resume(self):
        if self.fired:
            self.led(False)
        self.resize(self.view_size())
        self.say("Saving")
        return False

    def saved(self, path, error, had_frame):
        self.busy = False
        self.b_shutter.set_sensitive(True)
        if path:
            print("capture: saved at %s" % self.since(), flush=True)
            self.last_photo = path
            self.b_last.set_label("Last photo")
            self.b_last.show()
            self.say("Saved", 2)
        elif error:
            print("capture: not saved: %s" % error, flush=True)
            self.say("Not saved: %s" % error, 4)
        elif not had_frame:
            self.say("No frame from the camera", 4)
        return False

    def frame(self, sample):
        """The 12 MP frame as a pixbuf of its own (before the pipeline
        lets the buffer go)."""
        info = GstVideo.VideoInfo.new_from_caps(sample.get_caps())
        buf = sample.get_buffer()
        ok, mapping = buf.map(Gst.MapFlags.READ)
        if not ok:
            raise RuntimeError("cannot read the frame")
        try:
            # GLib.Bytes holds its own copy of the data.
            pix = GdkPixbuf.Pixbuf.new_from_bytes(
                GLib.Bytes.new(mapping.data), GdkPixbuf.Colorspace.RGB,
                False, 8, info.width, info.height, info.stride[0])
        finally:
            buf.unmap(mapping)
        return pix

    def write(self, pix, held, front, method):
        """Turned as the viewfinder, without its mirror (a photo is not a
        mirror image), then as the phone was held; a JPEG.  (The
        2026-11-01 finding that photos needed the opposite turn came from a
        viewfinder that was itself upside down in portrait, unnoticed.)"""
        # Degrees counterclockwise, both turns in one: a 12 MP turn takes
        # seconds (7.7 s to save with two, 3.2 s with none; 2026-11-16).
        degrees = {"counterclockwise": 90, "clockwise": 270, "rotate-180": 180,
                   "vertical-flip": 180}.get(method, 0)
        portrait = method in ("counterclockwise", "clockwise")
        # Then as held, when the display stayed portrait (the keyboard
        # closed).  right-up is the keyboard landscape here (sway-autorotate's
        # naming, swapped from Phosh's).  right-up needs the counterclockwise
        # turn: the clockwise one gave an upside down photo, held as one
        # taken right in the keyboard landscape (author, 2026-11-16).
        turn = {"right-up": 90, "left-up": 270, "bottom-up": 180}.get(held)
        print("capture: held %s" % held, flush=True)
        if portrait and turn is not None:
            degrees += turn
        if degrees % 360:
            pix = pix.rotate_simple(GdkPixbuf.PixbufRotation(degrees % 360))
        scale = self.scale()
        if scale != 1.0:
            pix = pix.scale_simple(int(pix.get_width() * scale),
                                   int(pix.get_height() * scale),
                                   GdkPixbuf.InterpType.BILINEAR)
        os.makedirs(PHOTOS, exist_ok=True)
        path = os.path.join(PHOTOS, time.strftime("IMG_%Y%m%d_%H%M%S.jpg"))
        pix.savev(path, "jpeg", ["quality"], [str(jpeg_quality())])
        print("capture: saved %s" % path, flush=True)
        return path

    def led(self, on):
        try:
            level = "0"
            if on:
                with open(os.path.join(FLASH_LED, "max_brightness")) as f:
                    level = f.read().strip()
            with open(os.path.join(FLASH_LED, "brightness"), "w") as f:
                f.write(level)
        except OSError as e:
            print("flash: %s" % e, flush=True)

    def on_last(self, *_):
        """The last photo in a tab next to the camera (author): the camera
        leaves fullscreen, its container turns tabbed, and the viewer opens
        as the next tab; when the viewer closes, fullscreen again."""
        if not self.last_photo:
            return
        # Over the lock screen no other app may open (pro1x-lock --app-unlock).
        if os.path.exists(self.locked_flag()):
            return
        me = '[app_id="^org.pro1x.Camera$"]'
        subprocess.run(["swaymsg", me + " fullscreen disable, layout tabbed"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        video = self.last_photo.endswith(".mkv")
        try:
            viewer = subprocess.Popen(["mpv" if video else "loupe",
                                       self.last_photo])
        except OSError:
            Gtk.show_uri_on_window(self.win, "file://" + self.last_photo,
                                   Gdk.CURRENT_TIME)
            return

        def back():
            viewer.wait()
            subprocess.run(["swaymsg", me + " focus, fullscreen enable"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        threading.Thread(target=back, daemon=True).start()


if __name__ == "__main__":
    # The Wayland app_id GTK 3 gives: Sway's rules (fullscreen, portrait,
    # the camera button) match org.pro1x.Camera.
    GLib.set_prgname("org.pro1x.Camera")
    Camera().run(None)
