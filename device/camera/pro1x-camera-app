def cameras():
    """[(display name, GstDevice)] from libcamera's own device provider
    (not PipeWire's, which lists them too), rear (IMX582) first."""
    factory = Gst.DeviceProviderFactory.find("libcameraprovider")
    provider = factory.get() if factory else None
    found = [(d.get_display_name(), d)
             for d in (provider.get_devices() if provider else [])]

    def rear_first(item):
        name, dev = item
        props = dev.get_properties()
        if props:
            print("camera %s: %s" % (name, props.to_string()), flush=True)
            ok, location = props.get_int("api.libcamera.Location")
            if ok:
                return 0 if location == 1 else 1     # 1: back
        # The IMX582 (rear) is at address 0x10, the S5K4H7 at 0x2d.
        return 0 if name.endswith("@10") else 1
    found.sort(key=rear_first)
    return found


def display_transform():
    """The panel's transform in Sway: normal, 90, 180 or 270."""
    try:
        out = subprocess.run(["swaymsg", "-t", "get_outputs", "-r"],
                             capture_output=True, text=True, timeout=2).stdout
        import json
        for o in json.loads(out):
            if o.get("name") == "DSI-1":
                return o.get("transform", "normal")
    except (OSError, ValueError, subprocess.SubprocessError):
        pass
    return "normal"


def max_width(dev):
    """The widest frame the camera offers: its caps' widths, single or a
    range, read from their text (without gst-python, GstIntRange cannot be
    read as a value)."""
    caps = dev.get_caps()
    text = caps.to_string() if caps else ""
    widths = [int(w) for w in re.findall(r"width=\(int\)(\d+)", text)]
    widths += [int(hi) for hi in
               re.findall(r"width=\(int\)\[ *\d+, *(\d+)", text)]
    return max(widths, default=0)


def active_area(dev):
    """The pixel array active area (x, y, w, h), or None."""
    props = dev.get_properties()
    if not props:
        return None
    ok, value = False, None
    try:
        value = props.get_value("api.libcamera.PixelArrayActiveAreas")
        ok = value is not None and len(value) >= 4
    except TypeError:
        ok = False
    return tuple(int(v) for v in value[:4]) if ok else None


