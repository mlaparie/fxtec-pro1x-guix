def jpeg_quality():
    """config.scm's jpeg-quality (/etc/pro1x/camera.conf), else 98."""
    try:
        with open("/etc/pro1x/camera.conf") as f:
            for line in f:
                if line.startswith("JPEG_QUALITY="):
                    return max(1, min(100, int(line.split("=", 1)[1])))
    except (OSError, ValueError):
        pass
    return 98


