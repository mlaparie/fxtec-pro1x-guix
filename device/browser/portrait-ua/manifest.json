{
  "manifest_version": 2,
  "name": "Pro1X portrait user agent",
  "version": "0.1",
  "description": "A mobile user agent while the window is in portrait; the browser's own in landscape.",
  "browser_specific_settings": { "gecko": { "id": "pro1x-portrait-ua@fxtec" } },
  "permissions": ["webRequest", "webRequestBlocking", "<all_urls>"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true }]
}
