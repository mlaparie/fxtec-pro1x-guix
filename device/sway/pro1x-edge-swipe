#!/usr/bin/env python3
# pro1x-edge-swipe — the swipe up from the bottom edge, followed as it goes
#
#   pro1x-edge-swipe O     O: the panel's orientation, as lisgd's -o
#
# A finger down within 100 px of the bottom edge (as the screen is turned)
# and gone 120 px in: a buzz, at once.  Lifted after it: the on-screen
# keyboard shown or hidden.  Back within 70 px of the edge after it (or
# lifted within 90 px, sliding off the panel): the focused window closed,
# as Super+BackSpace, with a second buzz.  Held still, nothing until it is
# lifted (author, 2026-11-24).  Lifted before the buzz, a second finger, or
# held over 10 s: nothing.
#
# It replaces lisgd's bottom swipe and the evtest watcher pro1x-gestures
# started for each one, whose buzz came late: an evtest and an fbcli were
# started for every swipe (author, 2026-11-24).  This one stays running,
# reads the touchscreen without taking it, and drives the motor itself
# (the aw86224's force feedback, as feedbackd does).  pro1x-gestures starts
# it beside lisgd and again when the screen turns.  Decisions go to
# $XDG_RUNTIME_DIR/pro1x-gesture-bottom.log, for tuning.
#
# State: written 2026-11-24, not yet run.

import os
import subprocess
import sys
import time

from evdev import InputDevice, ecodes, ff, list_devices

TOUCH = "/dev/input/by-path/platform-i2c-touchscreen-event"
W, H = 1080, 2160               # the panel, portrait, as the touchscreen
BAND, BUZZ, BACK, LIFT_BACK, TIME = 100, 120, 70, 90, 10
LOG = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"),
                   "pro1x-gesture-bottom.log")

o = int(sys.argv[1]) if len(sys.argv) > 1 else 0


def dist(x, y):
    """From the bottom edge as the screen is turned (lisgd's -o)."""
    return {0: H - y, 1: x, 2: y, 3: W - x}[o]


def motor():
    for path in list_devices():
        dev = InputDevice(path)
        if dev.name == "aw86224-haptics":
            return dev
    return None


hap = motor()
effects = {}


def buzz(ms):
    if hap is None:
        return
    try:
        if ms not in effects:
            effects[ms] = hap.upload_effect(ff.Effect(
                ecodes.FF_RUMBLE, -1, 0, ff.Trigger(0, 0), ff.Replay(ms, 0),
                ff.EffectType(ff_rumble_effect=ff.Rumble(
                    strong_magnitude=0xffff, weak_magnitude=0xffff))))
        hap.write(ecodes.EV_FF, effects[ms], 1)
    except OSError:
        pass


def log(what):
    try:
        with open(LOG, "a") as f:
            f.write(f"{time.strftime('%T')} o={o} {what}\n")
    except OSError:
        pass


def run(*cmd):
    subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL)


touch = InputDevice(TOUCH)
slot, active = 0, set()         # the current slot, the slots with a finger
pos = {}                        # slot: [x, y]
swipe = None                    # the followed finger: slot, start, buzzed, max
new = set()                     # slots that came down since the last report

for ev in touch.read_loop():
    if ev.type == ecodes.EV_ABS:
        if ev.code == ecodes.ABS_MT_SLOT:
            slot = ev.value
        elif ev.code == ecodes.ABS_MT_TRACKING_ID:
            if ev.value >= 0:
                active.add(slot)
                new.add(slot)
                pos.setdefault(slot, [0, 0])
            else:
                active.discard(slot)
                if swipe and swipe["slot"] == slot:
                    d = dist(*pos[slot])
                    if not swipe["buzzed"]:
                        log(f"no: lifted at {swipe['max']} px")
                    elif d <= LIFT_BACK:
                        run("swaymsg", "kill"); buzz(60); log("close")
                    else:
                        run("pro1x-osk", "toggle"); log("keyboard")
                    swipe = None
        elif ev.code == ecodes.ABS_MT_POSITION_X:
            pos.setdefault(slot, [0, 0])[0] = ev.value
        elif ev.code == ecodes.ABS_MT_POSITION_Y:
            pos.setdefault(slot, [0, 0])[1] = ev.value
    elif ev.type == ecodes.EV_SYN and ev.code == ecodes.SYN_REPORT:
        # A finger down alone in the bottom band starts a swipe; a second
        # finger ends it (the two-finger close and the Super gesture).
        for s in new:
            if swipe is None and active == {s} and dist(*pos[s]) <= BAND:
                swipe = {"slot": s, "start": time.monotonic(),
                         "buzzed": False, "max": 0}
            elif swipe and s != swipe["slot"]:
                log("no: a second finger"); swipe = None
        new.clear()
        if swipe is None:
            continue
        if time.monotonic() - swipe["start"] > TIME:
            log(f"no: held past {TIME} s"); swipe = None
            continue
        d = dist(*pos[swipe["slot"]])
        swipe["max"] = max(swipe["max"], d)
        if not swipe["buzzed"] and d >= BUZZ:
            swipe["buzzed"] = True
            buzz(35)
        elif swipe["buzzed"] and d <= BACK:
            run("swaymsg", "kill"); buzz(60); log("close")
            swipe = None
