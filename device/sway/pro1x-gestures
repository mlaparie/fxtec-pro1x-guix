#!/bin/sh
# pro1x-gestures — touchscreen edge swipes in Sway (lisgd)
#
#   swipe down from the top edge      quick actions (sway-quick-actions)
#   swipe up from the bottom edge     a buzz at 120 px; lifted then: on-screen
#                                     keyboard, shown or hidden (pro1x-edge-swipe)
#   ... and back to the bottom edge   close the focused window (as s-BackSpace)
#     after the buzz, without lifting  with a second buzz
#   two fingers down out the bottom edge   close the focused window too
#   both edges swiped in at once      Super held for the next key (pro1x-super)
#   swipe in from the right edge      app launcher (sway-launcher-desktop)
#   swipe in from the left edge       window switcher (sway-window-switcher)
#   (Sway Overview moved to the window switcher, author 2026-11-02)
#
# The same swipe again closes what it opened (pro1x-gestures toggle APP-ID
# COMMAND...; quick actions closes itself).  Every command runs in the
# background: lisgd waits for a command to end before taking the next
# gesture, so a second swipe used to wait for the first window to close
# and then open another (author, 2026-10-30).
#
# Sway has gestures for touchpads only; lisgd reads the touchscreen through
# libinput and runs a command per gesture, as Sxmo does.  lisgd knows
# nothing of Sway's rotation, so this runs it with -o set from the panel's
# transform and restarts it whenever the transform changes (Sway output
# events).  Started by the Sway config; ends with Sway, whose event
# subscription it follows.
#
# State: the three swipes work in Sway, landscape (-o 1; author,
# 2026-10-30); the other orientations and the toggles are untested.

# menu ID: a menu swipe, acted on while the finger is still down (author,
# 2026-11-02): a buzz and the menu at once.  A held swipe can fire again
# as the finger goes on, which would close the menu again: once per 0.8 s
# per menu.  fbcli ends the feedback when its input ends (it waits for
# Return), so it reads from a sleep, not /dev/null.
if [ "${1:-}" = menu ]; then
    stamp="${XDG_RUNTIME_DIR:-/tmp}/pro1x-gesture-$2"
    now=$(date +%s%N)
    [ $(( now - $(cat "$stamp" 2>/dev/null || echo 0) )) -lt 800000000 ] && exit 0
    # Part of a two-finger gesture (Super, both edges): not a menu.
    super="${XDG_RUNTIME_DIR:-/tmp}/pro1x-super-started"
    [ $(( now - $(cat "$super" 2>/dev/null || echo 0) )) -lt 1500000000 ] && exit 0
    echo "$now" > "$stamp"
    { sleep 1 | fbcli -E button-pressed; } >/dev/null 2>&1 &
    exec pro1x-menu toggle "$2"
fi

# toggle APP-ID COMMAND...: close that window if it is open, else run.
if [ "${1:-}" = toggle ]; then
    app=$2; shift 2
    if swaymsg -t get_tree 2>/dev/null | grep -q "\"app_id\": \"$app\""; then
        swaymsg "[app_id=\"^$app\$\"] kill" >/dev/null
    else
        exec "$@"
    fi
    exit
fi

dev=/dev/input/by-path/platform-i2c-touchscreen-event
output=DSI-1
events="${XDG_RUNTIME_DIR:-/tmp}/pro1x-gestures.events"
launcher='pro1x-term --app-id=launcher -e env TERMINAL_COMMAND="foot -e" PREVIEW_WINDOW=up:5:noborder sway-launcher-desktop'

transform() {
    swaymsg -t get_outputs -r 2>/dev/null |
        jq -r --arg o "$output" '.[] | select(.name == $o) | .transform'
}

lisgd_pid= edge_pid=
start() {                       # start <transform>
    case "$1" in
        90) o=1 ;; 180) o=2 ;; 270) o=3 ;; *) o=0 ;;
    esac
    # The panel is 1080x2160 (portrait); edges are measured in it.
    # More permissive than lisgd's defaults (author, 2026-11-02:
    # the two-finger swipe was hard to make; there every finger must go
    # the same way, the last one lifted must touch the edge band, all
    # within the timeout): 100 px edge bands (-s 2), 30 degrees off
    # straight (-r 30), 1.2 s (-m 1200).
    # Every swipe acts once the finger has gone 80 px (pressed, P), not
    # on release: the menus with a buzz (menu, above; author, 2026-11-02).
    # Two fingers down out the bottom edge close the focused window, on
    # release (author, 2026-11-22): lisgd's edge is where the swipe starts
    # or ends, so ending in the bottom band is enough.
    # Both edges in at once: two fingers down, each moving in from its own
    # edge, so lisgd matches each as a two-finger swipe; pro1x-super starts
    # once for both (author, 2026-11-22).
    lisgd -d "$dev" -w 1080 -h 2160 -o "$o" -T 80 -s 2 -r 30 -m 1200 \
        -g "1,UD,T,*,P,pro1x-gestures menu quickactions &" \
        -g "1,RL,R,*,P,pro1x-gestures menu launcher &" \
        -g "1,LR,L,*,P,pro1x-gestures menu windowswitcher &" \
        -g "2,LR,L,*,P,pro1x-super start &" \
        -g "2,RL,R,*,P,pro1x-super start &" \
        -g "2,UD,B,*,R,swaymsg kill >/dev/null; { sleep 1 | fbcli -E button-pressed; } >/dev/null 2>&1 &" \
        >/dev/null 2>&1 &
    lisgd_pid=$!
    # The swipe up from the bottom edge, followed as it goes: its own
    # program, with a buzz at once (pro1x-edge-swipe).
    pro1x-edge-swipe "$o" >/dev/null 2>&1 &
    edge_pid=$!
}

stop() {
    [ -n "$lisgd_pid" ] && kill "$lisgd_pid" 2>/dev/null; lisgd_pid=
    [ -n "$edge_pid" ] && kill "$edge_pid" 2>/dev/null; edge_pid=
}

trap 'stop; rm -f "$events"' EXIT
trap 'exit 0' INT TERM HUP

current=$(transform)
start "$current"

rm -f "$events"; mkfifo "$events"
swaymsg -m -r -t subscribe '["output"]' > "$events" 2>/dev/null &
# sway-autorotate sets the login orientation as this starts: a change before
# the subscription is lost, and left the swipes in the wrong orientation until
# the next turn (author, 2026-11-05).  So look again once it is surely on.
( sleep 3; echo recheck > "$events" ) &
while IFS= read -r _; do
    t=$(transform)
    if [ "$t" != "$current" ]; then
        stop; current=$t; start "$current"
    fi
done < "$events"
