#!/bin/sh
# pro1x-power-button — the power key in Sway: short press screen off/on
# (on release), held 0.6 s the power menu; with the menu open, a short
# press confirms its selection
#
# Sway acted on the key the moment it went down, so a long press could not
# be told apart (author, 2026-10-31); keyd does not grab the PMIC's power
# key either (as with pm8941_resin, volume down).  So this reads the key
# events itself (the user is in the input group): pm8941_pwrkey, and keyd's
# virtual keyboard in case.  Sway no longer binds XF86PowerOff.  Started by
# the Sway config; ends with Sway.
#
# State: written 2026-10-31, not yet run on the phone.

rt="${XDG_RUNTIME_DIR:-/tmp}"
menu_sock="$rt/pro1x-power-menu.sock"
held="$rt/pro1x-power-held"

devices=""
for e in /sys/class/input/event*; do
    case "$(cat "$e/device/name" 2>/dev/null)" in
        pm8941_pwrkey|"keyd virtual keyboard")
            devices="$devices /dev/input/${e##*/}" ;;
    esac
done
[ -n "$devices" ] || exit 0

if [ -n "${SWAYSOCK:-}" ]; then
    ( while [ -S "$SWAYSOCK" ]; do sleep 10; done; kill 0 ) &
fi

menu_open() { [ -S "$menu_sock" ] && pgrep -u "$(id -u)" -f "fzf --listen=$menu_sock" >/dev/null; }

# "Event: time …, type 1 (EV_KEY), code 116 (KEY_POWER), value 1"
for d in $devices; do evtest "$d" 2>/dev/null & done |
    while IFS= read -r line; do
        case "$line" in
            *"(KEY_POWER), value 1"*)
                # Held for 0.6 s with the flag still there: the menu.
                date +%s%N > "$held"
                ( stamp=$(cat "$held"); sleep 0.6
                  [ "$(cat "$held" 2>/dev/null)" = "$stamp" ] || exit 0
                  rm -f "$held"
                  menu_open || pro1x-power-menu ) & ;;
            *"(KEY_POWER), value 0"*)
                # Released early: a short press.
                if [ -f "$held" ]; then
                    rm -f "$held"
                    if menu_open; then pro1x-power-menu --key accept
                    else pro1x-power-key; fi
                fi ;;
        esac
    done
