#!/bin/sh
# pro1x-power-button — the power key in Sway: short press screen off/on
# (on release), held 0.6 s the power menu; with a menu focused (power,
# quick actions, launcher, switcher), a short press acts on its line (its
# Enter, without hiding it) and a long one hides it
#
# Sway acted on the key the moment it went down, so a long press could not
# be told apart (author, 2026-10-31); keyd does not grab the PMIC's power
# key either (as with pm8941_resin, volume down).  So this reads the key
# events itself (the user is in the input group): pm8941_pwrkey, and keyd's
# virtual keyboard in case.  Sway no longer binds XF86PowerOff.  Started by
# the Sway config; ends with Sway.
#
# State: written 2026-10-31, not yet run on the phone.

rt="${XDG_RUNTIME_DIR:-/tmp}"
menu_sock="$rt/pro1x-power-menu.sock"
held="$rt/pro1x-power-held"

# reader NAME: evtest on the input device named NAME, found again whenever
# it goes: pro1x-doubletap and keyd make theirs anew when they restart
# (2026-11-01: double tap and Esc no longer woke the panel after a
# restart of pro1x-doubletap).
reader() {
    while :; do
        for e in /sys/class/input/event*; do
            if [ "$(cat "$e/device/name" 2>/dev/null)" = "$1" ]; then
                evtest "/dev/input/${e##*/}" 2>/dev/null
                break
            fi
        done
        sleep 2
    done
}

if [ -n "${SWAYSOCK:-}" ]; then
    ( while [ -S "$SWAYSOCK" ]; do sleep 10; done; kill 0 ) &
fi


# "Event: time …, type 1 (EV_KEY), code 116 (KEY_POWER), value 1"
# pro1x-doubletap: its virtual power key (double tap, Esc: wake).
for n in pm8941_pwrkey "keyd virtual keyboard" pro1x-doubletap; do
    reader "$n" &
done |
    while IFS= read -r line; do
        case "$line" in
            *"(KEY_POWER), value 1"*)
                # Held for 0.6 s with the flag still there: the menu.
                date +%s%N > "$held"
                ( stamp=$(cat "$held"); sleep 0.6
                  [ "$(cat "$held" 2>/dev/null)" = "$stamp" ] || exit 0
                  rm -f "$held"
                  # Held long enough: a buzz, the key can go (author).
                  # (fbcli stops at the end of its input: a sleep feeds it.)
                  { sleep 1 | fbcli -E button-pressed; } >/dev/null 2>&1 &
                  # Locked: nothing shows over the lock screen, so the
                  # menu would wait behind it (author saw it after
                  # unlocking): a long press is a short one then.
                  if pro1x-lock --locked; then pro1x-power-key; exit 0; fi
                  # A menu focused: put it away; else the power menu,
                  # shown straight from the scratchpad in one Sway command
                  # (author: ~1.2 s after the buzz through pro1x-menu's
                  # key and toggle, several tree reads each; 2026-11-03),
                  # started only when it is not there.
                  case "$(pro1x-menu focused)" in
                      quickactions|launcher|windowswitcher|powermenu)
                          pro1x-menu key hide ;;
                      *)
                          swaymsg '[app_id="^powermenu$"] scratchpad show, resize set 50 ppt 45 ppt, move position center' \
                              >/dev/null 2>&1 || pro1x-menu toggle powermenu ;;
                  esac ) & ;;
            *"(KEY_POWER), value 0"*)
                # Released early: a short press.
                if [ -f "$held" ]; then
                    rm -f "$held"
                    # A menu focused: confirm in it; else screen off/on.
                    pro1x-menu key accept || pro1x-power-key
                fi ;;
        esac
    done
