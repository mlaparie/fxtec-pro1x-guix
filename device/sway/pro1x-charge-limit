#!/bin/sh
# pro1x-charge-limit LIMIT [RESUME] | off | default | get | temporary
# — the charge limit's temporary override, as root (sudo, from
# sway-quick-actions)
#
#   LIMIT [RESUME]   until reboot, stop charging at LIMIT %, charge again
#                    at or below RESUME % (default LIMIT - 5)
#   off              until reboot, charge to full
#   default          back to config.scm's (charge-limit, charge-resume)
#   get              print the limits in force: "LIMIT RESUME" or "off"
#   temporary        exit 0 when an override is in force
#
# config.scm sets the limits for good; quick actions only override them
# until the next reboot (author, 2026-11-01: as for the CPU mode).  The
# override is /run/pro1x-charge-limit (/run empties at boot), which the
# pro1x-charge-limit service reads on each pass.  Applied at once here too
# (the service looks once a minute).

PATH=/run/current-system/profile/bin:$PATH
state=/run/pro1x-charge-limit
param=/sys/module/pro1x_charger_icl/parameters/charge_enable
capacity=/sys/class/power_supply/battery/capacity

get() {
    if [ -f "$state" ]; then cat "$state"
    elif [ -r /etc/pro1x/charge.conf ]; then
        . /etc/pro1x/charge.conf
        if [ -n "${CHARGE_LIMIT:-}" ]; then echo "$CHARGE_LIMIT $CHARGE_RESUME"
        else echo off; fi
    else echo off
    fi
}

case "${1:-get}" in
    get) get; exit ;;
    temporary) [ -f "$state" ]; exit ;;
    default) rm -f "$state" ;;
    off) echo off > "$state" ;;
    [0-9]*)
        limit=$1 resume=${2:-$(( $1 - 5 ))}
        if [ "$limit" -lt 50 ] || [ "$limit" -gt 100 ] ||
           [ "$resume" -ge "$limit" ] || [ "$resume" -lt 40 ]; then
            echo "pro1x-charge-limit: limits out of range: $limit $resume" >&2
            exit 1
        fi
        echo "$limit $resume" > "$state" ;;
    *) echo "usage: pro1x-charge-limit LIMIT [RESUME] | off | default | get | temporary" >&2
       exit 1 ;;
esac

# What is now in force, applied at once.
[ -w "$param" ] || exit 0
set -- $(get)
if [ "$1" = off ]; then
    echo 1 > "$param"
else
    pct=$(cat "$capacity" 2>/dev/null || echo 0)
    if [ "$pct" -ge "$1" ]; then echo 0 > "$param"
    elif [ "$pct" -le "$2" ]; then echo 1 > "$param"; fi
fi
