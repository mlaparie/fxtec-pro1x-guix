#!/bin/sh
# pro1x-camera-button — the camera button in Sway (author, 2026-10-31)
#
#   Snapshot focused:  a press takes a picture (pro1x-camera), at once
#   double press:      CAMERA_DOUBLE_PRESS (/etc/pro1x/apps.conf,
#                      camera-double-press in config.scm; default snapshot),
#                      through pro1x-open, so it opens over the lock screen;
#                      not while the proximity sensor reads near (a pocket)
#   single press:      a right click where the finger last touched
#   held 0.4 s:        the left button held there, the pointer following
#                      the finger, until released (a mouse drag)
#
# Reads KEY_CAMERA from gpio-keys with evtest (Sway acts on presses only,
# and cannot tell a double press; Sway's own XF86WebCam binding is a nop,
# so apps do not get the key).  The clicks are Sway's own pointer (seat
# cursor set/press/release); the touch position comes from pro1x-doubletap
# (/run/pro1x-touch), mapped onto the output as wlroots maps touches
# (apply_output_transform in wlr_cursor.c).  A single press waits 0.35 s
# for a second one.  Started by the Sway config; ends with Sway.
#
# State: 2026-11-01: double press opened Snapshot (author); clicks were
# ydotool, which left them where the pointer was: now at the touch.

CAMERA_DOUBLE_PRESS=snapshot
[ -r /etc/pro1x/apps.conf ] && . /etc/pro1x/apps.conf
rt="${XDG_RUNTIME_DIR:-/tmp}"
st="$rt/pro1x-camera-button"           # press stamp; .pending, .drag

dev=
for e in /sys/class/input/event*; do
    [ "$(cat "$e/device/name" 2>/dev/null)" = gpio-keys ] && dev=/dev/input/${e##*/}
done
[ -n "$dev" ] || exit 0

if [ -n "${SWAYSOCK:-}" ]; then
    ( while [ -S "$SWAYSOCK" ]; do sleep 10; done; kill 0 ) &
fi

snapshot_focused() {
    [ "$(swaymsg -t get_tree -r |
         jq -r '.. | objects | select(.focused? == true) | .app_id // empty')" \
      = org.gnome.Snapshot ]
}

# The last touch as layout coordinates "X Y" (DSI-1's rectangle, transform).
touch_xy() {
    read -r tx ty txmax tymax _ < /run/pro1x-touch 2>/dev/null || return 1
    swaymsg -t get_outputs -r |
        jq -r --argjson tx "$tx" --argjson ty "$ty" \
              --argjson mx "$txmax" --argjson my "$tymax" '
            .[] | select(.name == "DSI-1") |
            ($tx / $mx) as $x | ($ty / $my) as $y |
            (if .transform == "90" then [1 - $y, $x]
             elif .transform == "180" then [1 - $x, 1 - $y]
             elif .transform == "270" then [$y, 1 - $x]
             else [$x, $y] end) as $d |
            "\(.rect.x + ($d[0] * .rect.width | floor)) \(.rect.y + ($d[1] * .rect.height | floor))"'
}
cursor_to_touch() {
    xy=$(touch_xy) && swaymsg "seat seat0 cursor set $xy" >/dev/null
}

rm -f "$st" "$st.pending" "$st.drag"
evtest "$dev" 2>/dev/null |
    while IFS= read -r line; do
        case "$line" in
            *"(KEY_CAMERA), value 1"*)
                if [ -f "$st.pending" ]; then        # the second press
                    rm -f "$st.pending" "$st"
                    [ -e /run/pro1x-pocket ] && continue
                    pro1x-open "$CAMERA_DOUBLE_PRESS" &
                    continue
                fi
                if snapshot_focused; then pro1x-camera & continue; fi
                stamp=$(date +%s%N); echo "$stamp" > "$st"
                ( sleep 0.4
                  [ "$(cat "$st" 2>/dev/null)" = "$stamp" ] || exit 0
                  touch "$st.drag"
                  cursor_to_touch
                  swaymsg 'seat seat0 cursor press button1' >/dev/null
                  # Follow the finger while held.
                  last=
                  while [ -f "$st.drag" ]; do
                      now=$(cat /run/pro1x-touch 2>/dev/null)
                      [ "$now" != "$last" ] && { last=$now; cursor_to_touch; }
                      sleep 0.05
                  done ) & ;;
            *"(KEY_CAMERA), value 0"*)
                if [ -f "$st.drag" ]; then
                    rm -f "$st.drag" "$st"
                    sleep 0.06                        # the follower's last move
                    swaymsg 'seat seat0 cursor release button1' >/dev/null
                elif [ -f "$st" ]; then              # a short press
                    rm -f "$st"
                    stamp=$(date +%s%N); echo "$stamp" > "$st.pending"
                    ( sleep 0.35
                      [ "$(cat "$st.pending" 2>/dev/null)" = "$stamp" ] || exit 0
                      rm -f "$st.pending"
                      cursor_to_touch
                      swaymsg 'seat seat0 cursor press button3, seat seat0 cursor release button3' \
                          >/dev/null ) &
                fi ;;
        esac
    done
