#!/bin/sh
# pro1x-camera-button — the camera button in Sway (author, 2026-10-31)
#
#   Snapshot focused:  a press takes a picture (pro1x-camera), at once
#   double press:      CAMERA_DOUBLE_PRESS (/etc/pro1x/apps.conf,
#                      camera-double-press in config.scm; default snapshot),
#                      through pro1x-open, so it opens over the lock screen;
#                      not while the proximity sensor reads near (a pocket)
#   single press:      a right click where the finger last touched
#   held 0.4 s:        Super and the left button held there, the pointer
#                      following the finger, until released: drags windows
#                      (Sway's floating_modifier); touch is off meanwhile
#
# Reads KEY_CAMERA from gpio-keys with evtest (Sway acts on presses only,
# and cannot tell a double press; Sway's own XF86WebCam binding is a nop,
# so apps do not get the key).  The pointer is pro1x-doubletap's virtual
# absolute one, at the touch's own position (no lag: it follows in C, not
# in this script); this sends it rclick, drag and end through
# /run/pro1x-pointer.  A single press waits 0.35 s for a second one.
# Started by the Sway config; ends with Sway.
#
# State: 2026-11-01: double press opened Snapshot (author); the first
# follower (this script moving Sway's cursor) lagged and could not drag
# windows: now pro1x-doubletap's pointer, with Super.

CAMERA_DOUBLE_PRESS=snapshot
[ -r /etc/pro1x/apps.conf ] && . /etc/pro1x/apps.conf
rt="${XDG_RUNTIME_DIR:-/tmp}"
st="$rt/pro1x-camera-button"           # press stamp; .pending, .drag

dev=
for e in /sys/class/input/event*; do
    [ "$(cat "$e/device/name" 2>/dev/null)" = gpio-keys ] && dev=/dev/input/${e##*/}
done
[ -n "$dev" ] || exit 0

if [ -n "${SWAYSOCK:-}" ]; then
    ( while [ -S "$SWAYSOCK" ]; do sleep 10; done; kill 0 ) &
fi

snapshot_focused() {
    [ "$(swaymsg -t get_tree -r |
         jq -r '.. | objects | select(.focused? == true) | .app_id // empty')" \
      = org.gnome.Snapshot ]
}

# The pointer is pro1x-doubletap's (it reads the touchscreen): a word to
# its fifo.
pointer() { [ -p /run/pro1x-pointer ] && echo "$1" > /run/pro1x-pointer; }

rm -f "$st" "$st.pending" "$st.drag"
evtest "$dev" 2>/dev/null |
    while IFS= read -r line; do
        case "$line" in
            *"(KEY_CAMERA), value 1"*)
                if [ -f "$st.pending" ]; then        # the second press
                    rm -f "$st.pending" "$st"
                    [ -e /run/pro1x-pocket ] && continue
                    pro1x-open "$CAMERA_DOUBLE_PRESS" &
                    continue
                fi
                if snapshot_focused; then pro1x-camera & continue; fi
                stamp=$(date +%s%N); echo "$stamp" > "$st"
                ( sleep 0.4
                  [ "$(cat "$st" 2>/dev/null)" = "$stamp" ] || exit 0
                  touch "$st.drag"
                  # Touch off in Sway meanwhile: the finger moves the
                  # pointer, not the app under it.
                  swaymsg 'input type:touch events disabled' >/dev/null
                  pointer drag ) & ;;
            *"(KEY_CAMERA), value 0"*)
                if [ -f "$st.drag" ]; then
                    rm -f "$st.drag" "$st"
                    pointer end
                    swaymsg 'input type:touch events enabled' >/dev/null
                elif [ -f "$st" ]; then              # a short press
                    rm -f "$st"
                    stamp=$(date +%s%N); echo "$stamp" > "$st.pending"
                    ( sleep 0.35
                      [ "$(cat "$st.pending" 2>/dev/null)" = "$stamp" ] || exit 0
                      rm -f "$st.pending"
                      pointer rclick ) &
                fi ;;
        esac
    done
