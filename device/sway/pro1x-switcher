#!/bin/sh
# pro1x-switcher — the Sway window switcher, resident in the scratchpad
#
#   pro1x-switcher           the fzf list (in its foot window, from pro1x-menu)
#   pro1x-switcher --list    one line per window: con_id, app, title
#
# Lists the windows, then workspaces 1-10 (author).  On a window, Enter and
# Ctrl-o (a short power press) ask Back / Focus / Close / Move to
# workspace / Tile / Tab / Stack / Toggle fullscreen, floating, sticky
# (author: Return does what the power key does);
# on a workspace they switch to it.  Right (or vol+ held) focuses or
# switches at once, Ctrl-k closes the window, Esc hides the switcher.  It
# stays alive hidden (pro1x-menu); each show reloads the list through
# fzf's socket.  Replaces sway-window-switcher, which started a new foot,
# bash and jq run each time (slow on the phone; author, 2026-10-30).
#
# State: written 2026-10-30, not yet run on the phone.

sock="${XDG_RUNTIME_DIR:-/tmp}/pro1x-switcher.sock"
self=$0

# pro1x-switcher --close CON_ID: close that window; with none left, the
# switcher goes away too (author: nothing left to switch to).
if [ "${1:-}" = --close ]; then
    swaymsg "[con_id=$2] kill" >/dev/null
    sleep 0.3
    if ! "$0" --list | grep -q -v '^ws:'; then          # no window left
        curl -s -m 2 --unix-socket "$sock" -X POST http://localhost \
             -d "clear-query+first" >/dev/null 2>&1 &
        swaymsg '[app_id="^windowswitcher$"] move scratchpad' >/dev/null
    fi
    exit
fi

# pro1x-switcher --go ID: a window (con_id): focus it; a workspace line
# (ws:N): switch to it; then the switcher goes away, its query cleared.
if [ "${1:-}" = --go ]; then
    case "$2" in
        ws:*) swaymsg "workspace number ${2#ws:}" >/dev/null ;;
        *) swaymsg "[con_id=$2] focus" >/dev/null ;;
    esac
    curl -s -m 2 --unix-socket "$sock" -X POST http://localhost \
         -d "clear-query+first" >/dev/null 2>&1 &
    swaymsg '[app_id="^windowswitcher$"] move scratchpad' >/dev/null
    exit
fi

if [ "${1:-}" = --ask ]; then
    # pro1x-switcher --ask CON_ID: Back / Focus / Close window, for the
    # power key (short press on a line; author, 2026-10-31).  Its own fzf
    # socket, which pro1x-menu key drives while it is open.
    asksock="${XDG_RUNTIME_DIR:-/tmp}/pro1x-switcher-ask.sock"
    pick() {                    # pick PROMPT LINES...: one of the lines
        prompt=$1; shift
        printf '%s\n' "$@" |
            fzf --listen="$asksock" --prompt="$prompt > " --layout=reverse-list \
                --bind="load:pos(2)" \
                --no-info --cycle --margin=1,2 --color=16,gutter:-1
        rm -f "$asksock"
    }
    # Move, tile and tab too (author, 2026-11-01).
    choice=$(pick window "← back" "Focus" "Close" \
                 "Move to workspace…" "Tile" "Tab" "Stack" \
                 "Toggle fullscreen" "Toggle floating" "Toggle sticky")
    case "$choice" in
        "Move to workspace…")
            ws=$(pick "move to" "← back" 1 2 3 4 5 6 7 8 9 0)
            [ "$ws" = 0 ] && ws=10
            case "$ws" in
                [0-9]*) swaymsg "[con_id=$2] move container to workspace number $ws" >/dev/null
                        sleep 0.2 ;;    # the list reloads after this: let Sway settle
            esac ;;
        Tile) swaymsg "[con_id=$2] floating disable, layout splith" >/dev/null ;;
        Tab) swaymsg "[con_id=$2] floating disable, layout tabbed" >/dev/null ;;
        Stack) swaymsg "[con_id=$2] floating disable, layout stacking" >/dev/null ;;
        "Toggle fullscreen") swaymsg "[con_id=$2] fullscreen toggle" >/dev/null ;;
        "Toggle floating") swaymsg "[con_id=$2] floating toggle" >/dev/null ;;
        "Toggle sticky") swaymsg "[con_id=$2] sticky toggle" >/dev/null ;;
        Focus)
            # Away, its query cleared (after this execute ends), then focus.
            curl -s -m 2 --unix-socket "$sock" -X POST http://localhost \
                 -d "clear-query+first" >/dev/null 2>&1 &
            swaymsg '[app_id="^windowswitcher$"] move scratchpad' >/dev/null
            swaymsg "[con_id=$2] focus" >/dev/null ;;
        Close) "$0" --close "$2" ;;
    esac
    exit
fi

if [ "${1:-}" = --list ]; then
    # The windows (with their workspace), then workspaces 1-10 whatever
    # the windows (author): "ws:N" lines switch to that workspace.  The
    # menus live in the scratchpad, which is not listed.  Short names
    # (author, 2026-11-02): the last part of the app_id (org.pro1x.Camera:
    # Camera), the title cut at 28.
    swaymsg -t get_tree -r |
        jq -r '[.. | objects | select(.type == "workspace" and .name != "__i3_scratch")] as $ws
               | def windows: [.. | objects
                               | select((.type == "con" or .type == "floating_con")
                                        and (.pid? // 0) > 0)];
               ($ws[] | . as $w | windows[]
                | ((.app_id // .window_properties.class // "?") | split(".") | last) as $app
                | ((.name // "") | if length > 28 then .[0:27] + "…" else . end) as $title
                | "\(.id)\t\($app)\t\($title) · \(if $w.num == 10 then "0" else $w.name end)"),
               (range(1; 11) as $n
                | ([$ws[] | select(.num == $n)] | .[0]) as $w
                | "ws:\($n)\t\u001b[34m\(if $n == 10 then 0 else $n end) ::\t\(if $w then ($w | windows | length) as $k | "\($k) window\(if $k == 1 then "" else "s" end)" else "empty" end)\u001b[0m")'
    exit
fi

# Hidden with its query cleared, for next time (author, 2026-10-31).
hide='clear-query+first+execute-silent(swaymsg "[app_id=\"^windowswitcher$\"] move scratchpad")'
# On a workspace line: switch to it; on a window: its question.
act="case {1} in
       ws:*) echo \"execute-silent($self --go {1})\" ;;
       *) echo \"execute($self --ask {1})+reload-sync($self --list)\" ;;
     esac"
"$self" --list |
    fzf --listen="$sock" --delimiter='\t' --with-nth=2,3 --no-sort --ansi \
        --prompt="windows > " --layout=reverse-list --no-info --cycle --margin=1,2 --color=16,gutter:-1 \
        --bind="enter:transform:$act" \
        --bind="ctrl-o:transform:$act" \
        --bind="right:execute-silent($self --go {1})" \
        --bind="ctrl-k:transform:case {1} in
                  ws:*) ;;
                  *) echo \"execute-silent($self --close {1})+reload($self --list)\" ;;
                esac" \
        --bind="esc:$hide" >/dev/null
