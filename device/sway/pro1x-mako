#!/bin/sh
# pro1x-mako — mako, noting when each notification arrives
#
# mako keeps no arrival times, and the Sway lock screen (pro1x-lock) shows
# the time of the latest notification of each app.  mako's on-notify runs
# `sway-notifications log "$id"' for each new one.  mako reads only
# ~/.mako/config or ~/.config/mako/config and has no command-line option for
# on-notify, so this writes a config with that line first (global options
# come before any [section]) followed by the user's own config, whose
# settings win, and runs mako -c on it.  Started by the Sway config.
#
# State: written 2026-10-30, not yet run on the phone.

conf="${XDG_RUNTIME_DIR:-/tmp}/pro1x-mako.config"
{
    echo '# Written by pro1x-mako; edit ~/.config/mako/config instead.'
    echo 'on-notify=exec sway-notifications log "$id"'
    for f in "$HOME/.mako/config" "${XDG_CONFIG_HOME:-$HOME/.config}/mako/config"; do
        if [ -r "$f" ]; then cat "$f"; break; fi
    done
} > "$conf"
exec mako -c "$conf" "$@"
