#!/bin/sh
# pro1x-mako — mako, noting when each notification arrives
#
# mako keeps no arrival times, and the Sway lock screen (pro1x-lock) shows
# the time of the latest notification of each app.  mako's on-notify runs
# `pro1x-notify "$id"' for each new one (logs it, wakes the panel briefly,
# refreshes the lock screen).  mako reads only
# ~/.mako/config or ~/.config/mako/config and has no command-line option for
# on-notify, so this writes a config with that line first (global options
# come before any [section]) followed by the user's own config, whose
# settings win, and runs mako -c on it.  Started by the Sway config.
# While Android's notifications are muted (quick actions), each Waydroid
# app's are invisible, so none flashes before pro1x-notify dismisses it;
# --reload writes the config again and has mako read it.
#
# State: written 2026-10-30, not yet run on the phone.

conf="${XDG_RUNTIME_DIR:-/tmp}/pro1x-mako.config"
muted="${XDG_STATE_HOME:-$HOME/.local/state}/pro1x/waydroid-muted"
apps="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
{
    echo '# Written by pro1x-mako; edit ~/.config/mako/config instead.'
    echo 'on-notify=exec pro1x-notify "$id"'
    # Keep the last 50 in history, which quick actions lists (mako keeps 5).
    echo 'max-history=50'
    for f in "$HOME/.mako/config" "${XDG_CONFIG_HOME:-$HOME/.config}/mako/config"; do
        if [ -r "$f" ]; then cat "$f"; break; fi
    done
    # Messages, calls and alarms stay until dismissed or opened (author,
    # 2026-11-02: an SMS received asleep was gone from the count after
    # its pop-up timed out into mako's history).  Last: sections take
    # every option after them.
    for app in Chats gnome-calls Calls Clocks; do
        printf '\n[app-name="%s"]\ndefault-timeout=0\nignore-timeout=1\n' "$app"
    done
    # mako matches desktop entries whole: one section per Waydroid app.
    if [ -e "$muted" ]; then
        for f in "$apps"/waydroid.*.desktop; do
            [ -e "$f" ] || continue
            printf '\n[desktop-entry="%s"]\ninvisible=1\n' "$(basename "$f" .desktop)"
        done
    fi
} > "$conf"
if [ "${1:-}" = --reload ]; then
    exec makoctl reload
fi
exec mako -c "$conf" "$@"
