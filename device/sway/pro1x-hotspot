#!/usr/bin/env bash
# pro1x-hotspot — share mobile data over Wi-Fi: on or off, the network name and
# password, the band, a hidden name, auto-off when idle, the data used, a QR
# code for others to join, and the connected devices, which can be expelled or
# banned.  Opened by Enter or Right on the Hotspot line of
# sway-quick-actions.
#
# It is a NetworkManager connection in shared mode.  wlan0 cannot be a client
# at the same time here, so starting it drops the Wi-Fi network in use, and the
# internet it shares comes from mobile data.
#
# State: on and off, the name and password confirmed by the author 2026-11-09.
# The device list, expel, ban, band, hidden, auto-off and data used are not yet
# run on the phone.

case "${FZF_DEFAULT_OPTS:-}" in
    *--with-shell=*) ;;
    *) export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:+$FZF_DEFAULT_OPTS }--with-shell='sh -c'" ;;
esac

rt="${XDG_RUNTIME_DIR:-/tmp}"
sock="$rt/pro1x-tool.sock"
con=pro1x-hotspot
iface=wlan0
leases=/var/lib/NetworkManager/dnsmasq-$iface.leases
banned=/var/lib/pro1x-hotspot/banned
statedir="${XDG_STATE_HOME:-$HOME/.local/state}/pro1x"
idle_file="$statedir/hotspot-idle"      # minutes without a device, 0 for never
watch_pid="$rt/pro1x-hotspot-watch.pid"
data_base="$rt/pro1x-hotspot-data"      # the byte count when it started
admin="/run/privileged/bin/sudo -n /run/current-system/profile/bin/pro1x-hotspot-admin"

state() { nmcli -g GENERAL.STATE connection show "$con" 2>/dev/null; }
exists() { nmcli -t -f NAME connection show | grep -qx "$con"; }
ssid() { nmcli -e no -g 802-11-wireless.ssid connection show "$con"; }
psk() { nmcli -s -e no -g 802-11-wireless-security.psk connection show "$con"; }
band() { nmcli -e no -g 802-11-wireless.band connection show "$con"; }
hidden() { nmcli -e no -g 802-11-wireless.hidden connection show "$con"; }
idle_minutes() { cat "$idle_file" 2>/dev/null || echo 0; }
stations() { iw dev "$iface" station dump 2>/dev/null | grep -c '^Station'; }

bytes_now() {
    n=/sys/class/net/$iface/statistics
    echo $(($(cat "$n/rx_bytes") + $(cat "$n/tx_bytes")))
}

data_used() {                   # since this start, or - when off
    [ "$(state)" = activated ] && [ -f "$data_base" ] || { echo -; return; }
    numfmt --to=iec --suffix=B $(($(bytes_now) - $(cat "$data_base")))
}

menu_lines() {
    case "$(state)" in
        activated) s=on ;;
        activating) s=starting… ;;
        deactivating) s=stopping… ;;
        *) s=off ;;
    esac
    printf '%s\t%s\n' \
        toggle "Hotspot:   $s" \
        name "Name:      $(ssid)" \
        password "Password:  $(psk)" \
        band "Band:      $(if [ "$(band)" = a ]; then echo 5 GHz; else echo 2.4 GHz; fi)" \
        hidden "Hidden:    $(if [ "$(hidden)" = yes ]; then echo yes; else echo no; fi)" \
        idle "Auto-off:  $(if [ "$(idle_minutes)" = 0 ]; then echo never; else echo "$(idle_minutes) min idle"; fi)" \
        data "Data used: $(data_used)" \
        qr "Show QR code" \
        clients "Connected devices"
}

# fzf reloads this after a background start or stop.
[ "${1:-}" = --menu ] && { menu_lines; exit; }

trap 'rm -f "$rt/pro1x-tool.done"' EXIT

clear_screen() { printf '\033[H\033[2J\033[3J'; }
pause() { printf '\nPress any key to go back.\n'; read -rsn1; }

# The first start makes the connection, with a random password.
ensure() {
    exists && return
    nmcli connection add type wifi ifname "$iface" con-name "$con" \
        autoconnect no ssid Pro1x wifi.mode ap wifi.band bg \
        ipv4.method shared ipv6.method ignore \
        wifi-sec.key-mgmt wpa-psk wifi-sec.proto rsn \
        wifi-sec.pairwise ccmp wifi-sec.group ccmp \
        wifi-sec.psk "$(LC_ALL=C tr -dc 'a-km-z2-9' < /dev/urandom | head -c 14)" \
        > /dev/null
}

# in_background COMMAND...: run it detached, so the menu stays usable, then
# tell the menu to redraw.  It outlives this window.
in_background() {
    setsid bash -c '
        "$@"
        curl -s -m 5 --unix-socket "'"$sock"'" -X POST http://localhost \
             -d "reload('"$0"' --menu)"
    ' "$0" "$@" > /dev/null 2>&1 < /dev/null &
}

start() {
    nmcli connection up "$con" || {
        notify-send -u critical Hotspot "Could not start"; return 1; }
    $admin apply
    bytes_now > "$data_base"
    # The old watcher ends with the old connection; this makes sure of it.
    [ -f "$watch_pid" ] && kill "$(cat "$watch_pid")" 2>/dev/null
    setsid "$0" --watch > /dev/null 2>&1 < /dev/null &
    notify-send Hotspot "On: $(ssid)"
}

# Turns the hotspot off after the set minutes with no device connected.
watch_idle() {
    echo $$ > "$watch_pid"
    idle=0
    while [ "$(state)" = activated ]; do
        if [ "$(stations)" = 0 ]; then idle=$((idle + 1)); else idle=0; fi
        limit=$(idle_minutes)
        if [ "$limit" != 0 ] && [ "$idle" -ge "$limit" ]; then
            stop
            break
        fi
        sleep 60
    done
    rm -f "$watch_pid"
}

stop() { nmcli connection down "$con"; notify-send Hotspot Off; }

restart() { nmcli connection down "$con"; start; }

toggle() {
    case "$(state)" in
        activated|activating) in_background "$0" --stop ;;
        *) in_background "$0" --start ;;
    esac
}

# A changed name or password applies on the next start.
restart_if_active() {
    [ "$(state)" = activated ] && in_background "$0" --restart
}

case "${1:-}" in
    --start) start; exit ;;
    --stop) stop; exit ;;
    --restart) restart; exit ;;
    --watch) watch_idle; exit ;;
esac

set_name() {
    clear_screen
    read -rp "Network name: " v
    [ -n "$v" ] || return
    nmcli connection modify "$con" 802-11-wireless.ssid "$v" && restart_if_active
}

set_password() {
    clear_screen
    read -rp "Password (8 characters or more): " v
    if [ "${#v}" -lt 8 ]; then
        echo "Too short: not changed."
        pause
        return
    fi
    nmcli connection modify "$con" wifi-sec.psk "$v" && restart_if_active
}

toggle_band() {
    if [ "$(band)" = a ]; then b=bg; else b=a; fi
    nmcli connection modify "$con" 802-11-wireless.band "$b" && restart_if_active
}

toggle_hidden() {
    if [ "$(hidden)" = yes ]; then h=no; else h=yes; fi
    nmcli connection modify "$con" 802-11-wireless.hidden "$h" && restart_if_active
}

cycle_idle() {                  # never, 5, 15, 30 minutes
    case "$(idle_minutes)" in
        0) next=5 ;;
        5) next=15 ;;
        15) next=30 ;;
        *) next=0 ;;
    esac
    mkdir -p "$statedir"
    echo "$next" > "$idle_file"
}

show_qr() {
    # The WIFI: format escapes these characters with a backslash.
    esc() { printf '%s' "$1" | sed 's/[\\;,:"]/\\&/g'; }
    s=$(ssid) p=$(psk)
    clear_screen
    # The lowest error correction and margin make the smallest code.
    h=; [ "$(hidden)" = yes ] && h="H:true;"
    qrencode -t ANSIUTF8 -l L -m 1 "WIFI:T:WPA;S:$(esc "$s");P:$(esc "$p");$h;"
    printf '%s  %s\n' "$s" "$p"
    read -rsn1
}

# One line per device, connected or banned: MAC, tab, what is shown.
client_lines() {
    macs=$(iw dev "$iface" station dump 2>/dev/null | awk '/^Station/ { print $2 }')
    for m in $(printf '%s\n' $macs $(cat "$banned" 2>/dev/null) | sort -u); do
        lease=$(awk -v m="$m" '$2 == m { print $3, $4 }' "$leases" 2>/dev/null)
        ip=${lease%% *} name=${lease##* }
        [ -n "$lease" ] || { ip=-; name=-; }
        [ "$name" != "*" ] || name=-
        if grep -qxF "$m" "$banned" 2>/dev/null; then note=banned; else note=; fi
        printf '%s\t%-20s %-15s %s  %s\n' "$m" "$name" "$ip" "$m" "$note"
    done
}

client_action() {               # client_action MAC
    if grep -qxF "$1" "$banned" 2>/dev/null; then
        actions=unban
    else
        actions=$'expel\nban'
    fi
    a=$(printf '%s\n' "$actions" |
        fzf --listen="$sock" --reverse --cycle --margin='1,2,1,2' \
            --color='16,gutter:-1' --header="$1")
    [ -n "$a" ] || return
    $admin "$a" "$1" || pause
}

show_clients() {
    while :; do
        pick=$(client_lines |
            fzf --listen="$sock" --delimiter='\t' --with-nth=2 --reverse \
                --cycle --margin='1,2,1,2' --color='16,gutter:-1' \
                --header="Name                 IP              MAC" |
            cut -f1)
        [ -n "$pick" ] || return
        client_action "$pick"
    done
}

ensure || { echo "Could not create the hotspot connection."; pause; exit 1; }

while :; do
    choice=$(menu_lines |
        fzf --listen="$sock" --delimiter='\t' --with-nth=2 \
            --reverse --cycle --margin='1,2,1,2' --color='16,gutter:-1' |
        cut -f1)
    case "$choice" in
        toggle) toggle ;;
        name) set_name ;;
        password) set_password ;;
        band) toggle_band ;;
        hidden) toggle_hidden ;;
        idle) cycle_idle ;;
        data) ;;                  # redrawn by the loop
        qr) show_qr ;;
        clients) show_clients ;;
        *) break ;;
    esac
done
: > "$rt/pro1x-tool.done"
