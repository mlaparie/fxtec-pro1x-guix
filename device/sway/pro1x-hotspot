#!/usr/bin/env bash
# pro1x-hotspot — share mobile data over Wi-Fi: on or off, the network name and
# password, the band, a hidden name, auto-off when idle, the data used, a QR
# code for others to join, and the connected devices, which can be expelled,
# banned, or sent the screen.  Opened by Enter or Right on the Hotspot line of
# sway-quick-actions, inside its window.
#
# It is a NetworkManager connection in shared mode.  It runs on wlan0 and
# shares mobile data, dropping a Wi-Fi network in use.  With Keep Wi-Fi on,
# it runs on a second interface, ap0, so that wlan0 can join networks: beside
# one, on that network's channel (SCC), or on a channel of its own where no
# access point may start on the network's (radar channels), sharing that
# network; with none, sharing mobile data until one is joined (place, below).
#
# State: on and off, the name and password confirmed by the author 2026-11-09.
# A 5 GHz hotspot starts (channel 149, 2026-11-18).  With the ath country-IE
# patch and an EEPROM country (FR), non-DFS 5 GHz channels (36–48, 149–165)
# lose "no IR" and an AP can run beside a client on the same channel (SCC).
# DFS channels (52–144) still have "no IR": beside a network there, the
# hotspot takes a channel of its own (MCC).
# The device list, expel, ban, band, hidden, auto-off and data used are not yet
# run on the phone.  Beside a Wi-Fi network: ap0 on the network's channel 36
# at 80 MHz (SCC) gave a laptop 3.5 Mbps at -61 dBm, a third of the phone's own
# 10 Mbps (2026-11-26).  ap0 on 5 GHz channel 36 beside a network on channel
# 112 (MCC) gave a laptop that network's internet, pings 245-1135 ms
# (2026-11-24).  ap0 on 2.4 GHz channel 6 beside that network worked two
# minutes, then frames to the laptop failed (cause not found).  The merged
# placement (SCC, else MCC) is not yet run on the phone; its ap0 placement
# beside a 2.4 GHz network was run by hand (2026-11-27).  Power saving off
# while on ap0 (start) is not yet measured with a device on the hotspot.

case "${FZF_DEFAULT_OPTS:-}" in
    *--with-shell=*) ;;
    *) export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:+$FZF_DEFAULT_OPTS }--with-shell='sh -c'" ;;
esac

rt="${XDG_RUNTIME_DIR:-/tmp}"
sock="${PRO1X_TOOL_SOCK:-$rt/pro1x-tool.sock}"
con=pro1x-hotspot
# The hotspot's interface: wlan0, or ap0 beside a Wi-Fi network (start).
iface=wlan0
[ -e /sys/class/net/ap0 ] && iface=ap0
saved_band="$rt/pro1x-hotspot-band"     # the owner's channel, kept while on ap0
banned=/var/lib/pro1x-hotspot/banned
statedir="${XDG_STATE_HOME:-$HOME/.local/state}/pro1x"
idle_file="$statedir/hotspot-idle"      # minutes without a device, 0 for never
keep_file="$statedir/hotspot-keep-wifi" # yes: the Wi-Fi in use stays the uplink
watch_pid="$rt/pro1x-hotspot-watch.pid"
data_base="$rt/pro1x-hotspot-data"      # the byte count when it started
admin="/run/privileged/bin/sudo -n /run/current-system/profile/bin/pro1x-hotspot-admin"
powersave="/run/privileged/bin/sudo -n /run/current-system/profile/bin/pro1x-wifi-powersave"

state() { nmcli -g GENERAL.STATE connection show "$con" 2>/dev/null; }
exists() { nmcli -t -f NAME connection show | grep -qx "$con"; }
ssid() { nmcli -e no -g 802-11-wireless.ssid connection show "$con"; }
psk() { nmcli -s -e no -g 802-11-wireless-security.psk connection show "$con"; }
band() { nmcli -e no -g 802-11-wireless.band connection show "$con"; }
hidden() { nmcli -e no -g 802-11-wireless.hidden connection show "$con"; }
idle_minutes() { cat "$idle_file" 2>/dev/null || echo 0; }
keep_wifi() { cat "$keep_file" 2>/dev/null || echo no; }
# The band chosen in Band; ap0 keeps it, on another channel maybe.
own_band() { if [ -f "$saved_band" ]; then cut -d' ' -f1 "$saved_band"; else band; fi; }
ghz() { if [ "$1" = a ]; then echo 5 GHz; else echo 2.4 GHz; fi; }
stations() { iw dev "$iface" station dump 2>/dev/null | grep -c '^Station'; }

bytes_now() {
    n=/sys/class/net/$iface/statistics
    echo $(($(cat "$n/rx_bytes") + $(cat "$n/tx_bytes")))
}

data_used() {                   # since this start, or - when off
    [ "$(state)" = activated ] && [ -f "$data_base" ] || { echo -; return; }
    numfmt --to=iec --suffix=B $(($(bytes_now) - $(cat "$data_base")))
}

menu_lines() {
    case "$(state)" in
        activated) s=on ;;
        activating) s=starting… ;;
        deactivating) s=stopping… ;;
        *) s=off ;;
    esac
    printf '%s\t%s\n' \
        back "← back" \
        toggle "Hotspot:    $s" \
        name "Name:       $(ssid)" \
        password "Password:   $(psk)" \
        band "Band:       $(ghz "$(own_band)")$(on_ap0 && [ "$(band)" != "$(own_band)" ] &&
                                 echo " ($(ghz "$(band)") now, the Wi-Fi's channel)")" \
        keep "Keep Wi-Fi: $(keep_line)" \
        hidden "Hidden:     $(if [ "$(hidden)" = yes ]; then echo yes; else echo no; fi)" \
        idle "Auto-off:   $(if [ "$(idle_minutes)" = 0 ]; then echo never; else echo "$(idle_minutes) min idle"; fi)" \
        data "Data used:  $(data_used)" \
        qr "QR code to join" \
        clients "Connected devices"
}

on_ap0() { [ "$(state)" = activated ] && [ "$iface" = ap0 ]; }
keep_line() {
    [ "$(keep_wifi)" = yes ] || { echo off; return; }
    case "$(state)" in
        activated) if [ "$iface" = ap0 ]; then echo "on (in use)"; else echo "on (unused now)"; fi ;;
        *) echo on ;;
    esac
}

qr_fit() {                      # qr_fit TEXT: as the stream menu's
    # In quick actions' own window (foot draws sixel): chafa, which fits the
    # image to the preview's cells itself (the author's choice; sizing it
    # here from the window's pixels came out wrong).  Elsewhere (SSH,
    # tmux) text: sixel may not get through.
    case "${PRO1X_TOOL_SOCK:-}" in
        *quick-actions*)
            qrencode -t PNG -s 8 -m 2 -l L -o - "$1" |
                chafa -f sixel --animate=off --polite=on \
                      -s "${FZF_PREVIEW_COLUMNS:-40}x${FZF_PREVIEW_LINES:-20}" -
            return ;;
    esac
    qrencode -t UTF8 -m 1 -l L "$1"
}

# The QR code to join: the WIFI: format escapes these with a backslash.  The
# lowest error correction and margin make the smallest code.
print_qr() {
    esc() { printf '%s' "$1" | sed 's/[\\;,:"]/\\&/g'; }
    s=$(ssid) p=$(psk)
    h=; [ "$(hidden)" = yes ] && h="H:true;"
    # In half-block characters, as the stream menu's: an image sized from
    # the phone's focused window overflowed the pane elsewhere (SSH, tmux).
    qr_fit "WIFI:T:WPA;S:$(esc "$s");P:$(esc "$p");$h;"
}

# fzf reloads the menu after a background start or stop, and asks for the QR
# code for its preview.
[ "${1:-}" = --menu ] && { menu_lines; exit; }
[ "${1:-}" = --qr ] && { print_qr; exit; }

trap 'rm -f "$rt/pro1x-tool.done"' EXIT

clear_screen() { printf '\033[H\033[2J\033[3J'; }
pause() { printf '\nPress any key to go back.\n'; read -rsn1; }

# The first start makes the connection, with a random password.
ensure() {
    exists && return
    nmcli connection add type wifi ifname "$iface" con-name "$con" \
        autoconnect no ssid Pro1x wifi.mode ap wifi.band bg \
        ipv4.method shared ipv6.method ignore \
        wifi-sec.key-mgmt wpa-psk wifi-sec.proto rsn \
        wifi-sec.pairwise ccmp wifi-sec.group ccmp \
        wifi-sec.psk "$(LC_ALL=C tr -dc 'a-km-z2-9' < /dev/urandom | head -c 14)" \
        > /dev/null
}

# in_background COMMAND...: run it detached, so the menu stays usable, then
# tell the menu to redraw.  It outlives this window.
in_background() {
    setsid bash -c '
        "$@"
        curl -s -m 5 --unix-socket "'"$sock"'" -X POST http://localhost \
             -d "reload('"$0"' --menu)"
    ' "$0" "$@" > /dev/null 2>&1 < /dev/null &
}

# The Wi-Fi network wlan0 is on, as its frequency in MHz; empty if none.
client_freq() {
    nmcli -t -f DEVICE,STATE device | grep -qx 'wlan0:connected' || return 0
    iw dev wlan0 link 2>/dev/null | sed -n 's/.*freq: \([0-9]*\).*/\1/p' | head -1
}

# Beside a Wi-Fi network (wlan0 connected), the hotspot is a second
# interface, ap0: the WCN3990 allows an access point beside a client, on
# the same channel or on two ("#{ managed } <= 2, #{ AP } <= 1, #channels
# <= 2").  So the Wi-Fi stays up, e.g. a phone's 5G hotspot as the uplink,
# and the car on the Pro1x's own (author, 2026-11-20).  ap0 takes the
# network's band and channel (SCC), 80 MHz wide on 5 GHz: one radio on one
# channel, the hotspot gets about a third of the phone's own speed
# (2026-11-26).  No access point may start on a radar channel (52-144):
# beside a network there, ap0 takes another channel on the hotspot's own
# band, away from the network's 80 MHz block (MCC).  The radio then shares
# its time between the two channels: a laptop's pings through it took
# 250-1100 ms, the phone's own about 65 ms (2026-11-24).  ap0 needs an
# address of its own: wlan0's (already a random local one) made both fail
# ("Name not unique on network").  Otherwise wlan0 itself, on the owner's
# band and channel.
# A channel the radio may not start an access point on.
no_ir() { iw phy 2>/dev/null | grep " $1 MHz " | grep -q -e "no IR" -e "radar detection"; }

# away BAND CHANNEL FREQ: the hotspot's channel on BAND, CHANNEL if it is
# clear of the network on FREQ (MHz), else another one.
away() {
    if [ "$1" = a ]; then
        # 36-64 share 80 MHz blocks with a network there: 149 instead.
        if [ "$3" -ge 5170 ] && [ "$3" -le 5330 ]; then echo 149; else echo 36; fi
    elif [ "$3" -lt 3000 ]; then
        n=$(( ($3 - 2407) / 5 ))
        if [ "${2:-0}" != 0 ] && [ $(( $2 > n ? $2 - n : n - $2 )) -ge 5 ]; then echo "$2"
        elif [ "$n" -ge 6 ]; then echo 1
        else echo 11; fi
    else
        echo "${2:-0}"
    fi
}

place() {
    # With Keep Wi-Fi, always on ap0, even with no network joined yet: on
    # wlan0 the hotspot would keep the phone off any network until it stops
    # (author, 2026-11-24: none could be joined while it ran).  Beside a
    # network, on its channel (SCC), or on a channel of its own when the
    # network is on one where no access point may start (MCC); with none,
    # on its own channel.
    ap=; [ "$(keep_wifi)" = yes ] && ap=yes
    w=auto
    if [ -n "$ap" ]; then
        f=$(client_freq)
        [ -f "$saved_band" ] ||
            echo "$(band) $(nmcli -e no -g 802-11-wireless.channel connection show "$con")" > "$saved_band"
        read -r b ch < "$saved_band"
        if [ -n "$f" ] && ! no_ir "$f"; then
            if [ "$f" = 2484 ]; then b=bg ch=14
            elif [ "$f" -lt 3000 ]; then b=bg ch=$(( (f - 2407) / 5 ))
            else b=a ch=$(( (f - 5000) / 5 )) w=80mhz; fi
        elif [ -n "$f" ]; then
            ch=$(away "$b" "$ch" "$f")
        fi
        if [ "$b" = a ]; then af=$((5000 + 5 * ch)); else af=$((2407 + 5 * ch)); fi
        if [ "${ch:-0}" != 0 ] && no_ir "$af"; then
            if [ -n "$f" ]; then
                notify-send Hotspot \
                    "No hotspot may start on channel $ch beside this network: it is dropped, and mobile data shared"
            else
                notify-send Hotspot \
                    "No hotspot may start on channel $ch beside Wi-Fi: Wi-Fi is left out, and mobile data shared"
            fi
            ap=
        fi
    fi
    if [ -n "$ap" ]; then
        $admin ap-up || return 1
        iface=ap0
        nmcli connection modify "$con" connection.interface-name ap0 \
              802-11-wireless.band "$b" 802-11-wireless.channel "${ch:-0}" \
              802-11-wireless.channel-width "$w" \
              802-11-wireless.cloned-mac-address "$(cat /sys/class/net/ap0/address)"
    else
        iface=wlan0
        $admin ap-down
        if [ -f "$saved_band" ]; then
            read -r b ch < "$saved_band"
            nmcli connection modify "$con" 802-11-wireless.band "$b" \
                  802-11-wireless.channel "${ch:-0}" 802-11-wireless.channel-width auto
            rm -f "$saved_band"
        fi
        nmcli connection modify "$con" connection.interface-name wlan0 \
              802-11-wireless.cloned-mac-address ""
    fi
}

start() {
    place || { notify-send -u critical Hotspot "Could not make its interface beside the Wi-Fi"; return 1; }
    # Beside a network, wlan0's power saving off while the hotspot runs: the
    # WCN3990 firmware does not support a client in power save next to an
    # access point (ath10k refuses to turn it on while ap0 runs), yet a client
    # already in it when ap0 starts stays so, with the network's replies
    # held back until it wakes (2026-11-27; pro1x-wifi-powersave).  Off
    # before ap0 starts, back as it was when the hotspot stops.
    [ "$iface" = ap0 ] && $powersave hold hotspot
    nmcli connection up "$con" || {
        [ "$iface" = ap0 ] && { $admin ap-down; $powersave release hotspot; }
        if [ "$iface" = ap0 ]; then
            notify-send -u critical Hotspot \
                "Could not start beside the Wi-Fi network (on its channel); disconnect it to use another"
        elif [ "$(band)" = a ]; then
            notify-send -u critical Hotspot \
                "Could not start on 5 GHz: try 2.4 GHz"
        else
            notify-send -u critical Hotspot "Could not start"
        fi
        return 1; }
    $admin apply
    bytes_now > "$data_base"
    # The old watcher ends with the old connection; this makes sure of it.
    [ -f "$watch_pid" ] && kill "$(cat "$watch_pid")" 2>/dev/null
    setsid "$0" --watch > /dev/null 2>&1 < /dev/null &
    notify-send Hotspot "On: $(ssid)"
}

# Turns the hotspot off after the set minutes with no device connected.
watch_idle() {
    echo $$ > "$watch_pid"
    idle=0
    while [ "$(state)" = activated ]; do
        if [ "$(stations)" = 0 ]; then idle=$((idle + 1)); else idle=0; fi
        limit=$(idle_minutes)
        if [ "$limit" != 0 ] && [ "$idle" -ge "$limit" ]; then
            stop
            break
        fi
        sleep 60
    done
    rm -f "$watch_pid"
}

stop() {
    nmcli connection down "$con"
    [ -e /sys/class/net/ap0 ] && $admin ap-down
    $powersave release hotspot
    notify-send Hotspot Off
}

restart() { nmcli connection down "$con"; start; }

toggle() {
    case "$(state)" in
        activated|activating) in_background "$0" --stop ;;
        *) in_background "$0" --start ;;
    esac
}

# A changed name or password applies on the next start.
restart_if_active() {
    [ "$(state)" = activated ] && in_background "$0" --restart
}

case "${1:-}" in
    --start) start; exit ;;
    --stop) stop; exit ;;
    --restart) restart; exit ;;
    --watch) watch_idle; exit ;;
esac

set_name() {
    clear_screen
    read -rp "Network name: " v
    [ -n "$v" ] || return
    nmcli connection modify "$con" 802-11-wireless.ssid "$v" && restart_if_active
}

set_password() {
    clear_screen
    read -rp "Password (8 characters or more): " v
    if [ "${#v}" -lt 8 ]; then
        echo "Too short: not changed."
        pause
        return
    fi
    nmcli connection modify "$con" wifi-sec.psk "$v" && restart_if_active
}

# A list of choices, the current one marked, the highlighted one explained
# in a preview (info); the key picked on stdout, nothing for Esc or Left.
choose_one() {                  # choose_one PROMPT WHAT CURRENT
    { printf 'back\t← back\n'
      awk -F'\t' -v cur="$3" '{ print $1 "\t" ($1 == cur ? "● " : "  ") $2 }'; } |
        fzf --listen="$sock" --delimiter='\t' --with-nth=2 --prompt="$1 > " \
            --layout=reverse-list --no-info --cycle --margin=1,2 \
            --color=16,gutter:-1 --bind='load:pos(2)' --bind='left:abort' --bind='right:accept' \
            --preview="$0 --info $2 {1}" --preview-window=right,50%,wrap,border-left \
            --bind='start,resize:transform:echo "change-preview-window(right,$((FZF_COLUMNS / 2 + 3)),wrap,border-left)"' |
        cut -f1 | sed '/^back$/d'
}
info() {                        # info WHAT KEY
    case "$1:$2" in
        band:bg) echo "2.4 GHz: reaches further and through walls, and every device has it; slower, and crowded where many networks are." ;;
        band:a)
            echo "5 GHz: faster and less crowded, shorter reach; some older devices (and some cars) lack it.  Channel 36."
            echo
            echo "Beside a Wi-Fi network the hotspot takes that network's band and channel (one radio, one channel for both).  On a radar channel (52–144, common on home routers) none may start: it keeps its own band, on channel 36, or 149 beside a network on 36–64." ;;
        keep:no) echo "Starting the hotspot drops the Wi-Fi network in use; devices get the mobile data." ;;
        keep:yes)
            echo "A Wi-Fi network in use stays up, and devices get its internet (e.g. a phone's hotspot as the uplink, the car on the Pro¹x's).  The hotspot takes the network's channel: about a third of its speed.  Beside a network on a radar channel it takes one of its own, and the radio shares its time between the two: slower, with longer delays.  Wi-Fi power saving is off while it runs."
            echo
            echo "Without a network, mobile data, and Wi-Fi stays free to join one meanwhile." ;;
        hidden:no) echo "The name is broadcast: devices list the hotspot." ;;
        hidden:yes) echo "The name is not broadcast: a device joins by typing it (or by the QR code).  It hides little: the name still travels when devices connect." ;;
        idle:0) echo "The hotspot stays on until turned off." ;;
        idle:*) echo "The hotspot turns itself off after $2 minutes without a device." ;;
    esac
}
pick_band() {
    # Channel 36 is open to access points in most countries and allows
    # more power than the channel NetworkManager picks by itself.
    b=$(printf '%s\t%s\n' bg "2.4 GHz" a "5 GHz" |
            choose_one band band "$(if [ "$(band)" = a ]; then echo a; else echo bg; fi)")
    case "$b" in
        a) ch=36 ;;
        bg) ch= ;;
        *) return ;;
    esac
    # On ap0 the connection may have another channel: the choice is kept
    # for the next start, which places it again.
    if [ -f "$saved_band" ]; then
        echo "$b $ch" > "$saved_band"
        restart_if_active
    else
        nmcli connection modify "$con" 802-11-wireless.band "$b" \
              802-11-wireless.channel "$ch" && restart_if_active
    fi
}
pick_keep() {
    k=$(printf '%s\t%s\n' no "Off, mobile data" yes "On, a Wi-Fi network in use stays the uplink" |
            choose_one "keep Wi-Fi" keep "$(keep_wifi)")
    [ -n "$k" ] || return
    mkdir -p "$statedir"
    echo "$k" > "$keep_file"
    restart_if_active
}
pick_hidden() {
    h=$(printf '%s\t%s\n' no "No, the name broadcast" yes "Yes, the name not broadcast" |
            choose_one hidden hidden "$(if [ "$(hidden)" = yes ]; then echo yes; else echo no; fi)")
    [ -n "$h" ] || return
    nmcli connection modify "$con" 802-11-wireless.hidden "$h" && restart_if_active
}
pick_idle() {
    m=$(printf '%s\t%s\n' 0 never 5 "5 min idle" 15 "15 min idle" 30 "30 min idle" |
            choose_one auto-off idle "$(idle_minutes)")
    [ -n "$m" ] || return
    mkdir -p "$statedir"
    echo "$m" > "$idle_file"
}
# For the previews of choose_one.
# Fixed help in a preview, reflowed narrower than the pane, so that it
# reads as a column rather than wrapped at its edge (author, 2026-11-25).
narrow() {
    w=$(( ${FZF_PREVIEW_COLUMNS:-64} - 4 ))
    [ "$w" -gt 60 ] && w=60; [ "$w" -lt 20 ] && w=20
    fmt -w "$w"
}
[ "${1:-}" = --info ] && { info "${2:-}" "${3:-}" | narrow; exit; }

# One line per device, connected or banned: MAC, tab, what is shown.
client_lines() {
    macs=$(iw dev "$iface" station dump 2>/dev/null | awk '/^Station/ { print $2 }')
    leases=$($admin leases)
    for m in $(printf '%s\n' $macs $(cat "$banned" 2>/dev/null) | sort -u); do
        lease=$(printf '%s\n' "$leases" | awk -v m="$m" '$2 == m { print $3, $4 }')
        ip=${lease%% *} name=${lease##* }
        [ -n "$lease" ] || { ip=-; name=-; }
        [ "$name" != "*" ] || name=-
        if grep -qxF "$m" "$banned" 2>/dev/null; then note=banned; else note=; fi
        printf '%s\t%-20s %-15s %s  %s\n' "$m" "$name" "$ip" "$m" "$note"
    done
}

ip_of() { $admin leases | awk -v m="$1" '$2 == m { print $3 }'; }

client_action() {               # client_action MAC
    if grep -qxF "$1" "$banned" 2>/dev/null; then
        actions=$'← back\nunban'
    elif [ -n "$(ip_of "$1")" ]; then
        actions=$'← back\nstream\nexpel\nban'
    else
        actions=$'← back\nexpel\nban'
    fi
    a=$(printf '%s\n' "$actions" |
        fzf --listen="$sock" --bind='left:abort' --bind='right:accept' --reverse --cycle --margin='1,2,1,2' \
            --color='16,gutter:-1' --header="$1")
    case "$a" in ""|"← back") return ;; esac
    if [ "$a" = stream ]; then
        PRO1X_TOOL_SOCK="$sock" pro1x-stream --to "$(ip_of "$1")"
    else
        $admin "$a" "$1" || pause
    fi
}

show_clients() {
    while :; do
        pick=$({ printf 'back\t← back\n'; client_lines; } |
            fzf --listen="$sock" --bind='left:abort' --bind='right:accept' --delimiter='\t' --with-nth=2 --reverse \
                --cycle --margin='1,2,1,2' --color='16,gutter:-1' \
                --header="Name                 IP              MAC" \
                --bind='load:pos(2)' |
            cut -f1)
        case "$pick" in ""|back) return ;; esac
        client_action "$pick"
    done
}

ensure || { echo "Could not create the hotspot connection."; pause; exit 1; }

# The QR code beside the list in landscape, below it in portrait.
qr_pane='[ {1} = qr ] || { echo hide-preview; exit; }
         if [ "$FZF_COLUMNS" -gt $((FZF_LINES * 2)) ]; then
             echo "change-preview-window(right,$((FZF_COLUMNS * 60 / 100 + 3)),border-left)+show-preview"
         else
             echo "change-preview-window(down,60%,border-top)+show-preview"
         fi'

while :; do
    choice=$(menu_lines |
        fzf --listen="$sock" --bind='left:abort' --bind='right:accept' --delimiter='\t' --with-nth=2 --prompt='hotspot > ' \
            --layout=reverse-list --no-info --cycle --margin=1,2 \
            --color=16,gutter:-1 --ansi \
            --preview="$0 --qr" --preview-window=hidden \
            --bind='load:pos(2)' \
            --bind="focus:transform:$qr_pane" \
            --bind="resize:transform:$qr_pane" |
        cut -f1)
    case "$choice" in
        toggle) toggle ;;
        name) set_name ;;
        password) set_password ;;
        band) pick_band ;;
        hidden) pick_hidden ;;
        idle) pick_idle ;;
        keep) pick_keep ;;
        data) ;;                  # redrawn by the loop
        qr) ;;                    # in the preview
        clients) show_clients ;;
        *) break ;;
    esac
done
: > "$rt/pro1x-tool.done"
