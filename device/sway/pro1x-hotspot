#!/usr/bin/env bash
# pro1x-hotspot — share mobile data over Wi-Fi: on or off, the network name and
# password, the band, a hidden name, auto-off when idle, the data used, a QR
# code for others to join, and the connected devices, which can be expelled,
# banned, or sent the screen.  Opened by Enter or Right on the Hotspot line of
# sway-quick-actions, inside its window.
#
# It is a NetworkManager connection in shared mode.  wlan0 cannot be a client
# at the same time here, so starting it drops the Wi-Fi network in use, and the
# internet it shares comes from mobile data.
#
# State: on and off, the name and password confirmed by the author 2026-11-09.
# A 5 GHz hotspot starts (channel 149, 2026-11-18).  While the phone is a
# Wi-Fi client, the access point's country beacon closes every 5 GHz channel
# ("no IR"), so the band can only be checked once the client link is dropped.
# The device list, expel, ban, band, hidden, auto-off and data used are not yet
# run on the phone.

case "${FZF_DEFAULT_OPTS:-}" in
    *--with-shell=*) ;;
    *) export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:+$FZF_DEFAULT_OPTS }--with-shell='sh -c'" ;;
esac

rt="${XDG_RUNTIME_DIR:-/tmp}"
sock="${PRO1X_TOOL_SOCK:-$rt/pro1x-tool.sock}"
con=pro1x-hotspot
iface=wlan0
banned=/var/lib/pro1x-hotspot/banned
statedir="${XDG_STATE_HOME:-$HOME/.local/state}/pro1x"
idle_file="$statedir/hotspot-idle"      # minutes without a device, 0 for never
watch_pid="$rt/pro1x-hotspot-watch.pid"
data_base="$rt/pro1x-hotspot-data"      # the byte count when it started
admin="/run/privileged/bin/sudo -n /run/current-system/profile/bin/pro1x-hotspot-admin"

state() { nmcli -g GENERAL.STATE connection show "$con" 2>/dev/null; }
exists() { nmcli -t -f NAME connection show | grep -qx "$con"; }
ssid() { nmcli -e no -g 802-11-wireless.ssid connection show "$con"; }
psk() { nmcli -s -e no -g 802-11-wireless-security.psk connection show "$con"; }
band() { nmcli -e no -g 802-11-wireless.band connection show "$con"; }
hidden() { nmcli -e no -g 802-11-wireless.hidden connection show "$con"; }
idle_minutes() { cat "$idle_file" 2>/dev/null || echo 0; }
stations() { iw dev "$iface" station dump 2>/dev/null | grep -c '^Station'; }

bytes_now() {
    n=/sys/class/net/$iface/statistics
    echo $(($(cat "$n/rx_bytes") + $(cat "$n/tx_bytes")))
}

data_used() {                   # since this start, or - when off
    [ "$(state)" = activated ] && [ -f "$data_base" ] || { echo -; return; }
    numfmt --to=iec --suffix=B $(($(bytes_now) - $(cat "$data_base")))
}

menu_lines() {
    case "$(state)" in
        activated) s=on ;;
        activating) s=starting… ;;
        deactivating) s=stopping… ;;
        *) s=off ;;
    esac
    printf '%s\t%s\n' \
        back "← back" \
        toggle "Hotspot:   $s" \
        name "Name:      $(ssid)" \
        password "Password:  $(psk)" \
        band "Band:      $(if [ "$(band)" = a ]; then echo 5 GHz; else echo 2.4 GHz; fi)" \
        hidden "Hidden:    $(if [ "$(hidden)" = yes ]; then echo yes; else echo no; fi)" \
        idle "Auto-off:  $(if [ "$(idle_minutes)" = 0 ]; then echo never; else echo "$(idle_minutes) min idle"; fi)" \
        data "Data used: $(data_used)" \
        qr "QR code to join" \
        clients "Connected devices"
}

qr_fit() {                      # qr_fit TEXT: as the stream menu's
    # In quick actions' own window (foot draws sixel images): an image at
    # a whole number of pixels per module, the largest that fits the pane,
    # from the cell's size (the window's pixels over fzf's size in cells).
    # Elsewhere (SSH, tmux), text: the cell's size is not known there.
    case "${PRO1X_TOOL_SOCK:-}" in
        *quick-actions*)
            set -- "$1" $(swaymsg -t get_tree -r 2>/dev/null | jq -r '
                .. | objects | select(.focused? == true) | "\(.rect.width) \(.rect.height)"' | head -1) \
                $(swaymsg -t get_outputs -r 2>/dev/null | jq -r '.[] | select(.focused) | .scale')
            if [ -n "${3:-}" ] && [ -n "${FZF_COLUMNS:-}" ] && [ -n "${FZF_LINES:-}" ]; then
                px=$(awk -v w="$2" -v h="$3" -v s="${4:-1}" -v c="$FZF_COLUMNS" -v l="$FZF_LINES" \
                         -v pc="${FZF_PREVIEW_COLUMNS:-40}" -v pl="${FZF_PREVIEW_LINES:-20}" '
                         BEGIN { cw = w * s / c; ch = h * s / l
                                 a = (pc - 2) * cw; b = (pl - 1) * ch
                                 print int(a < b ? a : b) }')
                modules=$(qrencode -t ASCII -m 1 -l L "$1" | wc -l)
                k=$(( px / modules ))
                if [ "$k" -ge 1 ]; then
                    qrencode -t PNG -s "$k" -m 1 -l L -o - "$1" | convert png:- sixel:-
                    return
                fi
            fi ;;
    esac
    qrencode -t UTF8 -m 1 -l L "$1"
}

# The QR code to join: the WIFI: format escapes these with a backslash.  The
# lowest error correction and margin make the smallest code.
print_qr() {
    esc() { printf '%s' "$1" | sed 's/[\\;,:"]/\\&/g'; }
    s=$(ssid) p=$(psk)
    h=; [ "$(hidden)" = yes ] && h="H:true;"
    # In half-block characters, as the stream menu's: an image sized from
    # the phone's focused window overflowed the pane elsewhere (SSH, tmux).
    qr_fit "WIFI:T:WPA;S:$(esc "$s");P:$(esc "$p");$h;"
}

# fzf reloads the menu after a background start or stop, and asks for the QR
# code for its preview.
[ "${1:-}" = --menu ] && { menu_lines; exit; }
[ "${1:-}" = --qr ] && { print_qr; exit; }

trap 'rm -f "$rt/pro1x-tool.done"' EXIT

clear_screen() { printf '\033[H\033[2J\033[3J'; }
pause() { printf '\nPress any key to go back.\n'; read -rsn1; }

# The first start makes the connection, with a random password.
ensure() {
    exists && return
    nmcli connection add type wifi ifname "$iface" con-name "$con" \
        autoconnect no ssid Pro1x wifi.mode ap wifi.band bg \
        ipv4.method shared ipv6.method ignore \
        wifi-sec.key-mgmt wpa-psk wifi-sec.proto rsn \
        wifi-sec.pairwise ccmp wifi-sec.group ccmp \
        wifi-sec.psk "$(LC_ALL=C tr -dc 'a-km-z2-9' < /dev/urandom | head -c 14)" \
        > /dev/null
}

# in_background COMMAND...: run it detached, so the menu stays usable, then
# tell the menu to redraw.  It outlives this window.
in_background() {
    setsid bash -c '
        "$@"
        curl -s -m 5 --unix-socket "'"$sock"'" -X POST http://localhost \
             -d "reload('"$0"' --menu)"
    ' "$0" "$@" > /dev/null 2>&1 < /dev/null &
}

start() {
    nmcli connection up "$con" || {
        if [ "$(band)" = a ]; then
            notify-send -u critical Hotspot \
                "Could not start on 5 GHz: try 2.4 GHz"
        else
            notify-send -u critical Hotspot "Could not start"
        fi
        return 1; }
    $admin apply
    bytes_now > "$data_base"
    # The old watcher ends with the old connection; this makes sure of it.
    [ -f "$watch_pid" ] && kill "$(cat "$watch_pid")" 2>/dev/null
    setsid "$0" --watch > /dev/null 2>&1 < /dev/null &
    notify-send Hotspot "On: $(ssid)"
}

# Turns the hotspot off after the set minutes with no device connected.
watch_idle() {
    echo $$ > "$watch_pid"
    idle=0
    while [ "$(state)" = activated ]; do
        if [ "$(stations)" = 0 ]; then idle=$((idle + 1)); else idle=0; fi
        limit=$(idle_minutes)
        if [ "$limit" != 0 ] && [ "$idle" -ge "$limit" ]; then
            stop
            break
        fi
        sleep 60
    done
    rm -f "$watch_pid"
}

stop() { nmcli connection down "$con"; notify-send Hotspot Off; }

restart() { nmcli connection down "$con"; start; }

toggle() {
    case "$(state)" in
        activated|activating) in_background "$0" --stop ;;
        *) in_background "$0" --start ;;
    esac
}

# A changed name or password applies on the next start.
restart_if_active() {
    [ "$(state)" = activated ] && in_background "$0" --restart
}

case "${1:-}" in
    --start) start; exit ;;
    --stop) stop; exit ;;
    --restart) restart; exit ;;
    --watch) watch_idle; exit ;;
esac

set_name() {
    clear_screen
    read -rp "Network name: " v
    [ -n "$v" ] || return
    nmcli connection modify "$con" 802-11-wireless.ssid "$v" && restart_if_active
}

set_password() {
    clear_screen
    read -rp "Password (8 characters or more): " v
    if [ "${#v}" -lt 8 ]; then
        echo "Too short: not changed."
        pause
        return
    fi
    nmcli connection modify "$con" wifi-sec.psk "$v" && restart_if_active
}

# A list of choices, the current one marked, the highlighted one explained
# in a preview (info); the key picked on stdout, nothing for Esc or Left.
choose_one() {                  # choose_one PROMPT WHAT CURRENT
    { printf 'back\t← back\n'
      awk -F'\t' -v cur="$3" '{ print $1 "\t" ($1 == cur ? "● " : "  ") $2 }'; } |
        fzf --listen="$sock" --delimiter='\t' --with-nth=2 --prompt="$1 > " \
            --layout=reverse-list --no-info --cycle --margin=1,2 \
            --color=16,gutter:-1 --bind='load:pos(2)' --bind='left:abort' --bind='right:accept' \
            --preview="$0 --info $2 {1}" --preview-window=right,50%,wrap,border-left |
        cut -f1 | sed '/^back$/d'
}
info() {                        # info WHAT KEY
    case "$1:$2" in
        band:bg) printf '%s\n' "2.4 GHz: reaches further and through walls, and every" \
                     "device has it; slower, and crowded where many networks are." ;;
        band:a)
            printf '%s\n' "5 GHz: faster and less crowded, shorter reach; some older" \
                "devices (and some cars) lack it.  Channel 36." ;;
        hidden:no) echo "The name is broadcast: devices list the hotspot." ;;
        hidden:yes) printf '%s\n' "The name is not broadcast: a device joins by typing it" \
                        "(or by the QR code).  It hides little: the name still" \
                        "travels when devices connect." ;;
        idle:0) echo "The hotspot stays on until turned off." ;;
        idle:*) echo "The hotspot turns itself off after $2 minutes without a device." ;;
    esac
}
pick_band() {
    # Channel 36 is open to access points in most countries and allows
    # more power than the channel NetworkManager picks by itself.
    b=$(printf '%s\t%s\n' bg "2.4 GHz" a "5 GHz" |
            choose_one band band "$(if [ "$(band)" = a ]; then echo a; else echo bg; fi)")
    case "$b" in
        a) ch=36 ;;
        bg) ch= ;;
        *) return ;;
    esac
    nmcli connection modify "$con" 802-11-wireless.band "$b" \
          802-11-wireless.channel "$ch" && restart_if_active
}
pick_hidden() {
    h=$(printf '%s\t%s\n' no "No, the name broadcast" yes "Yes, the name not broadcast" |
            choose_one hidden hidden "$(if [ "$(hidden)" = yes ]; then echo yes; else echo no; fi)")
    [ -n "$h" ] || return
    nmcli connection modify "$con" 802-11-wireless.hidden "$h" && restart_if_active
}
pick_idle() {
    m=$(printf '%s\t%s\n' 0 never 5 "5 min idle" 15 "15 min idle" 30 "30 min idle" |
            choose_one auto-off idle "$(idle_minutes)")
    [ -n "$m" ] || return
    mkdir -p "$statedir"
    echo "$m" > "$idle_file"
}
# For the previews of choose_one.
[ "${1:-}" = --info ] && { info "${2:-}" "${3:-}"; exit; }

# One line per device, connected or banned: MAC, tab, what is shown.
client_lines() {
    macs=$(iw dev "$iface" station dump 2>/dev/null | awk '/^Station/ { print $2 }')
    leases=$($admin leases)
    for m in $(printf '%s\n' $macs $(cat "$banned" 2>/dev/null) | sort -u); do
        lease=$(printf '%s\n' "$leases" | awk -v m="$m" '$2 == m { print $3, $4 }')
        ip=${lease%% *} name=${lease##* }
        [ -n "$lease" ] || { ip=-; name=-; }
        [ "$name" != "*" ] || name=-
        if grep -qxF "$m" "$banned" 2>/dev/null; then note=banned; else note=; fi
        printf '%s\t%-20s %-15s %s  %s\n' "$m" "$name" "$ip" "$m" "$note"
    done
}

ip_of() { $admin leases | awk -v m="$1" '$2 == m { print $3 }'; }

client_action() {               # client_action MAC
    if grep -qxF "$1" "$banned" 2>/dev/null; then
        actions=$'← back\nunban'
    elif [ -n "$(ip_of "$1")" ]; then
        actions=$'← back\nstream\nexpel\nban'
    else
        actions=$'← back\nexpel\nban'
    fi
    a=$(printf '%s\n' "$actions" |
        fzf --listen="$sock" --bind='left:abort' --bind='right:accept' --reverse --cycle --margin='1,2,1,2' \
            --color='16,gutter:-1' --header="$1")
    case "$a" in ""|"← back") return ;; esac
    if [ "$a" = stream ]; then
        PRO1X_TOOL_SOCK="$sock" pro1x-stream --to "$(ip_of "$1")"
    else
        $admin "$a" "$1" || pause
    fi
}

show_clients() {
    while :; do
        pick=$({ printf 'back\t← back\n'; client_lines; } |
            fzf --listen="$sock" --bind='left:abort' --bind='right:accept' --delimiter='\t' --with-nth=2 --reverse \
                --cycle --margin='1,2,1,2' --color='16,gutter:-1' \
                --header="Name                 IP              MAC" \
                --bind='load:pos(2)' |
            cut -f1)
        case "$pick" in ""|back) return ;; esac
        client_action "$pick"
    done
}

ensure || { echo "Could not create the hotspot connection."; pause; exit 1; }

# The QR code beside the list in landscape, below it in portrait.
qr_pane='[ {1} = qr ] || { echo hide-preview; exit; }
         if [ "$FZF_COLUMNS" -gt $((FZF_LINES * 2)) ]; then
             echo "change-preview-window(right,60%)+show-preview"
         else
             echo "change-preview-window(down,60%)+show-preview"
         fi'

while :; do
    choice=$(menu_lines |
        fzf --listen="$sock" --bind='left:abort' --bind='right:accept' --delimiter='\t' --with-nth=2 --prompt='hotspot > ' \
            --layout=reverse-list --no-info --cycle --margin=1,2 \
            --color=16,gutter:-1 --ansi \
            --preview="$0 --qr" --preview-window=hidden \
            --bind='load:pos(2)' \
            --bind="focus:transform:$qr_pane" \
            --bind="resize:transform:$qr_pane" |
        cut -f1)
    case "$choice" in
        toggle) toggle ;;
        name) set_name ;;
        password) set_password ;;
        band) pick_band ;;
        hidden) pick_hidden ;;
        idle) pick_idle ;;
        data) ;;                  # redrawn by the loop
        qr) ;;                    # in the preview
        clients) show_clients ;;
        *) break ;;
    esac
done
: > "$rt/pro1x-tool.done"
