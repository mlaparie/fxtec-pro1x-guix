#!/usr/bin/env bash
# pro1x-hotspot-admin — what pro1x-hotspot needs root for, allowed without a
# password in sudoers (system/mobile.scm).  Its arguments are checked here.
#
#   expel MAC   disconnect a device; it may join again
#   ban MAC     expel it and drop everything it sends
#   unban MAC
#   apply       set the rules from the saved list (at each hotspot start)
#   leases      print the devices' DHCP leases, in a directory only root reads
#   ap-up       make ap0, the hotspot's interface beside a Wi-Fi network
#               (pro1x-hotspot), with an address of its own; NetworkManager
#               does not connect it to networks by itself
#   ap-down     remove it
#
# A banned device can still associate, since NetworkManager has no access list
# for an access point.  Its traffic is dropped by nftables, matched on its MAC;
# the kernel has no netdev family, so this is an inet table.
#
# State: not yet run on the phone.

set -eu
PATH=/run/current-system/profile/bin:$PATH

# The hotspot's interface: ap0 beside a Wi-Fi network, else wlan0.
iface=wlan0
[ -e /sys/class/net/ap0 ] && iface=ap0
dir=/var/lib/pro1x-hotspot
banned=$dir/banned

check_mac() {
    [[ "$1" =~ ^[0-9a-f]{2}(:[0-9a-f]{2}){5}$ ]] ||
        { echo "not a MAC address: $1" >&2; exit 2; }
}

apply() {
    nft delete table inet pro1x_hotspot 2>/dev/null || true
    [ -s "$banned" ] || return 0
    elements=$(paste -sd, "$banned")
    nft -f - <<EOF
table inet pro1x_hotspot {
    set banned { type ether_addr; elements = { $elements } }
    chain input { type filter hook input priority -300; ether saddr @banned drop }
    chain forward { type filter hook forward priority -300; ether saddr @banned drop }
}
EOF
}

mkdir -p "$dir"
case "${1:-}" in
    expel)
        check_mac "${2:-}"
        iw dev "$iface" station del "$2" ;;
    ban)
        check_mac "${2:-}"
        grep -qxF "$2" "$banned" 2>/dev/null || echo "$2" >> "$banned"
        apply
        iw dev "$iface" station del "$2" 2>/dev/null || true ;;
    unban)
        check_mac "${2:-}"
        grep -vxF "$2" "$banned" > "$banned.new" || true
        mv "$banned.new" "$banned"
        apply ;;
    apply) apply ;;
    leases) cat "/var/lib/NetworkManager/dnsmasq-$iface.leases" 2>/dev/null || true ;;
    ap-up)
        if [ ! -e /sys/class/net/ap0 ]; then
            # wlan0's address with its last byte changed, local and unicast:
            # wlan0's own (a random local one already) made both fail.
            mac=$(cat /sys/class/net/wlan0/address)
            mac=${mac%:*}:$(printf '%02x' $(( 0x${mac##*:} ^ 0x01 )))
            mac=$(printf '%02x' $(( (0x${mac%%:*} | 2) & 0xfe ))):${mac#*:}
            iw dev wlan0 interface add ap0 type __ap addr "$mac"
            sleep 1
        fi
        nmcli device set ap0 autoconnect no ;;
    ap-down)
        [ -e /sys/class/net/ap0 ] && iw dev ap0 del
        true ;;
    *) echo "usage: pro1x-hotspot-admin expel|ban|unban MAC, apply, leases, ap-up, ap-down" >&2; exit 2 ;;
esac
