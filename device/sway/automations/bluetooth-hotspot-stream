#!/usr/bin/env bash
# A Bluetooth device connects: the hotspot and the stream start on it.
#
# For a car's screen: while the car is connected over Bluetooth, the phone
# runs its hotspot and streams its screen there.  The stream stops when the
# device leaves; the hotspot stays on until its own idle timer ends it.
# Set device below to the name `bluetoothctl devices' shows.

device="My car"
address=10.42.0.1               # NetworkManager's address on the hotspot

mac_of() {
    bluetoothctl devices | while read -r _ mac name; do
        [ "$name" = "$device" ] && echo "$mac"
    done
}
connected() { bluetoothctl info "$1" 2>/dev/null | grep -q 'Connected: yes'; }
hotspot_on() { [ "$(nmcli -g GENERAL.STATE connection show pro1x-hotspot 2>/dev/null)" = activated ]; }

start() {
    echo "$(date +%T) $device connected"
    hotspot_on || pro1x-hotspot --start
    for _ in $(seq 30); do
        ip -4 -o addr show wlan0 | grep -q " $address/" && break
        sleep 1
    done
    pro1x-stream --interactive "$address" || echo "$(date +%T) stream did not start"
}

stop() {
    echo "$(date +%T) $device disconnected"
    pro1x-stream --stop
}

trap '[ -n "$on" ] && stop; exit' TERM
on=
while sleep 5; do
    mac=${mac:-$(mac_of)}
    [ -n "$mac" ] || continue
    if connected "$mac"; then
        [ -n "$on" ] || { start; on=1; }
    elif [ -n "$on" ]; then
        stop
        on=
    fi
done
