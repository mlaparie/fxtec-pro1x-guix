#!/usr/bin/env python3
# pro1x-nfc-emulate: present a stored NDEF message as an NFC Forum Type-4 tag,
# so a reader (or another phone) reads it from the phone.  Unlike UID replay
# (pro1x-nfc-listen), this answers the reader's ISO 14443-4 APDUs.
#
#   pro1x-nfc-emulate NDEFFILE [--uid HEX] [--sak HEX]
#
# NDEFFILE is a raw NDEF message (the bytes of the records, no NLEN prefix).
#
# How it works (confirmed engaging on the device 2026-11-28):
#   Listen is set up through the nci_cmd control node (pro1x-nfc-replay.patch),
#   in RFST_IDLE: CORE_SET_CONFIG (SEL_INFO with the ISO-DEP bit),
#   RF_SET_LISTEN_MODE_ROUTING (NFC-A -> Device Host), RF_DISCOVER_MAP
#   (ISO-DEP listen -> the ISO_DEP interface), RF_DISCOVER listen-A.  The
#   controller then does anticollision and RATS/ATS itself and, once the
#   reader activates ISO-DEP, delivers the reader's APDUs to the host as NCI
#   DATA packets through /dev/nxp-nci (pro1x-nfc-data.patch); this script
#   answers them (SELECT NDEF app, SELECT CC/NDEF file, ReadBinary) and the
#   controller frames the responses back to the reader.  Because the ISO_DEP
#   interface handles the ISO-DEP layer, the APDUs arrive and leave BARE (no
#   RATS, no I-block PCB, no CRC -- the controller adds those and handles the
#   frame-waiting-time extension).
#
# Scope: Type-4 / ISO-DEP (NDEF) tags only.  The PN557 cannot emulate Type-2
# (e.g. a Mifare Ultralight / the RR badge, SAK 0x00) or any crypto card.
#
# State: 2026-11-28.  Setup + engagement (RF_INTF_ACTIVATED on a reader tap,
# the reader's SELECT APDU delivered to the host) confirmed on gen 297; the
# full NDEF answer loop is not yet confirmed end to end.  Needs the CI kernel
# with pro1x-nfc-replay.patch and pro1x-nfc-data.patch.  The APDU logic is
# unit-tested in isolation.
import glob
import os
import sys

# --- NCI control setup, through the nci_cmd sysfs node ----------------------

SET_CONFIG = (0x20, 0x02)
SET_ROUTING = (0x21, 0x01)
DISCOVER_MAP = (0x21, 0x00)
RF_DISCOVER = (0x21, 0x03)
RF_DEACTIVATE = (0x21, 0x06)
# Route NFC-A to the Device Host (more=0, 1 entry: tech, len3, DH, power, A).
ROUTING = (0x00, 0x01, 0x00, 0x03, 0x00, 0x01, 0x00)
# Map ISO-DEP listen (proto 0x04, mode 0x02) to the ISO_DEP interface (0x02).
MAP = (0x01, 0x04, 0x02, 0x02)
# RF_DISCOVER: 1 entry, listen NFC-A passive (0x80), frequency 1.
DISCOVER = (0x01, 0x80, 0x01)


def nci_node():
    for n in glob.glob("/sys/class/nfc/nfc*/device/nci_cmd"):
        return n
    sys.exit("pro1x-nfc-emulate: no nci_cmd node (kernel without the patches)")


def nci_cmd(path, gid_oid, payload, tolerant=False):
    gid, oid = gid_oid
    frame = bytes((gid, oid, len(payload))) + bytes(payload)
    try:
        with open(path, "w") as f:
            f.write(frame.hex())
        with open(path) as f:
            return int(f.read().strip() or "0")
    except OSError as e:
        # Routing and map have no kernel rsp handler, so their writes time out
        # (-110) though the controller accepted them; tolerate that.
        if tolerant:
            return None
        sys.exit("pro1x-nfc-emulate: %s: %s" % (path, e))


def setup_listen(path, uid, sak):
    params = bytearray([4])
    params += bytes((0x30, 1, 0x08))          # LA_BIT_FRAME_SDD
    params += bytes((0x31, 1, 0x03))          # LA_PLATFORM_CONFIG
    params += bytes((0x32, 1, sak | 0x20))    # LA_SEL_INFO: ISO-DEP
    params += bytes((0x33, len(uid))) + uid   # LA_NFCID1
    nci_cmd(path, RF_DEACTIVATE, (0x00,), tolerant=True)   # ensure idle
    st = nci_cmd(path, SET_CONFIG, params)
    if st != 0:
        sys.exit("pro1x-nfc-emulate: CORE_SET_CONFIG rejected (status %s)" % st)
    nci_cmd(path, SET_ROUTING, ROUTING, tolerant=True)
    nci_cmd(path, DISCOVER_MAP, MAP, tolerant=True)
    st = nci_cmd(path, RF_DISCOVER, DISCOVER)
    if st != 0:
        sys.exit("pro1x-nfc-emulate: RF_DISCOVER rejected (status %s)" % st)


def stop_listen(path):
    nci_cmd(path, RF_DEACTIVATE, (0x00,), tolerant=True)   # to idle


# --- Type-4 tag model -------------------------------------------------------

AID = bytes.fromhex("D2760000850101")   # NFC Forum NDEF Tag Application
CC_FILE_ID = bytes.fromhex("E103")
NDEF_FILE_ID = bytes.fromhex("E104")
SW_OK = bytes((0x90, 0x00))
SW_NOT_FOUND = bytes((0x6A, 0x82))
SW_WRONG_P1P2 = bytes((0x6A, 0x86))
SW_CLA = bytes((0x6E, 0x00))


class Type4Tag:
    """A read-only NFC Forum Type-4 tag holding one NDEF message."""

    def __init__(self, ndef_message):
        ndef_file = len(ndef_message).to_bytes(2, "big") + ndef_message
        self.ndef_file = ndef_file
        nmax = max(len(ndef_file), 0x000F)
        # Capability Container: CCLEN, mapping 2.0, MLe, MLc, NDEF-file ctrl TLV
        self.cc_file = (
            (0x000F).to_bytes(2, "big") + b"\x20" +
            (0x003B).to_bytes(2, "big") + (0x0034).to_bytes(2, "big") +
            b"\x04\x06" + NDEF_FILE_ID + nmax.to_bytes(2, "big") +
            b"\x00\xff"          # read allowed, write denied
        )
        self.selected = None

    def _read(self, data, offset, length):
        return data[offset:offset + length] + SW_OK

    def apdu(self, a):
        """Answer one bare C-APDU with its R-APDU (bytes)."""
        if len(a) < 4:
            return SW_WRONG_P1P2
        cla, ins, p1, p2 = a[0], a[1], a[2], a[3]
        if cla != 0x00:
            return SW_CLA
        if ins == 0xA4:                                   # SELECT
            lc = a[4] if len(a) > 4 else 0
            data = a[5:5 + lc]
            if p1 == 0x04:                                # by name (AID)
                return SW_OK if data == AID else SW_NOT_FOUND
            if p1 == 0x00 and p2 == 0x0C and lc == 2:     # by file id
                if data == CC_FILE_ID:
                    self.selected = "cc"; return SW_OK
                if data == NDEF_FILE_ID:
                    self.selected = "ndef"; return SW_OK
                return SW_NOT_FOUND
            return SW_WRONG_P1P2
        if ins == 0xB0:                                   # READ BINARY
            offset = (p1 << 8) | p2
            le = a[4] if len(a) > 4 else 0
            if self.selected == "cc":
                return self._read(self.cc_file, offset, le)
            if self.selected == "ndef":
                return self._read(self.ndef_file, offset, le)
            return SW_NOT_FOUND
        return bytes((0x6D, 0x00))                         # INS not supported


# --- main loop --------------------------------------------------------------

def run(dev, tag):
    # With the ISO_DEP interface, each NCI DATA packet carries a bare C-APDU
    # after the 3-byte header; the response goes back the same way, on the
    # packet's connection id.  The controller does the ISO-DEP framing.
    fd = os.open(dev, os.O_RDWR)
    try:
        while True:
            pkt = os.read(fd, 300)
            if not pkt or len(pkt) < 3:
                continue
            conn = pkt[0] & 0x0f
            plen = pkt[2]
            apdu = pkt[3:3 + plen]
            resp = tag.apdu(apdu)
            os.write(fd, bytes((conn, 0x00, len(resp))) + resp)
    except KeyboardInterrupt:
        pass
    finally:
        os.close(fd)


def main():
    args = sys.argv[1:]
    uid = bytes((0x08, 0x01, 0x02, 0x03))        # random-UID prefix (0x08)
    sak = 0x20
    ndef_path = None
    i = 0
    while i < len(args):
        if args[i] == "--uid" and i + 1 < len(args):
            uid = bytes.fromhex(args[i + 1].replace(":", "")); i += 2
        elif args[i] == "--sak" and i + 1 < len(args):
            sak = bytes.fromhex(args[i + 1])[0]; i += 2
        else:
            ndef_path = args[i]; i += 1
    if not ndef_path:
        sys.exit("usage: pro1x-nfc-emulate NDEFFILE [--uid HEX] [--sak HEX]")
    if len(uid) not in (4, 7):
        sys.exit("pro1x-nfc-emulate: UID must be 4 or 7 bytes")

    with open(ndef_path, "rb") as f:
        ndef = f.read()
    tag = Type4Tag(ndef)

    node = nci_node()
    setup_listen(node, uid, sak)
    sys.stderr.write("pro1x-nfc-emulate: listening as a Type-4 NDEF tag; "
                     "tap a reader (Ctrl-C to stop)\n")
    sys.stderr.flush()
    try:
        run("/dev/nxp-nci", tag)
    finally:
        stop_listen(node)


if __name__ == "__main__":
    main()
