#!/bin/sh
# pro1x-autotiling — Sway splits the focused window along its longer side
#
# Tiles stay close to square in portrait and in landscape (author,
# 2026-11-01): whenever a window takes the focus, the next window opened
# next to it splits it side by side if it is wider than tall, one above
# the other otherwise (split h or split v), as nwg-piotr's autotiling does.
# Floating, fullscreen, tabbed and stacked windows are left as they are
# (the menus, the camera's tabs).  Follows Sway's window events; started
# by the Sway config; ends with Sway.
#
# State: written 2026-11-01; not yet run on the phone.

[ -n "${SWAYSOCK:-}" ] || exit 0

# "w h layout" of the focused tiled window and its parent's layout, or
# nothing when it is floating, fullscreen, or in a tabbed or stacked
# container.
focused() {
    swaymsg -t get_tree -r 2>/dev/null | jq -r '
        def walk_parent(p): .nodes[]? as $n
            | if ($n.focused == true) then [$n, p]
              else ($n | walk_parent($n)) end;
        [walk_parent(null)] | .[0] // empty
        | .[0] as $w | .[1] as $p
        | select($w.type == "con" and ($w.fullscreen_mode // 0) == 0)
        | select(($p.layout // "splith") | IN("tabbed", "stacked") | not)
        | "\($w.rect.width) \($w.rect.height)"'
}

swaymsg -m -r -t subscribe '["window"]' 2>/dev/null |
    while IFS= read -r event; do
        case "$event" in
            *'"change":"focus"'*|*'"change": "focus"'*|*'"change":"new"'*|*'"change": "new"'*) ;;
            *) continue ;;
        esac
        set -- $(focused)
        [ $# -eq 2 ] || continue
        if [ "$1" -gt "$2" ]; then
            swaymsg 'split horizontal' >/dev/null 2>&1
        else
            swaymsg 'split vertical' >/dev/null 2>&1
        fi
    done
