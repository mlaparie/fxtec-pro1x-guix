#!/usr/bin/env bash
# pro1x-blank-led — a very dim white LED while the screen is blank but
# not locked (Sway); also redraws the lock screen's status (see redraw)
#
# Shows that the phone is idle, not locked yet (author, 2026-10-30).  It
# writes the RGB LED only while the LED is dark or shows this white, so
# feedbackd's notification patterns and pro1x-charge-led's colours keep it
# when they use it; off is a zero pattern (the pattern trigger stays, for
# feedbackd).  Follows Sway's output events, and every 10 s for the lock,
# which starts without one.  Started by the Sway config; ends with Sway.
#
# State: run on the phone 2026-10-31: lit within 2 s of blanking, off when
# lit again; once it stayed dark (relit-when-dark fix since).

led=/sys/class/leds/rgb:status
# Colour and level: unlocked-led in config.scm (/etc/pro1x/led.conf);
# empty: no indicator.
UNLOCKED_LED="255 255 255" UNLOCKED_LEVEL=6
[ -r /etc/pro1x/led.conf ] && . /etc/pro1x/led.conf
white=$UNLOCKED_LED level=$UNLOCKED_LEVEL
rt="${XDG_RUNTIME_DIR:-/tmp}"
events="$rt/pro1x-blank-led.events"
mine=0

ours() { [ "$(cat "$led/multi_intensity")" = "$white" ]; }
# Dark: an all-zero pattern (off, as feedbackd and pro1x-charge-led leave
# it), not brightness 0, which a breathing pattern passes through.
dark() {
    awk '{ for (i = 1; i <= NF; i += 2) if ($i != 0) exit 1 }' "$led/pattern" 2>/dev/null
}

# The lock screen's status (battery, CPU mode) as of now (author,
# 2026-11-01): redrawn when the screen lights while locked, unless drawn
# less than 30 s ago, and whenever the battery's percentage or charging
# state changes.
battery() { cat /sys/class/power_supply/battery/capacity \
                /sys/class/power_supply/battery/status 2>/dev/null | tr '\n' ' '; }
was_lit= charging=$(battery)
redraw() {
    pro1x-lock --locked || return
    if [ "${1:-}" = now ]; then        # battery: not over a password
        pro1x-lock --refresh-when-idle >/dev/null 2>&1 &
        return
    fi
    drawn=$(cat "$rt/pro1x-lock-drawn" 2>/dev/null || echo 0)
    [ $(( $(date +%s) - drawn )) -ge 30 ] || return
    # Not while the panel powers on: gtklock swapped then died with a
    # Wayland protocol error, leaving a red screen (2026-11-02, the redraw
    # on wake being new since 75c482f); 1.5 s later, if still locked.
    ( sleep 1.5; pro1x-lock --locked && pro1x-lock --refresh ) >/dev/null 2>&1 &
}

# Typing: no key or touch in the last 20 s leaves $rt/pro1x-input-idle
# (Sway counts input on the lock screen too, the hardware keyboard and the
# on-screen one).  A redraw put off meanwhile ($rt/pro1x-lock-pending)
# comes once idle.
touch "$rt/pro1x-input-idle"
swayidle timeout 20 "touch '$rt/pro1x-input-idle'" \
         resume "rm -f '$rt/pro1x-input-idle'" >/dev/null 2>&1 &
typing_watch=$!
pending() {
    [ -e "$rt/pro1x-lock-pending" ] || return 0
    if ! pro1x-lock --locked; then rm -f "$rt/pro1x-lock-pending"
    elif [ -e "$rt/pro1x-input-idle" ]; then
        rm -f "$rt/pro1x-lock-pending"
        pro1x-lock --refresh >/dev/null 2>&1 &
    fi
}

check() {
    lit=$(swaymsg -t get_outputs -r 2>/dev/null |
              jq -r '[.[] | select(.active) | .power] | any')
    [ "$lit" = true ] && [ "$was_lit" = false ] && redraw
    was_lit=$lit
    st=$(battery)
    if [ "$st" != "$charging" ]; then charging=$st; redraw now; fi
    pending
    [ -n "$white" ] || return 0      # no indicator (unlocked-led #f)
    if [ "$lit" = false ] && ! pro1x-lock --locked; then
        # Dark: light it, even if we think it is ours (feedbackd's white
        # terminal-bell pattern can end and leave it dark behind our back).
        if dark; then
            echo "$white" > "$led/multi_intensity"
            echo "$level 1000 $level 1000" > "$led/pattern"
            mine=1
        fi
    elif [ "$mine" = 1 ]; then
        ours && echo "0 1000 0 1000" > "$led/pattern"
        mine=0
    fi
}

off() { [ "$mine" = 1 ] && ours && echo "0 1000 0 1000" > "$led/pattern"; }
trap 'off; kill "$typing_watch" 2>/dev/null; rm -f "$events"' EXIT
trap 'exit 0' INT TERM HUP

rm -f "$events"; mkfifo "$events"
swaymsg -m -r -t subscribe '["output"]' > "$events" 2>/dev/null &
watcher=$!
exec 3< "$events"
while kill -0 "$watcher" 2>/dev/null; do
    read -r -t 10 _ <&3
    check
done
