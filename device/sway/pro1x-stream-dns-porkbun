#!/bin/sh
# pro1x-stream-dns-porkbun — Porkbun's DNS API for pro1x-stream-cert, as root.
#
#   pro1x-stream-dns-porkbun a NAME ADDRESS   make NAME's A record ADDRESS
#   pro1x-stream-dns-porkbun aaaa NAME ADDRESS, aaaa-clear NAME: its AAAA
#                                             (the stream menu's TESTS)
#   pro1x-stream-dns-porkbun auth             certbot's manual-auth-hook
#   pro1x-stream-dns-porkbun cleanup          certbot's manual-cleanup-hook
#
# The keys come from pro1x-stream-cert's environment (PORKBUN_API_KEY,
# PORKBUN_SECRET_KEY, from the user's settings); API Access must be on for
# the domain at Porkbun (its Details page).  certbot gives CERTBOT_DOMAIN
# and CERTBOT_VALIDATION to the hooks.  Another provider: a script
# pro1x-stream-dns-NAME doing the same three things.
#
# State: works (2026-11-19).

set -eu
PATH=/run/current-system/profile/bin:$PATH
PORKBUN_API_KEY=${PORKBUN_API_KEY:?PORKBUN_API_KEY missing}
PORKBUN_SECRET_KEY=${PORKBUN_SECRET_KEY:?PORKBUN_SECRET_KEY missing}
api=https://api.porkbun.com/api/json/v3

# The registered domain and the part of NAME under it: car.example.com ->
# example.com and car (a two-label domain assumed).
zone() { echo "$1" | awk -F. '{ print $(NF-1) "." $NF }'; }
sub() { z=$(zone "$1"); s=${1%"$z"}; echo "${s%.}"; }

call() {                        # call PATH [JSON-FIELDS]
    curl -s -m 30 -X POST -H "Content-Type: application/json" \
         -d "{\"apikey\":\"$PORKBUN_API_KEY\",\"secretapikey\":\"$PORKBUN_SECRET_KEY\"${2:+,$2}}" \
         "$api/$1"
}

case "${1:-}" in
    a|aaaa)
        type=$(echo "$1" | tr a-z A-Z)
        name=$2 address=$3 z=$(zone "$2") s=$(sub "$2")
        got=$(call "dns/retrieveByNameType/$z/$type/$s")
        case "$got" in
            *"\"content\":\"$address\""*) exit 0 ;;
            *"\"records\":[]"*)
                done=$(call "dns/create/$z" "\"name\":\"$s\",\"type\":\"$type\",\"content\":\"$address\",\"ttl\":\"600\"") ;;
            *"\"records\":[{"*)
                done=$(call "dns/editByNameType/$z/$type/$s" "\"content\":\"$address\",\"ttl\":\"600\"") ;;
            *) echo "porkbun: $got" >&2; exit 1 ;;
        esac
        case "$done" in
            *'"status":"SUCCESS"'*) ;;
            *) echo "porkbun: $type record not set: $done" >&2; exit 1 ;;
        esac ;;
    aaaa-clear)
        z=$(zone "$2") s=$(sub "$2")
        call "dns/deleteByNameType/$z/AAAA/$s" | grep -q '"status":"SUCCESS"' ;;
    auth)
        z=$(zone "$CERTBOT_DOMAIN") s=$(sub "$CERTBOT_DOMAIN")
        call "dns/create/$z" "\"name\":\"_acme-challenge${s:+.$s}\",\"type\":\"TXT\",\"content\":\"$CERTBOT_VALIDATION\",\"ttl\":\"600\"" |
            grep -q '"status":"SUCCESS"'
        # Porkbun's servers take a moment; Let's Encrypt asks them directly.
        sleep 60 ;;
    cleanup)
        z=$(zone "$CERTBOT_DOMAIN") s=$(sub "$CERTBOT_DOMAIN")
        call "dns/deleteByNameType/$z/TXT/_acme-challenge${s:+.$s}" >/dev/null || true ;;
    *) echo "usage: pro1x-stream-dns-porkbun a|aaaa NAME ADDRESS | aaaa-clear NAME | auth | cleanup" >&2; exit 2 ;;
esac
