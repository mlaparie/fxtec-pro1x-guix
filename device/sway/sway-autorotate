#!/bin/sh
# sway-autorotate — rotate the Pro¹x panel in Sway from the accelerometer
#
#   sway-autorotate              follow the sensor (started by the Sway config)
#   sway-autorotate on|off|toggle
#   sway-autorotate normal|left|right|inverted   force an orientation (auto off)
#
# rot8 reads raw IIO sysfs, which the SSC accelerometer is not; this follows
# iio-sensor-proxy (monitor-sensor).  While the keyboard is slid out the
# panel stays in landscape (transform 90, as in the Sway device settings).
# The on/off state is ~/.local/state/pro1x/sway-autorotate ($XDG_STATE_HOME),
# so it survives reboots (default off: portrait with the keyboard closed,
# landscape with it out, pro1x-osk-slider; author, 2026-10-30).
#
# Like Phosh (rotation-manager.c), the accelerometer is only held while
# auto-rotation is on and the panel is powered: every batch of the sensor
# stream wakes the ADSP (4.4 a second, rag-notes hardware/sensors).  The
# daemon re-checks on each Sway output event (power on/off, from the power
# key or swayidle) and when on/off/toggle poke it.  It ends
# when Sway exits, since its event subscription ends with Sway.
#
# State: the sensor landscapes and the keyboard landscape work in Sway on
# the phone (author, 2026-10-30).  Holding the sensor only while on and lit,
# run by hand in the Sway session (2026-10-30): on/off and panel off/on
# release and take it again (ADSP interrupts 0 vs 34 per 8 s).  Exit with
# Sway not checked yet.

rt="${XDG_RUNTIME_DIR:-/tmp}"
statedir="${XDG_STATE_HOME:-$HOME/.local/state}/pro1x"
mkdir -p "$statedir"
state="$statedir/sway-autorotate"
pidfile="$rt/sway-autorotate.pid"
fifo="$rt/sway-autorotate.fifo"          # monitor-sensor -> follow
events="$rt/sway-autorotate.events"      # swaymsg subscribe -> main loop
output=DSI-1

transform_for() {               # iio-sensor-proxy orientation -> transform
    case "$1" in
        normal) echo normal ;;
        # Swapped from Phosh's naming: with left-up 90 / right-up 270
        # both landscapes were upside down (author, 2026-10-30).
        left-up) echo 270 ;;
        right-up) echo 90 ;;
        bottom-up) echo 180 ;;
        *) echo "" ;;
    esac
}

slider_out() {                  # SW_KEYPAD_SLIDE set: evtest exits 10
    evtest --query /dev/input/pro1x-slider EV_SW SW_KEYPAD_SLIDE
    [ $? = 10 ]
}

set_transform() { swaymsg output "$output" transform "$1" >/dev/null; }

poke() {                        # tell the running daemon to re-check
    # A line in its event fifo, like a Sway output event.  Only when the
    # daemon is alive: opening a fifo nobody reads would block.
    if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
        timeout 2 sh -c 'echo poke > "$1"' sh "$events"
    fi
    return 0
}

# Off with the keyboard closed: back to portrait.
portrait_unless_slid_out() { slider_out || set_transform normal; }

case "${1:-}" in
    on) echo on > "$state"; poke; exit 0 ;;
    off) echo off > "$state"; poke; portrait_unless_slid_out; exit 0 ;;
    toggle)
        if [ "$(cat "$state" 2>/dev/null || echo off)" = off ]; then
            echo on > "$state"; poke
        else
            echo off > "$state"; poke; portrait_unless_slid_out
        fi
        exit 0 ;;
    normal) echo off > "$state"; poke; set_transform normal; exit 0 ;;
    left) echo off > "$state"; poke; set_transform 90; exit 0 ;;
    right) echo off > "$state"; poke; set_transform 270; exit 0 ;;
    inverted) echo off > "$state"; poke; set_transform 180; exit 0 ;;
    "") ;;
    *) echo "usage: sway-autorotate [on|off|toggle|normal|left|right|inverted]" >&2
       exit 2 ;;
esac

# ── Daemon ───────────────────────────────────────────────────────────────────

[ -f "$state" ] || echo off > "$state"
echo $$ > "$pidfile"
rm -f "$fifo" "$events"; mkfifo "$fifo" "$events"
sensor=                         # monitor-sensor's PID while held

follow() {                      # read monitor-sensor's lines from the fifo
    while IFS= read -r line; do
        # "=== Has accelerometer (orientation: right-up, tilt: ...)" first,
        # then "Accelerometer orientation changed: left-up".
        o=$(echo "$line" | sed -n 's/.*orientation[a-z ]*: \([a-z-]*\).*/\1/p')
        [ -n "$o" ] || continue
        if slider_out; then
            set_transform 90
        else
            t=$(transform_for "$o")
            [ -n "$t" ] && set_transform "$t"
        fi
    done < "$fifo"
}

lit() {                         # is the panel powered?
    [ "$(swaymsg -t get_outputs -r 2>/dev/null |
             jq -r --arg o "$output" '.[] | select(.name == $o) | .power')" = true ]
}

release() {
    [ -n "$sensor" ] && kill "$sensor" 2>/dev/null
    sensor=
}

reconcile() {
    if [ "$(cat "$state" 2>/dev/null)" != off ] && lit; then
        if [ -z "$sensor" ] || ! kill -0 "$sensor" 2>/dev/null; then
            follow &
            monitor-sensor --accel > "$fifo" 2>/dev/null &
            sensor=$!
        fi
    else
        release
    fi
}

cleanup() { release; rm -f "$fifo" "$events" "$pidfile"; }
trap cleanup EXIT
trap 'cleanup; exit 0' INT TERM HUP

reconcile
# One line per output event (-r: compact JSON), or "poke" from on/off/
# toggle; swaymsg exits with Sway, which ends the loop.
swaymsg -m -r -t subscribe '["output"]' > "$events" 2>/dev/null &
watcher=$!
exec 3< "$events"
while IFS= read -r line <&3; do
    reconcile
    kill -0 "$watcher" 2>/dev/null || break
done
