#!/bin/sh
# pro1x-stream-cert — an HTTPS name for the stream on the phone's hotspot,
# as root, run by the stream menu through sudo when a stream starts there
# and when the settings are saved; prints the result.
#
#   sudo pro1x-stream-cert           the calling user's settings
#   pro1x-stream-cert SETTINGS       as root, another file
#
# Some browsers refuse plain HTTP, self-signed certificates and local
# addresses, and resolve names through their own DNS: a Tesla's (found
# 2026-11-19), likely other car infotainment systems.  For them, as
# tesla-carplay does: a domain of the user's whose public A record is an
# address in no private range (240.3.3.4 by default), a Let's Encrypt
# certificate for it (certbot, DNS challenge through the DNS provider's
# API; renewed when 30 days are left, else a second's check), and the
# phone's hotspot sending that address to the stream's HTTPS port
# (nftables, until the next reboot).  Only on the phone's own hotspot: on another network
# nothing sends that address to the phone.
#
# The settings are the user's (~/.config/pro1x/stream-https.conf, mode 600,
# written from the stream menu's HTTPS line; a link or another owner's
# file is refused):
#   STREAM_DOMAIN=stream.example.com   the name; empty or absent: nothing
#   STREAM_ADDRESS=240.3.3.4           its A record
#   DNS_PROVIDER=porkbun               pro1x-stream-dns-PROVIDER: its API
#                                      (porkbun; cloudflare, desec not yet run)
#   PORKBUN_API_KEY=…  PORKBUN_SECRET_KEY=…   the provider's keys, PROVIDER_…
# It is read as KEY=value lines, never run: names in capitals, values of
# plain characters only.
#
#   /var/lib/pro1x/stream-tls/cert.pem, key.pem   the certificate (key: group users),
#                                                 which pro1x-stream-webrtc serves
#   /var/lib/pro1x/stream-tls/name                its name, for the stream menu
#   /var/lib/pro1x/stream-tls/status              the last result, for the menu
#   /var/lib/pro1x/letsencrypt                    certbot's account and certificates
#   /var/log/pro1x-stream-cert.log                every result
#
# State: works from a Tesla on the phone's hotspot with Porkbun
# (2026-11-19).

PATH=/run/current-system/profile/bin:/run/current-system/profile/sbin:$PATH
# Shepherd gives a bare environment: curl and certbot need the CA store.
export SSL_CERT_DIR=/etc/ssl/certs
export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
if [ -n "${SUDO_USER:-}" ]; then
    # /etc/passwd itself: getent is not in the system's profile.
    home=$(awk -F: -v u="$SUDO_USER" '$1 == u { print $6 }' /etc/passwd)
    settings=$home/.config/pro1x/stream-https.conf
    if [ -L "$settings" ] ||
           { [ -e "$settings" ] && [ "$(stat -c %U "$settings")" != "$SUDO_USER" ]; }; then
        echo "$settings: not the user's own file" >&2
        exit 1
    fi
else
    settings=${1:?usage: sudo pro1x-stream-cert, or as root: pro1x-stream-cert SETTINGS}
fi
dir=/var/lib/pro1x/stream-tls
le=/var/lib/pro1x/letsencrypt

say() {
    mkdir -p "$dir"
    echo "$*" > "$dir/status"
    echo "$(date '+%F %T') $*" >> /var/log/pro1x-stream-cert.log
    echo "$*"
}

# The last KEY=value line for KEY, quotes removed; nothing if the value has
# other characters than plain ones.
setting() {
    v=$(sed -n "s/^[[:space:]]*$1=//p" "$settings" 2>/dev/null | tail -1 |
            tr -d '\r' | sed -e 's/[[:space:]]*$//' -e 's/^"\(.*\)"$/\1/' \
                             -e "s/^'\(.*\)'$/\1/")
    case "$v" in *[!A-Za-z0-9_.:@/+=-]*) return 1 ;; esac
    echo "$v"
}

# The hotspot's packets for ADDRESS port 443 (and 8443) to the stream's 8443.
redirect() {
    nft delete table ip pro1x_stream 2>/dev/null || true
    [ -n "$1" ] || return 0
    printf '%s\n' \
        'table ip pro1x_stream {' \
        '    chain prerouting {' \
        '        type nat hook prerouting priority dstnat - 1;' \
        "        iifname \"wlan0\" ip daddr $1 tcp dport { 443, 8443 } dnat to 10.42.0.1:8443" \
        '    }' \
        '}' | nft -f -
}

# No name: no redirect, and the stream back to the phone's own certificate.
unset_name() {
    redirect ""
    rm -f "$dir/cert.pem" "$dir/key.pem" "$dir/name"
    say "not set"
}

install_cert() {                # install_cert CERT KEY NAME
    cp "$1" "$dir/cert.new" && cp "$2" "$dir/key.new" || return 1
    chgrp users "$dir/key.new" && chmod 640 "$dir/key.new"
    chmod 644 "$dir/cert.new"
    mv "$dir/cert.new" "$dir/cert.pem"
    mv "$dir/key.new" "$dir/key.pem"
    echo "$3" > "$dir/name"
}

once() {
    domain=$(setting STREAM_DOMAIN) || { say "STREAM_DOMAIN: unexpected characters"; return; }
    [ -n "$domain" ] || { unset_name; return; }
    case "$domain" in
        *[!a-z0-9.-]*|*.*.*.*.*.*|.*|*.) say "STREAM_DOMAIN: not a name: $domain"; return ;;
        *.*) ;;
        *) say "STREAM_DOMAIN: not a name: $domain"; return ;;
    esac
    address=$(setting STREAM_ADDRESS) || address=
    : "${address:=240.3.3.4}"
    case "$address" in
        *[!0-9.]*|*..*|.*|*.) say "STREAM_ADDRESS: not an address: $address"; return ;;
    esac
    provider=$(setting DNS_PROVIDER) || provider=
    [ -n "$provider" ] || { say "DNS_PROVIDER: not set (porkbun, cloudflare or desec)"; return; }
    case "$provider" in *[!a-z0-9]*) say "DNS_PROVIDER: unknown: $provider"; return ;; esac
    hook=pro1x-stream-dns-$provider
    command -v "$hook" >/dev/null || { say "DNS_PROVIDER: unknown: $provider"; return; }
    # The provider's keys, for its script: only its own variables
    # (PORKBUN_… for porkbun), never others (PATH, LD_PRELOAD…) of this
    # user-written file in a root environment.
    prefix=$(echo "$provider" | tr a-z A-Z)_
    for name in $(sed -n "s/^[[:space:]]*\\($prefix[A-Z0-9_]*\\)=.*/\\1/p" "$settings" | sort -u); do
        value=$(setting "$name") && export "$name=$value"
    done
    "$hook" a "$domain" "$address" >> /var/log/pro1x-stream-cert.log 2>&1 ||
        { say "$domain: the DNS record could not be set (keys, API access?)"; return; }
    if certbot certonly --non-interactive --agree-tos --register-unsafely-without-email \
            --config-dir "$le" --work-dir "$le/work" --logs-dir "$le/logs" \
            --manual --preferred-challenges dns --keep-until-expiring \
            --manual-auth-hook "$hook auth" --manual-cleanup-hook "$hook cleanup" \
            --cert-name "$domain" -d "$domain" >/dev/null 2>&1 &&
           install_cert "$le/live/$domain/fullchain.pem" "$le/live/$domain/privkey.pem" "$domain"
    then
        until=$(openssl x509 -in "$dir/cert.pem" -noout -enddate 2>/dev/null | cut -d= -f2)
        say "$domain, certificate until ${until:-?}"
        redirect "$address"
    else
        say "$domain: no certificate (see $le/logs/letsencrypt.log)"
    fi
}

if [ -r "$settings" ]; then once; else unset_name; fi
