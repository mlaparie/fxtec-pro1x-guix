#!/bin/sh
# pro1x-stream-cert — a certificate that browsers trust for the stream's
# HTTPS (pro1x-stream-webrtc), as root (Shepherd service pro1x-stream-cert).
#
# A car's browser (the author's Tesla, 2026-11-19) refuses plain HTTP and
# self-signed certificates, resolves names through its own DNS (only
# public names work) and refuses local addresses.  So, as tesla-carplay
# does: a domain of the user's whose public A record is an address in no
# private range, a Let's Encrypt certificate for it, and the hotspot
# sending that address to the phone.  Set up by the user, in
# /var/lib/pro1x/stream-tls.conf (root only, the user's own: never in
# config.scm nor in git):
#
#   STREAM_DOMAIN=car.example.com   the name the car opens
#   STREAM_ADDRESS=240.3.3.4        its A record (default 240.3.3.4)
#   DNS_PROVIDER=porkbun            pro1x-stream-dns-PROVIDER talks to its API
#   PORKBUN_API_KEY=… PORKBUN_SECRET_KEY=…   the provider's keys
#
# Then the A record is set through the API, a certificate made by certbot's
# DNS challenge (and renewed: checked every 12 hours), and the hotspot
# redirects STREAM_ADDRESS port 443 to the stream's HTTPS port (nftables).
# Without the file it does nothing, and the stream keeps the phone's own
# self-signed certificate.
#
#   /var/lib/pro1x/stream-tls/cert.pem, key.pem   the certificate (key: group users)
#   /var/lib/pro1x/stream-tls/name, url           its name and link, for the stream menu
#   /var/lib/pro1x/letsencrypt                    certbot's account and certificates
#
# State: written 2026-11-19, not yet run.

PATH=/run/current-system/profile/bin:/run/current-system/profile/sbin:$PATH
dir=/var/lib/pro1x/stream-tls
settings=/var/lib/pro1x/stream-tls.conf
le=/var/lib/pro1x/letsencrypt

install_cert() {                # install_cert CERT KEY NAME URL
    mkdir -p "$dir"
    cp "$1" "$dir/cert.new" && cp "$2" "$dir/key.new" || return 1
    chgrp users "$dir/key.new" && chmod 640 "$dir/key.new"
    chmod 644 "$dir/cert.new"
    mv "$dir/cert.new" "$dir/cert.pem"
    mv "$dir/key.new" "$dir/key.pem"
    echo "$3" > "$dir/name"
    echo "$4" > "$dir/url"
}

# The hotspot's packets for ADDRESS port 443 (and 8443) to the stream's 8443.
redirect() {
    nft delete table ip pro1x_stream 2>/dev/null || true
    printf '%s\n' \
        'table ip pro1x_stream {' \
        '    chain prerouting {' \
        '        type nat hook prerouting priority dstnat - 1;' \
        "        iifname \"wlan0\" ip daddr $1 tcp dport { 443, 8443 } dnat to 10.42.0.1:8443" \
        '    }' \
        '}' | nft -f -
}

once() {
    [ -r "$settings" ] && grep -q '^STREAM_DOMAIN=.' "$settings" || return 0
    . "$settings"
    : "${STREAM_ADDRESS:=240.3.3.4}" "${DNS_PROVIDER:=porkbun}"
    hook=pro1x-stream-dns-$DNS_PROVIDER
    "$hook" a "$STREAM_DOMAIN" "$STREAM_ADDRESS" ||
        echo "$(date '+%F %T') A record for $STREAM_DOMAIN not set"
    if certbot certonly --non-interactive --agree-tos --register-unsafely-without-email \
            --config-dir "$le" --work-dir "$le/work" --logs-dir "$le/logs" \
            --manual --preferred-challenges dns --keep-until-expiring \
            --manual-auth-hook "$hook auth" --manual-cleanup-hook "$hook cleanup" \
            -d "$STREAM_DOMAIN" >/dev/null 2>&1; then
        install_cert "$le/live/$STREAM_DOMAIN/fullchain.pem" \
                     "$le/live/$STREAM_DOMAIN/privkey.pem" \
                     "$STREAM_DOMAIN" "https://$STREAM_DOMAIN/" &&
            echo "$(date '+%F %T') certificate for $STREAM_DOMAIN"
    else
        echo "$(date '+%F %T') certbot failed for $STREAM_DOMAIN (see $le/logs)"
    fi
    redirect "$STREAM_ADDRESS"
}

case "${1:-}" in
    once) once ;;
    *) while :; do once; sleep 43200; done ;;
esac
