#!/bin/sh
# pro1x-browser-fit — LibreWolf, IceCat and Firefox narrow enough for portrait
#
# Their window asks for more width than the panel has in portrait (LibreWolf
# 158: 638 px of 540), so Sway cuts it off.  In each profile, once: a
# userChrome.css block that lowers the minimum window and URL bar widths, and
# in user.js the pref that makes these browsers read that file, and two for
# the pages: they follow their <meta name="viewport"> as on a phone, instead of
# a desktop layout that scrolls sideways, and can be pinched (author,
# 2026-11-03).  The rest of those files is left alone; a browser reads them
# when it starts.  Run at each login, so a new profile has it from the next
# one.
#
# The two rules are from postmarketOS's mobile-config-firefox
# (src/themes/shared/chrome/root.css, urlbar.css; Oliver Smith, Jesús Higueras,
# Peter Mack; MPL-2.0).  Only these: not its toolbar at the bottom or its tab
# menu.
#
# Portrait also sends a mobile user agent, landscape the browser's own (author,
# 2026-11-03): device/browser/portrait-ua, signed by Mozilla, as sites choose
# their layout by it and prefs cannot follow the orientation.  In portrait the
# browser stands out next to resistFingerprinting's uniform agent.
#
# browser-fit? #f in config.scm stops this; what it added stays in the profiles,
# to remove by hand: the block in chrome/userChrome.css, the lines in user.js, and
# extensions/pro1x-portrait-ua@fxtec.xpi.
#
# State: written 2026-11-03.

BROWSER_FIT=yes
[ -r /etc/pro1x/browser.conf ] && . /etc/pro1x/browser.conf
[ "$BROWSER_FIT" = yes ] || exit 0

mark='/* pro1x-browser-fit */'
extension=/run/current-system/profile/share/pro1x-sway/pro1x-portrait-ua.xpi
for dir in "$HOME/.librewolf" "$HOME/.mozilla/icecat" "$HOME/.mozilla/firefox"; do
    for profile in "$dir"/*/; do
        [ -f "$profile/prefs.js" ] || continue
        mkdir -p "$profile/chrome"
        css="$profile/chrome/userChrome.css"
        if ! grep -qF "$mark" "$css" 2>/dev/null; then
            cat >> "$css" <<CSS
$mark
:root { min-width: 300px !important; }
#urlbar-container { min-width: 150px !important; flex-shrink: 1 !important; }
CSS
        fi
        for line in 'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);' \
                    'user_pref("dom.meta_viewport.enabled", true);' \
                    'user_pref("apz.allow_zooming", true);' \
                    'user_pref("extensions.autoDisableScopes", 0);'; do
            grep -qF "$line" "$profile/user.js" 2>/dev/null ||
                echo "$line" >> "$profile/user.js"
        done
        # Signed by Mozilla for self-distribution; autoDisableScopes above
        # lets an add-on placed here start enabled.
        mkdir -p "$profile/extensions"
        xpi="$profile/extensions/pro1x-portrait-ua@fxtec.xpi"
        cmp -s "$extension" "$xpi" || cp -f "$extension" "$xpi"
    done
done
