def raw_source(fd, size):
    """The pipe of raw frames, read a frame at a time.  fdsrc's 4 KiB reads
    held the encoder to 9 frames a second at 1920x960, against 28 so
    (2026-11-18), and the frames waiting in the pipe became seconds of
    delay."""
    width, height = map(int, size.split("@")[0].split("x"))
    return f"fdsrc fd={fd} blocksize={width * height * 3 // 2}"


def hardware(size):
    """Elements from raw NV12 frames to H.264, by the phone's encoder.  If
    the encoder falls behind, the oldest frame waiting is dropped, so the
    delay cannot grow."""
    dimensions, fps = size.split("@")
    width, height = map(int, dimensions.split("x"))
    return (
        f"rawvideoparse width={width} height={height} format=nv12 "
        f'framerate={fps}/1 plane-strides="<{width},{width}>" '
        f'plane-offsets="<0,{width * height}>" ! '
        "queue max-size-buffers=1 max-size-bytes=0 max-size-time=0 "
        "leaky=downstream ! "
        'v4l2h264enc name=enc extra-controls="controls,'
        f'video_bitrate=6000000,video_gop_size={fps},h264_i_frame_period={fps};" ! '
        "video/x-h264,profile=constrained-baseline,level=(string)4 ! "
        "h264parse config-interval=-1"
    )


# The sound: what the phone plays (the default output's monitor, through
# PipeWire's PulseAudio server), as Opus in 10 ms frames, for the least
# delay.
AUDIO = (
