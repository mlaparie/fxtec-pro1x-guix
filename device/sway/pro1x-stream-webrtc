def output_shape(name):
    """The output's scale and mode, as Sway reports them."""
    for o in sway("-t", "get_outputs") or []:
        if o.get("name") == name:
            m = o.get("current_mode") or {}
            return (o.get("scale"), m.get("width"), m.get("height"), o.get("transform"))
    return None


def watch_output(name):
    """The captured output's scale, size or rotation changed (Super+- or
    Super+=): the capture stopped sending frames, so the stream starts
    again (author, 2026-11-20: frozen until refreshed)."""
    shape = output_shape(name)
    try:
        events = subprocess.Popen(["swaymsg", "-m", "-t", "subscribe", '["output"]'],
                                  stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    except OSError:
        return
    for _ in events.stdout:
        now = output_shape(name)
        if now and shape and now != shape:
            log_line(f"{name} changed {shape} -> {now}: starting again")
            GLib.idle_add(lambda: restart_session() and False)
            break
    events.terminate()


def sway(*args):
    """swaymsg's JSON answer, or None."""
    try:
        return json.loads(subprocess.run(["swaymsg", "-r", *args], capture_output=True,
                                         text=True, timeout=5).stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


class Screen:
    """A Sway output of the stream's own (--screen client|multi-monitor,
    the stream menu's Screen line): a headless output at the size the
    viewer's window asks for (its shape, squarish in a car), with the
    workspace "stream", captured by the portal in place of the panel
    (pro1x-stream-output) and played on by the viewer's input.  Client:
    the panel shows it too (wl-mirror); multi-monitor: the panel keeps its
    own workspaces, as a second monitor.  Kept over a
    restart of the server (a new size), removed at its end; its windows
    go back to the panel then."""

    FILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "pro1x-stream-output")
    SIZE = os.path.join(os.environ.get("XDG_STATE_HOME")
                        or os.path.expanduser("~/.local/state"), "pro1x-stream-screen-size")

    def __init__(self, mode, size):
        self.mode, self.mirror = mode, None
        width, height = size.split("@")[0].split("x")

        outputs = sway("-t", "get_outputs") or []
        names = {o["name"] for o in outputs}
        self.name = os.environ.pop("PRO1X_STREAM_OUTPUT", "")
        if self.name not in names:
            subprocess.run(["swaymsg", "create_output"], capture_output=True, timeout=5)
            new = {o["name"] for o in sway("-t", "get_outputs") or []} - names
            if not new:
                raise RuntimeError("Sway made no output")
            self.name = new.pop()
        # Right of the others, so that the panel's pointer and windows do
        # not wander into it.
        right = max((o["rect"]["x"] + o["rect"]["width"] for o in outputs
                     if o["name"] != self.name), default=0)
        # Upright and unscaled whatever the panel's settings, and a custom
        # mode at 60 Hz: with "resolution" Sway gave it a refresh of 0, it
        # never redrew, and the capture's first frame never came, which
        # held the portal's capture for good (2026-11-19).
        for command in (f"output {self.name} transform normal scale 1",
                        f"output {self.name} mode --custom {width}x{height}@60Hz "
                        f"position {right} 0"):
            subprocess.run(["swaymsg", "--", command], capture_output=True, timeout=5)
        # Multi-monitor: the workspace "stream" for it (the rule places it
        # only when it is made; one left on the panel is moved over).
        # Client: the phone's own workspaces go to it (client); an empty
        # "stream" there vanished once left (author, 2026-11-19).
        if mode != "client":
