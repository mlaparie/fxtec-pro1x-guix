def raw_source(fd, size):
    """The pipe of raw frames, read a frame at a time.  fdsrc's 4 KiB reads
    held the encoder to 9 frames a second at 1920x960, against 28 so
    (2026-11-18), and the frames waiting in the pipe became seconds of
    delay."""
    width, height = map(int, size.split("@")[0].split("x"))
    return f"fdsrc fd={fd} blocksize={width * height * 3 // 2}"


def hardware(size, parse=True, mbps=6.0, gop=10):
    """Elements from raw NV12 frames to H.264, by the phone's encoder, from
    the bytes of a pipe (PARSE) or from frames, a keyframe every GOP
    seconds.  If the encoder falls behind, the oldest frame waiting is
    dropped, so the delay cannot grow.

    The peak rate is the rate asked (Venus's default peak, 2 Mbit/s, held
    it below), and the picture is refreshed a part at a time over a second
    (cyclic intra refresh, as game streaming does), so that no frame is a
    large keyframe burst on the link.  Venus's constant bit rate sent twice
    the rate asked (6-8 Mbit/s for 3, 2026-11-19), so the variable one was
    used; that one sent 4 to 7 times it (8-15 Mbit/s for 2, 2026-11-20):
    the constant one again.
    Venus here ignores slice limits (one slice a frame, by bytes or by
    macroblocks, 2026-11-19).  Set only at the start: changing controls on
    a running encoder killed its firmware."""
    dimensions, fps = size.split("@")
    width, height = map(int, dimensions.split("x"))
    return (
        (f"rawvideoparse width={width} height={height} format=nv12 "
         f'framerate={fps}/1 plane-strides="<{width},{width}>" '
         f'plane-offsets="<0,{width * height}>" ! ' if parse else "")
        + "queue max-size-buffers=1 max-size-bytes=0 max-size-time=0 "
        "leaky=downstream ! "
        'v4l2h264enc name=enc extra-controls="controls,'
        f'video_bitrate_mode=1,video_bitrate={int(mbps * 1e6)},'
        f'video_peak_bitrate={int(mbps * 1e6)},'
        f'intra_refresh_period={int(fps)},intra_refresh_period_type=1,'
        f'video_gop_size={gop * int(fps)},h264_i_frame_period={gop * int(fps)};" ! '
        "video/x-h264,profile=constrained-baseline,level=(string)4 ! "
        "h264parse config-interval=-1"
    )


class Portal:
    """The screen through xdg-desktop-portal's ScreenCast (PipeWire), in
    place of wf-recorder for the whole screen: the portal's back end hands
    over Sway's frames as DMA-BUFs, the GPU turns, scales and converts them
    to NV12, and only the encoder's copy touches them on the CPU.  At 1920
    wide on a busy screen, 18 fps for about 95% of a core with Sway's share,
    against 195% for wf-recorder's path (2026-11-18).  One session, for the
    server's life, feeds the encoder of Producer.  Needs
    xdg-desktop-portal-wlr's config to pick the output without asking
    (chooser_type=none, output_name)."""

    PORTAL = ("org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop",
              "org.freedesktop.portal.ScreenCast")
    # Sway's transform of the output, to the turn that shows it upright.
    FLIP = {"90": "counterclockwise", "270": "clockwise", "180": "rotate-180"}

    def __init__(self, turn):
        from gi.repository import Gio
        self.flip = self.FLIP.get(turn, "none")
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        self.sender = self.bus.get_unique_name()[1:].replace(".", "_")
        self.count = 0
        self.session = None
        # Once at start, to fall back to wf-recorder if the portal fails;
        # a moment before the next session (a session opened at once after
        # it could stay without buffers, 2026-11-19).
        self.open()
        self.close()
        time.sleep(0.5)

    def open(self):
        """A new portal session; its stream's node serial in self.serial."""
        self.count += 1
        t = f"p{self.count}"
        r = self.request("CreateSession", GLib.Variant("(a{sv})", ({
            "handle_token": GLib.Variant("s", t + "a"),
            "session_handle_token": GLib.Variant("s", t)},)), t + "a")
        self.session = r["session_handle"]
        self.request("SelectSources", GLib.Variant("(oa{sv})", (self.session, {
            "handle_token": GLib.Variant("s", t + "b"),
            "types": GLib.Variant("u", 1),        # a monitor
            "cursor_mode": GLib.Variant("u", 2)})), t + "b")   # drawn in
        r = self.request("Start", GLib.Variant("(osa{sv})", (self.session, "", {
            "handle_token": GLib.Variant("s", t + "c")})), t + "c")
        node = r["streams"][0][0]
        # pipewiresrc finds a node by its serial, which the portal does not
        # give; the stream's node appears in pw-dump a moment later.
        self.serial = None
        for _ in range(20):
            out = subprocess.run(["pw-dump"], capture_output=True, text=True).stdout
            for o in json.loads(out or "[]"):
                if o.get("id") == node:
                    self.serial = (o.get("info", {}).get("props") or {}).get("object.serial")
            if self.serial:
                break
            time.sleep(0.25)
        if not self.serial:
            raise RuntimeError(f"no serial for node {node}")

    def close(self):
        """The portal session ends, and with it the back end's capture."""
        if self.session:
            try:
                self.bus.call_sync(self.PORTAL[0], self.session,
                                   "org.freedesktop.portal.Session", "Close",
                                   None, None, 0, -1, None)
            except GLib.Error:
                pass
            self.session = None

    def request(self, method, args, token):
        """Call METHOD and wait for its Request's Response; its results."""
        path = f"/org/freedesktop/portal/desktop/request/{self.sender}/{token}"
        got = {}
        loop = GLib.MainLoop()

        def on_response(_c, _s, _p, _i, _sig, params):
            got["code"], got["results"] = params.unpack()
            loop.quit()

        sub = self.bus.signal_subscribe(self.PORTAL[0], "org.freedesktop.portal.Request",
                                        "Response", path, None, 0, on_response)
        self.bus.call_sync(*self.PORTAL, method, args, None, 0, -1, None)
        GLib.timeout_add_seconds(10, loop.quit)
        loop.run()
        self.bus.signal_unsubscribe(sub)
        if got.get("code") != 0:
            raise RuntimeError(f"{method}: {got.get('code', 'no answer')}")
        return got["results"]

    def video(self, pipeline, size, sink):
        """The elements from the portal's frames to raw NV12 at SIZE, added
        to PIPELINE and linked to SINK.  Linked without the caps check:
        glupload tells which DMA-BUF formats it imports only once its GL
        context exists, and parse_launch's links fail before that.  The
        queue after the import lets PipeWire have its buffer back at once
        (18 fps against 15 without it); use-bufferpool must stay on, or
        pipewiresrc copies every frame out of its DMA-BUF (98% of a core)."""
        dimensions, fps = size.split("@")
        width, height = dimensions.split("x")
        # Scaled before it is turned, so that the turn has fewer pixels:
        # 26 fps out of the GPU against 19 the other way round, with a
        # screen changing all the time (2026-11-19).
        turned = self.flip in ("clockwise", "counterclockwise")
        parts = [
            "pipewiresrc name=pw min-buffers=8 do-timestamp=true stream-properties="
            "props,media.type=Video,media.category=Capture,media.role=Screen,"
            f"target.object={self.serial}",
            # The portal's frames were already 400 ms old here, whatever
            # the frame rate (5 to 28 a second), the buffers (2 to 8) or the
            # rate asked of the portal; pipewiresrc hands its buffers over
            # oldest first, one at a time (read from the portal's frames
            # with PRO1X_STREAM_BENCH, 2026-11-20).  This queue takes them
            # at once, the newest winning: PRO1X_STREAM_PW_LEAKY=1, untried
            # (the phone hung 30 s after its first start, as it did after
            # another restart without it: restarting the server hangs the
            # phone at times).
            *(["queue max-size-buffers=1 max-size-bytes=0 max-size-time=0 leaky=downstream"]
              if os.environ.get("PRO1X_STREAM_PW_LEAKY") == "1" else []),
            # Below the portal's own 30 fps only: videorate also dropped
            # frames it need not (15.4 fps out of the GPU without it, 11 with,
            # 2026-11-19).
            *([f"videorate drop-only=true max-rate={fps}"] if int(fps) < 30 else []),
            "video/x-raw(memory:DMABuf),format=DMA_DRM,drm-format=XR24",
            "glupload",
            "queue max-size-buffers=1 max-size-bytes=0 max-size-time=0 leaky=downstream",
            # On a screen of its own (Client, Multi-monitor) the frames have
            # the stream's size and are upright already: neither the scale
            # nor the turn, two GPU passes for nothing (the GPU passed 10 of
            # the portal's 16 fps at 1600x800, 2026-11-20).
            *([] if screen else [
                "glcolorscale",
                "video/x-raw(memory:GLMemory),"
                + (f"width={height},height={width}" if turned
                   else f"width={width},height={height}"),
                f"glvideoflip method={self.flip}"]),
            "glcolorconvert", "video/x-raw(memory:GLMemory),format=NV12",
            "gldownload", "video/x-raw,format=NV12",
            # The portal's frames come at a variable rate, and the encoder
            # planned for less: 20.6 fps with the rate set, 18.8 without.
            f"capssetter caps=video/x-raw,framerate={fps}/1",
        ]
        prev = None
        for part in parts:
            if part.startswith("video/"):
                e = Gst.ElementFactory.make("capsfilter")
                e.set_property("caps", Gst.Caps.from_string(part))
            else:
                e = Gst.parse_launch(part)
            pipeline.add(e)
            if prev is not None:
                prev.get_static_pad("src").link_full(e.get_static_pad("sink"),
                                                     Gst.PadLinkCheck.NOTHING)
            prev = e
        prev.get_static_pad("src").link_full(sink.get_static_pad("sink"),
                                             Gst.PadLinkCheck.NOTHING)


