class Approval:
    """A new viewer's address allowed from the phone (--approve, the stream
    menu's Approval line), besides the key: a tap on the notification, or
    a finger on the sensor (pro1x-fprintd, fprintd's D-Bus interface), within
    a minute.  An address allowed stays allowed until the stream stops; one
    refused waits a minute before it may ask again."""

    NOTIFY = ("org.freedesktop.Notifications", "/org/freedesktop/Notifications",
              "org.freedesktop.Notifications")
    FPRINT = "net.reactivated.Fprint"

    def __init__(self, mode):
        from gi.repository import Gio
        self.Gio = Gio
        self.mode = mode
        # address: "waiting", "allowed", or refusal time.  The allowed ones
        # are kept over a restart of the server (a new size, rate or fps):
        # it asked again for each (author, 2026-11-19).
        self.state = {ip: "allowed" for ip in
                      os.environ.pop("PRO1X_STREAM_ALLOWED", "").split(",") if ip}
        self.session = Gio.bus_get_sync(Gio.BusType.SESSION)

    def check(self, ip):
        """allowed, waiting or refused; a new address starts its question."""
        st = self.state.get(ip)
        if st == "allowed" or st == "waiting":
            return st
        if isinstance(st, float) and time.monotonic() - st < 60:
            return "refused"
        self.state[ip] = "waiting"
        GLib.idle_add(self.ask, ip)
        return "waiting"

    def answer(self, ip, ok):
        if self.state.get(ip) != "waiting":
            return
        self.state[ip] = "allowed" if ok else time.monotonic()
        log_line(f"viewer {ip} " + ("allowed" if ok else "refused") + " on the phone")

    def notify(self, body, actions, seconds=60):
        try:
            reply = self.session.call_sync(
                *self.NOTIFY, "Notify",
                GLib.Variant("(susssasa{sv}i)", (
                    "Stream", 0, "", "Stream viewer", body, actions,
                    {"urgency": GLib.Variant("y", 2)}, seconds * 1000)),
                None, 0, -1, None)
            return reply.unpack()[0]
        except GLib.Error as e:
            log_line(f"no notification: {e.message}")
            return None

    def close(self, nid):
        if nid is None:
            return
        try:
            self.session.call_sync(*self.NOTIFY, "CloseNotification",
                                   GLib.Variant("(u)", (nid,)), None, 0, -1, None)
        except GLib.Error:
            pass

    def ask(self, ip):
        if self.mode == "fingerprint" and self.ask_finger(ip):
            return GLib.SOURCE_REMOVE
        # A tap (mako's default action) allows; dismissed or a minute
        # gone, refused.
        nid = self.notify(f"{ip} wants to watch and control the Pro\u00b9x: tap to allow",
                          ["default", "Allow"])
        if nid is None:
            self.answer(ip, False)
            return GLib.SOURCE_REMOVE
        subs = []

        def done(ok):
            for sub in subs:
                self.session.signal_unsubscribe(sub)
            subs.clear()
            self.answer(ip, ok)

        def invoked(_c, _s, _p, _i, _sig, params):
            got, action = params.unpack()
            if got == nid and subs:
                done(action == "default")

        def closed(_c, _s, _p, _i, _sig, params):
            if params.unpack()[0] == nid and subs:
                done(False)
        subs.append(self.session.signal_subscribe(
            self.NOTIFY[0], self.NOTIFY[2], "ActionInvoked", self.NOTIFY[1], None, 0, invoked))
        subs.append(self.session.signal_subscribe(
            self.NOTIFY[0], self.NOTIFY[2], "NotificationClosed", self.NOTIFY[1], None, 0, closed))
        GLib.timeout_add_seconds(65, lambda: subs and done(False) or False)
        return GLib.SOURCE_REMOVE

    def ask_finger(self, ip):
        """The sensor, within a minute; False if it cannot be asked (then a
        tap instead)."""
        Gio = self.Gio
        try:
            system = Gio.bus_get_sync(Gio.BusType.SYSTEM)
            manager = Gio.DBusProxy.new_sync(
                system, 0, None, self.FPRINT, "/net/reactivated/Fprint/Manager",
                self.FPRINT + ".Manager", None)
            path = manager.call_sync("GetDefaultDevice", None, 0, -1, None).unpack()[0]
            device = Gio.DBusProxy.new_sync(system, 0, None, self.FPRINT, path,
                                            self.FPRINT + ".Device", None)
            device.call_sync("Claim", GLib.Variant("(s)", ("",)), 0, -1, None)
        except GLib.Error as e:
            log_line(f"no fingerprint: {e.message}")
            return False
        nid = self.notify(f"{ip} wants to watch and control the Pro\u00b9x: "
                          "touch the fingerprint sensor to allow", [])
        tries = [0]

        def finish(ok):
            if self.state.get(ip) != "waiting":
                return
            try:
                device.call_sync("VerifyStop", None, 0, -1, None)
            except GLib.Error:
                pass
            try:
                device.call_sync("Release", None, 0, -1, None)
            except GLib.Error:
                pass
            self.close(nid)
            self.answer(ip, ok)

        def buzz(event):
            # As the lock screen (gtklock-fingerprint): feedbackd's events,
            # one buzz for a match, two for a miss; fbcli ends its feedback
            # when its input ends.
            try:
                subprocess.Popen(["sh", "-c", f"sleep 1 | fbcli -E {event} >/dev/null 2>&1"],
                                 stdin=subprocess.DEVNULL)
            except OSError:
                pass

        def status(_proxy, _sender, signal_name, params):
            if signal_name != "VerifyStatus":
                return
            result, done = params.unpack()
            if result == "verify-match":
                buzz("fingerprint-match")
                finish(True)
                return
            if result == "verify-no-match":
                buzz("fingerprint-nomatch")
            if done:
                tries[0] += 1
                if tries[0] >= 3:
                    finish(False)
                else:
                    try:
                        device.call_sync("VerifyStart", GLib.Variant("(s)", ("any",)), 0, -1, None)
                    except GLib.Error:
                        finish(False)
        device.connect("g-signal", status)
        try:
            device.call_sync("VerifyStart", GLib.Variant("(s)", ("any",)), 0, -1, None)
        except GLib.Error as e:
            log_line(f"no fingerprint: {e.message}")
            finish(False)
            return True
        GLib.timeout_add_seconds(60, lambda: finish(False) or False)
        return True


