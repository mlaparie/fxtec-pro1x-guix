class Remote:
    """The viewer's touches and keys on the Pro1x: an absolute pointer with
    a wheel, mapped to the panel and turned with it by Sway like the
    touchscreen (pro1x.conf), and a keyboard."""

    def __init__(self):
        from evdev import AbsInfo, UInput, ecodes
        self.e = ecodes
        axis = AbsInfo(value=0, min=0, max=65535, fuzz=0, flat=0, resolution=0)
        self.pointer = UInput(
            {ecodes.EV_KEY: [ecodes.BTN_LEFT, ecodes.BTN_RIGHT],
             ecodes.EV_ABS: [(ecodes.ABS_X, axis), (ecodes.ABS_Y, axis)],
             ecodes.EV_REL: [ecodes.REL_WHEEL, ecodes.REL_HWHEEL]},
            name="pro1x-remote-pointer", vendor=0x1234, product=0x567A)
        keys = sorted({getattr(ecodes, n) for n in CODES.values()}
                      | {ecodes.KEY_LEFTSHIFT, ecodes.KEY_LEFTCTRL, ecodes.KEY_LEFTALT})
        self.keyboard = UInput({ecodes.EV_KEY: keys},
                               name="pro1x-remote-keyboard",
                               vendor=0x1234, product=0x567B)
        slots = AbsInfo(value=0, min=0, max=9, fuzz=0, flat=0, resolution=0)
        ids = AbsInfo(value=0, min=0, max=65535, fuzz=0, flat=0, resolution=0)
        self.touch = UInput(
            {ecodes.EV_KEY: [ecodes.BTN_TOUCH],
             ecodes.EV_ABS: [(ecodes.ABS_X, axis), (ecodes.ABS_Y, axis),
                             (ecodes.ABS_MT_SLOT, slots),
                             (ecodes.ABS_MT_TRACKING_ID, ids),
                             (ecodes.ABS_MT_POSITION_X, axis),
                             (ecodes.ABS_MT_POSITION_Y, axis)]},
            name="pro1x-remote-touch", vendor=0x1234, product=0x567C,
            input_props=[ecodes.INPUT_PROP_DIRECT])
        self.slots, self.tracking = {}, 0
        self.lock = threading.Lock()
        self.turn, self.turn_at = "normal", 0.0
        # As pro1x.conf says, also before Sway has read it again.
        time.sleep(0.5)
        for command in ('input "4660:22140:pro1x-remote-touch" map_to_output DSI-1',
                        'input "4660:22138:pro1x-remote-pointer" map_to_output DSI-1',
                        'input "4660:22139:pro1x-remote-keyboard" xkb_layout us',
                        'input "4660:22139:pro1x-remote-keyboard" xkb_variant ""'):
            subprocess.run(["swaymsg", command], capture_output=True, timeout=5)

    def transform(self):
        """The panel's turn, read again every few seconds."""
        if time.monotonic() - self.turn_at > 3:
            try:
                outputs = json.loads(subprocess.run(
                    ["swaymsg", "-t", "get_outputs", "-r"],
                    capture_output=True, text=True, timeout=2).stdout)
                self.turn = next(o["transform"] for o in outputs if o.get("active"))
            except (OSError, ValueError, StopIteration, subprocess.TimeoutExpired):
                pass
            self.turn_at = time.monotonic()
        return self.turn

    def place(self, x, y):
        """A point of the picture (0 to 1, as shown) on the panel, which
        Sway then turns: wlroots' output transform (types/wlr_cursor.c),
        undone here.  Sway names its turns clockwise and wlroots
        anticlockwise (sway/ipc-json.c), so Sway's "90" is wlroots' 270:
        mixing them up mirrored the taps (author, 2026-11-18)."""
        x, y = {"90": (1 - y, x), "180": (1 - x, 1 - y),
                "270": (y, 1 - x)}.get(self.transform(), (x, y))
        return int(x * 65535), int(y * 65535)

    def at(self, x, y):
        e = self.e
        px, py = self.place(x, y)
        self.pointer.write(e.EV_ABS, e.ABS_X, px)
        self.pointer.write(e.EV_ABS, e.ABS_Y, py)

    def touch_event(self, kind, ident, x=0.0, y=0.0):
        """A finger of the viewer's on the virtual touchscreen: a slot for
        each, as a real multi-touch screen reports them."""
        e, t = self.e, self.touch
        if kind == "tdown":
            if ident in self.slots or len(self.slots) >= 10:
                return
            slot = min(set(range(10)) - set(self.slots.values()))
            self.slots[ident] = slot
            self.tracking += 1
            t.write(e.EV_ABS, e.ABS_MT_SLOT, slot)
            t.write(e.EV_ABS, e.ABS_MT_TRACKING_ID, self.tracking)
        elif ident not in self.slots:
            return
        else:
            t.write(e.EV_ABS, e.ABS_MT_SLOT, self.slots[ident])
        if kind in ("tdown", "tmove"):
            px, py = self.place(x, y)
            t.write(e.EV_ABS, e.ABS_MT_POSITION_X, px)
            t.write(e.EV_ABS, e.ABS_MT_POSITION_Y, py)
            t.write(e.EV_ABS, e.ABS_X, px)
            t.write(e.EV_ABS, e.ABS_Y, py)
            if kind == "tdown" and len(self.slots) == 1:
                t.write(e.EV_KEY, e.BTN_TOUCH, 1)
        else:
            t.write(e.EV_ABS, e.ABS_MT_TRACKING_ID, -1)
            del self.slots[ident]
            if not self.slots:
                t.write(e.EV_KEY, e.BTN_TOUCH, 0)
        t.syn()

    def tap(self, key, shift=False, ctrl=False, alt=False):
        e, kb = self.e, self.keyboard
        mods = [m for m, on in ((e.KEY_LEFTSHIFT, shift), (e.KEY_LEFTCTRL, ctrl),
                                (e.KEY_LEFTALT, alt)) if on]
        for m in mods:
            kb.write(e.EV_KEY, m, 1)
        kb.write(e.EV_KEY, key, 1)
        kb.syn()
        kb.write(e.EV_KEY, key, 0)
        for m in mods:
            kb.write(e.EV_KEY, m, 0)
        kb.syn()

    # The Pro1x's menus and on-screen keyboard, as its swipes and keys open
    # them (desktop.conf).
    ACTIONS = {"quickactions": ["pro1x-menu", "toggle", "quickactions"],
               "launcher": ["pro1x-menu", "toggle", "launcher"],
               "windowswitcher": ["pro1x-menu", "toggle", "windowswitcher"],
               "osk": ["pro1x-osk", "toggle"]}

    def action(self, name):
        if name in self.ACTIONS:
            subprocess.Popen(self.ACTIONS[name], stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)

    def text(self, text):
        for ch in text:
            shift = ch.isupper() or ch in SHIFTED
            base = SHIFTED.get(ch, ch.lower())
            code = (f"Key{base.upper()}" if base.isalpha() and base.isascii()
                    else f"Digit{base}" if base.isdigit() else PLAIN.get(base))
            if code in CODES:
                self.tap(getattr(self.e, CODES[code]), shift=shift)

    def handle(self, message):
        try:
            m = json.loads(message)
        except ValueError:
            return
        e, p = self.e, self.pointer
        with self.lock:
            kind = m.get("t")
            if kind in ("tdown", "tmove", "tup"):
                self.touch_event(kind, m.get("id"), m.get("x", 0.0), m.get("y", 0.0))
                return
            if kind == "action":
                self.action(m.get("name"))
                return
            if kind == "move":
                self.at(m["x"], m["y"])
            elif kind in ("down", "up"):
                if "x" in m:
                    self.at(m["x"], m["y"])
                p.write(e.EV_KEY, e.BTN_LEFT, 1 if kind == "down" else 0)
            elif kind == "right":
                p.write(e.EV_KEY, e.BTN_RIGHT, 1)
                p.syn()
                p.write(e.EV_KEY, e.BTN_RIGHT, 0)
            elif kind == "scroll":
                if m.get("v"):
                    p.write(e.EV_REL, e.REL_WHEEL, int(m["v"]))
                if m.get("h"):
                    p.write(e.EV_REL, e.REL_HWHEEL, int(m["h"]))
            elif kind == "key" and m.get("code") in CODES:
                self.tap(getattr(e, CODES[m["code"]]), m.get("shift"),
                         m.get("ctrl"), m.get("alt"))
            elif kind == "text":
                self.text(str(m.get("text", ""))[:200])
            p.syn()


remote = None
LOG = os.path.join(os.environ.get("XDG_STATE_HOME")
                   or os.path.expanduser("~/.local/state"),
                   "pro1x", "interactive-stream.log")


def log_line(text):
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    with open(LOG, "a") as f:
        f.write(time.strftime("%Y-%m-%d %H:%M:%S ") + text.strip() + "\n")


class Session:
    """One viewer: the capture command, the pipeline, and its offer."""

    def __init__(self, command, codec, size):
        self.offer_ready = threading.Event()
        self.offer = None
        self.proc = subprocess.Popen(command, stdout=subprocess.PIPE)
        # RTP packets of at most 1200 bytes, as WebRTC usually sends: the
        # payloaders' 1400 did not fit through Tailscale (MTU 1280), where
        # only the input came through and the video stayed black.
        payload = {
            "h264": (hardware(size) if size else "h264parse config-interval=-1")
                    + " ! rtph264pay config-interval=-1 pt=96 mtu=1200 ! "
                    "application/x-rtp,media=video,encoding-name=H264,payload=96",
            "vp8": "ivfparse ! rtpvp8pay pt=96 mtu=1200 ! "
                   "application/x-rtp,media=video,encoding-name=VP8,payload=96",
        }[codec]
        self.pipeline = Gst.parse_launch(
            (raw_source(self.proc.stdout.fileno(), size) if size
             else f"fdsrc fd={self.proc.stdout.fileno()}")
            + f" ! {payload} ! "
            "webrtcbin name=w bundle-policy=max-bundle latency=0 "
            + AUDIO + " ! w."
        )
        self.webrtc = self.pipeline.get_by_name("w")
        self.webrtc.connect("on-negotiation-needed", self.negotiate)
        self.webrtc.connect("notify::ice-gathering-state", self.gathering)
        self.webrtc.connect("notify::ice-connection-state", self.connection)
        self.keyframes = keep_keyframes(self.pipeline)
        if remote:
            # The viewer's input, in the same connection, made before the
            # offer so that the offer carries it.
            self.pipeline.set_state(Gst.State.READY)
            self.channel = self.webrtc.emit("create-data-channel", "input", None)
            self.channel.connect("on-message-string",
                                 lambda _c, text: self.message(text))
        self.pipeline.set_state(Gst.State.PLAYING)

    def message(self, text):
        """The viewer's input, or a setting of the stream."""
        if '"bitrate"' in text:
            try:
                mbps = float(json.loads(text)["mbps"])
            except (ValueError, KeyError, TypeError):
                return
            GLib.idle_add(self.bitrate, min(20.0, max(0.5, mbps)))
        else:
            remote.handle(text)

    def bitrate(self, mbps):
        """The hardware encoder's bit rate, changed while it runs (V4L2
        controls are applied when set on an open device); the VP8 path has
        no such setting."""
        encoder = self.pipeline.get_by_name("enc")
        if encoder is not None:
            encoder.set_property("extra-controls", Gst.Structure.new_from_string(
                f"controls,video_bitrate={int(mbps * 1e6)}"))
            log_line(f"bit rate {mbps} Mbit/s")
        return GLib.SOURCE_REMOVE

    def negotiate(self, _element):
        promise = Gst.Promise.new_with_change_func(self.offered, None)
        self.webrtc.emit("create-offer", None, promise)

    def offered(self, promise, _data):
        # The reply owns the offer: it has to outlive this call's use of it.
        reply = promise.get_reply()
        offer = reply.get_value("offer")
        self.webrtc.emit("set-local-description", offer, Gst.Promise.new())

    def gathering(self, _element, _spec):
        state = self.webrtc.get_property("ice-gathering-state")
        if state == GstWebRTC.WebRTCICEGatheringState.COMPLETE:
            local = self.webrtc.get_property("local-description")
            self.offer = local.sdp.as_text()
            self.offer_ready.set()

    def connection(self, _element, _spec):
        state = self.webrtc.get_property("ice-connection-state")
        if state in (
            GstWebRTC.WebRTCICEConnectionState.FAILED,
            GstWebRTC.WebRTCICEConnectionState.CLOSED,
        ):
            GLib.idle_add(end_session, self)

    def answer(self, text):
        _result, sdp = GstSdp.SDPMessage.new_from_text(text)
        answer = GstWebRTC.WebRTCSessionDescription.new(
            GstWebRTC.WebRTCSDPType.ANSWER, sdp
        )
        self.webrtc.emit("set-remote-description", answer, Gst.Promise.new())

    def stop(self):
        if self.keyframes:
            GLib.source_remove(self.keyframes)
        self.pipeline.set_state(Gst.State.NULL)
        self.proc.terminate()
        try:
            self.proc.wait(timeout=3)
        except subprocess.TimeoutExpired:
            self.proc.kill()
        self.proc.stdout.close()


session = None
session_lock = threading.Lock()


def end_session(old):
    global session
    with session_lock:
        if session is old:
            session = None
    old.stop()
    return GLib.SOURCE_REMOVE


def new_session(command, codec, size, created):
    """Runs in the main loop, where GStreamer's signals are handled."""
    global session
    with session_lock:
        old, session = session, Session(command, codec, size)
        created["session"] = session
    if old:
        old.stop()
    created["done"].set()
    return GLib.SOURCE_REMOVE


class Handler(BaseHTTPRequestHandler):
    # Not "command": the HTTP request's method goes there.
    capture = {}
    size = ""

    def reply(self, body, kind="text/plain", code=200):
        self.send_response(code)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path.split("?")[0] == "/":
            self.reply(INTERACTIVE_PAGE if remote else PAGE,
                       "text/html; charset=utf-8")
        elif self.path.startswith("/offer"):
            codec = "h264" if self.path.endswith("=h264") else "vp8"
            created = {"done": threading.Event()}
            GLib.idle_add(new_session, self.capture[codec], codec, self.size, created)
            if (
                created["done"].wait(10)
                and created["session"].offer_ready.wait(15)
            ):
                self.reply(created["session"].offer.encode())
            else:
                self.reply(b"no offer", code=500)
        else:
            self.reply(b"not found", code=404)

    def do_POST(self):
        if self.path == "/log":
            text = self.rfile.read(min(int(self.headers["Content-Length"]), 4096))
            log_line(self.client_address[0] + " " + text.decode(errors="replace"))
            self.reply(b"ok")
            return
        if self.path != "/answer":
            self.reply(b"not found", code=404)
            return
        text = self.rfile.read(int(self.headers["Content-Length"])).decode()
        with session_lock:
            current = session
        if current:
            GLib.idle_add(lambda: current.answer(text) or GLib.SOURCE_REMOVE)
            self.reply(b"ok")
        else:
            self.reply(b"no session", code=409)

    def log_message(self, *_args):
        pass


def main_loop():
    """A loop that SIGTERM and SIGINT end."""
    loop = GLib.MainLoop()

    def quit_loop(*_args):
        # Stopping a pipeline with a viewer half connected can hang (seen
        # 2026-11-18, the interactive offer unanswered): out within 3 s.
        threading.Timer(3, lambda: os._exit(0)).start()
        loop.quit()

    signal.signal(signal.SIGTERM, quit_loop)
    signal.signal(signal.SIGINT, quit_loop)
    GLib.timeout_add(500, lambda: GLib.SOURCE_CONTINUE)  # lets Python see signals
    return loop


def send_udp(host, port, size, command):
    proc = subprocess.Popen(command, stdout=subprocess.PIPE)
    pipeline = Gst.parse_launch(
        f"{raw_source(proc.stdout.fileno(), size)} ! {hardware(size)} ! "
        f"mpegtsmux alignment=7 ! udpsink host={host} port={port} sync=false"
    )
    loop = main_loop()
    bus = pipeline.get_bus()
    bus.add_signal_watch()
    bus.connect("message::error", lambda *_args: loop.quit())
    keep_keyframes(pipeline)
    pipeline.set_state(Gst.State.PLAYING)
    try:
        loop.run()
    finally:
        pipeline.set_state(Gst.State.NULL)
        proc.terminate()


def main():
    Gst.init(None)
    if sys.argv[1:2] == ["udp"] and len(sys.argv) > 5:
        send_udp(sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5:])
        return
    global remote
    args = sys.argv[1:]
    if args[:1] == ["--raw"]:
        Handler.size, args = args[1], args[2:]
    if args[:1] == ["--interactive"]:
        args = args[1:]
        remote = Remote()
        log_line("started")
    if "--" not in args[1:]:
        sys.exit(__doc__.splitlines()[0])
    split = args.index("--", 1)
    Handler.capture = {"h264": args[1:split], "vp8": args[split + 1:]}
    server = ThreadingHTTPServer(("0.0.0.0", int(args[0])), Handler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    loop = main_loop()
    try:
        loop.run()
    finally:
        with session_lock:
            current = session
        if current:
            current.stop()


if __name__ == "__main__":
    main()
