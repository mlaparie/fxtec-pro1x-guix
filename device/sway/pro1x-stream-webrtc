class Remote:
    """The viewer's touches and keys on the Pro1x: an absolute pointer with
    a wheel, mapped to the panel and turned with it by Sway like the
    touchscreen (pro1x.conf), and a keyboard."""

    def __init__(self, output="DSI-1"):
        from evdev import AbsInfo, UInput, ecodes
        self.e = ecodes
        self.output = output
        axis = AbsInfo(value=0, min=0, max=65535, fuzz=0, flat=0, resolution=0)
        self.pointer = UInput(
            {ecodes.EV_KEY: [ecodes.BTN_LEFT, ecodes.BTN_RIGHT],
             ecodes.EV_ABS: [(ecodes.ABS_X, axis), (ecodes.ABS_Y, axis)],
             ecodes.EV_REL: [ecodes.REL_WHEEL, ecodes.REL_HWHEEL]},
            name="pro1x-remote-pointer", vendor=0x1234, product=0x567A)
        keys = sorted({getattr(ecodes, n) for n in CODES.values()}
                      | {ecodes.KEY_LEFTSHIFT, ecodes.KEY_LEFTCTRL, ecodes.KEY_LEFTALT})
        self.keyboard = UInput({ecodes.EV_KEY: keys},
                               name="pro1x-remote-keyboard",
                               vendor=0x1234, product=0x567B)
        slots = AbsInfo(value=0, min=0, max=9, fuzz=0, flat=0, resolution=0)
        ids = AbsInfo(value=0, min=0, max=65535, fuzz=0, flat=0, resolution=0)
        self.touch = UInput(
            {ecodes.EV_KEY: [ecodes.BTN_TOUCH],
             ecodes.EV_ABS: [(ecodes.ABS_X, axis), (ecodes.ABS_Y, axis),
                             (ecodes.ABS_MT_SLOT, slots),
                             (ecodes.ABS_MT_TRACKING_ID, ids),
                             (ecodes.ABS_MT_POSITION_X, axis),
                             (ecodes.ABS_MT_POSITION_Y, axis)]},
            name="pro1x-remote-touch", vendor=0x1234, product=0x567C,
            input_props=[ecodes.INPUT_PROP_DIRECT])
        # The touchpad mode and a captured mouse: moves from where the
        # pointer is.
        self.mouse = UInput(
            {ecodes.EV_KEY: [ecodes.BTN_LEFT, ecodes.BTN_RIGHT, ecodes.BTN_MIDDLE],
             ecodes.EV_REL: [ecodes.REL_X, ecodes.REL_Y]},
            name="pro1x-remote-mouse", vendor=0x1234, product=0x567D)
        self.held = set()                   # captured keys down
        self.rest = [0.0, 0.0]              # fractions of a move left over
        self.slots, self.tracking = {}, 0
        self.lock = threading.Lock()
        self.turn, self.turn_at = "normal", 0.0
        # As pro1x.conf says, also before Sway has read it again.
        time.sleep(0.5)
        for command in (f'input "4660:22140:pro1x-remote-touch" map_to_output {output}',
                        f'input "4660:22138:pro1x-remote-pointer" map_to_output {output}',
                        'input "4660:22139:pro1x-remote-keyboard" xkb_layout us',
                        'input "4660:22139:pro1x-remote-keyboard" xkb_variant ""'):
            subprocess.run(["swaymsg", command], capture_output=True, timeout=5)

    def transform(self):
        """The panel's turn, read again every few seconds."""
        if time.monotonic() - self.turn_at > 3:
            try:
                outputs = json.loads(subprocess.run(
                    ["swaymsg", "-t", "get_outputs", "-r"],
                    capture_output=True, text=True, timeout=2).stdout)
                self.turn = next(o["transform"] for o in outputs
                                 if o.get("active") and o["name"] == self.output)
            except (OSError, ValueError, StopIteration, subprocess.TimeoutExpired):
                pass
            self.turn_at = time.monotonic()
        return self.turn

    def place(self, x, y):
        """A point of the picture (0 to 1, as shown) on the panel, which
        Sway then turns: wlroots' output transform (types/wlr_cursor.c),
        undone here.  Sway names its turns clockwise and wlroots
        anticlockwise (sway/ipc-json.c), so Sway's "90" is wlroots' 270:
        mixing them up mirrored the taps (author, 2026-11-18)."""
        x, y = {"90": (1 - y, x), "180": (1 - x, 1 - y),
                "270": (y, 1 - x)}.get(self.transform(), (x, y))
        return int(x * 65535), int(y * 65535)

    def at(self, x, y):
        e = self.e
        px, py = self.place(x, y)
        self.pointer.write(e.EV_ABS, e.ABS_X, px)
        self.pointer.write(e.EV_ABS, e.ABS_Y, py)

    def touch_event(self, kind, ident, x=0.0, y=0.0):
        """A finger of the viewer's on the virtual touchscreen: a slot for
        each, as a real multi-touch screen reports them."""
        e, t = self.e, self.touch
        if kind == "tdown":
            if ident in self.slots or len(self.slots) >= 10:
                return
            slot = min(set(range(10)) - set(self.slots.values()))
            self.slots[ident] = slot
            self.tracking += 1
            t.write(e.EV_ABS, e.ABS_MT_SLOT, slot)
            t.write(e.EV_ABS, e.ABS_MT_TRACKING_ID, self.tracking)
        elif ident not in self.slots:
            return
        else:
            t.write(e.EV_ABS, e.ABS_MT_SLOT, self.slots[ident])
        if kind in ("tdown", "tmove"):
            px, py = self.place(x, y)
            t.write(e.EV_ABS, e.ABS_MT_POSITION_X, px)
            t.write(e.EV_ABS, e.ABS_MT_POSITION_Y, py)
            t.write(e.EV_ABS, e.ABS_X, px)
            t.write(e.EV_ABS, e.ABS_Y, py)
            if kind == "tdown" and len(self.slots) == 1:
                t.write(e.EV_KEY, e.BTN_TOUCH, 1)
        else:
            t.write(e.EV_ABS, e.ABS_MT_TRACKING_ID, -1)
            del self.slots[ident]
            if not self.slots:
                t.write(e.EV_KEY, e.BTN_TOUCH, 0)
        t.syn()

    def tap(self, key, shift=False, ctrl=False, alt=False):
        e, kb = self.e, self.keyboard
        mods = [m for m, on in ((e.KEY_LEFTSHIFT, shift), (e.KEY_LEFTCTRL, ctrl),
                                (e.KEY_LEFTALT, alt)) if on]
        for m in mods:
            kb.write(e.EV_KEY, m, 1)
        kb.write(e.EV_KEY, key, 1)
        kb.syn()
        kb.write(e.EV_KEY, key, 0)
        for m in mods:
            kb.write(e.EV_KEY, m, 0)
        kb.syn()

    # The Pro1x's menus and on-screen keyboard, as its swipes and keys open
    # them (desktop.conf).
    ACTIONS = {"quickactions": ["pro1x-menu", "toggle", "quickactions"],
               "launcher": ["pro1x-menu", "toggle", "launcher"],
               "windowswitcher": ["pro1x-menu", "toggle", "windowswitcher"],
               "osk": ["pro1x-osk", "toggle"]}

    def action(self, name):
        if name == "osk" and self.output != "DSI-1":
            threading.Thread(target=self.osk_here, daemon=True).start()
            return
        if name in self.ACTIONS:
            # The menus open on the focused output: the viewer's.  With a
            # screen of its own mirrored, the mirror on the panel had the
            # focus, and the menus opened there, out of the stream
            # (author, 2026-11-19).
            if self.output != "DSI-1":
                subprocess.run(["swaymsg", f"focus output {self.output}"],
                               capture_output=True, timeout=5)
            # Through Sway, in its session's environment: started from the
            # server's, the launcher's terminal did not come up (2026-11-19).
            subprocess.run(["swaymsg", "exec " + " ".join(self.ACTIONS[name])],
                           capture_output=True, timeout=5)

    def osk_here(self):
        """The on-screen keyboard on the stream's own screen (pro1x-osk
        moves stevia there, a second, when it is on the panel)."""
        subprocess.run(["swaymsg", f"focus output {self.output}"],
                       capture_output=True, timeout=5)
        subprocess.run(["swaymsg", "exec pro1x-osk toggle stream"],
                       capture_output=True, timeout=5)

    def text(self, text):
        for ch in text:
            shift = ch.isupper() or ch in SHIFTED
            base = SHIFTED.get(ch, ch.lower())
            code = (f"Key{base.upper()}" if base.isalpha() and base.isascii()
                    else f"Digit{base}" if base.isdigit() else PLAIN.get(base))
            if code in CODES:
                self.tap(getattr(self.e, CODES[code]), shift=shift)

    def handle(self, message):
        try:
            m = json.loads(message)
        except ValueError:
            return
        e, p = self.e, self.pointer
        with self.lock:
            kind = m.get("t")
            if kind in ("tdown", "tmove", "tup"):
                self.touch_event(kind, m.get("id"), m.get("x", 0.0), m.get("y", 0.0))
                return
            if kind == "action":
                self.action(m.get("name"))
                return
            if kind == "rel":
                mouse = self.mouse
                for i, axis in enumerate((e.REL_X, e.REL_Y)):
                    try:
                        self.rest[i] += float(m.get(("dx", "dy")[i], 0))
                    except (TypeError, ValueError):
                        return
                    step = int(self.rest[i])
                    self.rest[i] -= step
                    if step:
                        mouse.write(e.EV_REL, axis, step)
                mouse.syn()
                return
            if kind == "rbtn":
                button = {"left": e.BTN_LEFT, "right": e.BTN_RIGHT,
                          "middle": e.BTN_MIDDLE}.get(m.get("b"))
                if button is not None:
                    self.mouse.write(e.EV_KEY, button, 1 if m.get("d") else 0)
                    self.mouse.syn()
                return
            if kind in ("kd", "ku") and m.get("code") in CODES:
                key = getattr(e, CODES[m["code"]])
                self.keyboard.write(e.EV_KEY, key, 1 if kind == "kd" else 0)
                self.keyboard.syn()
                (self.held.add if kind == "kd" else self.held.discard)(key)
                return
            if kind == "allup":
                for key in self.held:
                    self.keyboard.write(e.EV_KEY, key, 0)
                self.keyboard.syn()
                self.held.clear()
                return
            if kind == "move":
                self.at(m["x"], m["y"])
            elif kind in ("down", "up"):
                if "x" in m:
                    self.at(m["x"], m["y"])
                p.write(e.EV_KEY, e.BTN_LEFT, 1 if kind == "down" else 0)
            elif kind == "right":
                p.write(e.EV_KEY, e.BTN_RIGHT, 1)
                p.syn()
                p.write(e.EV_KEY, e.BTN_RIGHT, 0)
            elif kind == "scroll":
                if "x" in m:
                    self.at(m["x"], m["y"])
                    p.syn()
                if m.get("v"):
                    p.write(e.EV_REL, e.REL_WHEEL, int(m["v"]))
                if m.get("h"):
                    p.write(e.EV_REL, e.REL_HWHEEL, int(m["h"]))
            elif kind == "key" and m.get("code") in CODES:
                self.tap(getattr(e, CODES[m["code"]]), m.get("shift"),
                         m.get("ctrl"), m.get("alt"))
            elif kind == "text":
                self.text(str(m.get("text", ""))[:200])
            p.syn()


class PanelTouch:
    """Client mode: the panel's own touches on the mirror (wl-mirror, fitted
    with bars) played on the stream's screen, through the viewer's virtual
    touchscreen (author, 2026-11-19).  The panel's touchscreen is taken from
    Sway meanwhile, since Sway would play them on the panel, under the
    mirror.  Its native axes are the panel's, turned as Sway turns the
    panel (as Remote.place, undone), then out of the mirror's bars."""

    NAME = "Goodix Capacitive TouchScreen"

    def __init__(self, remote, size):
        from evdev import InputDevice, ecodes, list_devices
        self.remote, self.e = remote, ecodes
        self.width, self.height = map(int, size.split("@")[0].split("x"))
        self.device = next((d for d in map(InputDevice, list_devices())
                            if d.name == self.NAME), None)
        if self.device is None:
            raise RuntimeError("no panel touchscreen")
        self.maxx = self.device.absinfo(ecodes.ABS_MT_POSITION_X).max or 1
        self.maxy = self.device.absinfo(ecodes.ABS_MT_POSITION_Y).max or 1
        panel = next((o for o in sway("-t", "get_outputs") or [] if o["name"] == "DSI-1"), {})
        mode = panel.get("current_mode") or {"width": 1080, "height": 2160}
        self.turn = panel.get("transform", "normal")
        pw, ph = mode["width"], mode["height"]
        self.panel = (ph, pw) if self.turn in ("90", "270") else (pw, ph)
        self.device.grab()
        self.slots, self.slot = {}, 0     # slot: [tracking id, x, y, down]
        threading.Thread(target=self.read, daemon=True).start()
        log_line("the panel's touches go to the stream's screen")

    def at(self, rx, ry):
        """A raw point: the picture's 0-1 point, or None in the bars."""
        u, v = rx / self.maxx, ry / self.maxy
        x, y = {"90": (v, 1 - u), "180": (1 - u, 1 - v),
                "270": (1 - v, u)}.get(self.turn, (u, v))
        pw, ph = self.panel
        scale = min(pw / self.width, ph / self.height)
        ox, oy = (pw - self.width * scale) / 2, (ph - self.height * scale) / 2
        nx = (x * pw - ox) / (self.width * scale)
        ny = (y * ph - oy) / (self.height * scale)
        if not (0 <= nx <= 1 and 0 <= ny <= 1):
            return None
        return nx, ny

    def read(self):
        e = self.e
        try:
            for ev in self.device.read_loop():
                if ev.type == e.EV_ABS:
                    if ev.code == e.ABS_MT_SLOT:
                        self.slot = ev.value
                    else:
                        st = self.slots.setdefault(self.slot, [-1, 0, 0, False])
                        if ev.code == e.ABS_MT_TRACKING_ID:
                            st[0] = ev.value
                        elif ev.code == e.ABS_MT_POSITION_X:
                            st[1] = ev.value
                        elif ev.code == e.ABS_MT_POSITION_Y:
                            st[2] = ev.value
                elif ev.type == e.EV_SYN and ev.code == e.SYN_REPORT:
                    self.report()
        except OSError:
            pass

    def report(self):
        with self.remote.lock:
            for slot, st in self.slots.items():
                ident = f"panel{slot}"
                if st[0] >= 0:
                    point = self.at(st[1], st[2])
                    if point is None:
                        continue
                    self.remote.touch_event("tmove" if st[3] else "tdown", ident, *point)
                    st[3] = True
                elif st[3]:
                    self.remote.touch_event("tup", ident)
                    st[3] = False

    def stop(self):
        try:
            self.device.ungrab()
            self.device.close()
        except OSError:
            pass


