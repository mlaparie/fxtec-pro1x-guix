#!/usr/bin/env python3
"""pro1x-stream-webrtc [--raw WxH@FPS] PORT COMMAND... -- VP8-COMMAND... -- serve by WebRTC.
pro1x-stream-webrtc udp HOST PORT WxH@FPS COMMAND... -- send MPEG-TS by UDP.

COMMAND writes H.264 (constrained baseline) to its standard output.  With a size
and rate it writes raw NV12 frames instead, for the hardware H.264 encoder.
VP8-COMMAND writes VP8 in IVF.  One of them
runs while a viewer is connected.  A browser gets a page from
http://ADDRESS:PORT/ and plays the video with no application; one viewer at a
time, and a new one replaces the last.

The page tries H.264, which costs the phone less, then VP8 if no picture comes:
LibreWolf lists H.264 but needs media.gmp-gmpopenh264.enabled to decode it, and
CEF (Nyxt) has no decoder.  VP8 is encoded in software: this encoder has no VP8.

The Pro1x makes the WebRTC offer and the browser answers, both by plain HTTP.
This way the browser takes the payload type GStreamer chose, and no signalling
server is needed.  ICE uses local addresses only.

State: VP8 played in a browser (author, 2026-11-10).  The hardware path encodes
real screen frames on the phone; not yet seen in a browser.
"""

import signal
import subprocess
import sys
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

import gi

gi.require_version("Gst", "1.0")
gi.require_version("GstSdp", "1.0")
gi.require_version("GstVideo", "1.0")
gi.require_version("GstWebRTC", "1.0")
from gi.repository import GLib, Gst, GstSdp, GstVideo, GstWebRTC  # noqa: E402

PAGE = b"""<!doctype html>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Pro1x screen</title>
<style>html,body{margin:0;height:100%;background:#000}
video{width:100%;height:100%;object-fit:contain}</style>
<video id="v" autoplay muted playsinline controls></video>
<script>
const pc = new RTCPeerConnection();
pc.ontrack = e => {
  document.getElementById("v").srcObject =
    e.streams[0] || new MediaStream([e.track]);
};
(async () => {
  const codecs = RTCRtpReceiver.getCapabilities("video").codecs;
  const codec = new URLSearchParams(location.search).get("codec")
    || (codecs.some(c => /h264/i.test(c.mimeType)) ? "h264" : "vp8");
  const offer = await (await fetch("/offer?codec=" + codec)).text();
  await pc.setRemoteDescription({type: "offer", sdp: offer});
  await pc.setLocalDescription(await pc.createAnswer());
  // All the local addresses go in the answer: there is no later exchange.
  await new Promise(done => {
    if (pc.iceGatheringState === "complete") return done();
    pc.onicegatheringstatechange = () =>
      pc.iceGatheringState === "complete" && done();
    setTimeout(done, 2000);
  });
  await fetch("/answer", {method: "POST", body: pc.localDescription.sdp});
  // A browser can list H.264 and have no decoder: VP8 if nothing was decoded.
  if (codec === "h264") setTimeout(async () => {
    let decoded = 0;
    (await pc.getStats()).forEach(r => {
      if (r.type === "inbound-rtp" && r.kind === "video") decoded = r.framesDecoded;
    });
    if (!decoded) location.replace("/?codec=vp8");
  }, 5000);
})();
</script>
"""


def hardware(size):
    """Elements from raw NV12 frames to H.264, by the phone's encoder."""
    dimensions, fps = size.split("@")
    width, height = map(int, dimensions.split("x"))
    return (
        f"rawvideoparse width={width} height={height} format=nv12 "
        f'framerate={fps}/1 plane-strides="<{width},{width}>" '
        f'plane-offsets="<0,{width * height}>" ! '
        'v4l2h264enc name=enc extra-controls="controls,'
        f'video_bitrate=6000000,video_gop_size={fps},h264_i_frame_period={fps};" ! '
        "video/x-h264,profile=constrained-baseline,level=(string)4 ! "
        "h264parse config-interval=-1"
    )


def keep_keyframes(pipeline):
    """A full keyframe every second, or a viewer that joins late sees nothing."""
    encoder = pipeline.get_by_name("enc")
    if encoder is None:
        return None

    def ask():
        encoder.get_static_pad("src").send_event(
            GstVideo.video_event_new_upstream_force_key_unit(
                Gst.CLOCK_TIME_NONE, True, 0
            )
        )
        return GLib.SOURCE_CONTINUE

    return GLib.timeout_add_seconds(1, ask)


class Session:
    """One viewer: the capture command, the pipeline, and its offer."""

    def __init__(self, command, codec, size):
        self.offer_ready = threading.Event()
        self.offer = None
        self.proc = subprocess.Popen(command, stdout=subprocess.PIPE)
        payload = {
            "h264": (hardware(size) if size else "h264parse config-interval=-1")
                    + " ! rtph264pay config-interval=-1 pt=96 ! "
                    "application/x-rtp,media=video,encoding-name=H264,payload=96",
            "vp8": "ivfparse ! rtpvp8pay pt=96 ! "
                   "application/x-rtp,media=video,encoding-name=VP8,payload=96",
        }[codec]
        self.pipeline = Gst.parse_launch(
            f"fdsrc fd={self.proc.stdout.fileno()} ! {payload} ! "
            "webrtcbin name=w bundle-policy=max-bundle latency=0"
        )
        self.webrtc = self.pipeline.get_by_name("w")
        self.webrtc.connect("on-negotiation-needed", self.negotiate)
        self.webrtc.connect("notify::ice-gathering-state", self.gathering)
        self.webrtc.connect("notify::ice-connection-state", self.connection)
        self.keyframes = keep_keyframes(self.pipeline)
        self.pipeline.set_state(Gst.State.PLAYING)

    def negotiate(self, _element):
        promise = Gst.Promise.new_with_change_func(self.offered, None)
        self.webrtc.emit("create-offer", None, promise)

    def offered(self, promise, _data):
        # The reply owns the offer: it has to outlive this call's use of it.
        reply = promise.get_reply()
        offer = reply.get_value("offer")
        self.webrtc.emit("set-local-description", offer, Gst.Promise.new())

    def gathering(self, _element, _spec):
        state = self.webrtc.get_property("ice-gathering-state")
        if state == GstWebRTC.WebRTCICEGatheringState.COMPLETE:
            local = self.webrtc.get_property("local-description")
            self.offer = local.sdp.as_text()
            self.offer_ready.set()

    def connection(self, _element, _spec):
        state = self.webrtc.get_property("ice-connection-state")
        if state in (
            GstWebRTC.WebRTCICEConnectionState.FAILED,
            GstWebRTC.WebRTCICEConnectionState.CLOSED,
        ):
            GLib.idle_add(end_session, self)

    def answer(self, text):
        _result, sdp = GstSdp.SDPMessage.new_from_text(text)
        answer = GstWebRTC.WebRTCSessionDescription.new(
            GstWebRTC.WebRTCSDPType.ANSWER, sdp
        )
        self.webrtc.emit("set-remote-description", answer, Gst.Promise.new())

    def stop(self):
        if self.keyframes:
            GLib.source_remove(self.keyframes)
        self.pipeline.set_state(Gst.State.NULL)
        self.proc.terminate()
        try:
            self.proc.wait(timeout=3)
        except subprocess.TimeoutExpired:
            self.proc.kill()
        self.proc.stdout.close()


session = None
session_lock = threading.Lock()


def end_session(old):
    global session
    with session_lock:
        if session is old:
            session = None
    old.stop()
    return GLib.SOURCE_REMOVE


def new_session(command, codec, size, created):
    """Runs in the main loop, where GStreamer's signals are handled."""
    global session
    with session_lock:
        old, session = session, Session(command, codec, size)
        created["session"] = session
    if old:
        old.stop()
    created["done"].set()
    return GLib.SOURCE_REMOVE


class Handler(BaseHTTPRequestHandler):
    # Not "command": the HTTP request's method goes there.
    capture = {}
    size = ""

    def reply(self, body, kind="text/plain", code=200):
        self.send_response(code)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path.split("?")[0] == "/":
            self.reply(PAGE, "text/html; charset=utf-8")
        elif self.path.startswith("/offer"):
            codec = "h264" if self.path.endswith("=h264") else "vp8"
            created = {"done": threading.Event()}
            GLib.idle_add(new_session, self.capture[codec], codec, self.size, created)
            if (
                created["done"].wait(10)
                and created["session"].offer_ready.wait(15)
            ):
                self.reply(created["session"].offer.encode())
            else:
                self.reply(b"no offer", code=500)
        else:
            self.reply(b"not found", code=404)

    def do_POST(self):
        if self.path != "/answer":
            self.reply(b"not found", code=404)
            return
        text = self.rfile.read(int(self.headers["Content-Length"])).decode()
        with session_lock:
            current = session
        if current:
            GLib.idle_add(lambda: current.answer(text) or GLib.SOURCE_REMOVE)
            self.reply(b"ok")
        else:
            self.reply(b"no session", code=409)

    def log_message(self, *_args):
        pass


def main_loop():
    """A loop that SIGTERM and SIGINT end."""
    loop = GLib.MainLoop()

    def quit_loop(*_args):
        loop.quit()

    signal.signal(signal.SIGTERM, quit_loop)
    signal.signal(signal.SIGINT, quit_loop)
    GLib.timeout_add(500, lambda: GLib.SOURCE_CONTINUE)  # lets Python see signals
    return loop


def send_udp(host, port, size, command):
    proc = subprocess.Popen(command, stdout=subprocess.PIPE)
    pipeline = Gst.parse_launch(
        f"fdsrc fd={proc.stdout.fileno()} ! {hardware(size)} ! "
        f"mpegtsmux alignment=7 ! udpsink host={host} port={port} sync=false"
    )
    loop = main_loop()
    bus = pipeline.get_bus()
    bus.add_signal_watch()
    bus.connect("message::error", lambda *_args: loop.quit())
    keep_keyframes(pipeline)
    pipeline.set_state(Gst.State.PLAYING)
    try:
        loop.run()
    finally:
        pipeline.set_state(Gst.State.NULL)
        proc.terminate()


def main():
    Gst.init(None)
    if sys.argv[1:2] == ["udp"] and len(sys.argv) > 5:
        send_udp(sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5:])
        return
    args = sys.argv[1:]
    if args[:1] == ["--raw"]:
        Handler.size, args = args[1], args[2:]
    if "--" not in args[1:]:
        sys.exit(__doc__.splitlines()[0])
    split = args.index("--", 1)
    Handler.capture = {"h264": args[1:split], "vp8": args[split + 1:]}
    server = ThreadingHTTPServer(("0.0.0.0", int(args[0])), Handler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    loop = main_loop()
    try:
        loop.run()
    finally:
        with session_lock:
            current = session
        if current:
            current.stop()


if __name__ == "__main__":
    main()
