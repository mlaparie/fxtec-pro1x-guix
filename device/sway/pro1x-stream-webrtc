async function status() {
  try {
    phone = await (await fetch(withKey("/status"))).json();
    if (phone.fps && phone.fps !== cfg.fps && document.activeElement !== sf) {
      cfg.fps = phone.fps; showFps();
    }
    if (phone.cpu !== undefined) { temps.push(phone.cpu); if (temps.length > 120) temps.shift(); }
    if (info.style.display === "block") drawTemps();
