                   or os.path.expanduser("~/.local/state"),
                   "pro1x", "interactive-stream.log")
# The page's settings and modes, kept on the phone for any browser.
SETTINGS = os.path.join(os.path.dirname(LOG), "interactive-stream.json")


def log_line(text):
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    with open(LOG, "a") as f:
        f.write(time.strftime("%Y-%m-%d %H:%M:%S ") + text.strip() + "\n")


class Session:
    """One viewer: the capture command, the pipeline, and its offer."""

    def __init__(self, command, codec, size):
        self.offer_ready = threading.Event()
        self.offer = None
        self.proc = subprocess.Popen(command, stdout=subprocess.PIPE)
        # RTP packets of at most 1200 bytes, as WebRTC usually sends: the
        # payloaders' 1400 did not fit through Tailscale (MTU 1280), where
        # only the input came through and the video stayed black.
        payload = {
            "h264": (hardware(size) if size else "h264parse config-interval=-1")
                    + " ! rtph264pay config-interval=-1 pt=96 mtu=1200 ! "
                    "application/x-rtp,media=video,encoding-name=H264,payload=96",
            "vp8": "ivfparse ! rtpvp8pay pt=96 mtu=1200 ! "
                   "application/x-rtp,media=video,encoding-name=VP8,payload=96",
        }[codec]
        self.pipeline = Gst.parse_launch(
            (raw_source(self.proc.stdout.fileno(), size) if size
             else f"fdsrc fd={self.proc.stdout.fileno()}")
            + f" ! {payload} ! "
            "webrtcbin name=w bundle-policy=max-bundle latency=0 "
            + AUDIO + " ! w."
        )
        self.webrtc = self.pipeline.get_by_name("w")
        # Picture and sound as two streams: in one, the browser lip-synced
        # them, and with the picture's timestamps counted from frames and the
        # sound's from its clock, it held the sound back 1.5 s and cut it
        # now and then (author, 2026-11-18).  Apart, each plays as it comes;
        # the page's a/v setting lines them up.
        for i, pad in enumerate(self.webrtc.sinkpads):
            if pad.find_property("msid"):
                pad.set_property("msid", f"pro1x-{i}")
        self.webrtc.connect("on-negotiation-needed", self.negotiate)
        self.webrtc.connect("notify::ice-gathering-state", self.gathering)
        self.webrtc.connect("notify::ice-connection-state", self.connection)
        self.keyframes = keep_keyframes(self.pipeline)
        if remote:
            # The viewer's input, in the same connection, made before the
            # offer so that the offer carries it.
            self.pipeline.set_state(Gst.State.READY)
            self.channel = self.webrtc.emit("create-data-channel", "input", None)
            self.channel.connect("on-message-string",
                                 lambda _c, text: self.message(text))
        self.pipeline.set_state(Gst.State.PLAYING)

    def message(self, text):
        """The viewer's input, or a setting of the stream."""
        if '"bitrate"' in text:
            try:
                mbps = float(json.loads(text)["mbps"])
            except (ValueError, KeyError, TypeError):
                return
            GLib.idle_add(self.bitrate, min(20.0, max(0.5, mbps)))
        else:
            remote.handle(text)

    def bitrate(self, mbps):
        """The hardware encoder's bit rate, changed while it runs (V4L2
        controls are applied when set on an open device); the VP8 path has
        no such setting."""
        encoder = self.pipeline.get_by_name("enc")
        if encoder is not None:
            encoder.set_property("extra-controls", Gst.Structure.new_from_string(
                f"controls,video_bitrate={int(mbps * 1e6)}"))
            log_line(f"bit rate {mbps} Mbit/s")
        return GLib.SOURCE_REMOVE

    def negotiate(self, _element):
        promise = Gst.Promise.new_with_change_func(self.offered, None)
        self.webrtc.emit("create-offer", None, promise)

    def offered(self, promise, _data):
        # The reply owns the offer: it has to outlive this call's use of it.
        reply = promise.get_reply()
        offer = reply.get_value("offer")
        self.webrtc.emit("set-local-description", offer, Gst.Promise.new())

    def gathering(self, _element, _spec):
        state = self.webrtc.get_property("ice-gathering-state")
        if state == GstWebRTC.WebRTCICEGatheringState.COMPLETE:
            local = self.webrtc.get_property("local-description")
            self.offer = local.sdp.as_text()
            self.offer_ready.set()

    def connection(self, _element, _spec):
        state = self.webrtc.get_property("ice-connection-state")
        if state in (
            GstWebRTC.WebRTCICEConnectionState.FAILED,
            GstWebRTC.WebRTCICEConnectionState.CLOSED,
        ):
            GLib.idle_add(end_session, self)

    def answer(self, text):
        _result, sdp = GstSdp.SDPMessage.new_from_text(text)
        answer = GstWebRTC.WebRTCSessionDescription.new(
            GstWebRTC.WebRTCSDPType.ANSWER, sdp
        )
        self.webrtc.emit("set-remote-description", answer, Gst.Promise.new())

    def stop(self):
        if self.keyframes:
            GLib.source_remove(self.keyframes)
        self.pipeline.set_state(Gst.State.NULL)
        self.proc.terminate()
        try:
            self.proc.wait(timeout=3)
        except subprocess.TimeoutExpired:
            self.proc.kill()
        self.proc.stdout.close()


session = None
session_lock = threading.Lock()


def cpu_temperature():
    """The hottest CPU sensor, in degrees, or None."""
    hottest = None
    for zone in os.listdir("/sys/class/thermal"):
        base = os.path.join("/sys/class/thermal", zone)
        try:
            with open(os.path.join(base, "type")) as f:
                if not f.read().startswith("cpu"):
                    continue
            with open(os.path.join(base, "temp")) as f:
                t = int(f.read()) / 1000
        except (OSError, ValueError):
            continue
        hottest = t if hottest is None else max(hottest, t)
    return None if hottest is None else round(hottest, 1)


def capture_fps():
    return int(Handler.size.split("@")[1]) if Handler.size else None


def set_fps(fps):
    """A new capture rate from the page: the capture commands, the raw
    frames' rate and the keyframe period change, the menu's setting with
    them, and the viewer's session ends; its page connects again."""
    Handler.size = Handler.size.split("@")[0] + f"@{fps}"
    for command in Handler.capture.values():
        for i, arg in enumerate(command[:-1]):
            if arg == "-r":
                command[i + 1] = str(fps)
            elif arg == "-p" and command[i + 1].startswith("g="):
                command[i + 1] = f"g={fps}"
    state = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    try:
        with open(os.path.join(state, "pro1x-stream-fps"), "w") as f:
            f.write(f"{fps}\n")
    except OSError:
        pass
    log_line(f"capture rate {fps} fps")
    with session_lock:
        current = session
    if current:
        GLib.idle_add(end_session, current)


def end_session(old):
    global session
    with session_lock:
        if session is old:
            session = None
    old.stop()
    return GLib.SOURCE_REMOVE


def new_session(command, codec, size, created):
    """Runs in the main loop, where GStreamer's signals are handled."""
    global session
    with session_lock:
        old, session = session, Session(command, codec, size)
        created["session"] = session
    if old:
        old.stop()
    created["done"].set()
    return GLib.SOURCE_REMOVE


class Handler(BaseHTTPRequestHandler):
    # Not "command": the HTTP request's method goes there.
    capture = {}
    size = ""
    key = ""          # --key: every request carries it as ?k=

    def allowed(self):
        if not self.key:
            return True
        query = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
        given = query.get("k", [""])[0]
        if hmac.compare_digest(given.encode(), self.key.encode()):
            return True
        self.reply(b"forbidden: the link's key is missing or wrong", code=403)
        return False

    def reply(self, body, kind="text/plain", code=200):
        self.send_response(code)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        path = self.path.split("?")[0]
        # The page itself asks for the key, so it comes without one.
        if path == "/":
            self.reply(INTERACTIVE_PAGE if remote else PAGE,
                       "text/html; charset=utf-8")
            return
        if not self.allowed():
            return
        if path == "/check":
            self.reply(b"ok")
        elif path == "/status":
            self.reply(json.dumps({"cpu": cpu_temperature(),
                                   "fps": capture_fps()}).encode(),
                       "application/json")
        elif path == "/settings":
            try:
                with open(SETTINGS, "rb") as f:
                    self.reply(f.read(), "application/json")
            except OSError:
                self.reply(b"{}", "application/json")
        elif self.path.startswith("/offer"):
            query = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
            codec = "h264" if query.get("codec") == ["h264"] else "vp8"
            created = {"done": threading.Event()}
            GLib.idle_add(new_session, self.capture[codec], codec, self.size, created)
            if (
                created["done"].wait(10)
                and created["session"].offer_ready.wait(15)
            ):
                self.reply(created["session"].offer.encode())
            else:
                self.reply(b"no offer", code=500)
        else:
            self.reply(b"not found", code=404)

    def do_POST(self):
        if not self.allowed():
            return
        path = self.path.split("?")[0]
        if path == "/fps":
            query = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
            try:
                fps = int(query.get("fps", [""])[0])
            except ValueError:
                fps = 0
            if not 5 <= fps <= 60 or not self.size:
                self.reply(b"bad rate", code=400)
                return
            set_fps(fps)
            self.reply(b"ok")
            return
        if path == "/settings":
            text = self.rfile.read(min(int(self.headers["Content-Length"]), 2048))
            try:
                kept = json.loads(text)
                assert isinstance(kept, dict) and all(
                    isinstance(v, (bool, int, float)) for v in kept.values())
            except (ValueError, AssertionError):
                self.reply(b"bad settings", code=400)
                return
            os.makedirs(os.path.dirname(SETTINGS), exist_ok=True)
            with open(SETTINGS + ".new", "w") as f:
                json.dump(kept, f)
            os.replace(SETTINGS + ".new", SETTINGS)
            self.reply(b"ok")
            return
        if path == "/log":
            text = self.rfile.read(min(int(self.headers["Content-Length"]), 4096))
            log_line(self.client_address[0] + " " + text.decode(errors="replace"))
            self.reply(b"ok")
            return
        if path != "/answer":
            self.reply(b"not found", code=404)
            return
        text = self.rfile.read(int(self.headers["Content-Length"])).decode()
        with session_lock:
            current = session
        if current:
            GLib.idle_add(lambda: current.answer(text) or GLib.SOURCE_REMOVE)
            self.reply(b"ok")
        else:
            self.reply(b"no session", code=409)

    def log_message(self, *_args):
        pass


def main_loop():
    """A loop that SIGTERM and SIGINT end."""
    loop = GLib.MainLoop()

    def quit_loop(*_args):
        # Stopping a pipeline with a viewer half connected can hang (seen
        # 2026-11-18, the interactive offer unanswered): out within 3 s.
        threading.Timer(3, lambda: os._exit(0)).start()
        loop.quit()

    signal.signal(signal.SIGTERM, quit_loop)
    signal.signal(signal.SIGINT, quit_loop)
    GLib.timeout_add(500, lambda: GLib.SOURCE_CONTINUE)  # lets Python see signals
    return loop


def send_udp(host, port, size, command):
    proc = subprocess.Popen(command, stdout=subprocess.PIPE)
    pipeline = Gst.parse_launch(
        f"{raw_source(proc.stdout.fileno(), size)} ! {hardware(size)} ! "
        f"mpegtsmux alignment=7 ! udpsink host={host} port={port} sync=false"
    )
    loop = main_loop()
    bus = pipeline.get_bus()
    bus.add_signal_watch()
    bus.connect("message::error", lambda *_args: loop.quit())
    keep_keyframes(pipeline)
    pipeline.set_state(Gst.State.PLAYING)
    try:
        loop.run()
    finally:
        pipeline.set_state(Gst.State.NULL)
        proc.terminate()


def main():
    Gst.init(None)
    if sys.argv[1:2] == ["udp"] and len(sys.argv) > 5:
        send_udp(sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5:])
        return
    global remote
    args = sys.argv[1:]
    if args[:1] == ["--raw"]:
        Handler.size, args = args[1], args[2:]
    if args[:1] == ["--key"]:
        Handler.key, args = args[1], args[2:]
    if args[:1] == ["--interactive"]:
        args = args[1:]
        remote = Remote()
        log_line("started")
    if "--" not in args[1:]:
        sys.exit(__doc__.splitlines()[0])
    split = args.index("--", 1)
    Handler.capture = {"h264": args[1:split], "vp8": args[split + 1:]}
    server = ThreadingHTTPServer(("0.0.0.0", int(args[0])), Handler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    loop = main_loop()
    try:
        loop.run()
    finally:
        with session_lock:
            current = session
        if current:
            current.stop()


if __name__ == "__main__":
    main()
