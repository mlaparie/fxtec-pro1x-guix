  const r = (canvas ? c : v).getBoundingClientRect();
  const vw = v.videoWidth || r.width, vh = v.videoHeight || r.height;
  const s = Math.min(r.width / vw, r.height / vh), dw = vw * s, dh = vh * s;
  const x = (e.clientX - r.left - (r.width - dw) / 2) / dw;
  const y = (e.clientY - r.top - (r.height - dh) / 2) / dh;
  return {x: Math.min(1, Math.max(0, x)), y: Math.min(1, Math.max(0, y))};
