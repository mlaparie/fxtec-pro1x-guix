def caffeine_off():
    try:
        with open(CAFFEINE) as f:
            if f.read().strip() != "on":
                return
    except OSError:
        return
    subprocess.run(["sway-quick-actions", "--act", "caffeine"], timeout=10,
                   stdin=subprocess.DEVNULL, capture_output=True)


def end_session(old):
    global session
    with session_lock:
        if session is old:
            session = None
    old.stop(background=True)
    return GLib.SOURCE_REMOVE


rate_restart = [None]
# When the last session stopped: the next waits until 3 s after it.  Every
# power-off with the portal capture came as one session's encoder closed and
# the next opened at once (2026-11-18); with wf-recorder the next encoder
# opens only after its first frame, a second later.
last_stop = [0.0]


def new_session(command, codec, size, created, direct=False):
    """Runs in the main loop, where GStreamer's signals are handled."""
    global session
    # The old session ends before the new one starts: overlapping, two
    # encoder sessions powered the phone off (2026-11-18, each time a viewer
    # reconnected).  With wf-recorder, 3 s between them; the producer's
    # viewers have no encoder of their own.
    with session_lock:
        old, session = session, None
    if old:
        old.stop(background=True)
    wait = last_stop[0] + 3 - time.monotonic()
    if wait > 0 and not producer:
        time.sleep(wait)
    with session_lock:
        session = Session(command, codec, size, Handler.mbps, direct)
        created["session"] = session
    created["done"].set()
    return GLib.SOURCE_REMOVE


class DirectViewer:
    """A DIRECT page's WebSocket: each encoded access unit as one binary
    message, its header as the page reads it (frame number, index 0, count
    1, keyframe flag, the time it left the encoder in ms, the encoder's
    delay in ms).  While the network is behind (a frame waiting here, or
    more than UNSENT bytes not yet sent by TCP), the producer gives the
    encoder no new frame: nothing encoded is dropped, so no keyframe is
    needed after a stall, and the delay stays bounded (Tesor, a WebSocket
    stream for car browsers, also measures what its socket carries).
    Dropping encoded frames turned each Wi-Fi stall into 2-3 s frozen
    while a keyframe crossed the same link (2026-11-20).  Only a full
    queue still skips to a keyframe.  One viewer at a time: a new one ends
    the old."""

    UNSENT = 48 * 1024          # about 0.2 s at 2 Mbit/s

    current = None
    GUID = b"258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

    def __init__(self, sock):
        self.sock = sock
        self.frames = queue.Queue(maxsize=12)
        self.seq = 0
        self.alive = True

    def send(self, data, key, enc_ms=0):
        if not self.alive:
            return False
        self.seq = (self.seq + 1) & 0xFFFFFFFF
        head = struct.pack(">IHHBQH", self.seq, 0, 1, 1 if key else 0,
                           int(time.time() * 1000), min(enc_ms, 65535))
        try:
            self.frames.put_nowait(head + data)
            return True
        except queue.Full:
            return False

    def behind(self):
        """Whether the network has not caught up: a frame waiting, or TCP
        holding more than UNSENT bytes (TIOCOUTQ: not sent or not yet
        acknowledged)."""
        if not self.frames.empty():
            return True
        try:
            import fcntl
            import termios
            out = fcntl.ioctl(self.sock, termios.TIOCOUTQ, b"\0\0\0\0")
            return struct.unpack("i", out)[0] > self.UNSENT
        except OSError:
            return False

    def run(self):
        """Writes the frames until the page goes (in its HTTP thread).
        A small send buffer and no Nagle delay: with the system's own
        buffer, megabytes of frames waited in TCP behind this queue, drawn
        4 to 9 s late (2026-11-20); now the backlog shows here, where the
        newest frame wins."""
        import socket
        try:
            self.sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
            self.sock.setsockopt(socket.SOL_SOCKET, socket.SO_SNDBUF, 256 * 1024)
        except OSError:
            pass
        if DirectViewer.current:
            DirectViewer.current.alive = False
        DirectViewer.current = self
        if producer:
            producer.attach_direct(self.send)
        log_line("direct: viewer connected")
        try:
            while self.alive:
                try:
                    msg = self.frames.get(timeout=1)
                except queue.Empty:
                    continue
                n = len(msg)
                if n < 126:
                    frame = struct.pack(">BB", 0x82, n)
                elif n < 65536:
                    frame = struct.pack(">BBH", 0x82, 126, n)
                else:
                    frame = struct.pack(">BBQ", 0x82, 127, n)
                self.sock.sendall(frame + msg)
        except OSError:
            pass
        self.alive = False
        if producer:
            producer.detach_direct(self.send)
        log_line("direct: viewer gone")


class Handler(BaseHTTPRequestHandler):
    screen_waiting = None           # client or multi-monitor, until a viewer
    # Not "command": the HTTP request's method goes there.
    capture = {}
    size = ""
    target = 0        # the capture rate chosen (the heat limit may hold it lower)
    key = ""          # --key: every request carries it as ?k=
    mbps = 6.0        # the encoder's bit rate, from the page

    # --visibility hotspot: only the phone's hotspot (and the phone itself).
    only_hotspot = False

    def allowed(self):
        if self.only_hotspot:
            ip = self.client_address[0]
            if not (ip.startswith("10.42.0.") or ip == "127.0.0.1"):
                self.reply(b"forbidden: this stream is for the phone's hotspot only", code=403)
                return False
        if not self.key:
            return True
        query = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
        given = query.get("k", [""])[0]
        if hmac.compare_digest(given.encode(), self.key.encode()):
            return True
        self.reply(b"forbidden: the link's key is missing or wrong", code=403)
        return False

    def reply(self, body, kind="text/plain", code=200):
        self.send_response(code)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        path = self.path.split("?")[0]
        # The page itself asks for the key, so it comes without one.
        if path == "/":
            self.reply(INTERACTIVE_PAGE if remote else PAGE,
                       "text/html; charset=utf-8")
            return
        if not self.allowed():
            return
        if path == "/video" and self.headers.get("Upgrade", "").lower() == "websocket":
            accept = base64.b64encode(hashlib.sha1(
                self.headers.get("Sec-WebSocket-Key", "").encode() + DirectViewer.GUID).digest())
            self.send_response(101)
            self.send_header("Upgrade", "websocket")
            self.send_header("Connection", "Upgrade")
            self.send_header("Sec-WebSocket-Accept", accept.decode())
            self.end_headers()
            self.wfile.flush()
            self.close_connection = True
            DirectViewer(self.connection).run()
            return
        if path == "/check":
            self.reply(b"ok")
        elif path == "/status":
            self.reply(json.dumps({"cpu": cpu_temperature(),
                                   "fps": capture_fps(),
                                   "target": Handler.target,
                                   "mbps": producer.mbps if producer else Handler.mbps,
                                   "wifi_powersave": wifi_powersave(),
                                   "live": producer.rate() if producer else None,
                                   "screen": screen.mode if screen else "phone",
                                   "screen_mode": (screen.mode if screen else
                                                   Handler.screen_waiting or "phone"),
                                   "size": Handler.size.split("@")[0] if Handler.size else None,
                                   "long": capture_long(),
                                   "locked": phone_locked(),
                                   "waiting": Handler.screen_waiting}).encode(),
                       "application/json")
        elif path == "/settings":
            try:
                with open(SETTINGS, "rb") as f:
                    self.reply(f.read(), "application/json")
            except OSError:
                self.reply(b"{}", "application/json")
        elif self.path.startswith("/offer"):
            query = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
            codec = "h264" if query.get("codec") == ["h264"] else "vp8"
            # The page's rate, unless the producer's encoder has its own: a
            # different rate for each page restarted the server for each,
            # and two pages open kept it restarting (2026-11-19).  Its rate
            # changes by APPLY.
            if not producer:
                try:
                    Handler.mbps = min(20.0, max(0.5, float(query["mbps"][0])))
                except (KeyError, ValueError, IndexError):
                    pass
            if approval:
                st = approval.check(self.client_address[0])
                if st != "allowed":
                    self.reply(st.encode(), code=202 if st == "waiting" else 403)
                    return
            if Handler.screen_waiting and not screen and producer:
                # The first viewer: the server again with its screen, at the
                # page's window's shape when it sends it (w, h), so that no
                # second restart follows to fit it (each restart reloads the
                # page); the page retries on 503 until it is up.
                Handler.screen_waiting = None
                try:
                    width, height = int(query["w"][0]), int(query["h"][0])
                    if 320 <= width <= 3840 and 320 <= height <= 3840:
                        with open(Screen.SIZE, "w") as f:
                            f.write(f"{width - width % 16}x{height - height % 16}\n")
                except (KeyError, ValueError, IndexError, OSError):
                    pass
                os.environ["PRO1X_STREAM_SCREEN_NOW"] = "1"
                self.reply(b"making its screen", code=503)
                GLib.idle_add(lambda: reexec() and False)
                return
            created = {"done": threading.Event()}
            GLib.idle_add(new_session, self.capture[codec], codec, self.size, created,
                          query.get("direct") == ["1"])
            if (
                created["done"].wait(10)
                and created["session"].offer_ready.wait(15)
            ):
                self.reply(created["session"].offer.encode())
            else:
                self.reply(b"no offer", code=500)
        else:
            self.reply(b"not found", code=404)

    def do_POST(self):
        if not self.allowed():
            return
        path = self.path.split("?")[0]
        if path == "/screen":
            # The page's screen mode button: kept as the menu's setting, the
            # old screen taken down, the server started again with the new.
            query = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
            mode = query.get("mode", [""])[0]
            if mode not in ("phone", "client", "multi-monitor") or "--screen" not in own_args:
                self.reply(b"bad mode", code=400)
                return
            self.reply(b"ok")
            GLib.idle_add(switch_screen, mode)
            return
        if path == "/fps":
            query = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
            try:
                fps = int(query.get("fps", [""])[0])
            except ValueError:
                fps = 0
            if not 5 <= fps <= 60 or not self.size:
                self.reply(b"bad rate", code=400)
                return
            Handler.target = fps
            set_fps(fps)
            self.reply(b"ok")
            return
        if path == "/size":
            query = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
            try:
                long = int(query.get("long", [""])[0])
            except ValueError:
                long = 0
            if long not in (960, 1280, 1600, 1920) or not self.size:
                self.reply(b"bad size", code=400)
                return
            set_size(long)
            self.reply(b"ok")
            return
        if path == "/apply":
            # The page's rate, fps and size together: one restart.
            query = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)

            def number(name, kind):
                try:
                    return kind(query[name][0])
                except (KeyError, ValueError, IndexError):
                    return None
            mbps, fps, long = number("mbps", float), number("fps", int), number("long", int)
            width, height = number("w", int), number("h", int)
            if width is not None or height is not None:
                # The stream's own output at the viewer's window's shape.
                if (not screen or width is None or height is None
                        or not (160 <= width <= 1920 and 160 <= height <= 1920)):
                    self.reply(b"bad size", code=400)
                    return
                # Multiples of 16 (H.264's blocks; see fitted in the page).
                width, height = width // 16 * 16, height // 16 * 16
                Handler.size = f"{width}x{height}@" + Handler.size.split("@")[1]
                try:
                    with open(Screen.SIZE, "w") as f:
                        f.write(f"{width}x{height}\n")
                except OSError:
                    pass
                log_line(f"screen size {width}x{height}")
                long = None
            if ((fps is not None and not 5 <= fps <= 60)
                    or (long is not None and long not in (960, 1280, 1600, 1920))
                    or ((fps or long) and not self.size)):
                self.reply(b"bad setting", code=400)
                return
            if mbps is not None:
                Handler.mbps = min(20.0, max(0.5, mbps))
                log_line(f"bit rate {Handler.mbps} Mbit/s")
            if long is not None:
                set_size(long, restart=False)
            if fps is not None:
                Handler.target = fps
                set_fps(fps, restart=False)
            GLib.idle_add(lambda: restart_session() or GLib.SOURCE_REMOVE)
            self.reply(b"ok")
            return
        if path == "/settings":
            text = self.rfile.read(min(int(self.headers["Content-Length"]), 2048))
            try:
                kept = json.loads(text)
                # Numbers, switches and short words (the input mode): with
                # numbers only, every save since the input mode was refused,
                # and a new browser got the defaults (author, 2026-11-19).
                assert isinstance(kept, dict) and all(
                    isinstance(v, (bool, int, float))
                    or (isinstance(v, str) and len(v) <= 16)
                    for v in kept.values())
            except (ValueError, AssertionError):
                self.reply(b"bad settings", code=400)
                return
            os.makedirs(os.path.dirname(SETTINGS), exist_ok=True)
            with open(SETTINGS + ".new", "w") as f:
                json.dump(kept, f)
            os.replace(SETTINGS + ".new", SETTINGS)
            if producer:
                producer.steady = bool(kept.get("steady", True))
                producer.adaptive = bool(kept.get("adaptive", True))
                if not producer.adaptive:
                    producer.limit = producer.fps
            wifi_hold(bool(kept.get("wifi_awake", True)))
            self.reply(b"ok")
            return
        if path == "/log":
            text = self.rfile.read(min(int(self.headers["Content-Length"]), 4096))
            log_line(self.client_address[0] + " " + text.decode(errors="replace"))
            self.reply(b"ok")
            return
        if path != "/answer":
            self.reply(b"not found", code=404)
            return
        text = self.rfile.read(int(self.headers["Content-Length"])).decode()
        with session_lock:
            current = session
        if current:
            GLib.idle_add(lambda: current.answer(text) or GLib.SOURCE_REMOVE)
            self.reply(b"ok")
        else:
            self.reply(b"no session", code=409)

    def log_message(self, *_args):
        pass


def main_loop():
    """A loop that SIGTERM and SIGINT end."""
    loop = GLib.MainLoop()

    def quit_loop(*_args):
        # Stopping a pipeline with a viewer half connected can hang (seen
        # 2026-11-18, the interactive offer unanswered): out within 8 s.
        threading.Timer(8, lambda: os._exit(0)).start()
        loop.quit()

    signal.signal(signal.SIGTERM, quit_loop)
    signal.signal(signal.SIGINT, quit_loop)
    GLib.timeout_add(500, lambda: GLib.SOURCE_CONTINUE)  # lets Python see signals
    return loop


def send_udp(host, port, size, command):
    proc = subprocess.Popen(command, stdout=subprocess.PIPE)
    pipeline = Gst.parse_launch(
        f"{raw_source(proc.stdout.fileno(), size)} ! {hardware(size, gop=3)} ! "
        f"mpegtsmux alignment=7 ! udpsink host={host} port={port} sync=false"
    )
    loop = main_loop()
    bus = pipeline.get_bus()
    bus.add_signal_watch()
    bus.connect("message::error", lambda *_args: loop.quit())
    keep_keyframes(pipeline, every=3)
    pipeline.set_state(Gst.State.PLAYING)
    try:
        loop.run()
    finally:
        pipeline.set_state(Gst.State.NULL)
        proc.terminate()


def main():
    Gst.init(None)
    if sys.argv[1:2] == ["udp"] and len(sys.argv) > 5:
        send_udp(sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5:])
        return
    global remote, portal, producer
    args = sys.argv[1:]
    if args[:1] == ["--raw"]:
        Handler.size, args = args[1], args[2:]
    if args[:1] == ["--key"]:
        Handler.key, args = args[1], args[2:]
        own_args.extend(["--key", Handler.key])
    tls = None
    if args[:1] == ["--tls"]:
        own_args.extend(args[:2])
        tls, args = int(args[1]), args[2:]
    global approval, screen
    if args[:1] == ["--screen"]:
        own_args.extend(args[:2])
        # The screen of its own only once a viewer connects (author,
        # 2026-11-20: made at start, it resized the phone's windows for
        # nobody): until then the panel; the first viewer's offer starts
        # the server again with it (PRO1X_STREAM_SCREEN_NOW, kept over
        # later restarts).
        if (args[1] in ("client", "multi-monitor") and Handler.size
                and os.environ.get("PRO1X_STREAM_SCREEN_NOW") != "1"):
            Handler.screen_waiting = args[1]
            log_line(f"{args[1]} screen once a viewer connects")
        elif args[1] in ("client", "multi-monitor") and Handler.size:
            Handler.size = Screen.kept(Handler.size)
            try:
                screen = Screen(args[1], Handler.size)
            except (OSError, RuntimeError, subprocess.TimeoutExpired) as e:
                log_line(f"no screen of its own ({e}): the panel")
        args = args[2:]
    if args[:1] == ["--approve"]:
        own_args.extend(args[:2])
        if args[1] in ("tap", "fingerprint"):
            approval = Approval(args[1])
            log_line(f"viewers approved on the phone ({args[1]})")
        args = args[2:]
    if args[:1] == ["--visibility"]:
        own_args.extend(args[:2])
        Handler.only_hotspot = args[1] == "hotspot"
        args = args[2:]
    if args[:1] == ["--portal"] and SCREENCAST:
        # The helper captures by itself: no portal session.
        own_args.extend(args[:2])
        portal = "screencast"
        args = args[2:]
    if args[:1] == ["--portal"]:
        own_args.extend(args[:2])
        try:
            # The stream's own output is not turned.
            portal = Portal("normal" if screen else args[1])
            log_line("capture by the ScreenCast portal")
        except (GLib.Error, RuntimeError, KeyError, IndexError, OSError) as e:
            log_line(f"no ScreenCast portal ({e}): wf-recorder")
        args = args[2:]
    if screen and not portal:
        # wf-recorder records the panel: no screen of its own without the
        # portal.
        log_line("no screen of its own without the ScreenCast portal")
        screen.stop()
        screen = None
    # Set by reexec, else the rate the page kept on the phone.
    try:
        Handler.mbps = float(os.environ.pop("PRO1X_STREAM_MBPS"))
    except (KeyError, ValueError):
        try:
            Handler.mbps = min(20.0, max(0.5, float(kept_setting("rate", Handler.mbps))))
        except (ValueError, TypeError):
            pass
    if Handler.size:
        Handler.target = int(os.environ.pop("PRO1X_STREAM_TARGET", "0")) or \
            int(Handler.size.split("@")[1])
    if portal == "screencast" and Handler.size:
        try:
            producer = Screencast(screen.name if screen else "DSI-1",
                                  Handler.size, Handler.mbps)
        except OSError as e:
            log_line(f"pro1x-screencast failed to start ({e})")
    elif portal and Handler.size:
        try:
            producer = Producer(portal, Handler.size, Handler.mbps)
        except (GLib.Error, RuntimeError, KeyError, IndexError) as e:
            log_line(f"no ScreenCast portal ({e}): wf-recorder")
    caffeinated[0] = os.environ.pop("PRO1X_STREAM_CAFFEINE", "") == "1"
    # Held by the server before a reexec, and still held.
    wifi_held[0] = os.environ.pop("PRO1X_STREAM_WIFI", "") == "1"
    wifi_hold(bool(kept_setting("wifi_awake", True)))
    if args[:1] == ["--interactive"]:
        own_args.append("--interactive")
        args = args[1:]
        remote = Remote(screen.name if screen else "DSI-1")
        global panel_touch
        if screen and screen.mode == "client":
            try:
                panel_touch = PanelTouch(remote, Handler.size)
            except (OSError, RuntimeError, ImportError) as err:
                log_line(f"the panel's touches stay on the panel: {err}")
        log_line("started")
        try:
            caffeinated[0] = caffeine_on() or caffeinated[0]
        except (OSError, subprocess.TimeoutExpired):
            pass
        GLib.timeout_add_seconds(15, heat_check)
    if "--" not in args[1:]:
        sys.exit(__doc__.splitlines()[0])
    own_args.append(args[0])
    split = args.index("--", 1)
    Handler.capture = {"h264": args[1:split], "vp8": args[split + 1:]}
    server = ThreadingHTTPServer(("0.0.0.0", int(args[0])), Handler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    if tls:
        try:
            serve_tls(tls)
        except (OSError, subprocess.SubprocessError, ValueError) as e:
            log_line(f"no HTTPS: {e}")
    if producer:
        threading.Thread(target=watch_output, args=(screen.name if screen else "DSI-1",),
                         daemon=True).start()
    loop = main_loop()
    try:
        loop.run()
    finally:
        # What the phone shows and its Wi-Fi first, quick and what matters:
        # behind the pipelines, the end's time limit cut them off, and the
        # stream's screen, its mirror workspace and power saving stayed
        # (author, 2026-11-19).
        if panel_touch:
            panel_touch.stop()
        if screen:
            screen.stop()
        wifi_hold(False)
        if caffeinated[0]:
            try:
                caffeine_off()
            except (OSError, subprocess.TimeoutExpired):
                pass
        with session_lock:
            current = session
        if current:
            current.stop()
        if producer:
            producer.stop()


if __name__ == "__main__":
    main()
