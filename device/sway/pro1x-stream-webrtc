  s.mb = (bytes / 1e6).toFixed(1);
  s.settings = {smooth: cfg.smooth, av: cfg.av, mbps: cfg.rate, fps: cfg.fps, muted: v.muted};
  s.events = counts;
  s.temp = phone.cpu;
  if (info.style.display === "block") {
    const ev = Object.entries(counts).map(([a, b]) => a + " " + b);
