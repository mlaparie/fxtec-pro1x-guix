# HTTPS beside HTTP (--tls PORT), for browsers that refuse plain HTTP: a
# certificate browsers trust when the owner put one in
# /var/lib/pro1x/stream-tls (cert.pem, key.pem readable by the user), else
# one of the phone's own, made on first use and kept, for its addresses
# (self-signed: the browser warns once; some refuse it).
CERT = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
                    "pro1x", "stream-cert.pem")
CERT_KEY = CERT.replace("-cert.pem", "-key.pem")


# A certificate browsers trust, when the owner put one there.
TRUSTED = "/var/lib/pro1x/stream-tls"


def certificate():
    """The certificate and key files: the trusted ones if readable, else the
    phone's own, made if missing."""
    cert, key = os.path.join(TRUSTED, "cert.pem"), os.path.join(TRUSTED, "key.pem")
    if os.access(cert, os.R_OK) and os.access(key, os.R_OK):
        return cert, key
    if os.path.exists(CERT) and os.path.exists(CERT_KEY):
        return CERT, CERT_KEY
    os.makedirs(os.path.dirname(CERT), exist_ok=True)
    try:
        out = subprocess.run(["ip", "-4", "-o", "addr", "show", "scope", "global"],
                             capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        out = ""
    addresses = {"10.42.0.1", "127.0.0.1"} | {
        line.split()[3].split("/")[0] for line in out.splitlines() if len(line.split()) > 3}
    names = ",".join(["DNS:localhost"] + [f"IP:{a}" for a in sorted(addresses)])
    subprocess.run(["openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes",
                    "-days", "3650", "-subj", "/CN=pro1x",
                    "-addext", f"subjectAltName={names}",
                    "-keyout", CERT_KEY, "-out", CERT],
                   capture_output=True, timeout=60, check=True)
    os.chmod(CERT_KEY, 0o600)
    log_line("stream certificate made: " + names)
    return CERT, CERT_KEY


def serve_tls(port):
    """The same pages and offers over HTTPS on PORT."""
    import ssl
    cert, key = certificate()
    context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    context.load_cert_chain(cert, key)
    server = ThreadingHTTPServer(("0.0.0.0", port), Handler)
    # The handshake in the request's thread, not in the one accepting.
    server.socket = context.wrap_socket(server.socket, server_side=True,
                                        do_handshake_on_connect=False)
    threading.Thread(target=server.serve_forever, daemon=True).start()


POWERSAVE = "/run/current-system/profile/bin/pro1x-wifi-powersave"
# Guix's setuid sudo; the profile's own is not setuid.
SUDO = "/run/privileged/bin/sudo" if os.path.exists("/run/privileged/bin/sudo") else "sudo"
wifi_held = [False]


def wifi_hold(on):
    """Wi-Fi power saving off while the stream runs (the page's INFO
    checkbox, on by default), and back as it was after."""
    if on == wifi_held[0]:
        return
    try:
        done = subprocess.run([SUDO, "-n", POWERSAVE, "hold" if on else "release"],
                              timeout=10, stdin=subprocess.DEVNULL, capture_output=True)
    except (OSError, subprocess.TimeoutExpired):
        return
    if done.returncode == 0:
        wifi_held[0] = on
        log_line("Wi-Fi power saving " + ("off while streaming" if on else "as before"))
    else:
        log_line("Wi-Fi power saving unchanged: " + done.stderr.decode(errors="replace").strip()[:120])


def wifi_powersave():
    """on or off, or None without Wi-Fi."""
    try:
        out = subprocess.run(["iw", "dev", "wlan0", "get", "power_save"], timeout=5,
                             capture_output=True, text=True).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    return out.split()[-1] if out.strip() else None


def kept_setting(name, default):
    """A setting the page kept on the phone (SETTINGS), or DEFAULT."""
    try:
        with open(SETTINGS) as f:
            return json.load(f).get(name, default)
    except (OSError, ValueError, AttributeError):
        return default


class Producer:
    """The portal's capture and the encoder, made once for the server's
    life; each viewer's pipeline takes its H.264 from here (attach), from
    the next keyframe.  Opening and closing a portal session and an encoder
    for each viewer powered the phone off, as one closed and the next
    opened (2026-11-18, four times, also with a session per viewer and 3 s
    between them); the test programs, which opened both once per run, never
    did.  A new bit rate, size or frame rate starts the whole server again
    (reexec) rather than the encoder alone.

    The portal sends a frame only when the screen changes, and the encoder
    makes a keyframe only from a frame: a viewer joining a still screen got
    no picture, and the page fell back to VP8 (author, 2026-11-19).  Its
    frames also come unevenly, as the screen changes, and the picture
    jerked (author: it should be as steady as a game or a film).  So the
    capture and the encoder are two pipelines, and a clock (pace) hands the
    encoder the latest frame at exactly the chosen rate, again when nothing
    changed: up to one frame's time later, but even.  Without it (the
    page's "steady" off), frames go as they come: the encoder works only
    when the screen changes, and the phone stays cooler."""

    # The profile and level as hardware() sets them, for the offer's
    # profile-level-id.
    CAPS = ("video/x-h264,stream-format=byte-stream,alignment=au,"
            "profile=constrained-baseline,level=(string)4")

    def __init__(self, portal, size, mbps):
        self.portal, self.mbps = portal, mbps
        self.lock = threading.Lock()
        self.viewers = {}          # appsrc: still waiting for a keyframe
        self.direct = {}           # send(data, key): still waiting, as above
        self.asked_key = 0.0
        self.last = None
        self.fps = int(size.split("@")[1])
        self.limit = self.fps      # lowered while the viewer loses packets
        self.heat_cap = None       # lowered by the heat limit, in place
        self.caps = None           # the frames' caps the encoder was made for
        self.restarting = False
        self.entered = {}          # pts: when the frame entered the encoder
        self.bench = {"portal": [], "captured": [], "gpu": [], "encoded": [], "encoder": []}
        self.vinfo = (None, None)  # caps, GstVideo.VideoInfo
        self.adaptive = kept_setting("adaptive", True)
        self.paused = False        # the viewer's PAUSE: no frames encoded
        self.calm = 0              # loss checks since the last loss
        self.steady = kept_setting("steady", True)
        self.pushed_at = 0.0
        self.size = size
        self.pipeline = Gst.parse_launch(
            "appsrc name=in is-live=true format=time do-timestamp=true "
            "leaky-type=downstream max-buffers=1 ! "
            f"{hardware(size, parse=False, mbps=mbps)} ! "
            f"{self.CAPS} ! appsink name=out emit-signals=true sync=false "
            "max-buffers=4 drop=true")
        self.input = self.pipeline.get_by_name("in")
        self.encoder = self.pipeline.get_by_name("enc")
        self.pipeline.get_by_name("out").connect("new-sample", self.sample)
        bus = self.pipeline.get_bus()
        bus.add_signal_watch()
        bus.connect("message::error", lambda _b, m: log_line(
            f"encoder error: {m.parse_error()[0].message}"))
        self.keyframes = keep_keyframes(self.pipeline)
        # Frames a second from PipeWire, out of the GPU and out of the
        # encoder, in the log every 10 s.
        self.counts = {"portal": 0, "gpu": 0, "encoded": 0, "held": 0}
        self.bytes = 0
        self.pipeline.get_by_name("out").get_static_pad("sink").add_probe(
            Gst.PadProbeType.BUFFER, self.count, "encoded")
        self.encoder.get_static_pad("sink").add_probe(
            Gst.PadProbeType.BUFFER, self.entering)
        GLib.timeout_add_seconds(10, self.report)
        self.pipeline.set_state(Gst.State.PLAYING)
        self.capture = None
        self.start_capture()
        self.watcher = GLib.timeout_add_seconds(2, self.watch)
        self.running = True
        threading.Thread(target=self.pace, daemon=True).start()

    def start_capture(self):
        """A portal session and the pipeline from its frames to NV12 (the
        encoder's pipeline stays): at the start, and again when it stalls."""
        self.portal.open()
        self.capture = Gst.parse_launch(
            "identity name=frames ! appsink name=raw emit-signals=true sync=false "
            "max-buffers=1 drop=true")
        self.portal.video(self.capture, self.size, self.capture.get_by_name("frames"))
        self.capture.get_by_name("raw").connect("new-sample", self.frame)
        bus = self.capture.get_bus()
        bus.add_signal_watch()
        bus.connect("message::error", lambda _b, m: log_line(
            f"capture error: {m.parse_error()[0].message}"))
        for name, pad in (("portal", self.capture.get_by_name("pw").get_static_pad("src")),
                          ("gpu", self.capture.get_by_name("raw").get_static_pad("sink"))):
            pad.add_probe(Gst.PadProbeType.BUFFER, self.count, name)
        if PW_SYNC:
            self.capture.get_by_name("pw").get_static_pad("src").add_probe(
                Gst.PadProbeType.BUFFER, self.written)
        if BENCH:
            self.capture.get_by_name("pw").get_static_pad("src").add_probe(
                Gst.PadProbeType.BUFFER, self.bench_portal)
        self.started_at = time.monotonic()
        self.frame_at = 0.0
        self.capture.set_state(Gst.State.PLAYING)

    def watch(self):
        """A capture that never got a frame (4 s), or none for 75 s (the
        bar's clock changes every minute), starts again.  Its portal session
        could stay without buffers from its start, the back end dropping
        every frame ("out of buffers", 30 a second for 40 s, 2026-11-19)."""
        now = time.monotonic()
        if ((not self.frame_at and now - self.started_at > 4)
                or (self.frame_at and now - self.frame_at > 75)):
            log_line("capture stalled: its portal session again")
            self.capture.set_state(Gst.State.NULL)
            self.portal.close()
            time.sleep(0.5)
            self.start_capture()
        return GLib.SOURCE_CONTINUE

    def rate(self):
        """Frames a second now: the chosen rate, lowered by losses
        (adaptive) and by the heat limit."""
        return min(self.limit, self.heat_cap or self.limit)

    def frame(self, sink):
        """A new frame of the screen: to the encoder at once, unless one
        went less than 0.9 frame ago (then the clock takes the latest at
        its next tick).  Steady too: waiting for the tick cost up to a
        frame of delay (33 ms at 30 fps); the clock only repeats the last
        frame when the screen sends none."""
        sample = sink.emit("pull-sample")
        caps = sample.get_caps()
        if self.last is None:
            self.input.set_caps(caps)
            self.caps = caps.to_string()
        elif caps.to_string() != self.caps and not self.restarting:
            # A new frame size (Sway's scale changed on the captured
            # output): the encoder was made for the old one and stalled
            # until the stream was started again (author, 2026-11-20).
            self.restarting = True
            log_line(f"capture size changed ({caps.get_structure(0).get_value('width')}x"
                     f"{caps.get_structure(0).get_value('height')}): starting again")
            GLib.idle_add(lambda: restart_session() and False)
        self.last = sample.get_buffer()
        self.frame_at = time.monotonic()
        if BENCH:
            age = self.bench_age(self.last, caps)
            if age is not None:
                self.bench["captured"].append(age)
            # From PipeWire's handover (pipewiresrc's timestamp) to here:
            # the GPU stage; the rest of "captured" is Sway and the portal.
            clock = self.capture.get_clock()
            if clock and self.last.pts != Gst.CLOCK_TIME_NONE:
                self.bench["gpu"].append(
                    (clock.get_time() - self.capture.get_base_time() - self.last.pts) / 1e6)
        if (not self.paused
                and time.monotonic() - self.pushed_at >= 0.9 / self.rate()):
            if self.held():
                self.counts["held"] += 1
            else:
                self.push(self.last)
        return Gst.FlowReturn.OK

    def held(self):
        """A DIRECT viewer's network behind: no new frame for the encoder
        until it catches up (DirectViewer)."""
        with self.lock:
            sends = list(self.direct)
        return any(getattr(send, "__self__", None) is not None
                   and send.__self__.behind() for send in sends)

    def push(self, buf):
        copy = buf.copy()
        copy.pts = copy.dts = copy.duration = Gst.CLOCK_TIME_NONE
        self.input.emit("push-buffer", copy)
        self.pushed_at = time.monotonic()

    def pace(self):
        """The latest frame to the encoder every 1/fps s, on a schedule that
        does not drift; a late tick is skipped rather than made up.  Not
        steady: only the last frame again for a viewer waiting for its
        keyframe on a still screen (the encoder makes one only from a
        frame)."""
        due = time.monotonic()
        while self.running:
            step = 1 / self.rate()
            due += step
            wait = due - time.monotonic()
            if wait > 0:
                time.sleep(wait)
            elif wait < -step:
                due = time.monotonic()
            buf = self.last
            if buf is None or self.paused or self.held():
                continue
            # Steady: the last frame again only if none went this tick.
            if self.steady:
                if time.monotonic() - self.pushed_at >= 0.9 * step:
                    self.push(buf)
            elif time.monotonic() - self.pushed_at > 0.5:
                with self.lock:
                    waiting = any(self.viewers.values())
                if waiting:
                    self.push(buf)

    def loss(self, fraction):
        """The viewer's share of packets lost (its receiver reports, every
        few seconds): above 3%, a quarter fewer frames, down to 5 a second;
        after 10 s under 0.5%, 2 more, up to the fps chosen.  The bit rate
        falls with the frames (the encoder budgets each frame), which the
        encoder's own rate could not do: changing it while running killed
        its firmware.  As Parsec and Shadow lower their rate on loss.  Off
        (SET's adaptive): the fps chosen whatever the losses."""
        if not self.adaptive:
            return
        if fraction > 0.03:
            self.calm = 0
            limit = max(5, int(self.limit * 0.75))
        elif fraction < 0.005:
            self.calm += 1
            if self.calm < 5:
                return
            self.calm = 0
            limit = min(self.fps, self.limit + 2)
        else:
            self.calm = 0
            return
        if limit != self.limit:
            log_line(f"viewer lost {fraction:.0%} of packets: {limit} fps")
            self.limit = limit

    def count(self, _pad, info, name):
        self.counts[name] += 1
        if name == "encoded":
            self.bytes += info.get_buffer().get_size()
        return Gst.PadProbeReturn.OK

    def report(self):
        log_line("frames/s: " + ", ".join(f"{k} {v / 10:.1f}" for k, v in self.counts.items())
                 + f"; encoded {self.bytes * 8 / 10e6:.1f} Mbit/s")
        self.counts = dict.fromkeys(self.counts, 0)
        self.bytes = 0
        with self.lock:
            bench = {k: sorted(v) for k, v in self.bench.items()}
            for v in self.bench.values():
                v.clear()
        if any(bench.values()):
            log_line("delay ms (median/worst): " + ", ".join(
                f"{k} {v[len(v) // 2]:.0f}/{v[-1]:.0f}" for k, v in bench.items() if v))
        return GLib.SOURCE_CONTINUE

    def entering(self, _pad, info):
        """When each frame enters the encoder, by its timestamp: the
        encoder's own delay is measured on the frame that comes out."""
        buf = info.get_buffer()
        value = (self.bench_value(buf, Gst.Caps.from_string(self.caps))
                 if BENCH and self.caps else None)
        with self.lock:
            self.entered[buf.pts] = (time.monotonic(), value)
            if len(self.entered) > 64:
                del self.entered[next(iter(self.entered))]
        return Gst.PadProbeReturn.OK

    def bench_value(self, buf, caps):
        """The phone's clock (ms modulo 2^24) that scripts/stream-bench's
        test window drew on this NV12 frame, or None: 25 blocks across (24
        bits, then the phase that inverts them every other second), at
        17.5% of the height and the same inverted at 32.5%."""
        if self.vinfo[0] != caps.to_string():
            self.vinfo = (caps.to_string(), GstVideo.VideoInfo.new_from_caps(caps))
        vi = self.vinfo[1]
        if vi is None:
            return None
        w, h, stride = vi.width, vi.height, vi.stride[0]
        # Two rows only: a map from Python copies the whole frame, out of
        # gldownload's uncached memory, which held the GPU stage to 6 of
        # its 18 frames a second (2026-11-20).
        ra = buf.extract_dup(int(h * 0.175) * stride, w)
        rb = buf.extract_dup(int(h * 0.325) * stride, w)
        v = 0
        for i in range(25):
            x = int(w * (0.02 + 0.96 * (i + 0.5) / 25))
            if abs(ra[x] - rb[x]) < 60:
                return None
            v = v * 2 + (ra[x] > rb[x])
        return (v >> 1) ^ (0xffffff if v & 1 else 0)

    def written(self, _pad, info):
        """Waits until the compositor's copy into this frame has run: its
        DMA-BUF reads as ready once its writer (the GPU) is done.  wlroots
        sends "ready" as soon as it has queued the copy on the GPU; read at
        once, the buffer still held its previous frame, one turn of the
        portal's buffers earlier (about 400 ms, 2026-11-20)."""
        buf = info.get_buffer()
        start = time.monotonic()
        if PW_WAIT_MS:
            time.sleep(PW_WAIT_MS / 1000)
            return Gst.PadProbeReturn.OK
        for i in range(buf.n_memory()):
            mem = buf.peek_memory(i)
            if GstAllocators.is_dmabuf_memory(mem):
                fd = GstAllocators.dmabuf_memory_get_fd(mem)
                p = select.poll()
                p.register(fd, select.POLLIN)
                p.poll(100)
        if BENCH:
            with self.lock:
                self.bench.setdefault("written", []).append(
                    (time.monotonic() - start) * 1000)
        return Gst.PadProbeReturn.OK

    def bench_portal(self, pad, info):
        """The clock's age in the portal's own frame, before the GPU: the
        output's buffer, not turned (XR24, linear), read a pixel per block
        in each of the two ways it may be turned."""
        buf = info.get_buffer()
        caps = pad.get_current_caps()
        meta = GstVideo.buffer_get_video_meta(buf)
        if caps is None:
            return Gst.PadProbeReturn.OK
        st = caps.get_structure(0)
        bw, bh = st.get_value("width"), st.get_value("height")
        stride = meta.stride[0] if meta else bw * 4
        W, H = max(bw, bh), min(bw, bh)
        def px(bx, by):
            b = buf.extract_dup(by * stride + bx * 4 + 1, 1)
            return b[0] if b else 0
        for turn in (lambda X, Y: (Y, W - 1 - X), lambda X, Y: (H - 1 - Y, X)):
            v, ok = 0, True
            for i in range(25):
                X = int(W * (0.02 + 0.96 * (i + 0.5) / 25))
                a, b = px(*turn(X, int(H * 0.175))), px(*turn(X, int(H * 0.325)))
                if abs(a - b) < 60:
                    ok = False
                    break
                v = v * 2 + (a > b)
            if ok:
                v = (v >> 1) ^ (0xffffff if v & 1 else 0)
                d = time.time_ns() // 1_000_000 % (1 << 24) - v
                with self.lock:
                    self.bench["portal"].append(d + (1 << 24) if d < -(1 << 23) else d)
                break
        return Gst.PadProbeReturn.OK

    def bench_age(self, buf, caps):
        v = self.bench_value(buf, caps)
        if v is None:
            return None
        d = time.time_ns() // 1_000_000 % (1 << 24) - v
        return d + (1 << 24) if d < -(1 << 23) else d

    def sample(self, sink):
        buf = sink.emit("pull-sample").get_buffer()
        key = not buf.has_flags(Gst.BufferFlags.DELTA_UNIT)
        with self.lock:
            viewers = [src for src, waiting in self.viewers.items()
                       if key or not waiting]
            for src in viewers:
                self.viewers[src] = False
            direct = [send for send, waiting in self.direct.items()
                      if key or not waiting]
            for send in direct:
                self.direct[send] = False
        for src in viewers:
            # Timed by each viewer's pipeline as it arrives (do-timestamp).
            copy = buf.copy()
            copy.pts = copy.dts = copy.duration = Gst.CLOCK_TIME_NONE
            src.emit("push-buffer", copy)
        # The encoder's delay: from this frame's way in (by its timestamp).
        with self.lock:
            entered = self.entered.pop(buf.pts, None)
        enc_ms = int(1000 * (time.monotonic() - entered[0])) if entered else 0
        if BENCH and entered:
            with self.lock:
                self.bench["encoder"].append(enc_ms)
            if entered[1] is not None:
                d = time.time_ns() // 1_000_000 % (1 << 24) - entered[1]
                with self.lock:
                    self.bench["encoded"].append(d + (1 << 24) if d < -(1 << 23) else d)
        if direct:
            ok, info = buf.map(Gst.MapFlags.READ)
            data = bytes(info.data) if ok else b""
            if ok:
                buf.unmap(info)
            for send in direct:
                # Behind (or not open yet): nothing more until a keyframe.
                if not send(data, key, enc_ms):
                    with self.lock:
                        if send in self.direct:
                            self.direct[send] = True
                    self.keyframe_soon()
        return Gst.FlowReturn.OK

    def keyframe_soon(self):
        """keyframe() from a streaming thread, at most once a second: each
        skip asked for one, keyframes (850 kB) filled the link, which made
        more skips (35 Mbit/s out of a 7 Mbit/s encoder, 2026-11-20).  The
        page asks again every second while it waits."""
        now = time.monotonic()
        if now - self.asked_key >= 1.0:
            self.asked_key = now
            GLib.idle_add(lambda: self.keyframe() and False)

    def attach_direct(self, send):
        """A viewer that decodes the H.264 itself (the page's DIRECT mode):
        SEND(data, key) gets each access unit from the next keyframe on,
        and returns False when it could not take it."""
        with self.lock:
            self.direct[send] = True
        self.keyframe()

    def detach_direct(self, send):
        with self.lock:
            self.direct.pop(send, None)

    def attach(self, src):
        with self.lock:
            self.viewers[src] = True
        # The viewer's own requests (the browser's, after a loss) stop at
        # its appsrc: passed on to the encoder.
        src.get_static_pad("src").add_probe(
            Gst.PadProbeType.EVENT_UPSTREAM,
            lambda _p, info: (self.keyframe()
                              if GstVideo.video_event_is_force_key_unit(info.get_event())
                              else None) or Gst.PadProbeReturn.OK)
        self.keyframe()

    def keyframe(self):
        """A keyframe from the encoder, from the next frame it gets."""
        self.encoder.get_static_pad("src").send_event(
            GstVideo.video_event_new_upstream_force_key_unit(
                Gst.CLOCK_TIME_NONE, True, 0))
        if not self.steady and self.last is not None:
            self.push(self.last)

    def detach(self, src):
        with self.lock:
            self.viewers.pop(src, None)

    def stop(self):
        if self.keyframes:
            GLib.source_remove(self.keyframes)
        self.running = False
        GLib.source_remove(self.watcher)
        self.capture.set_state(Gst.State.NULL)
        self.last = None
        self.pipeline.set_state(Gst.State.NULL)
        self.portal.close()

class Screencast(Producer):
    """The screen to H.264 by pro1x-screencast (device/stream), with no CPU
    copy of a pixel, as scrcpy does on Android: Sway copies the output into
    the helper's GPU buffers, the GPU turns, scales and converts it to NV12
    in Venus's own input buffers, and Venus encodes.  In place of the
    portal, PipeWire, the GPU stage and the encoder pipeline of Producer,
    whose frames were 0.4 s old before the encoder and which used more than
    a core in copies; the helper took 4% of a core and 69 ms from Sway's
    frame to the encoded one (2026-11-20).  The viewers are Producer's:
    RTP pipelines (attach) and DIRECT pages (attach_direct).  While a
    DIRECT page's network is behind, the helper copies no new frame (h, g
    on its stdin); k asks it for a keyframe."""

    HEAD = struct.Struct("<4sIBQQ")

    def __init__(self, output, size, mbps):
        self.portal, self.mbps = None, mbps
        self.lock = threading.Lock()
        self.viewers = {}
        self.direct = {}
        self.asked_key = 0.0
        self.last = None
        self.fps = int(size.split("@")[1])
        self.limit = self.fps
        self.heat_cap = None
        self.caps = None
        self.restarting = False
        self.entered = {}
        self.bench = {"encoder": []}
        self.adaptive = kept_setting("adaptive", True)
        self.paused = False
        self.calm = 0
        self.steady = False
        self.pushed_at = 0.0
        self.size = size
        self.keyframes = None
        self.counts = {"encoded": 0, "held": 0}
        self.bytes = 0
        self.headers = b""          # SPS and PPS, for later keyframes
        self.holding = False
        self.proc = subprocess.Popen(
            [SCREENCAST, "-o", output, "-s", size.split("@")[0], "-r", str(self.fps),
             "-b", str(int(mbps * 1e6))],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        self.running = True
        threading.Thread(target=self.read, daemon=True).start()
        threading.Thread(target=self.errors, daemon=True).start()
        threading.Thread(target=self.watch_hold, daemon=True).start()
        self.reporter = GLib.timeout_add_seconds(10, self.report)
        log_line(f"capture and encoding by pro1x-screencast ({output})")

    def tell(self, c):
        try:
            self.proc.stdin.write(c)
            self.proc.stdin.flush()
        except (OSError, ValueError):
            pass

    def errors(self):
        for line in self.proc.stderr:
            log_line("screencast: " + line.decode(errors="replace").rstrip())

    def watch_hold(self):
        """h while a DIRECT page's network is behind (or PAUSE), g after."""
        while self.running:
            hold = self.paused or self.held()
            if hold != self.holding:
                self.holding = hold
                self.tell(b"h" if hold else b"g")
            if hold:
                self.counts["held"] += 1
            time.sleep(0.02)

    def read(self):
        out = self.proc.stdout
        while self.running:
            head = out.read(self.HEAD.size)
            if len(head) < self.HEAD.size:
                break
            magic, n, key, captured, done = self.HEAD.unpack(head)
            data = out.read(n)
            if magic != b"PXSC" or len(data) < n:
                break
            key = bool(key)
            if key:
                data = self.with_headers(data)
            self.counts["encoded"] += 1
            self.bytes += len(data)
            enc_ms = max(0, (done - captured) // 1000)
            with self.lock:
                self.bench["encoder"].append(enc_ms)
            self.deliver(data, key, enc_ms)
        if self.running:
            log_line(f"pro1x-screencast ended ({self.proc.poll()})")

    def with_headers(self, data):
        """Venus puts SPS and PPS only before the first keyframe; a viewer
        joining later needs them before its own."""
        nals = re.split(b"(?=\x00\x00\x00\x01)", data)
        kinds = [x[4] & 0x1F for x in nals if len(x) > 4]
        if 7 in kinds:
            self.headers = b"".join(x for x in nals if len(x) > 4 and x[4] & 0x1F in (7, 8))
            return data
        return self.headers + data

    def deliver(self, data, key, enc_ms):
        with self.lock:
            viewers = [src for src, waiting in self.viewers.items() if key or not waiting]
            for src in viewers:
                self.viewers[src] = False
            direct = [send for send, waiting in self.direct.items() if key or not waiting]
            for send in direct:
                self.direct[send] = False
        if viewers:
            buf = Gst.Buffer.new_wrapped(data)
            if not key:
                buf.set_flags(Gst.BufferFlags.DELTA_UNIT)
            for src in viewers:
                src.emit("push-buffer", buf)
        for send in direct:
            if not send(data, key, enc_ms):
                with self.lock:
                    if send in self.direct:
                        self.direct[send] = True
                self.keyframe_soon()

    def keyframe(self):
        self.tell(b"k")

    def report(self):
        log_line("frames/s: " + ", ".join(f"{k} {v / 10:.1f}" for k, v in self.counts.items())
                 + f"; encoded {self.bytes * 8 / 10e6:.1f} Mbit/s")
        self.counts = dict.fromkeys(self.counts, 0)
        self.bytes = 0
        with self.lock:
            enc = sorted(self.bench["encoder"])
            self.bench["encoder"].clear()
        if enc:
            log_line(f"delay ms, Sway's frame to encoded (median/worst): "
                     f"{enc[len(enc) // 2]}/{enc[-1]}")
        return GLib.SOURCE_CONTINUE

    def stop(self):
        self.running = False
        GLib.source_remove(self.reporter)
        self.tell(b"q")
        try:
            self.proc.wait(timeout=3)
        except subprocess.TimeoutExpired:
            self.proc.kill()


