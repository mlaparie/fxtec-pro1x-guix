    for (let i = 0; i < ev.length; i += 3) rows.push("  " + ev.slice(i, i + 3).join("  "));
    it.textContent = [
      `screen  ${s.w}x${s.h}  video ${s.video}`,
      `mode    ${s.mode}, ${cfg.input}, ${v.muted ? "muted" : "sound"}${captured ? ", captured" : ""}`,
      `fps     ${s.fps}  decoded ${s.decoded}  dropped ${s.dropped}`,
      `rate    ${s.kbps} kbit/s  (set ${cfg.rate} Mbit/s, ${cfg.fps} fps)`,
      `data    ${s.mb} MB so far`,
      `buffer  video ${s.buffer_ms} ms, sound ${s.audio_buffer_ms} ms`,
      `set     smooth ${cfg.smooth} ms, a/v ${cfg.av} ms`,
      `network rtt ${s.rtt_ms} ms, ${s.codec}`,
      `phone   CPU ${phone.cpu === undefined ? "?" : phone.cpu + " C"}, last 10 min:`,
    ].concat(rows.length ? ["events"].concat(rows) : []).join("\\n");
  }
  if (++ticks % 10 === 0) log(Object.assign({ev: "stats"}, s));
}, 1000);

// Touch: touches, as on the Pro1x's own screen.  Mouse: an absolute pointer
// (a tap clicks, a drag drags, a long press right-clicks, two fingers
// scroll).  Pad: a touchpad moving the Pro1x's pointer from where it is (a
// tap clicks, two fingers tap to right-click and drag to scroll, a press
// held then moved drags).  Positions in the picture, 0 to 1.
