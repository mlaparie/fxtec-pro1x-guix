                ["wl-mirror", "--fullscreen-output", "DSI-1", self.name],
                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL)
        except OSError as e:
            log_line(f"no mirror on the panel: {e}")
        time.sleep(1)
        swaymsg(f"focus output {self.name}")
        # One of the phone's workspaces in front: an empty "stream" left from
        # an earlier mode then goes (Sway drops it once it is not shown).
        mine = [w["name"] for w in sway("-t", "get_workspaces") or []
                if w["output"] == self.name and w["name"] != "stream"]
        if mine:
            swaymsg(f'workspace "{mine[0]}"')

        def guard():
            focused = next((w["output"] for w in sway("-t", "get_workspaces") or []
                            if w.get("focused")), None)
            if focused and focused != self.name:
                subprocess.run(["swaymsg", f"focus output {self.name}"],
                               capture_output=True, timeout=5)
            return GLib.SOURCE_CONTINUE
        self.guard = GLib.timeout_add_seconds(2, guard)

    @classmethod
    def kept(cls, size):
        """SIZE with the last width and height a viewer chose, if any."""
        try:
            with open(cls.SIZE) as f:
                dims = f.read().strip()
            width, height = map(int, dims.split("x"))
            width, height = width // 16 * 16, height // 16 * 16   # H.264's blocks
            return f"{width}x{height}@{size.split('@')[1]}"
        except (OSError, ValueError):
            return size

    def stop(self, keep=False):
        if self.guard:
            GLib.source_remove(self.guard)
            self.guard = None
        if self.mirror:
            self.mirror.terminate()
            self.mirror = None
        if keep:
            return
        try:
            os.remove(self.FILE)
        except OSError:
            pass
        # The workspace shown on the stream's screen as it ends, shown on
        # the panel after: the stream may be where it was changed (author).
        shown = [w["name"] for w in sway("-t", "get_workspaces") or []
                 if w.get("output") == self.name and w.get("visible")]
        subprocess.run(["swaymsg", f"output {self.name} unplug"], capture_output=True, timeout=5)
        # The on-screen keyboard back to the panel, if moved here.
        subprocess.run(["swaymsg", "exec pro1x-osk home"], capture_output=True, timeout=5)
        # That one if it outlived the screen, else another with windows,
        # else 1: the panel stayed on the empty "mirror" (2026-11-20), which
        # Sway then drops.
        left = [w["name"] for w in sway("-t", "get_workspaces") or []
                if w["name"] != "mirror"]
        back = next((n for n in shown if n in left), left[0] if left else "")
        subprocess.run(["swaymsg", "--", f'workspace "{back}"' if back else "workspace number 1"],
                       capture_output=True, timeout=5)


