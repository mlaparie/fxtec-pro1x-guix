setInterval(status, 5000);
setInterval(async () => {
  const s = {w: innerWidth, h: innerHeight, video: v.videoWidth + "x" + v.videoHeight,
             mode: cfg.canvas ? "canvas" : "video", hidden: document.hidden};
  let bytes = 0, rate = 0;
  (await pc.getStats()).forEach(r => {
    if (r.type === "inbound-rtp") {
      bytes += r.bytesReceived || 0;
      rate += delta(r.id, "b", r.bytesReceived || 0) * 8 / 1000;
      // The buffer over the last second, not since the start.
      const n = delta(r.id, "n", r.jitterBufferEmittedCount || 0);
      const ms = delta(r.id, "d", r.jitterBufferDelay || 0);
      if (n > 0) s[r.kind === "audio" ? "audio_buffer_ms" : "buffer_ms"] = Math.round(1000 * ms / n);
