class Session:
    """One viewer: the capture command, the pipeline, and its offer."""

    def __init__(self, command, codec, size, mbps=6.0, direct=False):
        self.mbps = mbps
        self.video_channel = None   # DIRECT: the RTP video closed after the offer
        self.offer_ready = threading.Event()
        self.offer = None
        self.producer = producer if codec == "h264" and size else None
        self.proc = (None if self.producer
                     else subprocess.Popen(command, stdout=subprocess.PIPE))
        # RTP packets of at most 1200 bytes, as WebRTC usually sends: the
        # payloaders' 1400 did not fit through Tailscale (MTU 1280), where
        # only the input came through and the video stayed black.
        payload = {
            "h264": ("" if self.producer
                     else (hardware(size, mbps=mbps) if size
                           else "h264parse config-interval=-1") + " ! ")
                    + "valve name=vv ! rtph264pay config-interval=-1 pt=96 mtu=1200 ! "
                    "application/x-rtp,media=video,encoding-name=H264,payload=96"
                    # The phone's encoder: constrained baseline, level 4.  The
                    # offer had no profile-level-id, which browsers read as
                    # level 3.1, too low for 1920x960.
                    + (",profile-level-id=(string)42c028,packetization-mode=(string)1"
                       if size else ""),
            "vp8": "ivfparse ! valve name=vv ! rtpvp8pay pt=96 mtu=1200 ! "
                   "application/x-rtp,media=video,encoding-name=VP8,payload=96",
        }[codec]
        self.pipeline = Gst.parse_launch(
            (f"appsrc name=frames is-live=true format=time do-timestamp=true "
             f"leaky-type=downstream max-buffers=4 caps={Producer.CAPS}"
             if self.producer
             else raw_source(self.proc.stdout.fileno(), size) if size
             else f"fdsrc fd={self.proc.stdout.fileno()}")
            + f" ! {payload} ! "
            "webrtcbin name=w bundle-policy=max-bundle latency=0 "
            + AUDIO + " ! w."
        )
        self.webrtc = self.pipeline.get_by_name("w")
        # Picture and sound as two streams: in one, the browser lip-synced
        # them, and with the picture's timestamps counted from frames and the
        # sound's from its clock, it held the sound back 1.5 s and cut it
        # now and then (author, 2026-11-18).  Apart, each plays as it comes;
        # the page's a/v setting lines them up.
        for i, pad in enumerate(self.webrtc.sinkpads):
            if pad.find_property("msid"):
                pad.set_property("msid", f"pro1x-{i}")
        # A video packet lost on the Wi-Fi is sent again when the browser
        # asks (NACK, RTX): without it each loss cost frames until the next
        # keyframe, and the picture jerked at a steady 20 fps from the
        # encoder (2026-11-19).
        # Recovery packets (ULP FEC in RED) only with VP8: with H.264 the
        # author's Firefox showed no picture (2026-11-19), and browsers take
        # ULP FEC reliably with VP8 only.
        video = self.webrtc.emit("get-transceiver", 0)
        if video is not None:
            video.set_property("do-nack", True)
            if codec == "vp8":
                video.set_property("fec-type", GstWebRTC.WebRTCFECType.ULP_RED)
                video.set_property("fec-percentage", 20)
        self.webrtc.connect("on-negotiation-needed", self.negotiate)
        self.webrtc.connect("notify::ice-gathering-state", self.gathering)
        self.webrtc.connect("notify::ice-connection-state", self.connection)
        self.keyframes = keep_keyframes(self.pipeline)
        self.losses = (GLib.timeout_add_seconds(2, self.ask_loss)
                       if self.producer else None)
        if remote:
            # The viewer's input, in the same connection, made before the
            # offer so that the offer carries it.
            self.pipeline.set_state(Gst.State.READY)
            self.channel = self.webrtc.emit("create-data-channel", "input", None)
            self.channel.connect("on-message-string",
                                 lambda _c, text: self.message(text))
            # Moves (pointer, touch) unordered and never resent: a lost one
            # is outdated by the next, and resending held the later ones
            # back.  Clicks and keys stay on the reliable channel.
            self.fast = self.webrtc.emit(
                "create-data-channel", "fast",
                Gst.Structure.new_from_string(
                    "application/data-channel, ordered=(boolean)false, "
                    "max-retransmits=(int)0"))
            if self.fast is not None:
                self.fast.connect("on-message-string",
                                  lambda _c, text: self.message(text))
        # DIRECT: the encoder's access units go to the page by WebSocket
        # (/video, DirectViewer); the RTP video feeds the offer's parameters
        # (negotiate), then its valve closes.  A data channel for them
        # drained at about 4 kB/s in GStreamer (2026-11-20).
        self.video_channel = bool(direct and self.producer and remote)
        self.pipeline.set_state(Gst.State.PLAYING)
        if self.producer:
            self.producer.attach(self.pipeline.get_by_name("frames"))

    def message(self, text):
        """The viewer's input, a setting of the stream, or its PAUSE, PLAY
        and STOP buttons."""
        if '"t":"pause"' in text or '"t":"play"' in text:
            GLib.idle_add(self.pause, '"t":"pause"' in text)
        elif '"t":"stop"' in text:
            log_line("stopped by the viewer")
            GLib.timeout_add(300, lambda: os.kill(os.getpid(), signal.SIGTERM) and False)
        elif '"t":"keyframe"' in text:
            if self.producer:
                self.producer.keyframe_soon()
        elif '"bitrate"' in text:
            try:
                mbps = float(json.loads(text)["mbps"])
            except (ValueError, KeyError, TypeError):
                return
            GLib.idle_add(self.bitrate, min(20.0, max(0.5, mbps)))
        else:
            remote.handle(text)

    def pause(self, on):
        """Picture and sound held back (PAUSE), the encoder idle so that the
        phone cools; or back (PLAY), from a new keyframe."""
        for name in ("vv", "av"):
            valve = self.pipeline.get_by_name(name)
            if valve is not None and not (name == "vv" and self.video_channel):
                valve.set_property("drop", on)
        if self.producer:
            self.producer.paused = on
            if not on:
                self.producer.keyframe()
        else:
            encoder = self.pipeline.get_by_name("enc")
            if encoder is not None and not on:
                encoder.get_static_pad("src").send_event(
                    GstVideo.video_event_new_upstream_force_key_unit(
                        Gst.CLOCK_TIME_NONE, True, 0))
        log_line("paused by the viewer" if on else "playing again")
        return GLib.SOURCE_REMOVE

    def bitrate(self, mbps):
        """A new bit rate from the page: the session starts again with it.
        Not set on the running encoder: the Venus firmware died of it
        (Err_Fatal in vbuffer.c, as the page sent its rate on connecting),
        and its failed recovery powered the phone off (2026-11-18).  A
        second later, so that a slider's moves make one restart."""
        Handler.mbps = mbps
        if rate_restart[0]:
            GLib.source_remove(rate_restart[0])
        rate_restart[0] = GLib.timeout_add(1000, self.rate_changed)
        return GLib.SOURCE_REMOVE

    def rate_changed(self):
        rate_restart[0] = None
        if Handler.mbps != (self.producer.mbps if self.producer else self.mbps):
            log_line(f"bit rate {Handler.mbps} Mbit/s")
            restart_session()
        return GLib.SOURCE_REMOVE

    def negotiate(self, _element, tries=60):
        """The offer, with the producer once the payloader has seen the
        stream's parameters (SPS and PPS, the offer's fmtp line), from the
        first keyframe.  Offered before, the offer had no fmtp line for H.264, and
        browsers decoded nothing, then fell back to VP8 (2026-11-19)."""
        if self.producer and tries:
            caps = self.webrtc.get_static_pad("sink_0").get_current_caps()
            if caps is None or "sprop-parameter-sets" not in caps.to_string():
                GLib.timeout_add(50, self.negotiate, _element, tries - 1)
                return GLib.SOURCE_REMOVE
        if self.video_channel:
            self.pipeline.get_by_name("vv").set_property("drop", True)
        promise = Gst.Promise.new_with_change_func(self.offered, None)
        self.webrtc.emit("create-offer", None, promise)
        return GLib.SOURCE_REMOVE

    def offered(self, promise, _data):
        # The reply owns the offer: it has to outlive this call's use of it.
        reply = promise.get_reply()
        offer = reply.get_value("offer")
        self.webrtc.emit("set-local-description", offer, Gst.Promise.new())

    def gathering(self, _element, _spec):
        state = self.webrtc.get_property("ice-gathering-state")
        if state == GstWebRTC.WebRTCICEGatheringState.COMPLETE:
            local = self.webrtc.get_property("local-description")
            self.offer = local.sdp.as_text()
            self.offer_ready.set()

    def connection(self, _element, _spec):
        state = self.webrtc.get_property("ice-connection-state")
        # The keyframes sent before the connection was up are lost.
        if self.producer and state == GstWebRTC.WebRTCICEConnectionState.CONNECTED:
            GLib.idle_add(lambda: self.producer.keyframe() or GLib.SOURCE_REMOVE)
        if state in (
            GstWebRTC.WebRTCICEConnectionState.FAILED,
            GstWebRTC.WebRTCICEConnectionState.CLOSED,
        ):
            GLib.idle_add(end_session, self)

    def answer(self, text):
        _result, sdp = GstSdp.SDPMessage.new_from_text(text)
        answer = GstWebRTC.WebRTCSessionDescription.new(
            GstWebRTC.WebRTCSDPType.ANSWER, sdp
        )
        self.webrtc.emit("set-remote-description", answer, Gst.Promise.new())

    def ask_loss(self):
        self.webrtc.emit("get-stats", None,
                         Gst.Promise.new_with_change_func(self.got_loss, None))
        return GLib.SOURCE_CONTINUE

    def got_loss(self, promise, _data):
        """The video's fraction lost from the viewer's last receiver report."""
        reply = promise.get_reply()
        if reply is None:
            return
        found = []

        def each(_field, value):
            if (isinstance(value, Gst.Structure)
                    and value.get_name() == "remote-inbound-rtp"
                    and value.get_string("kind") == "video"):
                ok, fraction = value.get_double("fraction-lost")
                if ok:
                    found.append(fraction)
            return True
        reply.foreach(each)
        if found:
            GLib.idle_add(lambda: self.producer.loss(max(found)) or GLib.SOURCE_REMOVE)

    def stop(self, background=False):
        """The pipeline down.  BACKGROUND, for a producer's viewer: in a
        thread, since stopping a webrtcbin whose viewer has gone held the
        main loop for 12 s, and the next viewer's start with it
        (2026-11-19)."""
        if self.keyframes:
            GLib.source_remove(self.keyframes)
            self.keyframes = None
        if self.losses:
            GLib.source_remove(self.losses)
            self.losses = None
        if self.producer:
            self.producer.paused = False
            self.producer.detach(self.pipeline.get_by_name("frames"))
            if background:
                threading.Thread(target=self.pipeline.set_state,
                                 args=(Gst.State.NULL,), daemon=True).start()
                return
        self.pipeline.set_state(Gst.State.NULL)
        last_stop[0] = time.monotonic()
        if not self.proc:
            return
        self.proc.terminate()
        try:
            self.proc.wait(timeout=3)
        except subprocess.TimeoutExpired:
            self.proc.kill()
        self.proc.stdout.close()


