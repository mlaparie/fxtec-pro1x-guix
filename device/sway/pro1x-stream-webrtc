def cpu_temperature():
    """The hottest CPU sensor, in degrees, or None."""
    hottest = None
    for zone in os.listdir("/sys/class/thermal"):
        base = os.path.join("/sys/class/thermal", zone)
        try:
            with open(os.path.join(base, "type")) as f:
                if not f.read().startswith("cpu"):
                    continue
            with open(os.path.join(base, "temp")) as f:
                t = int(f.read()) / 1000
        except (OSError, ValueError):
            continue
        hottest = t if hottest is None else max(hottest, t)
    return None if hottest is None else round(hottest, 1)


def capture_long():
    if not Handler.size:
        return None
    width, height = map(int, Handler.size.split("@")[0].split("x"))
    return max(width, height)


def set_size(long, restart=True):
    """A new picture size from the page: the long side LONG, the short one
    in the same proportion, in the raw frames and the capture's scale
    filter (which runs before wf-recorder turns the picture, so its two
    sides are kept in their order); the menu's size setting with them; the
    viewer connects again."""
    dims, fps = Handler.size.split("@")
    width, height = map(int, dims.split("x"))
    scale = long / max(width, height)
    width = int(width * scale + 0.5) // 2 * 2
    height = int(height * scale + 0.5) // 2 * 2
    Handler.size = f"{width}x{height}@{fps}"
    command = Handler.capture["h264"]
    for i, arg in enumerate(command[:-1]):
        if arg == "-F" and command[i + 1].startswith("scale="):
            a, b = map(int, command[i + 1][6:].split(":")[:2])
            command[i + 1] = (f"scale={min(width, height)}:{max(width, height)}"
                              if a < b else f"scale={width}:{height}")
    state = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    try:
        with open(os.path.join(state, "pro1x-stream-size"), "w") as f:
            f.write(f"{long}\n")
    except OSError:
        pass
    log_line(f"picture size {width}x{height}")
    if restart:
        restart_session()


def switch_screen(mode):
    """The stream's screen mode changed from the page (main loop)."""
    global screen
    state = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    try:
        with open(os.path.join(state, "pro1x-stream-screen"), "w") as f:
            f.write(mode + "\n")
    except OSError:
        pass
    i = own_args.index("--screen")
    own_args[i + 1] = mode
    # A new screen at once (a viewer is here), none for the panel.
    if mode == "phone":
        os.environ.pop("PRO1X_STREAM_SCREEN_NOW", None)
    else:
        os.environ["PRO1X_STREAM_SCREEN_NOW"] = "1"
    os.environ.pop("PRO1X_STREAM_OUTPUT", None)
    if screen:
        screen.stop()
        screen = None
    log_line(f"screen mode {mode}, from the page")
    restart_session()
    return GLib.SOURCE_REMOVE


def restart_session():
    """The viewer's session ends, its page told to connect again; with the
    producer, the server starts again with the new settings."""
    with session_lock:
        current = session
    if current:
        channel = getattr(current, "channel", None)
        if channel is not None:
            GLib.idle_add(lambda: channel.emit("send-string", '{"t":"reconnect"}')
                          and False)
    if producer:
        GLib.timeout_add(300, reexec)
    elif current:
        GLib.timeout_add(300, end_session, current)


# The server's own arguments but --raw, for reexec; whether it turned the
# screen's caffeine on (and reexec's predecessor, if it did).
own_args = []
caffeinated = [False]


def reexec():
    """The server again, in the same process, with the size, frame rate and
    bit rate set now; the screen kept on if this one turned it on.  The
    page waits for it and connects again."""
    with session_lock:
        current = session
    if current:
        current.stop()
    producer.stop()
    os.environ["PRO1X_STREAM_MBPS"] = str(Handler.mbps)
    os.environ["PRO1X_STREAM_TARGET"] = str(Handler.target)
    if caffeinated[0]:
        os.environ["PRO1X_STREAM_CAFFEINE"] = "1"
    if wifi_held[0]:
        os.environ["PRO1X_STREAM_WIFI"] = "1"
    if screen:
        screen.stop(keep=True)
        os.environ["PRO1X_STREAM_OUTPUT"] = screen.name
    if approval:
        os.environ["PRO1X_STREAM_ALLOWED"] = ",".join(
            ip for ip, st in approval.state.items() if st == "allowed")
    log_line(f"starting again: {Handler.size}, {Handler.mbps} Mbit/s")
    argv = ([sys.argv[0], "--raw", Handler.size] + own_args
            + Handler.capture["h264"] + ["--"] + Handler.capture["vp8"])
    # Python itself: sys.executable names the Guix wrapper (exec -a), which
    # would add the script once more.
    os.execv("/proc/self/exe", ["python3"] + argv)


def capture_fps():
    return int(Handler.size.split("@")[1]) if Handler.size else None


def set_fps(fps, chosen=True, restart=True):
    """A new capture rate, from the page or the heat limit: the capture
    commands, the raw frames' rate and the keyframe period change (and the
    menu's setting, when chosen), and the viewer's session ends; its page,
    told so, connects again."""
    Handler.size = Handler.size.split("@")[0] + f"@{fps}"
    for command in Handler.capture.values():
        for i, arg in enumerate(command[:-1]):
            if arg == "-r":
                command[i + 1] = str(fps)
            elif arg == "-p" and command[i + 1].startswith("g="):
                command[i + 1] = f"g={fps}"
    state = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    if chosen:
        try:
            with open(os.path.join(state, "pro1x-stream-fps"), "w") as f:
                f.write(f"{fps}\n")
        except OSError:
            pass
    log_line(f"capture rate {fps} fps" + ("" if chosen else " (heat limit)"))
    if restart:
        restart_session()


# The heat limit (the page's "heat", in the kept settings): every 15 s,
# above it the capture rate drops 5 fps (down to 10), and 5 degrees under it
# climbs back towards the rate chosen, a minute at least between steps.
last_step = [0.0]


def heat_check():
    if not Handler.size or not Handler.target:
        return GLib.SOURCE_CONTINUE
    try:
        with open(SETTINGS) as f:
            limit = float(json.load(f).get("heat", 0))
    except (OSError, ValueError, AttributeError):
        limit = 0
    temp, fps = cpu_temperature(), capture_fps()
    if limit < 50 or temp is None or time.monotonic() - last_step[0] < 60:
        return GLib.SOURCE_CONTINUE
    # With the producer, in place: the encoder's rate, without starting the
    # server again (each heat step cut the stream, 2026-11-19).
    if producer:
        cap = producer.heat_cap or Handler.target
        if temp > limit and cap > 10:
            producer.heat_cap = max(10, cap - 5)
        elif temp < limit - 5 and cap < Handler.target:
            producer.heat_cap = min(Handler.target, cap + 5)
            if producer.heat_cap == Handler.target:
                producer.heat_cap = None
        else:
            return GLib.SOURCE_CONTINUE
        log_line(f"encoder rate {producer.rate()} fps (heat limit)")
        last_step[0] = time.monotonic()
        return GLib.SOURCE_CONTINUE
    if temp > limit and fps > 10:
        set_fps(max(10, fps - 5), chosen=False)
        last_step[0] = time.monotonic()
    elif temp < limit - 5 and fps < Handler.target:
        set_fps(min(Handler.target, fps + 5), chosen=False)
        last_step[0] = time.monotonic()
    return GLib.SOURCE_CONTINUE


# The screen stays on while the stream runs: the phone hung when it blanked
# during a stream (author, 2026-11-18).  Caffeine (quick actions) is turned
# on if it was off, and back off at the end.
CAFFEINE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "pro1x-caffeine")


def phone_locked():
    """Whether the lock screen (gtklock) is up: Sway keeps it out of screen
    captures, and the stream shows black (author, 2026-11-19)."""
    for pid in os.listdir("/proc"):
        if pid.isdigit():
            try:
                with open(f"/proc/{pid}/comm") as f:
                    if f.read().strip() == "gtklock":
                        return True
            except OSError:
                pass
    return False


def caffeine_on():
    try:
        with open(CAFFEINE) as f:
            if f.read().strip() == "on":
                return False
    except OSError:
        pass
    subprocess.run(["sway-quick-actions", "--act", "caffeine"], timeout=10,
                   stdin=subprocess.DEVNULL, capture_output=True)
