// What the browser reports, every second (logged every 10 s), in short
// lines; the phone's temperature every 5 s, its last 10 minutes drawn.
const it = document.getElementById("it");
const prev = {};
function delta(id, field, value) {
  const k = id + field, d = value - (prev[k] === undefined ? value : prev[k]);
  prev[k] = value;
  return d;
}
const temps = [], tc = document.getElementById("tc"), tctx = tc.getContext("2d");
function drawTemps() {
  tctx.clearRect(0, 0, tc.width, tc.height);
  if (temps.length < 2) return;
  const lo = Math.min(...temps) - 1, hi = Math.max(...temps) + 1;
  tctx.strokeStyle = "#f80"; tctx.lineWidth = 2; tctx.beginPath();
  temps.forEach((t, i) => {
    const x = i * tc.width / 119, y = tc.height - (t - lo) * tc.height / (hi - lo);
    i ? tctx.lineTo(x, y) : tctx.moveTo(x, y);
  });
  tctx.stroke();
}
