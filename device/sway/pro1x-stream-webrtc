def keep_keyframes(pipeline, every=10):
    """A full keyframe every EVERY s, to recover from a loss.  Each is a
    burst of data: every 3 s they filled a weak Wi-Fi link (2026-11-19);
    WebRTC viewers get lost packets again (NACK) and ask for a keyframe
    when they need one, so 10 s will do.  The UDP stream has neither: 3 s."""
    encoder = pipeline.get_by_name("enc")
    if encoder is None:
        return None

    def ask():
        encoder.get_static_pad("src").send_event(
            GstVideo.video_event_new_upstream_force_key_unit(
                Gst.CLOCK_TIME_NONE, True, 0
            )
        )
        return GLib.SOURCE_CONTINUE

    return GLib.timeout_add_seconds(every, ask)


