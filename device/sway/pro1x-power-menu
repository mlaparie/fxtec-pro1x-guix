#!/bin/sh
# pro1x-power-menu — long press on the power key: cancel, lock, blank
# screen, suspend, hibernate, log out, reboot, power off (fzf, floating
# foot window)
#
#   pro1x-power-menu              open the menu
#
# pro1x-power-button opens it on a held power key.  While it has the
# focus, the volume keys move the selection and a short power press
# confirms (pro1x-menu key), so it works with the keyboard closed (author,
# 2026-10-31).  Cancel is
# first and selected.  Power off, reboot, suspend and hibernate run as root
# through sudo rules for wheel users (no password).  The hibernation lines
# show only when it is possible (pro1x-sleep: the swap file, and this boot
# started with its resume arguments); "then hibernate" waits config.scm's
# hibernate-delay, as a line apart from Suspend so that auto-hibernate? can
# stay off (author, 2026-11-17).  Hibernation is untested.
#
# State: written 2026-10-31, not yet run on the phone.

# fzf runs its binds and previews with $SHELL -c: with fish as the login
# shell each took 1.6 s to start, and fish cannot parse the sh in them
# (2026-11-06).  The user's own fzf in a terminal keeps $SHELL.
case "${FZF_DEFAULT_OPTS:-}" in
    *--with-shell=*) ;;
    *) export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:+$FZF_DEFAULT_OPTS }--with-shell='sh -c'" ;;
esac

sock="${XDG_RUNTIME_DIR:-/tmp}/pro1x-power-menu.sock"

case "${1:-}" in
    --menu|--lines|--resident) ;;
    # Resident in the scratchpad (pro1x-menu start powermenu, at login):
    # shown and hidden like the other menus.
    *) exec pro1x-menu toggle powermenu ;;
esac

HIBERNATE_DELAY=
[ -r /etc/pro1x/sleep.conf ] && . /etc/pro1x/sleep.conf
# As pro1x-sleep's hibernate_ready.
hibernate_ready() {
    [ -r /var/lib/pro1x/resume ] && [ -r /boot/boot/extlinux/extlinux.conf ] &&
        swapon --show=NAME --noheadings 2>/dev/null | grep -qx /swap/swapfile &&
        grep -qF -- "$(cat /var/lib/pro1x/resume)" /boot/boot/extlinux/extlinux.conf
}
# The delay as said in the lines: 2 h, 90 min.
delay=
if [ -n "$HIBERNATE_DELAY" ]; then
    if [ $((HIBERNATE_DELAY % 60)) = 0 ]; then delay="$((HIBERNATE_DELAY / 60)) h"
    else delay="$HIBERNATE_DELAY min"; fi
fi

# The menu's lines.  (The CPU mode is a quick actions line: author.)
if [ "${1:-}" = --lines ]; then
    printf '%s\n' "Cancel" "Lock screen" "Lock and suspend" "Blank screen" "Suspend"
    if hibernate_ready; then
        [ -n "$delay" ] && printf '%s\n' "Suspend, then hibernate ($delay)" \
                                         "Lock, suspend, then hibernate ($delay)"
        echo "Hibernate"
    fi
    printf '%s\n' "Log out" "Reboot" "Power off"
    exit
fi
hide() { swaymsg '[app_id="^powermenu$"] move scratchpad' >/dev/null; }
while :; do
choice=$("$0" --lines |
             fzf --listen="$sock" --prompt="power > " --layout=reverse-list \
                 --no-info --cycle --margin=1,2 --color=16,gutter:-1)
# Away first, then the choice; a fresh list (on Cancel) waits hidden.
hide
case "$choice" in
    "Lock screen") swaymsg exec pro1x-lock >/dev/null ;;
    # Locked first, then asleep (author, 2026-11-02); Calls and Clocks get
    # past the lock (pro1x-call-watch, pro1x-alarm-watch), Chats does not.
    "Lock and suspend")
        swaymsg exec pro1x-lock >/dev/null
        sleep 1.5
        setsid -f sudo -n /run/current-system/profile/bin/pro1x-sleep suspend ;;
    "Blank screen") swaymsg 'input type:touch events disabled' >/dev/null
                    swaymsg 'output * power off' >/dev/null ;;
    # Detached: after the resume it may restart the ADSP (about 20 s),
    # which closing this window must not cut short.
    "Suspend") setsid -f sudo -n /run/current-system/profile/bin/pro1x-sleep suspend ;;
    "Suspend, then hibernate"*)
        setsid -f sudo -n /run/current-system/profile/bin/pro1x-sleep suspend then-hibernate ;;
    "Lock, suspend, then hibernate"*)
        swaymsg exec pro1x-lock >/dev/null
        sleep 1.5
        setsid -f sudo -n /run/current-system/profile/bin/pro1x-sleep suspend then-hibernate ;;
    "Hibernate") sudo -n /run/current-system/profile/bin/pro1x-sleep hibernate ;;
    # Ends Sway and its apps; greetd shows tuigreet again.
    "Log out") swaymsg exit >/dev/null ;;
    "Reboot") sudo -n /run/current-system/profile/sbin/reboot ;;
    "Power off") sudo -n /run/current-system/profile/sbin/halt ;;
esac
[ "${1:-}" = --resident ] || break
sleep 0.3                       # never a busy loop
done
