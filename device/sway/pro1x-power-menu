#!/bin/sh
# pro1x-power-menu — long press on the power key: cancel, lock, blank
# screen, CPU mode, suspend, hibernate, reboot, power off (fzf, floating
# foot window)
#
#   pro1x-power-menu              open the menu
#
# pro1x-power-button opens it on a held power key.  While it has the
# focus, the volume keys move the selection and a short power press
# confirms (pro1x-menu key), so it works with the keyboard closed (author,
# 2026-10-31).  Cancel is
# first and selected.  Power off, reboot, suspend and hibernate run as root
# through sudo rules for wheel users (no password).  Suspend and hibernate
# are untested; hibernate needs swap, which the port does not set up.
#
# State: written 2026-10-31, not yet run on the phone.

sock="${XDG_RUNTIME_DIR:-/tmp}/pro1x-power-menu.sock"

case "${1:-}" in
    --menu|--lines) ;;
    *)
        pro1x-menu hide-all          # one menu at a time (author)
        exec pro1x-term --app-id=powermenu -o pad=12x8 \
            -o "font=Iosevka Term:size=13" -e "$0" --menu ;;
esac

# The menu's lines; the CPU mode line shows the current mode, and Enter
# (or a short power press) moves to the next one without leaving the menu
# (author: user-set energy management; pro1x-cpu-mode).
if [ "${1:-}" = --lines ]; then
    printf '%s\n' "Cancel" "Lock screen" "Blank screen" \
           "CPU mode: $(pro1x-cpu-mode get)  (auto → battery → balanced → performance)" \
           "Suspend" "Hibernate" "Reboot" "Power off"
    exit
fi
cpu="sudo -n /run/current-system/profile/bin/pro1x-cpu-mode next"
choice=$("$0" --lines |
             fzf --listen="$sock" --prompt="power > " --layout=reverse-list \
                 --no-info --cycle --margin=1,2 --color=16,gutter:-1 \
                 --bind="enter:transform:case {1} in
                           CPU) echo \"execute-silent($cpu)+reload($0 --lines)\" ;;
                           *) echo accept ;;
                         esac")
case "$choice" in
    "Lock screen") swaymsg exec pro1x-lock >/dev/null ;;
    "Blank screen") swaymsg 'input type:touch events disabled' >/dev/null
                    swaymsg 'output * power off' >/dev/null ;;
    # Detached: after the resume it may restart the ADSP (about 20 s),
    # which closing this window must not cut short.
    "Suspend") setsid -f sudo -n /run/current-system/profile/bin/pro1x-sleep suspend ;;
    "Hibernate") sudo -n /run/current-system/profile/bin/pro1x-sleep hibernate ;;
    "Reboot") sudo -n /run/current-system/profile/sbin/reboot ;;
    "Power off") sudo -n /run/current-system/profile/sbin/halt ;;
esac
