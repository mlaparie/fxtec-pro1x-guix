#!/bin/sh
# pro1x-power-menu — long press on the power key: cancel, lock, blank
# screen, suspend, log out, reboot, power off, auto-sleep (fzf, floating
# foot window)
#
#   pro1x-power-menu              open the menu
#
# pro1x-power-button opens it on a held power key.  While it has the
# focus, the volume keys move the selection and a short power press
# confirms (pro1x-menu key), so it works with the keyboard closed (author,
# 2026-10-31).  Cancel is
# first and selected.  Power off, reboot and suspend run as root through
# sudo rules for wheel users (no password).
#
# State: written 2026-10-31, not yet run on the phone.

# fzf runs its binds and previews with $SHELL -c: with fish as the login
# shell each took 1.6 s to start, and fish cannot parse the sh in them
# (2026-11-06).  The user's own fzf in a terminal keeps $SHELL.
case "${FZF_DEFAULT_OPTS:-}" in
    *--with-shell=*) ;;
    *) export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:+$FZF_DEFAULT_OPTS }--with-shell='sh -c'" ;;
esac

sock="${XDG_RUNTIME_DIR:-/tmp}/pro1x-power-menu.sock"

case "${1:-}" in
    --menu|--lines|--resident) ;;
    # Resident in the scratchpad (pro1x-menu start powermenu, at login):
    # shown and hidden like the other menus.
    *) exec pro1x-menu toggle powermenu ;;
esac

# The menu's lines.  (The CPU mode is a quick actions line: author.)
# Auto-sleep when locked (moved here from quick actions, author,
# 2026-11-19): config.scm's AUTO_SLEEP, or this boot's choice in
# XDG_RUNTIME_DIR (until reboot).
autosleep=${XDG_RUNTIME_DIR:-/tmp}/pro1x-autosleep
default_sleep() { AUTO_SLEEP=; . /etc/pro1x/dim.conf 2>/dev/null; echo "${AUTO_SLEEP:-off}"; }
autosleep_shown() {
    a=$(cat "$autosleep" 2>/dev/null)
    case "${a:-$(default_sleep)}" in
        off) printf off ;;
        *) printf '%s min locked' "${a:-$(default_sleep)}" ;;
    esac
    [ -n "$a" ] && printf ' (until reboot)'
    echo
}
autosleep_pick() {
    cur=$(cat "$autosleep" 2>/dev/null || echo default)
    d=$(default_sleep)
    pick=$({ printf 'back\t← back\n'
             { printf 'default\tconfig.scm: %s\n' "$([ "$d" = off ] && echo off || echo "$d min locked")"
               printf 'off\toff\n'
               for m in 1 5 10 15 30 60; do printf '%s\t%s min locked\n' "$m" "$m"; done; } |
                 awk -F'\t' -v cur="$cur" '{ print $1 "\t" ($1 == cur ? "● " : "  ") $2 }'; } |
           fzf --listen="$sock" --delimiter='\t' --with-nth=2 --prompt="auto-sleep > " \
               --layout=reverse-list --no-info --cycle --margin=1,2 --color=16,gutter:-1 \
               --bind='load:pos(2)' --bind='left:abort' --bind='right:accept' | cut -f1)
    case "$pick" in ""|back) return ;; default) rm -f "$autosleep" ;; *) echo "$pick" > "$autosleep" ;; esac
    # A new swayidle with it, unless Keep screen on holds none.
    [ "$(cat "${XDG_RUNTIME_DIR:-/tmp}/pro1x-caffeine" 2>/dev/null || echo off)" = on ] && return
    for p in $(pgrep -u "$(id -u)" -x swayidle); do kill "$p"; done
    swaymsg exec "pro1x-idle --sway" >/dev/null
}

if [ "${1:-}" = --lines ]; then
    printf '%s\n' "Cancel" "Lock screen" "Lock and suspend" "Blank screen" "Suspend" \
           "Log out" "Reboot" "Power off" "Auto-sleep: $(autosleep_shown)"
    exit
fi
hide() { swaymsg '[app_id="^powermenu$"] move scratchpad' >/dev/null 2>&1; }
while :; do
choice=$("$0" --lines |
             fzf --listen="$sock" --prompt="power > " --layout=reverse-list \
                 --no-info --cycle --margin=1,2 --color=16,gutter:-1 \
                 --bind='left:abort' --bind='right:accept')
# Its list in this window, then this menu again.
case "$choice" in
    Auto-sleep*) autosleep_pick; continue ;;
esac
# Away first, then the choice; a fresh list (on Cancel) waits hidden.
hide
case "$choice" in
    "Lock screen") swaymsg exec pro1x-lock >/dev/null ;;
    # Locked first, then asleep (author, 2026-11-02); Calls and Clocks get
    # past the lock (pro1x-call-watch, pro1x-alarm-watch), Chats does not.
    "Lock and suspend")
        swaymsg exec pro1x-lock >/dev/null
        sleep 1.5
        setsid -f sudo -n /run/current-system/profile/bin/pro1x-sleep suspend ;;
    "Blank screen") swaymsg 'input type:touch events disabled' >/dev/null
                    swaymsg 'output * power off' >/dev/null ;;
    # Detached: after the resume it may restart the ADSP (about 20 s),
    # which closing this window must not cut short.
    "Suspend") setsid -f sudo -n /run/current-system/profile/bin/pro1x-sleep suspend ;;
    # Ends Sway and its apps; greetd shows tuigreet again.
    "Log out") swaymsg exit >/dev/null ;;
    "Reboot") sudo -n /run/current-system/profile/sbin/reboot ;;
    "Power off") sudo -n /run/current-system/profile/sbin/halt ;;
esac
# Run in another menu's window (--menu): back there; false for Cancel or
# Esc, so that menu stays.
if [ "${1:-}" = --menu ]; then
    case "$choice" in ""|Cancel) exit 1 ;; *) exit 0 ;; esac
fi
[ "${1:-}" = --resident ] || break
sleep 0.3                       # never a busy loop
done
