#!/bin/sh
# pro1x-power-key — the power key in Sway: screen off when on, on when off
#
# It toggled the panel (swaymsg output power toggle), which went wrong
# after the idle timer had blanked it: the key press is also activity, so
# swayidle's resume turned the panel on while the toggle turned it off
# again; the screen flashed and stayed dark (author, 2026-10-31).  Now it
# decides from the panel's state, and leaves the panel on when pro1x-idle's
# resume woke it for this very press (it stamps the time).
rt="${XDG_RUNTIME_DIR:-/tmp}"
# One app over the lock screen (pro1x-lock --app-unlock): the key ends that.
[ -e "$rt/pro1x-locked-app" ] && pro1x-lock
on=$(swaymsg -t get_outputs -r |
         jq -r '[.[] | select(.name == "DSI-1") | .power] | any')
if [ "$on" = true ]; then
    woke=$(cat "$rt/pro1x-woke" 2>/dev/null || echo 0)
    [ $(( $(date +%s%N) - woke )) -lt 800000000 ] && exit 0
    pro1x-menu hide-all               # blanking hides the menus
    # No touch while dark: the lock screen took taps with the screen off
    # (author, 2026-10-31).  pro1x-doubletap reads the touchscreen itself.
    swaymsg 'input type:touch events disabled' >/dev/null
    swaymsg 'output DSI-1 power off' >/dev/null
else
    swaymsg 'output DSI-1 power on' >/dev/null
    swaymsg 'input type:touch events enabled' >/dev/null
fi
