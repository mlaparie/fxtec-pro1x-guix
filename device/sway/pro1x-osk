#!/bin/sh
# pro1x-osk run | follow — the on-screen keyboard (stevia) kept ready in Sway
#
#   run      stevia, started again whenever none runs (none owns
#            sm.puri.OSK0).  Running, it shows for a focused text field by
#            itself (text-input) and comes up at once on a D-Bus call.
#            (The 2026-11-02 claim that it had died was a wrong check: it
#            ran all along, so slowness and text fields need another look.)
#   toggle   shown or hidden, for the bottom swipe: sway-quick-actions
#            --osk took 110-120 ms to start, the D-Bus calls 15-30 ms, stevia
#            answers in 2-4 ms (measured 2026-11-02); one toggle per 0.6 s,
#            as a pressed swipe can fire twice
#   follow   in portrait with the keyboard slid in, show it while a
#            terminal has the focus (terminals have no text-input), hide it
#            when the focus leaves one (author, 2026-11-02)
#
# Both started by the Sway config; they end with the session.
#
# State: written 2026-11-02; not yet run on the phone.

rt="${XDG_RUNTIME_DIR:-/tmp}"

osk() {                         # osk true|false
    gdbus call --session --dest sm.puri.OSK0 --object-path /sm/puri/OSK0 \
        --method sm.puri.OSK0.SetVisible "$1" >/dev/null 2>&1
}

portrait() {
    swaymsg -t get_outputs -r 2>/dev/null |
        jq -e '.[] | select(.name == "DSI-1")
               | .transform == "normal" or .transform == "180"' >/dev/null
}

slid_out() {                    # SW_KEYPAD_SLIDE set: evtest exits 10
    evtest --query /dev/input/pro1x-slider EV_SW SW_KEYPAD_SLIDE
    [ $? = 10 ]
}

terminal() {                    # an app_id of a terminal
    case "$1" in
        foot|footclient|*[Tt]erminal*|*[Cc]onsole*|kitty|Alacritty) return 0 ;;
    esac
    return 1
}

case "${1:-}" in
    run)
        # Only when no stevia owns its name: a second one exits at once,
        # and the loop then spun once a second (2026-11-02).
        while swaymsg -t get_version >/dev/null 2>&1; do
            if gdbus call --session --dest org.freedesktop.DBus \
                   --object-path /org/freedesktop/DBus \
                   --method org.freedesktop.DBus.NameHasOwner sm.puri.OSK0 \
                   2>/dev/null | grep -q true; then
                sleep 5
            else
                phosh-osk-stevia
                sleep 1
            fi
        done ;;
    toggle)
        stamp="$rt/pro1x-osk-toggled"
        now=$(date +%s%N)
        [ $(( now - $(cat "$stamp" 2>/dev/null || echo 0) )) -lt 600000000 ] && exit 0
        echo "$now" > "$stamp"
        # A buzz as the menu swipes do (author, 2026-11-02); fbcli reads
        # from a sleep, or it ends the feedback at once.
        { sleep 1 | fbcli -E button-pressed; } >/dev/null 2>&1 &
        case "$(gdbus call --session --dest sm.puri.OSK0 --object-path /sm/puri/OSK0 \
                    --method org.freedesktop.DBus.Properties.Get sm.puri.OSK0 Visible \
                    2>/dev/null)" in
            *true*) osk false ;;
            *) osk true ;;
        esac ;;
    follow)
        shown="$rt/pro1x-osk-terminal"     # we showed it for a terminal
        rm -f "$shown"
        swaymsg -t subscribe -m '["window"]' 2>/dev/null |
            jq --unbuffered -r 'select(.change == "focus") | .container.app_id // ""' |
            while read -r app; do
                if terminal "$app" && portrait && ! slid_out; then
                    osk true; touch "$shown"
                elif [ -f "$shown" ]; then
                    osk false; rm -f "$shown"
                fi
            done ;;
    *) echo "usage: pro1x-osk run|toggle|follow" >&2; exit 1 ;;
esac
