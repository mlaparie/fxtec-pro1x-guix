#!/bin/sh
# pro1x-portrait-apps — portrait or landscape while an app has the focus
# (portrait-apps, landscape-apps in config.scm; default: Snapshot, Calls in
# portrait).  fullscreen-apps are Sway rules, /etc/sway/pro1x.d/apps.conf.
#
# Sway rotates whole outputs, not windows.  While a portrait app (the
# camera, Calls) is the focused window, the panel is put in portrait and
# $XDG_RUNTIME_DIR/pro1x-portrait-app tells sway-autorotate and
# pro1x-osk-slider to leave the rotation alone.  When the focus goes to
# another window or workspace, or the app closes, the rotation the context
# calls for comes back: landscape with the keyboard slid out, the sensor's
# orientation with auto-rotation on, portrait otherwise (author,
# 2026-10-30).  Follows Sway's window and workspace events; started by the
# Sway config, ends with Sway.
#
# State: written 2026-10-30, not yet run on the phone.

# The apps: portrait-apps, landscape-apps and fullscreen-apps in
# config.scm (/etc/pro1x/apps.conf).
PORTRAIT_APPS='org.gnome.Snapshot org.gnome.Calls' LANDSCAPE_APPS=
[ -r /etc/pro1x/apps.conf ] && . /etc/pro1x/apps.conf
rt="${XDG_RUNTIME_DIR:-/tmp}"
flag="$rt/pro1x-portrait-app"
events="$rt/pro1x-portrait-apps.events"
rotation="${XDG_STATE_HOME:-$HOME/.local/state}/pro1x/sway-autorotate"

focused_app() {
    swaymsg -t get_tree -r 2>/dev/null |
        jq -r '[.. | objects | select(.focused? == true) | .app_id // ""] | .[0] // ""'
}

slider_out() {
    evtest --query /dev/input/pro1x-slider EV_SW SW_KEYPAD_SLIDE
    [ $? = 10 ]
}

restore() {
    rm -f "$flag"
    sway-autorotate restore         # sensor, keyboard or fixed
}

check() {
    app=$(focused_app)
    case "$app" in
        # No app (an empty workspace, just after unlocking): with an empty
        # list, " $LIST " matched it, and landscape stuck for good
        # (2026-11-01: no portrait, the power menu closed at once).  Our
        # menus: the rotation stays as it is (a change would close them).
        quickactions|launcher|windowswitcher|powermenu) return ;;
        # Nothing focused (the forced app just closed, an empty workspace):
        # its orientation goes (author: stuck in portrait after the camera
        # until a touch, 2026-11-02); never forced from here.
        "") [ -f "$flag" ] && restore; return ;;
    esac
    case " $PORTRAIT_APPS " in *" $app "*) want=normal ;; *) want= ;; esac
    case " $LANDSCAPE_APPS " in *" $app "*) want=90 ;; esac
    if [ -n "$want" ]; then
        if [ "$(cat "$flag" 2>/dev/null)" != "$want" ]; then
            echo "$want" > "$flag"
            swaymsg output DSI-1 transform "$want" >/dev/null
        fi
    elif [ -f "$flag" ]; then
        restore
    fi
}


rm -f "$flag"
trap 'rm -f "$events"' EXIT
trap 'exit 0' INT TERM HUP
rm -f "$events"; mkfifo "$events"
swaymsg -m -r -t subscribe '["window", "workspace"]' > "$events" 2>/dev/null &
while IFS= read -r _; do
    check
done < "$events"
