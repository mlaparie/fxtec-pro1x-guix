#!/bin/sh
# pro1x-open COMMAND… — run a command in Sway, over the lock screen for the
# apps allowed there
#
# Unlocked: runs COMMAND.  Locked: runs it, and if within 8 s a window of
# an app in LOCK_SCREEN_APPS appears (/etc/pro1x/apps.conf,
# lock-screen-apps in config.scm), unlocks for it, focuses it, lights the
# panel, and
# locks again as soon as the focus goes to another app or the app closes
# (author, 2026-10-31: the camera, like Calls, should open while locked).
# Used by the camera button's double press and the shake action; Calls has
# pro1x-call-watch.  Meanwhile the phone is unlocked behind that app.
#
# State: written 2026-10-31, not yet run on the phone.

[ $# -gt 0 ] || exit 2
LOCK_SCREEN_APPS=
[ -r /etc/pro1x/apps.conf ] && . /etc/pro1x/apps.conf

pro1x-lock --locked || exec sh -c "$*"

focused() {                     # "CON_ID APP_ID" of the focused window
    swaymsg -t get_tree -r 2>/dev/null |
        jq -r '[.. | objects | select(.focused? == true)
                | "\(.id) \(.app_id // "")"] | .[0] // ""'
}
windows() {                     # "CON_ID APP_ID" of every app window
    swaymsg -t get_tree -r 2>/dev/null |
        jq -r '.. | objects | select(.pid? != null and .app_id? != null)
               | "\(.id) \(.app_id)"'
}
allowed() { case " $LOCK_SCREEN_APPS " in *" $1 "*) return 0 ;; esac; return 1; }

# The app the command is for, when it is a known one: its window counts
# even if it was open before (Snapshot is a single instance: the command
# only presents the window it has).
case "${1##*/}" in
    snapshot|pro1x-camera) want=org.gnome.Snapshot ;;
    gnome-calls) want=org.gnome.Calls ;;
    *) want= ;;
esac

# While locked, Sway does not focus new windows (author: Snapshot started
# but stayed behind the lock): watch the tree for a new window of an
# allowed app instead.
before=$(windows | cut -d' ' -f1)
sh -c "$*" &
app= con=
for i in $(seq 40); do
    sleep 0.2
    while read -r c a; do
        allowed "$a" || continue
        if [ "$a" = "$want" ] ||
           ! printf '%s\n' "$before" | grep -qx "$c"; then
            app=$a con=$c; break
        fi
    done <<WINDOWS
$(windows)
WINDOWS
    [ -n "$app" ] && break
done
[ -n "$app" ] || exit 0

pro1x-lock --unlock
swaymsg 'output * power on' >/dev/null
swaymsg 'input type:touch events enabled' >/dev/null
pro1x-dim restore 2>/dev/null
swaymsg "[con_id=$con] focus" >/dev/null
sleep 0.5                       # the focus settles after the unlock

# Lock again when the focus leaves APP (another app, a workspace switch,
# APP closed).  Our menus are no exception: they would reach everything.
swaymsg -m -r -t subscribe '["window", "workspace"]' 2>/dev/null |
    while IFS= read -r _; do
        now=$(focused)
        [ "${now#* }" = "$app" ] && continue
        pro1x-lock
        break
    done
