#!/bin/sh
# pro1x-stream-output — the output the screen-cast portal captures, for
# xdg-desktop-portal-wlr's chooser (chooser_cmd, system/mobile.scm): the
# interactive stream's own Sway output while it has one (its name in
# $XDG_RUNTIME_DIR/pro1x-stream-output, written by pro1x-stream-webrtc),
# else the panel.  No question asked: the stream opens the portal
# unattended.
#
# State: used on the phone (2026-11-19).
name=$(cat "${XDG_RUNTIME_DIR:-/tmp}/pro1x-stream-output" 2>/dev/null)
echo "Monitor: ${name:-DSI-1}"
