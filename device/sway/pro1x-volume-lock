#!/bin/sh
# pro1x-volume-lock — the volume keys beyond volume (Sway): both held
# together lock the screen; in a menu, short and long presses drive it
#
# A way to lock with the hardware keyboard closed (author, 2026-10-31).
# Sway did not match a binding of two ordinary keys (tried with
# XF86AudioRaiseVolume+XF86AudioLowerVolume), and keyd cannot take the
# gpio-keys device, which also carries the keyboard slide switch.  So this
# reads the key events itself (the user is in the input group): volume up
# from gpio-keys, volume down from pm8941_resin (the PMIC key; recorded on
# the phone: not through keyd), and keyd's virtual keyboard in case.  Each
# key alone still changes the volume first.  Started by the Sway config;
# ends with Sway.
#
# State: 2026-10-31: chord seen with ydotool; real keys missed volume down
# (wrong device), fixed.

# reader NAME: evtest on the input device named NAME, found again whenever
# it goes (keyd makes its virtual keyboard anew when it restarts).
reader() {
    while :; do
        for e in /sys/class/input/event*; do
            if [ "$(cat "$e/device/name" 2>/dev/null)" = "$1" ]; then
                evtest "/dev/input/${e##*/}" 2>/dev/null
                break
            fi
        done
        sleep 2
    done
}

if [ -n "${SWAYSOCK:-}" ]; then
    # Sway's exec double-forks: end with its IPC socket, whole group.
    # A Sway that died can leave its socket behind (2026-11-06: a stale
    # watcher of a dead Sway fought the live one over an incoming call),
    # so also check the Sway PID in the socket name.
    swaypid=${SWAYSOCK%.sock}; swaypid=${swaypid##*.}
    ( while [ -S "$SWAYSOCK" ] && kill -0 "$swaypid" 2>/dev/null; do sleep 10; done; kill 0 ) &
fi

rt="${XDG_RUNTIME_DIR:-/tmp}"

# In a menu (quick actions, launcher, switcher, power menu; pro1x-osd then
# leaves the volume alone): a short press moves the selection, on release;
# held 0.4 s, in quick actions, it toggles an on/off line once or steps a
# gauge or multi-option line (up: more, down: less) every 0.25 s until
# released; elsewhere it keeps moving (author, 2026-10-31).  KEY: up or down; files in $rt mark a press and a fired hold.
press() {
    key=$1; stamp=$(date +%s%N)
    rm -f "$rt/pro1x-vol-$key.fired"
    # Which menu, once per press: the release and the hold reuse it (a
    # get_tree and jq cost about 0.1 s each on the phone).
    menu=$(pro1x-menu focused) || { rm -f "$rt/pro1x-vol-$key"; return; }
    echo "$stamp" > "$rt/pro1x-vol-$key"
    echo "$menu" > "$rt/pro1x-vol-$key.menu"
    ( sleep 0.4
      tick=hold
      while [ "$(cat "$rt/pro1x-vol-$key" 2>/dev/null)" = "$stamp" ]; do
          touch "$rt/pro1x-vol-$key.fired"
          PRO1X_MENU_FOCUSED=$menu pro1x-menu key "$tick-$key"
          tick=repeat
          sleep 0.25
      done ) &
}
release() {
    key=$1
    if [ -f "$rt/pro1x-vol-$key" ]; then
        rm -f "$rt/pro1x-vol-$key"
        [ -f "$rt/pro1x-vol-$key.fired" ] ||
            PRO1X_MENU_FOCUSED=$(cat "$rt/pro1x-vol-$key.menu") pro1x-menu key "$key"
    fi
    rm -f "$rt/pro1x-vol-$key.fired"
}

up=0 down=0
# "Event: time …, type 1 (EV_KEY), code 115 (KEY_VOLUMEUP), value 1"
for n in gpio-keys pm8941_resin "keyd virtual keyboard"; do reader "$n" & done |
    while IFS= read -r line; do
        case "$line" in
            *"(KEY_VOLUMEUP), value 1"*) up=1; press up ;;
            *"(KEY_VOLUMEUP), value 0"*) up=0; release up ;;
            *"(KEY_VOLUMEDOWN), value 1"*) down=1; press down ;;
            *"(KEY_VOLUMEDOWN), value 0"*) down=0; release down ;;
            *) continue ;;
        esac
        if [ "$up$down" = 11 ]; then
            # Both: lock, and no menu action for either key.
            rm -f "$rt/pro1x-vol-up" "$rt/pro1x-vol-down"
            touch "$rt/pro1x-vol-up.fired" "$rt/pro1x-vol-down.fired"
            # Put back the volume from before the first of the two keys:
            # each key changed it as it went down (pro1x-osd notes it).
            # "0.45 TIME": the level, then when pro1x-osd noted it.
            v=; read -r v _ 2>/dev/null < "$rt/pro1x-vol-before"
            [ -n "$v" ] && ( sleep 0.15; wpctl set-volume @DEFAULT_AUDIO_SINK@ "$v" ) &
            pro1x-lock --locked || pro1x-lock &
            up=0 down=0
        fi
    done
