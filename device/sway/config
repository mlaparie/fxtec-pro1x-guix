# sway configuration for the F(x)tec Pro1X (keyboard out, landscape).
#
# Installed as ~/.config/sway/config for new accounts (skeleton, see
# systems/mobile.scm); edit it there.  Keys: the yellow slant arrows are Super ($mod), the
# F(x) key is Fn (F1-F12, media, brightness, PgUp/PgDn/Home/End; see
# device/input/keyd.conf).  Super+m opens the launcher, Super+Tab the window
# switcher, Super+Return a terminal (Super+Shift+Return without the foot server), Super+BackSpace or Super+Shift+q
# closes a window, Super+Ctrl+h shows the key bindings, Super+Shift+e exits.  Launcher, switcher and bar follow mlaparie's
# guix-config.
#
# State: written 2026-10-28; tested on the phone as noted in TODO.md.

set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term pro1x-term
set $launcher pro1x-term --app-id=launcher -e env TERMINAL_COMMAND="foot -e" PREVIEW_WINDOW=up:5:noborder sway-launcher-desktop

xwayland disable
font pango:monospace 9

### Gaps between windows (author, 2026-10-30)
gaps inner 6

### SwayFX: blur behind translucent windows (foot at 90%), small rounded
### corners.  These commands need SwayFX; plain sway rejects them.
blur enable
blur_passes 2
blur_radius 4
corner_radius 6

### Windows: no title bars; colours from mlaparie's guix-config
default_border pixel 2
default_floating_border pixel 2
smart_borders on
# class                 border  backgr. text    indicator child_border
client.focused          #404552 #404552 #fafafa #ff5757 #5294E2
client.focused_inactive #666666 #404552 #eeeeee #666666 #262626
client.unfocused        #404552 #484b52 #eeeeee #ff5757 #262626
client.urgent           #ff5757 #404552 #ffffff #555757 #EFEDEC
client.background       #404552

### Device: panel rotation and scale, keyboard layout, touch mapping, in
### /etc/sway/config.d/pro1x.conf (device/sway/pro1x.conf), shared with Sxmo.
include /etc/sway/config.d/*

output DSI-1 bg /run/current-system/profile/share/backgrounds/pro1x/dark.png fill #252a3a
# Power key turns the panel off and on.
bindsym --locked XF86PowerOff exec swaymsg output DSI-1 power toggle

### Idle: dim, blank, then lock with swaylock (pro1x-idle --sway; times and
### level set in config.scm, see /etc/pro1x/dim.conf); a touch or key press
### D-Bus starts services (the desktop portal and its GTK back end) with
### the bus's environment, from before Sway: give it the display, or the
### GTK portal could not start and libadwaita apps stayed light.  Apps that
### may start the portal run after it ($dbusenv && ...).
set $dbusenv dbus-update-activation-environment WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
exec $dbusenv

### brings the panel back.
exec pro1x-idle --sway

### Rotation: follows the accelerometer while the keyboard is in; landscape
### while it is out.  Super+o toggles auto-rotation.
exec sway-autorotate

### Edge swipes (pro1x-gestures): down from the top, quick actions; up from
### the bottom, the on-screen keyboard; in from the right, the launcher; in
### from the left, the window switcher.
exec pro1x-gestures

### Snapshot (camera) fullscreen.  Snapshot and Calls get the panel in
### portrait while they have the focus, and the rotation from before comes
### back afterwards (pro1x-portrait-apps; Sway rotates whole outputs).
for_window [app_id="^org.gnome.Snapshot$"] fullscreen enable
exec pro1x-portrait-apps

### A very dim white LED while the screen is blank but not locked.
exec pro1x-blank-led

### foot server: quick actions, the launcher and the window switcher open
### as footclient windows (pro1x-term), faster than a new foot, and so does
### Super+Return ($term); Super+Shift+Return is a plain foot, in case the
### server is gone.
exec foot --server

### Notifications (pro1x-mako: mako, noting arrival times for the lock screen)
exec pro1x-mako

### Chatty and Calls in the background, for messages and incoming calls
exec $dbusenv && chatty --gapplication-service
exec $dbusenv && gnome-calls --gapplication-service
### Calls' window (an incoming call, or opened to dial): fullscreen, focused;
### portrait while focused (pro1x-portrait-apps).
for_window [app_id="^org.gnome.Calls$"] fullscreen enable, focus
### An incoming call unlocks the screen until it ends (pro1x-call-watch):
### nothing can show above the lock screen.
exec pro1x-call-watch

### On-screen keyboard: Phosh's (stevia), shown for text fields while the
### keyboard is slid in (pro1x-osk-slider turns that off while it is out),
### and on demand: Super+i, the Keyboard line in quick actions, the gear.
exec $dbusenv && phosh-osk-stevia
exec pro1x-osk-slider
bindsym $mod+i exec sway-quick-actions --osk toggle

### Launcher window
### The three menus open against the edge their swipe comes from, sized in
### percent of the screen (portrait or landscape): quick actions at the top,
### the launcher on the right, the window switcher on the left.
### Each starts hidden in the scratchpad (pro1x-menu shows it), however long
### it takes to appear: a timed hide missed a slow first launcher.
for_window [app_id="^quickactions$"] floating enable, sticky enable, border pixel 2, resize set 80 ppt 55 ppt, move position 10 ppt 2 ppt, move scratchpad
for_window [app_id="^launcher$"] floating enable, sticky enable, border pixel 2, resize set 70 ppt 85 ppt, move position 28 ppt 7 ppt, move scratchpad
for_window [app_id="^windowswitcher$"] floating enable, sticky enable, border pixel 2, resize set 55 ppt 70 ppt, move position 2 ppt 15 ppt, move scratchpad
for_window [app_id="^swayhelp$"] floating enable, sticky enable, resize set 90 ppt 80 ppt, border pixel 2, move position center

########## KEYBINDINGS ##########
# Super+Ctrl+h shows this section of the loaded config (q closes it).
bindsym $mod+Ctrl+h exec foot --app-id=swayhelp -e sh -c 'swaymsg -t get_config | jq -r .config | sed -n "/^########## KEYBINDINGS/,/^########## BAR/p" | less'

### Basics
bindsym $mod+Return exec $term
bindsym $mod+Shift+Return exec foot
bindsym $mod+m exec pro1x-menu toggle launcher
bindsym $mod+Tab exec pro1x-menu toggle windowswitcher
bindsym $mod+Shift+o exec sway-autorotate toggle
bindsym $mod+q exec pro1x-menu toggle quickactions
### Quick actions, launcher and window switcher stay hidden in the
### scratchpad from login, so they show at once (pro1x-menu).
exec pro1x-menu start quickactions hidden
exec pro1x-menu start launcher hidden
exec pro1x-menu start windowswitcher hidden
bindsym $mod+BackSpace kill
bindsym $mod+Shift+q kill
bindsym $mod+Shift+r reload
bindsym $mod+Ctrl+l exec pro1x-lock
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway?' -B 'Exit' 'swaymsg exit'
# Super and drag moves a floating window (touch too, on windows that do
# not take touch themselves, such as foot); with a mouse, Super and the
# right button resizes.
floating_modifier $mod normal

### Moving around
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

### Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Ctrl+1 move container to workspace number 1
bindsym $mod+Ctrl+2 move container to workspace number 2
bindsym $mod+Ctrl+3 move container to workspace number 3
bindsym $mod+Ctrl+4 move container to workspace number 4
bindsym $mod+Ctrl+5 move container to workspace number 5
bindsym $mod+Ctrl+6 move container to workspace number 6
bindsym $mod+Ctrl+7 move container to workspace number 7
bindsym $mod+Ctrl+8 move container to workspace number 8
bindsym $mod+Ctrl+9 move container to workspace number 9
bindsym $mod+Ctrl+0 move container to workspace number 10

### Layout
### Super+b hides or shows the bars; Super+h splits vertically, Super+v
### horizontally (author's choice).
bindsym $mod+b exec pro1x-bar toggle
bindsym $mod+h splitv
bindsym $mod+v splith
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+space floating toggle
bindsym $mod+Shift+space focus mode_toggle
bindsym $mod+a focus parent
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

### Numbered scratchpad: Alt+Super+digit puts the window away as number
### N, Shift+Super+digit brings number N back (and hides it again).
### Moving a window to workspace N is Ctrl+Super+digit.
bindsym $mod+Mod1+1 mark --add sp1, move scratchpad
bindsym $mod+Shift+1 [con_mark="^sp1$"] scratchpad show
bindsym $mod+Mod1+2 mark --add sp2, move scratchpad
bindsym $mod+Shift+2 [con_mark="^sp2$"] scratchpad show
bindsym $mod+Mod1+3 mark --add sp3, move scratchpad
bindsym $mod+Shift+3 [con_mark="^sp3$"] scratchpad show
bindsym $mod+Mod1+4 mark --add sp4, move scratchpad
bindsym $mod+Shift+4 [con_mark="^sp4$"] scratchpad show
bindsym $mod+Mod1+5 mark --add sp5, move scratchpad
bindsym $mod+Shift+5 [con_mark="^sp5$"] scratchpad show
bindsym $mod+Mod1+6 mark --add sp6, move scratchpad
bindsym $mod+Shift+6 [con_mark="^sp6$"] scratchpad show
bindsym $mod+Mod1+7 mark --add sp7, move scratchpad
bindsym $mod+Shift+7 [con_mark="^sp7$"] scratchpad show
bindsym $mod+Mod1+8 mark --add sp8, move scratchpad
bindsym $mod+Shift+8 [con_mark="^sp8$"] scratchpad show
bindsym $mod+Mod1+9 mark --add sp9, move scratchpad
bindsym $mod+Shift+9 [con_mark="^sp9$"] scratchpad show
bindsym $mod+Mod1+0 mark --add sp0, move scratchpad
bindsym $mod+Shift+0 [con_mark="^sp0$"] scratchpad show

### Opacity of the focused window: Super+o more, Ctrl+Super+o less.
bindsym $mod+o opacity plus 0.05
bindsym $mod+Ctrl+o opacity minus 0.05

### Super+; goes back to the previous workspace.  keyd turns that key into
### Shift+/ (it types "?"), so both forms are bound.
bindsym $mod+semicolon workspace back_and_forth
bindsym $mod+Shift+question workspace back_and_forth

mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

### Fn keys (F(x) + key, through keyd) and the side volume buttons
# Volume keys (and Fn media keys): wpctl, capped at 120% (author's choice).
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.2 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-

### Screenshots and clipboard
# Screenshots (pro1x-screenshot): to ~/Pictures/Screenshots and the
# clipboard.  Print is Fn+Alt+p on the Pro1X keyboard, Ctrl+Print
# Ctrl+Fn+Alt+p (keyd).
### Camera button: start Snapshot, focus it, or take a picture when it
### has the focus.
bindsym XF86WebCam exec pro1x-camera

bindsym Print exec pro1x-screenshot full
bindsym Ctrl+Print exec pro1x-screenshot region
bindsym $mod+Shift+p exec pro1x-screenshot full
bindsym $mod+Shift+s exec pro1x-screenshot region

########## BAR ##########
### Bar: i3status-rust through pro1x-bar.  Landscape:
### ~/.config/i3status-rust/config.toml; portrait, the essentials on one
### line: portrait.toml there, else the port's.
exec pro1x-bar watch
bar bar-0 {
    position top
    font pango:monospace, FontAwesome 10
    status_command pro1x-bar main
    colors {
        statusline #ebdbb2
        background #1d2021
        focused_workspace #458588 #458588 #ebdbb2
        inactive_workspace #1d2021 #1d2021 #a89984
    }
}
