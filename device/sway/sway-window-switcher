#!/usr/bin/env bash
# sway-window-switcher: pick a window with fzf (in a floating foot) and focus
# it; C-k kills the selected application.  Needs swaymsg, jq, fzf, foot.
# From mlaparie's guix-config (.config/sway/scripts/sway-window-switcher).
SCRIPTNAME=$(basename $0)
SCRIPTPATH="$( cd -- "$(dirname "$0")" >/dev/null 2>&1 ; pwd -P )"
IFS=$'\n'

if [[ -n $THEME ]]; then
    fzf_color="--color=$THEME"
fi

# $THEME env variable set via sway config.

# check for env variable, if exists we are the
# forked shell, get the waiting string from the fifo
# and call fzf and sway from there.
if [[ -n $fifo ]]; then
    str=$(cat $fifo)
    rm -rf $fifo

    selection=$(printf $str \
      | fzf --prompt="# " $fzf_color \
            --ansi \
	    --extended \
	    --no-border \
	    --layout=reverse-list \
	    --with-nth=2.. \
            --print-query \
            --no-multi \
	    --cycle \
	    --header='
Switch (Ret) or kill (C-k)' \
	    --margin='1,2,1,2' \
            --color='16,gutter:-1' \
	    --bind="tab:down" \
	    --bind="btab:up" \
	    --bind="ctrl-k:execute:pkill {2}")

    id=$(echo $selection | cut -d "." -f1)
    if [[ -z $id ]]; then
        exit
    fi

    swaymsg "[con_id=$id]" focus
    exit
fi

# WIP to add a "Move here (C-k) command to fzf
# workspace=$(swaymsg -t get_tree | grep current_workspace | cut -d ":" -f2 | cut -d '"' -f2)
# --bind="ctrl-x:execute:swaymsg 'move [con_id={1}] to workspace $workspace'"

windows=($(swaymsg -t get_tree| jq -r 'recurse(.nodes[]?) | recurse(.floating_nodes[]?) | select(.type=="con"), select(.type=="floating_con") | select((.app_id != null) or .name != null) | {id, app_id, name} | .id, .app_id, .name'))

# build the selection string we will ultimate
# pipe to fzf, take note of largest string to set
# columns and number of lines to set lines for alacritty.
str=""
columns=0
lines=0
for ((i=0; i<"${#windows[@]}"; i=i+3,lines++)); do
    id="${windows[i]}"
    app_id="${windows[i+1]}"
    name=$(echo "${windows[i+2]}" | sed 's/^ *\| *$//g')
    building_string="$id."
    if [[ $app_id != "null" ]]; 
    then
        building_string="$building_string $app_id >"
    fi
    if [[ $name != "null" ]];
    then
        building_string="$building_string $name"
    fi
    if [[ ${#building_string} -gt $columns ]];
    then
        str_largest="$building_string"
        columns=${#building_string}
    fi
    str="$str$building_string\n" 
done

# add some padding to the terminal for 
# lines and columns, for columns make sure
# we take the prompt into the padding consideration
lines=$((lines+6))
if [[ lines -gt 30 ]];
then
    lines=30
fi
columns=$((columns+"${#header}"+5))
if [[ columns -gt 80 ]];
then
    columns=80
fi

fifo=/tmp/sts-$(date +%s)
mkfifo $fifo
fifo=$fifo $SHELL -c "pro1x-term \
    -W ${columns}x${lines} \
    -a windowswitcher \
    -e $SCRIPTPATH/$SCRIPTNAME"&
echo -n $str > $fifo
