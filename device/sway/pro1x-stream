#!/usr/bin/env bash
# pro1x-stream — send the screen, or a window, to another device on any local
# network: the Pro¹x's hotspot, or a Wi-Fi network both are on.  Opened by Enter
# or Right on the Stream line of sway-quick-actions, inside its window, or from
# Hotspot > Connected devices with --to ADDRESS (VLC then sends there).
# --interactive ADDRESS and --stop start and stop the interactive stream
# without the menu.
#
# Networks that keep their clients apart, as in many hotels, block all of this;
# the hotspot gets around that.  wf-recorder copies an area of the display, so
# what is sent is what is there: starting a window's stream goes to it, and
# switching workspace afterwards sends the other workspace.
#
# Also opens catt and GNOME Network Displays, for Chromecast and Miracast.
#
# State: the MJPEG pipeline, and wf-recorder sending UDP, tested on the phone
# 2026-11-10 without a second device; WebRTC against a GStreamer client.  This
# menu is not yet run.

case "${FZF_DEFAULT_OPTS:-}" in
    *--with-shell=*) ;;
    *) export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:+$FZF_DEFAULT_OPTS }--with-shell='sh -c'" ;;
esac

rt="${XDG_RUNTIME_DIR:-/tmp}"
sock="${PRO1X_TOOL_SOCK:-$rt/pro1x-tool.sock}"
pid_file="$rt/pro1x-stream.pid"
to_file="$rt/pro1x-stream.to"           # what the menus show
fps_file="${XDG_STATE_HOME:-$HOME/.local/state}/pro1x-stream-fps"
size_file="${XDG_STATE_HOME:-$HOME/.local/state}/pro1x-stream-size"
key_file="${XDG_STATE_HOME:-$HOME/.local/state}/pro1x-stream-key"   # on or off
key_value="${XDG_STATE_HOME:-$HOME/.local/state}/pro1x-stream-key-value"
approve_file="${XDG_STATE_HOME:-$HOME/.local/state}/pro1x-stream-approve"  # off, tap, fingerprint
screen_file="${XDG_STATE_HOME:-$HOME/.local/state}/pro1x-stream-screen"    # phone, client, multi-monitor

admin="/run/privileged/bin/sudo -n /run/current-system/profile/bin/pro1x-hotspot-admin"
udp_port=5000
http_port=8080
webrtc_port=8081
# The same over HTTPS, for browsers that refuse plain HTTP, with the
# phone's own certificate (pro1x-stream-webrtc); on the phone's hotspot,
# the user's own name when one is set up (HTTPS line, pro1x-stream-cert).
tls_port=8443
tls_dir=/var/lib/pro1x/stream-tls
https_file=${XDG_CONFIG_HOME:-$HOME/.config}/pro1x/stream-https.conf
# The user's hook, if executable (an add-on, not the port's):
# `stream-hook url ADDRESS PORT' may print another link to show, and
# `stream-hook started PID KIND' runs once a stream is up (KIND: webrtc or
# interactive); a hook that fails is ignored.
hook=${XDG_CONFIG_HOME:-$HOME/.config}/pro1x/stream-hook
tls_url() {
    name=$(cat "$tls_dir/name" 2>/dev/null)
    if [ -x "$hook" ] && u=$("$hook" url "$1" "$tls_port" 2>/dev/null) && [ -n "$u" ]
    then echo "$u"
    elif [ "$1" = 10.42.0.1 ] && [ -n "$name" ]; then echo "https://$name/"
    else echo "https://$1:$tls_port/"; fi
}
https_state() {
    if grep -qE '^[[:space:]]*STREAM_DOMAIN=[^[:space:]]' "$https_file" 2>/dev/null; then
        cat "$tls_dir/status" 2>/dev/null || echo "set, not checked yet"
    else echo "not set (for browsers that refuse local addresses: some cars)"; fi
}
# The name's certificate and the hotspot's redirect, through sudo
# (pro1x-stream-cert): when a stream starts on the hotspot with a name set
# (a second's check unless a renewal is due), and after the settings are
# saved.  Prints the result.
https_check() {
    timeout 300 /run/privileged/bin/sudo -n /run/current-system/profile/bin/pro1x-stream-cert 2>&1 | tail -1
}
https_wanted() {
    [ "$(main_address)" = 10.42.0.1 ] &&
        grep -qE '^[[:space:]]*STREAM_DOMAIN=[^[:space:]]' "$https_file" 2>/dev/null
}
# A public link to the interactive stream through Tailscale Funnel, for
# a device that reaches the phone by no other way (a car's browser on
# another device's hotspot refuses local addresses).  Opt-in, off by
# default; offered only while Tailscale runs.  While the stream runs,
# anyone with the link reaches its page: the key and the approval guard
# it.  The video still goes straight over the local network when it can.
# Who reaches the browser streams (Settings, Visibility): hotspot, only
# devices on the phone's hotspot; lan, every network the phone is on
# (Wi-Fi, mobile, Tailscale), the default; wan, also the public link.
visibility_file=${XDG_STATE_HOME:-$HOME/.local/state}/pro1x-stream-visibility
visibility() {
    case "$(cat "$visibility_file" 2>/dev/null)" in
        hotspot) echo hotspot ;;
        wan) echo wan ;;
        *) echo lan ;;
    esac
}
funnel_on() { [ "$(visibility)" = wan ]; }
ts_json() { tailscale status --json 2>/dev/null; }
funnel_offered() {
    command -v tailscale >/dev/null &&
        [ "$(ts_json | jq -r '.BackendState // empty')" = Running ]
}
funnel_name() { ts_json | jq -r '.Self.DNSName // empty' | sed 's/\.$//'; }
# What Funnel still needs, one line each with how to set it; nothing when
# ready.
funnel_missing() {
    j=$(ts_json)
    [ "$(echo "$j" | jq -r '.CurrentTailnet.MagicDNSEnabled')" = true ] ||
        echo "- MagicDNS: on, in the Tailscale admin console, DNS page."
    [ "$(echo "$j" | jq -r '.CertDomains | length')" -gt 0 ] 2>/dev/null ||
        echo "- HTTPS Certificates: on, same page (with MagicDNS)."
    [ "$(echo "$j" | jq -r '.Self.CapMap | has("funnel")')" = true ] ||
        printf '%s\n' "- Funnel allowed: Access controls > JSON editor, in \"nodeAttrs\":" \
            '    {"target": ["autogroup:member"], "attr": ["funnel"]}' \
            "  (new tailnets have it already)."
    [ "$(tailscale debug prefs 2>/dev/null | jq -r '.OperatorUser // empty')" = "$(id -un)" ] ||
        echo "- Funnel for this user, once, in a terminal:  sudo tailscale set --operator=$(id -un)"
}
pick_visibility() {
    now=$(visibility)
    v=$(printf '%s\t%s\n' \
            hotspot "Hotspot      only devices on the phone's hotspot" \
            lan "LAN          every network the phone is on: Wi-Fi, mobile, Tailscale" \
            wan "WAN          also a public link on the internet (Tailscale Funnel)" |
            mark "$now" | pick "visibility")
    [ -n "$v" ] || return
    if [ "$v" = wan ]; then
        if ! command -v tailscale >/dev/null; then
            missing="- Tailscale, installed and logged in: docs/configure.md has
  it in config.scm (the tailscale channel, its service); then, once,
  sudo tailscale up"
        elif ! funnel_offered; then
            missing="- Tailscale running and logged in:  sudo tailscale up"
        else
            missing=$(funnel_missing)
        fi
        if [ -n "$missing" ]; then
            clear_screen
            printf 'WAN, a public link through Tailscale Funnel, needs:\n\n%s\n\n' "$missing"
            printf 'Visibility stays %s.  Choose WAN again once these are done.\n' "$now"
            pause
            return
        fi
    fi
    mkdir -p "${visibility_file%/*}"
    echo "$v" > "$visibility_file"
    if [ "$v" = wan ]; then
        clear_screen
        printf 'WAN: https://%s/ while a browser stream runs.\n' "$(funnel_name)"
        printf 'Anyone with the link reaches its page: keep the access key on,\n'
        printf 'and an approval.\n'
        pause
    fi
}
# Funnel on for a stream, off when it ends.
funnel_start() {                # funnel_start PID
    funnel_on && funnel_offered || return 0
    tailscale funnel --bg "$webrtc_port" >/dev/null 2>&1 || return 0
    setsid sh -c 'while kill -0 "$1" 2>/dev/null; do sleep 5; done
                  tailscale funnel --https=443 off' _ "$1" >/dev/null 2>&1 </dev/null &
}
funnel_stop() {
    funnel_on && tailscale funnel --https=443 off >/dev/null 2>&1
    return 0
}

# The settings in the user's editor, from a template the first time.
https_setup() {
    mkdir -p "${https_file%/*}"
    [ -e "$https_file" ] || (umask 077; cat > "$https_file" <<'EOF'
# The stream's HTTPS name on the phone's hotspot (pro1x-stream-cert).
#
# What for: browsers that refuse plain HTTP, self-signed certificates and
# local addresses, and resolve names through their own DNS, as some car
# infotainment systems do (a Tesla's).  Most browsers do not need this:
# leave STREAM_DOMAIN empty.
#
# What it needs: a domain name of yours, at a DNS provider whose API the
# phone can use, and internet on the phone (its mobile data).
#
# What it does: sets the name's public A record to STREAM_ADDRESS, an
# address in no private range; gets a Let's Encrypt certificate for the
# name (a DNS challenge through the same API); and has the hotspot send
# that address to the stream.  The other device, on the phone's hotspot,
# then opens https://STREAM_DOMAIN/.  Other networks: not this way.
#
# Checked when this file is saved from the menu and when a stream starts
# on the hotspot; a first certificate takes about two minutes.  This file
# holds API keys: it stays readable by you only; scripts/backup-phone.sh
# saves it.

# The name, e.g. stream.example.org; empty: off.
STREAM_DOMAIN=
# Its A record; any address in no private range will do.
STREAM_ADDRESS=240.3.3.4
# The DNS provider, and its keys below.  Supported: porkbun.  Another
# provider: a script pro1x-stream-dns-NAME (see pro1x-stream-dns-porkbun),
# its keys as NAME_... lines.
DNS_PROVIDER=porkbun

# porkbun: Account > API Access makes both keys; then switch API Access
# on in the domain's Details.
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=
EOF
    )
    chmod 600 "$https_file"
    ${EDITOR:-nano} "$https_file"
    clear_screen
    printf 'Checking (a first certificate takes about two minutes)…\n'
    https_check
    pause
}
run_hook() { [ -x "$hook" ] && setsid "$hook" "$@" >/dev/null 2>&1 </dev/null & }

trap 'rm -f "$rt/pro1x-tool.done"' EXIT

clear_screen() { printf '\033[H\033[2J\033[3J'; }
pause() { printf '\nPress any key to go back.\n'; read -rsn1; }

streaming() { [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null; }

# The screen kept on while a stream runs: blanked, the panel is no longer
# drawn and the capture freezes, and the lock screen would cover it.  On
# if it was off, and off again when that stream ends, however it ends.
keep_awake() {                  # keep_awake PID
    caf=${XDG_RUNTIME_DIR:-/tmp}/pro1x-caffeine
    [ "$(cat "$caf" 2>/dev/null)" = on ] && return
    sway-quick-actions --act caffeine >/dev/null 2>&1 </dev/null
    setsid sh -c 'while kill -0 "$1" 2>/dev/null; do sleep 5; done
                  [ "$(cat "$2" 2>/dev/null)" = on ] &&
                      sway-quick-actions --act caffeine' _ "$1" "$caf" \
        >/dev/null 2>&1 </dev/null &
}

stop_stream() {
    funnel_stop
    streaming && kill -TERM -- "-$(cat "$pid_file")" 2>/dev/null
    rm -f "$pid_file" "$to_file"
}

fps() { cat "$fps_file" 2>/dev/null || echo 30; }

# Besides the key, a new viewer of the interactive stream may need the
# phone's owner: off, a tap on a notification, or a finger on the sensor.
approve() { cat "$approve_file" 2>/dev/null || echo off; }
# What the interactive stream shows: the phone's panel; or a screen of its
# own at the client's window's shape (a squarish browser), mirrored
# on the panel (client) or apart from it as a second monitor
# (multi-monitor).
screen() { cat "$screen_file" 2>/dev/null || echo phone; }
screen_label() {
    case "$(screen)" in
        client) echo "client, adapts to the client's window" ;;
        multi-monitor) echo "multi-monitor, a display of its own" ;;
        *) echo "host, the phone's ratio and resolution" ;;
    esac
}
# mark CURRENT: a dot before the line whose key is CURRENT.
mark() { awk -F'\t' -v cur="$1" '{ print $1 "\t" ($1 == cur ? "● " : "  ") $2 }'; }
pick_screen() {
    v=$(printf '%s\t%s\n' \
            phone "Host           keeps the phone's ratio and resolution" \
            client "Client         the phone adapts to the client's window" \
            multi-monitor "Multi-monitor  separate displays for the client and the phone" |
            mark "$(screen)" | pick "screen mode")
    [ -n "$v" ] && echo "$v" > "$screen_file"
}
fingers() { pro1x-fpd list 2>/dev/null | grep -c '^finger'; }
pick_approve() {
    n=$(fingers)
    v=$(printf '%s\t%s\n' \
            off "Off            the key alone" \
            tap "Tap            a notification on the phone" \
            fingerprint "Fingerprint    a finger on the sensor$([ "$n" -gt 0 ] 2>/dev/null || echo " (none enrolled yet)")" |
            mark "$(approve)" | pick "connection approval")
    [ -n "$v" ] || return
    if [ "$v" = fingerprint ] && ! [ "$n" -gt 0 ] 2>/dev/null; then
        clear_screen
        printf 'No finger enrolled: Quick actions, Fingerprints, first.\n'
        pause
        return
    fi
    echo "$v" > "$approve_file"
}
pick_key() {
    v=$(printf '%s\t%s\n' \
            on "On             the link carries the key $(current_key)" \
            off "Off            anyone on the network gets in" |
            mark "$(key_on && echo on || echo off)" | pick "access key")
    [ -n "$v" ] && echo "$v" > "$key_file"
}

# The interactive link carries a random key unless turned off (on a shared
# network, only who has the link gets in).
key_on() { [ "$(cat "$key_file" 2>/dev/null)" != off ]; }

# The key stays the same until renewed, so a bookmarked link with ?k= keeps
# working.
current_key() {
    [ -s "$key_value" ] || new_key
    cat "$key_value"
}
new_key() {
    mkdir -p "${key_value%/*}"
    LC_ALL=C tr -dc 'a-km-z2-9' < /dev/urandom | head -c 5 > "$key_value"
}

# A lower rate is what lightens the load: copying the screen costs more than
# encoding it.
pick_fps() {
    rate=$(printf '%s\n' 30 20 15 10 |
        awk -v cur="$(fps)" '{ print $1 "\t" ($1 == cur ? "● " : "  ") $1 " fps" }' |
        pick "capture rate")
    [ -n "$rate" ] || return
    mkdir -p "$(dirname "$fps_file")"
    echo "$rate" > "$fps_file"
}

out_size() { cat "$size_file" 2>/dev/null || echo native; }

# The longest side of the picture sent, in pixels, or native.
pick_size() {
    size=$(printf '%s\n' native 1920 1280 960 640 |
        awk -v cur="$(out_size)" '{ print $1 "\t" ($1 == cur ? "● " : "  ") $1 }' |
        pick "output size")
    [ -n "$size" ] || return
    mkdir -p "$(dirname "$size_file")"
    echo "$size" > "$size_file"
}

# wf-recorder's arguments for a long side of at most $1; none for native.  The
# filter runs before it turns the picture, so it limits both sides.
scale_args() {
    [ "$1" = native ] || printf '%s\n' -F \
        "scale='min($1,iw)':'min($1,ih)':force_original_aspect_ratio=decrease:force_divisible_by=2"
}

# $1, or the most a method can take, $2, if $1 is more or native.
limited() { if [ "$1" = native ] || [ "$1" -gt "$2" ]; then echo "$2"; else echo "$1"; fi; }

# pick PROMPT: lines of "key<TAB>shown" from stdin, the key picked on stdout;
# nothing for the back line, as for Esc and Left (one level back).
pick() {
    { printf 'back\t← back\n'; cat; } |
        fzf --listen="$sock" --delimiter='\t' --with-nth=2 --prompt="$1 > " \
            --layout=reverse-list --no-info --cycle --margin=1,2 \
            --color=16,gutter:-1 --bind='load:pos(2)' --bind='left:abort' |
        cut -f1 | sed '/^back$/d'
}

# An image, as block characters come out too tall in this font.
# show_qr URL [LINES]: the code in what is left below LINES lines of text
# (7 by default), a row being about 40 pixels.
show_qr() {
    rows=$(stty size 2>/dev/null | cut -d' ' -f1)
    qrencode -t PNG -s 8 -m 2 -l L -o - "$1" |
        convert png:- -filter point -resize "x$(( (${rows:-20} - ${2:-7} - 1) * 40 ))" sixel:-
    echo
}

# What can be sent: every window, with its Sway id and the area it covers.
sources() {
    printf 'full\tFull screen\n'
    swaymsg -t get_tree -r | jq -r '
        .. | objects | select(.type? == "workspace" and .name != "__i3_scratch")
        | .name as $ws
        | recurse(.nodes[]?, .floating_nodes[]?)
        | select(.pid? != null and .app_id != "quickactions")
        | "\(.id) \(.rect.x),\(.rect.y) \(.rect.width - .rect.width % 2)x\(.rect.height - .rect.height % 2)\t\($ws): \(.app_id // .window_properties.class // "window"): \(.name)"'
}

# Sets area for wf-recorder and target, the window; false if nothing was picked.
pick_source() {
    source=$(sources | pick "send") || return 1
    [ -n "$source" ] || return 1
    if [ "$source" = full ]; then
        area=() target=
    else
        target=${source%% *}
        area=(-g "${source#* }")
    fi
}

# Sets hw_size and hw_capture, for the hardware encoder: raw frames of at most
# 1920 on the long side, its limit.  It manages about 26 a second at 1280 and
# 16 at 1920.  wf-recorder's rate label is 90000 in its other formats, which
# the encoder also refuses.
hw_source() {
    read -r scale turn sw sh < <(swaymsg -t get_outputs -r | jq -r '
        [.[] | select(.active)][0]
        | "\(.scale) \(.transform) \(.rect.width) \(.rect.height)"')
    if [ -n "$target" ]; then
        geometry=${area[1]#* }
        sw=${geometry%x*} sh=${geometry#*x}
    fi
    read -r w h < <(awk -v w="$sw" -v h="$sh" -v s="$scale" \
                        -v l="$(limited "$(out_size)" 1920)" 'BEGIN {
        w *= s; h *= s; m = w > h ? w : h; f = m > l ? l / m : 1
        w = int(w * f + 0.5); h = int(h * f + 0.5); print w - w % 2, h - h % 2 }')
    rate=$(fps)
    hw_size=${w}x$h@$rate
    # The filter runs before wf-recorder turns the picture.
    case "$turn" in
        *90|*270) filter="scale=$h:$w" ;;
        *) filter="scale=$w:$h" ;;
    esac
    hw_capture=(-D -r "$rate" -F "$filter" -m rawvideo -c rawvideo -x nv12 -f pipe:1)
}

# Hides this menu and brings the window on screen, for it to be captured.
go_to_source() {
    [ -n "$target" ] || return 0
    swaymsg '[app_id="^quickactions$"] move scratchpad' >/dev/null
    swaymsg "[con_id=$target] focus" >/dev/null
}

# This phone's addresses, for a link that others open.
# The addresses other devices can reach: Wi-Fi or the hotspot, mobile data,
# a VPN such as Tailscale when it runs (none of them needed); not USB, nor
# Waydroid's bridge and containers, which only the phone reaches.
own_address() {
    list=$(ip -4 -o addr show scope global |
        awk '$2 !~ /^(usb|lo|waydroid|veth|docker|br-)/ {
                 sub("/.*", "", $4); print $4 "\t" $2 "  " $4 }')
    if [ -z "$list" ]; then
        { echo "No network."; pause; } >&2
    elif [ "$(printf '%s\n' "$list" | wc -l)" -le 1 ]; then
        printf '%s\n' "$list" | cut -f1
    else
        printf '%s\n' "$list" | pick "on network"
    fi
}

# The address a stream is announced on (the bar, the Stop line): the
# hotspot's if it is up, else the first network's; links lists them all.
main_address() { networks | head -1 | cut -d' ' -f1; }

# The phone's addresses, best first: "ADDRESS INTERFACE", hotspot, Wi-Fi,
# Tailscale, then the rest (mobile).
networks() {
    only=$(visibility)
    ip -4 -o addr show scope global |
        awk '$2 !~ /^(usb|lo|waydroid|veth|docker|br-)/ {
                 sub("/.*", "", $4)
                 r = $4 == "10.42.0.1" ? 0 : $2 ~ /^wlan/ ? 1 : $2 ~ /^tailscale/ ? 2 : 3
                 print r, $4, $2 }' | sort -n -k1,1 -s | cut -d' ' -f2- |
        if [ "$only" = hotspot ]; then grep '^10\.42\.0\.1 '; else cat; fi
}

# A browser stream's links, HTTPS then HTTP on each network, with SUFFIX
# (the key): "URL<tab>network  URL".
links() {                       # links [SUFFIX]
    if funnel_on && funnel_offered && n=$(funnel_name) && [ -n "$n" ]; then
        printf 'https://%s/%s\t%-10s https://%s/\n' "$n" "${1:-}" public "$n"
    fi
    networks |
        while read -r a dev; do
            case "$dev" in
                wlan*) [ "$a" = 10.42.0.1 ] && net=hotspot || net=wi-fi ;;
                tailscale*) net=tailscale ;;
                qmap*|rmnet*|wwan*) net=mobile ;;
                *) net=$dev ;;
            esac
            u=$(tls_url "$a")
            printf '%s%s\t%-10s %s\n' "$u" "${1:-}" "$net" "$u"
            u="http://$a:$webrtc_port/"
            printf '%s%s\t%-10s %s\n' "$u" "${1:-}" "$net" "$u"
        done | awk -F'\t' '!seen[$1]++'
}

# A QR code for fzf's preview, as large as the preview allows (a cell
# being about 20x40 pixels).
qr_preview() {
    h=$(( ${FZF_PREVIEW_LINES:-20} * 40 - 40 )) w=$(( ${FZF_PREVIEW_COLUMNS:-40} * 20 - 40 ))
    [ "$h" -lt "$w" ] && size=$h || size=$w
    qrencode -t PNG -s 8 -m 2 -l L -o - "$1" |
        convert png:- -filter point -resize "${size}x${size}" sixel:-
}

# A running stream's links, the highlighted one's QR code beside it.
show_links() {                  # show_links HEADER [SUFFIX]
    links "${2:-}" |
        fzf --listen="$sock" --delimiter='\t' --with-nth=2 --prompt="links > " \
            --header="$1" --layout=reverse-list --no-info --cycle --margin=1,2 \
            --color=16,gutter:-1 --preview="$0 --qr {1}" --bind='left:abort' \
            --preview-window=right,50%,border-left >/dev/null
}

# The devices seen on the local networks: hotspot clients by name.
devices() {
    leases=$($admin leases 2>/dev/null)
    for ip in $(ip -4 neigh show | awk '/lladdr/ && !/FAILED/ { print $1 }' | sort -uV); do
        name=$(printf '%s\n' "$leases" | awk -v i="$ip" '$3 == i { print $4 }')
        [ -n "$name" ] && [ "$name" != "*" ] || name=device
        printf '%s\t%-20s %s\n' "$ip" "$name" "$ip"
    done
    printf 'type\tType an address\n'
}

send_udp() {                    # send_udp [ADDRESS]
    ip=${1:-}
    pick_source || return
    if [ -z "$ip" ]; then
        ip=$(devices | pick "to")
        [ -n "$ip" ] || return
        if [ "$ip" = type ]; then
            clear_screen
            read -rp "Address: " ip
            [ -n "$ip" ] || return
        fi
    fi
    url="udp://@:$udp_port"
    clear_screen
    printf 'In VLC on the other device, open:  %s\n' "$url"
    printf 'Then press a key to start sending to %s.\n\n' "$ip"
    show_qr "$url"
    read -rsn1
    stop_stream
    go_to_source
    if [ -n "${use_hw:-}" ]; then
        hw_source
        setsid pro1x-stream-webrtc udp "$ip" "$udp_port" "$hw_size" \
            wf-recorder "${area[@]}" "${hw_capture[@]}" >/dev/null 2>&1 </dev/null &
    else
        mapfile -t scale < <(scale_args "$(out_size)")
        setsid wf-recorder "${area[@]}" "${scale[@]}" -r "$(fps)" -m mpegts -c libx264 \
            -p preset=ultrafast -p tune=zerolatency -f "udp://$ip:$udp_port" \
            >/dev/null 2>&1 </dev/null &
    fi
    echo $! > "$pid_file"
    echo "VLC to $ip" > "$to_file"
    sleep 1
    streaming || { rm -f "$pid_file" "$to_file"; echo "Could not start."; pause; return; }
    keep_awake "$(cat "$pid_file")"
}

# ffmpeg serves one viewer at a time, and stops when that one leaves: the loop
# is ready for the next.  At most 15 images a second keep the bandwidth bearable.
send_mjpeg() {
    pick_source || return
    ip=$(own_address)
    [ -n "$ip" ] || return
    stop_stream
    rate=$(fps); [ "$rate" -le 15 ] || rate=15
    mapfile -t scale < <(scale_args "$(out_size)")
    setsid bash -c '
        port=$1 rate=$2; shift 2
        while :; do
            wf-recorder "$@" -m mjpeg -c mjpeg -x yuvj420p -r "$rate" -f pipe:1 2>/dev/null |
                ffmpeg -nostdin -loglevel quiet -probesize 100000 \
                    -analyzeduration 0 -f mjpeg -i pipe:0 -c copy -f mpjpeg \
                    -content_type "multipart/x-mixed-replace;boundary=ffmpeg" \
                    -listen 1 "http://0.0.0.0:$port/"
            sleep 1
        done' _ "$http_port" "$rate" "${area[@]}" "${scale[@]}" >/dev/null 2>&1 </dev/null &
    echo $! > "$pid_file"
    keep_awake "$(cat "$pid_file")"
    url="http://$ip:$http_port/"
    echo "browser, $url" > "$to_file"
    clear_screen
    printf 'Open in a browser on the other device:  %s\n' "$url"
    printf 'One viewer at a time.  Press a key once it is open; it keeps running.\n\n'
    show_qr "$url"
    read -rsn1
    go_to_source
}

# The capture starts when a viewer connects, and stops when it leaves.  The
# phone's encoder (1920 pixels at most); the whole screen through the
# ScreenCast portal, a window through wf-recorder.  VP8 in software is the
# fallback for browsers without H.264.
send_webrtc() {
    pick_source || return
    ip=$(main_address)
    [ -n "$ip" ] || { no_network; return; }
    key=() k=
    if key_on; then
        k=$(current_key)
        key=(--key "$k")
    fi
    https_wanted && { printf 'HTTPS name: '; https_check; }
    stop_stream
    hw_source
    rate=$(fps)
    mapfile -t scale < <(scale_args "$(out_size)")
    portal=()                   # see send_interactive
    [ -z "$target" ] && [ "${PRO1X_STREAM_PORTAL:-1}" != 0 ] && portal=(--portal "$turn")
    # -D -r: frames even on a still screen.  A viewer needs a keyframe sent
    # after it connects, and without frames none comes, so the picture stays
    # black.
    setsid pro1x-stream-webrtc --raw "$hw_size" "${key[@]}" --tls "$tls_port" \
        --visibility "$(visibility)" "${portal[@]}" "$webrtc_port" \
        wf-recorder "${area[@]}" "${hw_capture[@]}" -- \
        wf-recorder "${area[@]}" "${scale[@]}" -D -r "$rate" \
            -m ivf -c libvpx \
            -x yuv420p -p deadline=realtime -p cpu-used=8 -p threads=4 \
            -p b=4000000 -p g="$rate" -f pipe:1 \
        >/dev/null 2>&1 </dev/null &
    echo $! > "$pid_file"
    url=$(tls_url "$ip")
    echo "read-only, $url${k:+  key $k} (or http://$ip:$webrtc_port/)" > "$to_file"
    sleep 1
    streaming || { rm -f "$pid_file" "$to_file"; echo "Could not start."; pause; return; }
    keep_awake "$(cat "$pid_file")"
    funnel_start "$(cat "$pid_file")"
    run_hook started "$(cat "$pid_file")" webrtc
    show_links "Streaming.  Open a link on the other device (its code on the right${k:+, with the key $k});
A certificate warning: accept it once.  One viewer; Esc, it keeps running." "${k:+?k=$k}"
    go_to_source
    leave_menu
}

# No address to stream on: none at all, or no hotspot with Visibility on
# Hotspot.
no_network() {
    clear_screen
    if [ "$(visibility)" = hotspot ]; then
        echo "Visibility is Hotspot (Settings), and the phone's hotspot is off."
    else
        echo "No network."
    fi
    pause
}

# Inside quick actions: once a stream is up and its links seen, quick
# actions hides, back at its first list.
leave_menu() {
    case "${PRO1X_TOOL_SOCK:-}" in
        *quick-actions*) sway-quick-actions --hide >/dev/null 2>&1; exit 0 ;;
    esac
}

# The interactive stream (docs/interactive-stream.md): the whole screen by
# hardware WebRTC, and the viewer's touches and keys back.
send_interactive() {
    area=() target=
    # The page asks for the key in a box; the QR code's link carries it.
    key=() k=
    if key_on; then
        k=$(current_key)
        key=(--key "$k")
    fi
    ip=${addr:-$(main_address)}
    [ -n "$ip" ] || { [ -n "${quiet:-}" ] || no_network; return 1; }
    if https_wanted; then
        if [ -n "${quiet:-}" ]; then https_check >/dev/null
        else printf 'HTTPS name: '; https_check; fi
    fi
    stop_stream
    hw_source
    rate=$(fps)
    mapfile -t scale < <(scale_args "$(out_size)")
    # The whole screen through the ScreenCast portal: half wf-recorder's
    # CPU, and cooler.  Its capture and encoder open once for the server
    # (they powered the phone off when opened for each viewer, 2026-11-18).
    # PRO1X_STREAM_PORTAL=0: wf-recorder instead.
    portal=()
    [ -z "$target" ] && [ "${PRO1X_STREAM_PORTAL:-1}" != 0 ] && portal=(--portal "$turn")
    setsid pro1x-stream-webrtc --raw "$hw_size" "${key[@]}" --tls "$tls_port" --screen "$(screen)" \
        --approve "$(approve)" --visibility "$(visibility)" \
        "${portal[@]}" --interactive "$webrtc_port" \
        wf-recorder "${hw_capture[@]}" -- \
        wf-recorder "${scale[@]}" -D -r "$rate" -m ivf -c libvpx \
            -x yuv420p -p deadline=realtime -p cpu-used=8 -p threads=4 \
            -p b=4000000 -p g="$rate" -f pipe:1 \
        >/dev/null 2>&1 </dev/null &
    echo $! > "$pid_file"
    url=$(tls_url "$ip")
    echo "interactive, $url${k:+  key $k} (or http://$ip:$webrtc_port/)" > "$to_file"
    sleep 1
    streaming || { rm -f "$pid_file" "$to_file"
                   [ -n "${quiet:-}" ] && return 1
                   echo "Could not start."; pause; return; }
    keep_awake "$(cat "$pid_file")"
    funnel_start "$(cat "$pid_file")"
    run_hook started "$(cat "$pid_file")" interactive
    [ -n "${quiet:-}" ] && return
    show_links "Streaming.  Open a link on the other device (its code on the right${k:+, with the key $k});
A certificate warning: accept it once.  One viewer; Esc, it runs until Stop." "${k:+?k=$k}"
    leave_menu
}

try_catt() {
    clear_screen
    echo "Looking for Chromecasts…"
    names=$(catt scan 2>/dev/null | awk -F' - ' 'NF >= 2 { print $2 "\t" $2 }')
    if [ -z "$names" ]; then
        echo "None found on this network."
        pause
        return
    fi
    name=$(printf '%s\n' "$names" | pick "chromecast")
    [ -n "$name" ] || return
    clear_screen
    read -rp "Video URL or file: " what
    [ -n "$what" ] || return
    catt -d "$name" cast "$what" || pause
}

network_displays() {
    swaymsg '[app_id="^quickactions$"] move scratchpad' >/dev/null
    swaymsg exec gnome-network-displays >/dev/null
}

[ "${1:-}" = --qr ] && { qr_preview "${2:-}"; exit; }
# For scripts: start the interactive stream on ADDRESS without the menu, or stop.
[ "${1:-}" = --interactive ] && { addr=${2:-} quiet=1 send_interactive; exit; }
[ "${1:-}" = --stop ] && { stop_stream; exit; }
# From Hotspot > Connected devices: this menu, VLC sending to that device.
to=
[ "${1:-}" = --to ] && to=${2:-}

# Settings: one line each, a list of choices for each (Esc comes back).
settings_menu() {
    while :; do
        lines=$(printf '%s\t%s\n' \
            screen "Screen mode          $(screen_label)" \
            fps "Capture rate         $(fps) fps, lower saves CPU" \
            size "Output size          $(out_size), long side" \
            key "Access key           $(key_on && echo "on, $(current_key)" || echo off) (for streams except Browser simple and VLC)" \
            approve "Connection approval  $(approve)" \
            visibility "Visibility           $(visibility)" \
            https "HTTPS name           $(https_state)" \
            renew "Renew access key")
        case "$(printf '%s\n' "$lines" | pick "settings")" in
            screen) pick_screen ;;
            fps) pick_fps ;;
            size) pick_size ;;
            key) pick_key ;;
            approve) pick_approve ;;
            visibility) pick_visibility ;;
            https) https_setup ;;
            renew) new_key ;;
            *) return ;;
        esac
    done
}

while :; do
    lines=$(
        if streaming; then printf 'stop\tStop: %s\n' "$(cat "$to_file")"; fi
        printf '%s\t%s\n' \
            interactive "Browser, interactive  screen, sound, touch and keys; full screen (approval recommended)" \
            webrtc "Browser, read-only    screen and sound, no input; full screen or a window" \
            mjpeg "Browser, simple       no sound, any browser; heavy on bandwidth" \
            udp "VLC                   ${to:+to $to; }needs VLC on the client" \
            catt "Chromecast            sends a video URL or file; the client plays it itself" \
            miracast "Miracast              mirrors to a Miracast or Chromecast display" \
            settings "SETTINGS              screen mode, rate, size, key, approval, visibility, HTTPS")
    choice=$(printf '%s\n' "$lines" | pick "stream")
    case "$choice" in
        stop) stop_stream ;;
        # The phone's encoder up to 1920 pixels, software above.
        udp) if [ "$(limited "$(out_size)" 1921)" -le 1920 ]; then
                 use_hw=1 send_udp "$to"
             else
                 send_udp "$to"
             fi ;;
        mjpeg) send_mjpeg ;;
        webrtc) send_webrtc ;;
        interactive) send_interactive ;;
        settings) settings_menu ;;
        catt) try_catt ;;
        miracast) network_displays; break ;;
        *) break ;;
    esac
done
: > "$rt/pro1x-tool.done"
