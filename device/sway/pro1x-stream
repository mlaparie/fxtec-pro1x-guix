#!/usr/bin/env bash
# pro1x-stream — send the screen, or a window, to another device on any local
# network: the Pro¹x's hotspot, or a Wi-Fi network both are on.  Opened by Enter
# or Right on the Stream line of sway-quick-actions, inside its window, or from
# Hotspot > Connected devices with --to ADDRESS.
#
# Networks that keep their clients apart, as in many hotels, block all of this;
# the hotspot gets around that.  wf-recorder copies an area of the display, so
# what is sent is what is there: starting a window's stream goes to it, and
# switching workspace afterwards sends the other workspace.
#
# Also opens catt and GNOME Network Displays, for Chromecast and Miracast.
#
# State: the MJPEG pipeline, and wf-recorder sending UDP, tested on the phone
# 2026-11-10 without a second device; WebRTC against a GStreamer client.  This
# menu is not yet run.

case "${FZF_DEFAULT_OPTS:-}" in
    *--with-shell=*) ;;
    *) export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:+$FZF_DEFAULT_OPTS }--with-shell='sh -c'" ;;
esac

rt="${XDG_RUNTIME_DIR:-/tmp}"
sock="${PRO1X_TOOL_SOCK:-$rt/pro1x-tool.sock}"
pid_file="$rt/pro1x-stream.pid"
to_file="$rt/pro1x-stream.to"           # what the menus show
fps_file="${XDG_STATE_HOME:-$HOME/.local/state}/pro1x-stream-fps"
size_file="${XDG_STATE_HOME:-$HOME/.local/state}/pro1x-stream-size"
admin="/run/privileged/bin/sudo -n /run/current-system/profile/bin/pro1x-hotspot-admin"
udp_port=5000
http_port=8080
webrtc_port=8081

trap 'rm -f "$rt/pro1x-tool.done"' EXIT

clear_screen() { printf '\033[H\033[2J\033[3J'; }
pause() { printf '\nPress any key to go back.\n'; read -rsn1; }

streaming() { [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null; }

stop_stream() {
    streaming && kill -TERM -- "-$(cat "$pid_file")" 2>/dev/null
    rm -f "$pid_file" "$to_file"
}

fps() { cat "$fps_file" 2>/dev/null || echo 30; }

# A lower rate is what lightens the load: copying the screen costs more than
# encoding it.
pick_fps() {
    rate=$(printf '%s\n' 30 20 15 10 |
        awk -v cur="$(fps)" '{ print $1 "\t" ($1 == cur ? "● " : "  ") $1 " fps" }' |
        pick "capture rate")
    [ -n "$rate" ] || return
    mkdir -p "$(dirname "$fps_file")"
    echo "$rate" > "$fps_file"
}

out_size() { cat "$size_file" 2>/dev/null || echo native; }

# The longest side of the picture sent, in pixels, or native.
pick_size() {
    size=$(printf '%s\n' native 1920 1280 960 640 |
        awk -v cur="$(out_size)" '{ print $1 "\t" ($1 == cur ? "● " : "  ") $1 }' |
        pick "output size")
    [ -n "$size" ] || return
    mkdir -p "$(dirname "$size_file")"
    echo "$size" > "$size_file"
}

# wf-recorder's arguments for a long side of at most $1; none for native.  The
# filter runs before it turns the picture, so it limits both sides.
scale_args() {
    [ "$1" = native ] || printf '%s\n' -F \
        "scale='min($1,iw)':'min($1,ih)':force_original_aspect_ratio=decrease:force_divisible_by=2"
}

# $1, or the most a method can take, $2, if $1 is more or native.
limited() { if [ "$1" = native ] || [ "$1" -gt "$2" ]; then echo "$2"; else echo "$1"; fi; }

# pick PROMPT: lines of "key<TAB>shown" from stdin, the key picked on stdout;
# nothing for the back line, as for Esc.
pick() {
    { printf 'back\t← back\n'; cat; } |
        fzf --listen="$sock" --delimiter='\t' --with-nth=2 --prompt="$1 > " \
            --layout=reverse-list --no-info --cycle --margin=1,2 \
            --color=16,gutter:-1 --bind='load:pos(2)' |
        cut -f1 | sed '/^back$/d'
}

# An image, as block characters come out too tall in this font.
show_qr() {
    rows=$(stty size 2>/dev/null | cut -d' ' -f1)
    qrencode -t PNG -s 8 -m 2 -l L -o - "$1" |
        convert png:- -filter point -resize "x$(( (${rows:-20} - 7) * 40 ))" sixel:-
    echo
}

# What can be sent: every window, with its Sway id and the area it covers.
sources() {
    printf 'full\tFull screen\n'
    swaymsg -t get_tree -r | jq -r '
        .. | objects | select(.type? == "workspace" and .name != "__i3_scratch")
        | .name as $ws
        | recurse(.nodes[]?, .floating_nodes[]?)
        | select(.pid? != null and .app_id != "quickactions")
        | "\(.id) \(.rect.x),\(.rect.y) \(.rect.width - .rect.width % 2)x\(.rect.height - .rect.height % 2)\t\($ws): \(.app_id // .window_properties.class // "window"): \(.name)"'
}

# Sets area for wf-recorder and target, the window; false if nothing was picked.
pick_source() {
    source=$(sources | pick "send") || return 1
    [ -n "$source" ] || return 1
    if [ "$source" = full ]; then
        area=() target=
    else
        target=${source%% *}
        area=(-g "${source#* }")
    fi
}

# Sets hw_size and hw_capture, for the hardware encoder: raw frames of at most
# 1920 on the long side, its limit.  It manages about 26 a second at 1280 and
# 16 at 1920.  wf-recorder's rate label is 90000 in its other formats, which
# the encoder also refuses.
hw_source() {
    read -r scale turn sw sh < <(swaymsg -t get_outputs -r | jq -r '
        [.[] | select(.active)][0]
        | "\(.scale) \(.transform) \(.rect.width) \(.rect.height)"')
    if [ -n "$target" ]; then
        geometry=${area[1]#* }
        sw=${geometry%x*} sh=${geometry#*x}
    fi
    read -r w h < <(awk -v w="$sw" -v h="$sh" -v s="$scale" \
                        -v l="$(limited "$(out_size)" 1920)" 'BEGIN {
        w *= s; h *= s; m = w > h ? w : h; f = m > l ? l / m : 1
        w = int(w * f + 0.5); h = int(h * f + 0.5); print w - w % 2, h - h % 2 }')
    rate=$(fps)
    hw_size=${w}x$h@$rate
    # The filter runs before wf-recorder turns the picture.
    case "$turn" in
        *90|*270) filter="scale=$h:$w" ;;
        *) filter="scale=$w:$h" ;;
    esac
    hw_capture=(-D -r "$rate" -F "$filter" -m rawvideo -c rawvideo -x nv12 -f pipe:1)
}

# Hides this menu and brings the window on screen, for it to be captured.
go_to_source() {
    [ -n "$target" ] || return 0
    swaymsg '[app_id="^quickactions$"] move scratchpad' >/dev/null
    swaymsg "[con_id=$target] focus" >/dev/null
}

# This phone's addresses, for a link that others open.
own_address() {
    list=$(ip -4 -o addr show scope global |
        awk '$2 != "usb0" && $2 != "lo" { sub("/.*", "", $4); print $4 "\t" $2 "  " $4 }')
    if [ -z "$list" ]; then
        { echo "No network."; pause; } >&2
    elif [ "$(printf '%s\n' "$list" | wc -l)" -le 1 ]; then
        printf '%s\n' "$list" | cut -f1
    else
        printf '%s\n' "$list" | pick "on network"
    fi
}

# The devices seen on the local networks: hotspot clients by name.
devices() {
    leases=$($admin leases 2>/dev/null)
    for ip in $(ip -4 neigh show | awk '/lladdr/ && !/FAILED/ { print $1 }' | sort -uV); do
        name=$(printf '%s\n' "$leases" | awk -v i="$ip" '$3 == i { print $4 }')
        [ -n "$name" ] && [ "$name" != "*" ] || name=device
        printf '%s\t%-20s %s\n' "$ip" "$name" "$ip"
    done
    printf 'type\tType an address\n'
}

send_udp() {                    # send_udp [ADDRESS]
    ip=${1:-}
    pick_source || return
    if [ -z "$ip" ]; then
        ip=$(devices | pick "to")
        [ -n "$ip" ] || return
        if [ "$ip" = type ]; then
            clear_screen
            read -rp "Address: " ip
            [ -n "$ip" ] || return
        fi
    fi
    url="udp://@:$udp_port"
    clear_screen
    printf 'In VLC on the other device, open:  %s\n' "$url"
    printf 'Then press a key to start sending to %s.\n\n' "$ip"
    show_qr "$url"
    read -rsn1
    stop_stream
    go_to_source
    if [ -n "${use_hw:-}" ]; then
        hw_source
        setsid pro1x-stream-webrtc udp "$ip" "$udp_port" "$hw_size" \
            wf-recorder "${area[@]}" "${hw_capture[@]}" >/dev/null 2>&1 </dev/null &
    else
        mapfile -t scale < <(scale_args "$(out_size)")
        setsid wf-recorder "${area[@]}" "${scale[@]}" -r "$(fps)" -m mpegts -c libx264 \
            -p preset=ultrafast -p tune=zerolatency -f "udp://$ip:$udp_port" \
            >/dev/null 2>&1 </dev/null &
    fi
    echo $! > "$pid_file"
    echo "VLC to $ip" > "$to_file"
    sleep 1
    streaming || { rm -f "$pid_file" "$to_file"; echo "Could not start."; pause; }
}

# ffmpeg serves one viewer at a time, and stops when that one leaves: the loop
# is ready for the next.  At most 15 images a second keep the bandwidth bearable.
send_mjpeg() {
    pick_source || return
    ip=$(own_address)
    [ -n "$ip" ] || return
    stop_stream
    rate=$(fps); [ "$rate" -le 15 ] || rate=15
    mapfile -t scale < <(scale_args "$(out_size)")
    setsid bash -c '
        port=$1 rate=$2; shift 2
        while :; do
            wf-recorder "$@" -m mjpeg -c mjpeg -x yuvj420p -r "$rate" -f pipe:1 2>/dev/null |
                ffmpeg -nostdin -loglevel quiet -probesize 100000 \
                    -analyzeduration 0 -f mjpeg -i pipe:0 -c copy -f mpjpeg \
                    -content_type "multipart/x-mixed-replace;boundary=ffmpeg" \
                    -listen 1 "http://0.0.0.0:$port/"
            sleep 1
        done' _ "$http_port" "$rate" "${area[@]}" "${scale[@]}" >/dev/null 2>&1 </dev/null &
    echo $! > "$pid_file"
    url="http://$ip:$http_port/"
    echo "browser, $url" > "$to_file"
    clear_screen
    printf 'Open in a browser on the other device:  %s\n' "$url"
    printf 'One viewer at a time.  Press a key once it is open; it keeps running.\n\n'
    show_qr "$url"
    read -rsn1
    go_to_source
}

# The capture starts when a viewer connects, and stops when it leaves.
send_webrtc() {
    pick_source || return
    ip=$(own_address)
    [ -n "$ip" ] || return
    stop_stream
    rate=$(fps)
    mapfile -t scale < <(scale_args "$(out_size)")
    mapfile -t vp8_scale < <(scale_args "$(limited "$(out_size)" 1280)")
    # -D -r: frames even on a still screen.  A viewer needs a keyframe sent
    # after it connects, and without frames none comes, so the picture stays
    # black.  VP8 in software keeps up at 1280, not at this screen's size.
    if [ -n "${use_hw:-}" ]; then
        hw_source
        first=(--raw "$hw_size" "$webrtc_port" wf-recorder "${area[@]}" "${hw_capture[@]}")
    else
        first=("$webrtc_port" wf-recorder "${area[@]}" "${scale[@]}" -D -r "$rate" -m h264 \
            -c libx264 -x yuv420p -p preset=ultrafast -p tune=zerolatency \
            -p profile=baseline -p keyint="$rate" -f pipe:1)
    fi
    setsid pro1x-stream-webrtc "${first[@]}" -- \
        wf-recorder "${area[@]}" "${vp8_scale[@]}" -D -r "$rate" \
            -m ivf -c libvpx \
            -x yuv420p -p deadline=realtime -p cpu-used=8 -p threads=4 \
            -p b=4000000 -p g="$rate" -f pipe:1 \
        >/dev/null 2>&1 </dev/null &
    echo $! > "$pid_file"
    url="http://$ip:$webrtc_port/"
    echo "browser, $url" > "$to_file"
    sleep 1
    streaming || { rm -f "$pid_file" "$to_file"; echo "Could not start."; pause; return; }
    clear_screen
    printf 'Open in a browser on the other device:  %s\n' "$url"
    printf 'One viewer at a time.  Press a key once it is open; it keeps running.\n\n'
    show_qr "$url"
    read -rsn1
    go_to_source
}

try_catt() {
    clear_screen
    echo "Looking for Chromecasts…"
    names=$(catt scan 2>/dev/null | awk -F' - ' 'NF >= 2 { print $2 "\t" $2 }')
    if [ -z "$names" ]; then
        echo "None found on this network."
        pause
        return
    fi
    name=$(printf '%s\n' "$names" | pick "chromecast")
    [ -n "$name" ] || return
    clear_screen
    read -rp "Video URL or file: " what
    [ -n "$what" ] || return
    catt -d "$name" cast "$what" || pause
}

network_displays() {
    swaymsg '[app_id="^quickactions$"] move scratchpad' >/dev/null
    swaymsg exec gnome-network-displays >/dev/null
}

[ "${1:-}" = --to ] && { send_udp "${2:-}"; exit; }

while :; do
    lines=$(
        if streaming; then printf 'stop\tStop: %s\n' "$(cat "$to_file")"; fi
        printf '%s\t%s\n' \
            udp "VLC (UDP)         software; needs VLC there" \
            udphw "VLC, hardware     a little less CPU, 1920 at most" \
            mjpeg "Browser (MJPEG)   no app, any browser; heavy on bandwidth, no sound" \
            webrtc "Browser (WebRTC)  no app, one viewer, software" \
            webrtchw "WebRTC, hardware  a little less CPU, 1920 at most" \
            catt "Chromecast (catt) sends a video or file; the TV plays it itself" \
            miracast "Network Displays  mirrors to a Miracast or Chromecast display" \
            fps "Capture rate      $(fps) fps, lower saves CPU" \
            size "Output size       $(out_size), long side")
    choice=$(printf '%s\n' "$lines" | pick "stream")
    case "$choice" in
        stop) stop_stream ;;
        udp) send_udp ;;
        udphw) use_hw=1 send_udp ;;
        mjpeg) send_mjpeg ;;
        webrtc) send_webrtc ;;
        webrtchw) use_hw=1 send_webrtc ;;
        fps) pick_fps ;;
        size) pick_size ;;
        catt) try_catt ;;
        miracast) network_displays; break ;;
        *) break ;;
    esac
done
: > "$rt/pro1x-tool.done"
