#!/usr/bin/env bash
# pro1x-stream — send the screen, or a window, to another device on any local
# network: the Pro¹x's hotspot, or a Wi-Fi network both are on.  Opened by Enter
# or Right on the Stream line of sway-quick-actions, inside its window, or from
# Hotspot > Connected devices with --to ADDRESS (VLC then sends there).
# --interactive ADDRESS and --stop start and stop the interactive stream
# without the menu.
#
# Networks that keep their clients apart, as in many hotels, block all of this;
# the hotspot gets around that.  wf-recorder copies an area of the display, so
# what is sent is what is there: starting a window's stream goes to it, and
# switching workspace afterwards sends the other workspace.
#
# Also opens catt and GNOME Network Displays, for Chromecast and Miracast.
#
# State: the MJPEG pipeline, and wf-recorder sending UDP, tested on the phone
# 2026-11-10 without a second device; WebRTC against a GStreamer client.  This
# menu is not yet run.

case "${FZF_DEFAULT_OPTS:-}" in
    *--with-shell=*) ;;
    *) export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:+$FZF_DEFAULT_OPTS }--with-shell='sh -c'" ;;
esac

# Run from SSH, without the session's environment: the phone's own Sway
# session's, so that the portal, D-Bus and Sway are reached (a stream
# started from SSH fell back to wf-recorder and got no frames while the
# phone was locked, 2026-11-19).
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
export XDG_RUNTIME_DIR
[ -n "${WAYLAND_DISPLAY:-}" ] || for w in "$XDG_RUNTIME_DIR"/wayland-[0-9]; do
    [ -S "$w" ] && export WAYLAND_DISPLAY="${w##*/}" && break
done
[ -n "${SWAYSOCK:-}" ] || for s in "$XDG_RUNTIME_DIR"/sway-ipc.*.sock; do
    [ -S "$s" ] && export SWAYSOCK="$s" && break
done
# The session bus has a random address (dbus-launch): Sway's own.
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    for pid in $(pgrep -u "$(id -u)" -x sway); do
        a=$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null |
                sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p')
        [ -n "$a" ] && export DBUS_SESSION_BUS_ADDRESS="$a" && break
    done
fi

rt="${XDG_RUNTIME_DIR:-/tmp}"
sock="${PRO1X_TOOL_SOCK:-$rt/pro1x-tool.sock}"
pid_file="$rt/pro1x-stream.pid"
to_file="$rt/pro1x-stream.to"           # what the menus show
kind_file="$rt/pro1x-stream.kind"       # the running stream: KIND [KEY | ADDRESS]
fps_file="${XDG_STATE_HOME:-$HOME/.local/state}/pro1x-stream-fps"
size_file="${XDG_STATE_HOME:-$HOME/.local/state}/pro1x-stream-size"
key_file="${XDG_STATE_HOME:-$HOME/.local/state}/pro1x-stream-key"   # on or off
key_value="${XDG_STATE_HOME:-$HOME/.local/state}/pro1x-stream-key-value"
approve_file="${XDG_STATE_HOME:-$HOME/.local/state}/pro1x-stream-approve"  # off, tap, fingerprint
screen_file="${XDG_STATE_HOME:-$HOME/.local/state}/pro1x-stream-screen"    # phone, client, multi-monitor

admin="/run/privileged/bin/sudo -n /run/current-system/profile/bin/pro1x-hotspot-admin"
udp_port=5000
http_port=8080
webrtc_port=8081
# The same over HTTPS, for browsers that refuse plain HTTP, with the
# phone's own certificate (pro1x-stream-webrtc); on the phone's hotspot,
# the user's own name when one is set up (HTTPS line, pro1x-stream-cert).
tls_port=8443
tls_dir=/var/lib/pro1x/stream-tls
https_file=${XDG_CONFIG_HOME:-$HOME/.config}/pro1x/stream-https.conf
# The user's hook, if executable (an add-on, not the port's):
# `stream-hook url ADDRESS PORT' may print another link to show, and
# `stream-hook started PID KIND' runs once a stream is up (KIND: webrtc or
# interactive); a hook that fails is ignored.
hook=${XDG_CONFIG_HOME:-$HOME/.config}/pro1x/stream-hook
tls_url() {
    name=$(cat "$tls_dir/name" 2>/dev/null)
    if [ -x "$hook" ] && u=$("$hook" url "$1" "$tls_port" 2>/dev/null) && [ -n "$u" ]
    then echo "$u"
    elif [ "$1" = 10.42.0.1 ] && [ -n "$name" ]; then echo "https://$name/"
    else echo "https://$1:$tls_port/"; fi
}
https_state() {
    if grep -qE '^[[:space:]]*STREAM_DOMAIN=[^[:space:]]' "$https_file" 2>/dev/null; then
        cat "$tls_dir/status" 2>/dev/null || echo "set, not checked yet"
    else echo "not set (for browsers that refuse local addresses: some cars)"; fi
}
# The name's certificate and the hotspot's redirect, through sudo
# (pro1x-stream-cert): when a stream starts on the hotspot with a name set
# (a second's check unless a renewal is due), and after the settings are
# saved.  Prints the result.
https_check() {
    timeout 300 /run/privileged/bin/sudo -n /run/current-system/profile/bin/pro1x-stream-cert 2>&1 | tail -1
}
https_wanted() {
    [ "$(main_address)" = 10.42.0.1 ] &&
        grep -qE '^[[:space:]]*STREAM_DOMAIN=[^[:space:]]' "$https_file" 2>/dev/null
}
# A public link to the interactive stream through Tailscale Funnel, for
# a device that reaches the phone by no other way (a car's browser on
# another device's hotspot refuses local addresses).  Opt-in, off by
# default; offered only while Tailscale runs.  While the stream runs,
# anyone with the link reaches its page: the key and the approval guard
# it.  The video still goes straight over the local network when it can.
# Who reaches the browser streams (Settings, Visibility): hotspot, only
# devices on the phone's hotspot; lan, every network the phone is on
# (Wi-Fi, mobile, Tailscale), the default; wan, also the public link.
visibility_file=${XDG_STATE_HOME:-$HOME/.local/state}/pro1x-stream-visibility
visibility() {
    # A TEST may ask for another than the setting (test 1: wan).
    [ -n "${visibility_override:-}" ] && { echo "$visibility_override"; return; }
    case "$(cat "$visibility_file" 2>/dev/null)" in
        hotspot) echo hotspot ;;
        wan) echo wan ;;
        *) echo lan ;;
    esac
}
funnel_on() { [ "$(visibility)" = wan ]; }
ts_json() { tailscale status --json 2>/dev/null; }
funnel_offered() {
    command -v tailscale >/dev/null &&
        [ "$(ts_json | jq -r '.BackendState // empty')" = Running ]
}
funnel_name() { ts_json | jq -r '.Self.DNSName // empty' | sed 's/\.$//'; }
# What Funnel still needs, one line each with how to set it; nothing when
# ready.
funnel_missing() {
    j=$(ts_json)
    [ "$(echo "$j" | jq -r '.CurrentTailnet.MagicDNSEnabled')" = true ] ||
        echo "- MagicDNS: on, in the Tailscale admin console, DNS page."
    [ "$(echo "$j" | jq -r '.CertDomains | length')" -gt 0 ] 2>/dev/null ||
        echo "- HTTPS Certificates: on, same page (with MagicDNS)."
    [ "$(echo "$j" | jq -r '.Self.CapMap | has("funnel")')" = true ] ||
        printf '%s\n' "- Funnel allowed (new tailnets have it already): Access controls > JSON editor, in \"nodeAttrs\":" \
            '    {"target": ["autogroup:member"], "attr": ["funnel"]}'
    [ "$(tailscale debug prefs 2>/dev/null | jq -r '.OperatorUser // empty')" = "$(id -un)" ] ||
        echo "- Funnel for this user, once, in a terminal:  sudo tailscale set --operator=$(id -un)"
}
# What WAN still needs, one item a line; nothing when ready.
wan_missing() {
    if ! command -v tailscale >/dev/null; then
        echo "- Tailscale, installed and logged in: docs/configure.md has it in config.scm (the tailscale channel and its service); then, once: sudo tailscale up"
    elif ! funnel_offered; then
        echo "- Tailscale running and logged in:  sudo tailscale up"
    else
        funnel_missing
    fi
}
# The preview of a choice: what it means, and what it still needs.
info() {                        # info WHAT KEY
    case "$1:$2" in
        visibility:hotspot)
            echo "Only devices on the phone's own hotspot reach the streams."
            echo
            if networks_all | grep -q '^10\.42\.0\.1 '; then echo "The hotspot is on."
            else echo "The hotspot is off now: streams will not start until it is on."; fi ;;
        visibility:lan)
            echo "Every network the phone is on reaches the streams:"
            echo
            networks_all | awk '{ print "  " $2 "  " $1 }' ;;
        visibility:wan)
            echo "LAN, and a public link on the internet through Tailscale Funnel while a browser stream runs: for a device that reaches the phone by no other way.  Anyone with the link reaches the page: keep the access key on, and an approval."
            echo
            missing=$(wan_missing)
            if [ -n "$missing" ]; then printf 'Still needed:\n\n%s\n' "$missing"
            else echo "Ready: https://$(funnel_name)/"; fi ;;
        screen:phone)
            echo "The client sees the phone's screen as it is: its ratio and resolution (Output size scales it down).  A window of another shape shows it with bars." ;;
        screen:client)
            echo "The phone's screen takes the client's window's shape and the Output size, and follows the window when it is resized; the panel shows it too, its touches passed on.  Interactive only." ;;
        screen:multi-monitor)
            echo "A second display at the client's shape, apart from the panel: windows move between the two, as with a second monitor.  Interactive only." ;;
        fps:*)
            echo "Frames captured a second: $2."
            echo
            echo "Lower rates save CPU and heat (copying the screen costs more than encoding it) and bandwidth; 30 is smoothest.  The phone lowers it by itself when it gets hot." ;;
        size:native)
            echo "The picture's long side as the screen's (2160): the sharpest, and the most work.  The phone's encoder takes 1920 at most: above, software encoding (VLC) or 1920." ;;
        size:*)
            echo "The picture's long side scaled to $2 pixels, the ratio kept."
            echo
            echo "Smaller: less work for the phone and less bandwidth, a softer picture; 1280 is a good start for a car or a tablet." ;;
        moonlight:client)
            echo "A screen of the client's size for Sunshine, with the whole phone on it (as the interactive stream's Client mode); the panel mirrors it.  Upright, whatever the panel's turn."
            echo
            echo "In Moonlight, open \"Screen at the client's size\": it takes the client's resolution and frame rate before the session (as Apollo's virtual display on Windows)." ;;
        moonlight:multi)
            echo "A second screen for the client, apart from the panel: windows move between the two, as with a second monitor."
            echo
            echo "In Moonlight, \"Screen at the client's size\" sizes it to the client's resolution." ;;
        moonlight:panel)
            echo "Sunshine captures the panel as it is: its buffer is portrait (the panel is turned in software), so the picture comes sideways." ;;
        test:1)
            echo "A car (or any device) on a hotspot the phone does not run, reaching the stream through Tailscale Funnel, in VIDEO mode: only the page goes through Tailscale; the video, sound and touches go by WebRTC, which tries the hotspot's own network first."
            echo
            echo "Needs Tailscale Funnel ready (Visibility, WAN).  Open the link in the car, wait a minute, touch the screen a few times, then Stop stream.  The page logs which way WebRTC went." ;;
        test:2)
            echo "A car on a hotspot the phone does not run, reaching the phone's own public IPv6 address on that hotspot (the phone's own certificate: the browser warns once).  Shows whether the car uses IPv6 and accepts the phone's address at all."
            echo
            echo "Needs the hotspot to give IPv6 (the phone shows its address below).  Open the https link, accept the warning if one shows, or try the http one; wait a minute, then Stop stream."
            echo
            v6=$(global_v6); echo "The phone's IPv6 address now: ${v6:-none}" ;;
        test:3)
            echo "As test 2, by the HTTPS name with its trusted certificate: the name gets an IPv6 (AAAA) record pointing to the phone while the test runs, cleared at Stop stream (caches may keep it 10 minutes)."
            echo
            echo "Needs the HTTPS name set up (SETTINGS) and IPv6 on the hotspot.  Open the link in the car, wait a minute, then Stop stream."
            echo
            v6=$(global_v6); echo "The phone's IPv6 address now: ${v6:-none}" ;;
        test:4)
            echo "The Tesla phone key through Waydroid's Bluetooth (the soft HCI bridge): logs only, no stream.  Records Android's log (Tesla, Bluetooth, GATT), the Bluetooth trace and the bridge's log, for 20 minutes at most."
            echo
            echo "Near the car: start this, open the Tesla app and set up the phone key (or use it), then come back here and stop it (Test 4 again).  The logs stay in /var/log/pro1x-bt-tests/."
            echo
            if s=$(sudo -n /run/current-system/profile/bin/pro1x-bt-log status 2>/dev/null) && [ -n "$s" ]; then
                echo "Logging now: $s"
            fi ;;
        approve:off) echo "The access key alone lets a viewer in." ;;
        approve:tap) echo "A notification on the phone: a tap lets the viewer in." ;;
        approve:fingerprint)
            echo "A finger on the phone's sensor lets the viewer in, with a buzz."
            echo
            # Not asked of the fingerprint daemon: it serves one client at a
            # time, and while the lock screen waited for a finger the menu
            # hung (2026-11-19).
            echo "Needs a finger enrolled: Quick actions, Fingerprints." ;;
    esac
}
# A choice that cannot apply yet stays in the list, its preview saying why.
pick_visibility() {
    while :; do
        v=$(printf '%s\t%s\n' \
                hotspot "Hotspot      only devices on the phone's hotspot" \
                lan "LAN          every network the phone is on" \
                wan "WAN          also a public link (Tailscale Funnel)" |
                mark "$(visibility)" | pick_info "visibility" visibility)
        [ -n "$v" ] || return
        [ "$v" = wan ] && [ -n "$(wan_missing)" ] && continue
        mkdir -p "${visibility_file%/*}"
        echo "$v" > "$visibility_file"
        return
    done
}
# Funnel on for a stream, off when it ends.
funnel_start() {                # funnel_start PID
    funnel_on && funnel_offered || return 0
    tailscale funnel --bg "$webrtc_port" >/dev/null 2>&1 || return 0
    setsid sh -c 'while kill -0 "$1" 2>/dev/null; do sleep 5; done
                  tailscale funnel --https=443 off' _ "$1" >/dev/null 2>&1 </dev/null &
}
funnel_stop() {
    funnel_on && tailscale funnel --https=443 off >/dev/null 2>&1
    return 0
}

# The settings in the user's editor, from a template the first time.
https_setup() {
    mkdir -p "${https_file%/*}"
    [ -e "$https_file" ] || (umask 077; cat > "$https_file" <<'EOF'
# The stream's HTTPS name on the phone's hotspot (pro1x-stream-cert).
#
# What for: browsers that refuse plain HTTP, self-signed certificates and
# local addresses, and resolve names through their own DNS, as some car
# infotainment systems do (a Tesla's).  Most browsers do not need this:
# leave STREAM_DOMAIN empty.
#
# What it needs: a domain name of yours, at a DNS provider whose API the
# phone can use, and internet on the phone (its mobile data).
#
# What it does: sets the name's public A record to STREAM_ADDRESS, an
# address in no private range; gets a Let's Encrypt certificate for the
# name (a DNS challenge through the same API); and has the hotspot send
# that address to the stream.  The other device, on the phone's hotspot,
# then opens https://STREAM_DOMAIN/.  Other networks: not this way.
#
# Checked when this file is saved from the menu and when a stream starts
# on the hotspot; a first certificate takes about two minutes.  This file
# holds API keys: it stays readable by you only; scripts/backup-phone.sh
# saves it.

# The name, e.g. stream.example.org; empty: off.
STREAM_DOMAIN=
# Its A record; any address in no private range will do.
STREAM_ADDRESS=240.3.3.4
# The DNS provider: porkbun, cloudflare or desec (deSEC, free), and
# its keys below (only the chosen provider's are read).  Another provider:
# a script pro1x-stream-dns-NAME (see pro1x-stream-dns-porkbun), its keys
# as NAME_... lines.
DNS_PROVIDER=

# porkbun: Account > API Access makes both keys; then switch API Access
# on in the domain's Details.
#PORKBUN_API_KEY=pk1_...
#PORKBUN_SECRET_KEY=sk1_...

# cloudflare: My Profile > API Tokens > Create Token, "Edit zone DNS",
# for the domain.
#CLOUDFLARE_API_TOKEN=...

# desec: Token management, in deSEC's web interface.
#DESEC_TOKEN=...
EOF
    )
    chmod 600 "$https_file"
    ${EDITOR:-nano} "$https_file"
    clear_screen
    notice "HTTPS name: $(https_check)"
}
run_hook() { [ -x "$hook" ] && setsid "$hook" "$@" >/dev/null 2>&1 </dev/null & }

trap 'rm -f "$rt/pro1x-tool.done"' EXIT

clear_screen() { printf '\033[H\033[2J\033[3J'; }
pause() { printf '\nPress any key to go back.\n'; read -rsn1; }
# A message in fzf over a back line: nothing printed outside fzf (author).
notice() {                      # notice TEXT
    printf 'back\t← back\n' |
        fzf --listen="$sock" --delimiter='\t' --with-nth=2 --header="$1" \
            --layout=reverse-list --no-info --margin=1,2 --color=16,gutter:-1 \
            --bind='left:abort' --bind='right:accept' >/dev/null
}
# A line typed in fzf's own prompt.
ask() {                         # ask PROMPT HEADER
    fzf --listen="$sock" --print-query --prompt="$1 > " --header="$2" --no-info \
        --margin=1,2 --color=16,gutter:-1 --bind='left:abort' </dev/null | head -1
}

streaming() { [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null; }

# The screen kept on while a stream runs: blanked, the panel is no longer
# drawn and the capture freezes, and the lock screen would cover it.  On
# if it was off, and off again when that stream ends, however it ends.
keep_awake() {                  # keep_awake PID
    caf=${XDG_RUNTIME_DIR:-/tmp}/pro1x-caffeine
    [ "$(cat "$caf" 2>/dev/null)" = on ] && return
    sway-quick-actions --act caffeine >/dev/null 2>&1 </dev/null
    setsid sh -c 'while kill -0 "$1" 2>/dev/null; do sleep 5; done
                  [ "$(cat "$2" 2>/dev/null)" = on ] &&
                      sway-quick-actions --act caffeine' _ "$1" "$caf" \
        >/dev/null 2>&1 </dev/null &
}

stop_stream() {
    [ -f "$aaaa_file" ] && aaaa_clear &
    # Moonlight's screen of its own (pro1x-virtual-screen), after Sunshine.
    stop_screen=$([ -f "$rt/pro1x-virtual-screen" ] && echo 1)
    funnel_stop
    streaming && kill -TERM -- "-$(cat "$pid_file")" 2>/dev/null
    rm -f "$pid_file" "$to_file" "$kind_file"
    [ -n "${stop_screen:-}" ] && pro1x-virtual-screen stop
}

# The running stream's links again (Show links, or its line chosen again).
running_links() {
    read -r kind arg < "$kind_file" 2>/dev/null || return
    case "$kind" in
        interactive|webrtc) show_links "$(streaming_note "$arg")" "${arg:+?k=$arg}" ;;
        mjpeg) simple_links ;;
        moonlight) moonlight_links ;;
        test[123]) test_links "${kind#test}" "$arg" ;;
        udp) printf '%s\t%-10s %s\n' "udp://@:$udp_port" vlc "udp://@:$udp_port" |
                 show_urls "Sending to $arg: in VLC there, open the URL above." >/dev/null ;;
    esac
}
running_kind() { streaming && cut -d' ' -f1 "$kind_file" 2>/dev/null; }

fps() { cat "$fps_file" 2>/dev/null || echo 30; }

# Besides the key, a new viewer of the interactive stream may need the
# phone's owner: off, a tap on a notification, or a finger on the sensor.
approve() { cat "$approve_file" 2>/dev/null || echo off; }
# What the interactive stream shows: the phone's panel; or a screen of its
# own at the client's window's shape (a squarish browser), mirrored
# on the panel (client) or apart from it as a second monitor
# (multi-monitor).
screen() { cat "$screen_file" 2>/dev/null || echo phone; }
screen_label() {
    case "$(screen)" in
        client) echo "client, adapts to the client's window" ;;
        multi-monitor) echo "multi-monitor, a display of its own" ;;
        *) echo "host, the phone's ratio and resolution" ;;
    esac
}
# mark CURRENT: a dot before the line whose key is CURRENT.
mark() { awk -F'\t' -v cur="$1" '{ print $1 "\t" ($1 == cur ? "● " : "  ") $2 }'; }
pick_screen() {
    v=$(printf '%s\t%s\n' \
            phone "Host           keeps the phone's ratio and resolution" \
            client "Client         the phone adapts to the client's window" \
            multi-monitor "Multi-monitor  separate displays for the client and the phone" |
            mark "$(screen)" | pick_info "screen mode" screen)
    [ -n "$v" ] && echo "$v" > "$screen_file"
}
pick_approve() {
    while :; do
        v=$(printf '%s\t%s\n' \
                off "Off            the key alone" \
                tap "Tap            a notification on the phone" \
                fingerprint "Fingerprint    a finger on the sensor" |
                mark "$(approve)" | pick_info "connection approval" approve)
        [ -n "$v" ] || return
        echo "$v" > "$approve_file"
        return
    done
}
pick_key() {
    v=$(printf '%s\t%s\n' \
            on "On             the link carries the key $(current_key)" \
            off "Off            anyone on the network gets in" |
            mark "$(key_on && echo on || echo off)" | pick "access key")
    [ -n "$v" ] && echo "$v" > "$key_file"
}

# The interactive link carries a random key unless turned off (on a shared
# network, only who has the link gets in).
key_on() { [ "$(cat "$key_file" 2>/dev/null)" != off ]; }

# The key stays the same until renewed, so a bookmarked link with ?k= keeps
# working.
current_key() {
    [ -s "$key_value" ] || new_key
    cat "$key_value"
}
new_key() {
    mkdir -p "${key_value%/*}"
    LC_ALL=C tr -dc 'a-km-z2-9' < /dev/urandom | head -c 5 > "$key_value"
}

# A lower rate is what lightens the load: copying the screen costs more than
# encoding it.
pick_fps() {
    rate=$(printf '%s\n' 30 20 15 10 |
        awk -v cur="$(fps)" '{ print $1 "\t" ($1 == cur ? "● " : "  ") $1 " fps" }' |
        pick_info "capture rate" fps)
    [ -n "$rate" ] || return
    mkdir -p "$(dirname "$fps_file")"
    echo "$rate" > "$fps_file"
}

out_size() { cat "$size_file" 2>/dev/null || echo native; }

# The longest side of the picture sent, in pixels, or native.
pick_size() {
    size=$(printf '%s\n' native 1920 1280 960 640 |
        awk -v cur="$(out_size)" '{ print $1 "\t" ($1 == cur ? "● " : "  ") $1 }' |
        pick_info "output size" size)
    [ -n "$size" ] || return
    mkdir -p "$(dirname "$size_file")"
    echo "$size" > "$size_file"
}

# wf-recorder's arguments for a long side of at most $1; none for native.  The
# filter runs before it turns the picture, so it limits both sides.
scale_args() {
    [ "$1" = native ] || printf '%s\n' -F \
        "scale='min($1,iw)':'min($1,ih)':force_original_aspect_ratio=decrease:force_divisible_by=2"
}

# $1, or the most a method can take, $2, if $1 is more or native.
limited() { if [ "$1" = native ] || [ "$1" -gt "$2" ]; then echo "$2"; else echo "$1"; fi; }

# pick PROMPT: lines of "key<TAB>shown" from stdin, the key picked on stdout;
# nothing for the back line, as for Esc and Left (one level back).
pick() {                        # pick PROMPT [FZF-OPTION...]
    prompt=$1; shift
    { printf 'back\t← back\n'; cat; } |
        fzf --listen="$sock" --delimiter='\t' --with-nth=2 --prompt="$prompt > " \
            --layout=reverse-list --no-info --cycle --margin=1,2 \
            --color=16,gutter:-1 --bind='load:pos(2)' --bind='left:abort' --bind='right:accept' "$@" |
        cut -f1 | sed '/^back$/d'
}
# A list whose preview explains the highlighted line (info WHAT KEY).
pick_info() {                   # pick_info PROMPT WHAT
    pick "$1" --preview="$0 --info $2 {1}" --preview-window=right,50%,wrap,border-left
}

# What can be sent: every window, with its Sway id and the area it covers.
sources() {
    printf 'full\tFull screen\n'
    swaymsg -t get_tree -r 2>/dev/null | jq -r '
        .. | objects | select(.type? == "workspace" and .name != "__i3_scratch")
        | .name as $ws
        | recurse(.nodes[]?, .floating_nodes[]?)
        | select(.pid? != null and .app_id != "quickactions")
        | "\(.id) \(.rect.x),\(.rect.y) \(.rect.width - .rect.width % 2)x\(.rect.height - .rect.height % 2)\t\($ws): \(.app_id // .window_properties.class // "window"): \(.name)"'
}

# Sets area for wf-recorder and target, the window; false if nothing was picked.
pick_source() {
    source=$(sources | pick "send") || return 1
    [ -n "$source" ] || return 1
    if [ "$source" = full ]; then
        area=() target=
    else
        target=${source%% *}
        area=(-g "${source#* }")
    fi
}

# Sets hw_size and hw_capture, for the hardware encoder: raw frames of at most
# 1920 on the long side, its limit.  It manages about 26 a second at 1280 and
# 16 at 1920.  wf-recorder's rate label is 90000 in its other formats, which
# the encoder also refuses.
hw_source() {
    read -r scale turn sw sh < <(swaymsg -t get_outputs -r 2>/dev/null | jq -r '
        [.[] | select(.active)][0]
        | "\(.scale) \(.transform) \(.rect.width) \(.rect.height)"')
    if [ -n "$target" ]; then
        geometry=${area[1]#* }
        sw=${geometry%x*} sh=${geometry#*x}
    fi
    read -r w h < <(awk -v w="$sw" -v h="$sh" -v s="$scale" \
                        -v l="$(limited "$(out_size)" 1920)" 'BEGIN {
        w *= s; h *= s; m = w > h ? w : h; f = m > l ? l / m : 1
        w = int(w * f + 0.5); h = int(h * f + 0.5); print w - w % 2, h - h % 2 }')
    rate=$(fps)
    hw_size=${w}x$h@$rate
    # The filter runs before wf-recorder turns the picture.
    case "$turn" in
        *90|*270) filter="scale=$h:$w" ;;
        *) filter="scale=$w:$h" ;;
    esac
    hw_capture=(-D -r "$rate" -F "$filter" -m rawvideo -c rawvideo -x nv12 -f pipe:1)
}

# Hides this menu and brings the window on screen, for it to be captured.
go_to_source() {
    [ -n "$target" ] || return 0
    swaymsg '[app_id="^quickactions$"] move scratchpad' >/dev/null 2>&1
    swaymsg "[con_id=$target] focus" >/dev/null 2>&1
}

# This phone's addresses, for a link that others open.
# The addresses other devices can reach: Wi-Fi or the hotspot, mobile data,
# a VPN such as Tailscale when it runs (none of them needed); not USB, nor
# Waydroid's bridge and containers, which only the phone reaches.
own_address() {
    list=$(ip -4 -o addr show scope global |
        awk '$2 !~ /^(usb|lo|waydroid|veth|docker|br-)/ {
                 sub("/.*", "", $4); print $4 "\t" $2 "  " $4 }')
    if [ -z "$list" ]; then
        notice "No network."
    elif [ "$(printf '%s\n' "$list" | wc -l)" -le 1 ]; then
        printf '%s\n' "$list" | cut -f1
    else
        printf '%s\n' "$list" | pick "on network"
    fi
}

# The address a stream is announced on (the bar, the Stop line): the
# hotspot's if it is up, else the first network's; links lists them all.
main_address() { networks | head -1 | cut -d' ' -f1; }

# The phone's addresses, best first: "ADDRESS INTERFACE", hotspot, Wi-Fi,
# Tailscale, then the rest (mobile).
networks_all() { only=all networks_raw; }
networks() { only=$(visibility) networks_raw; }
networks_raw() {
    ip -4 -o addr show scope global |
        awk '$2 !~ /^(usb|lo|waydroid|veth|docker|br-)/ {
                 sub("/.*", "", $4)
                 r = $4 == "10.42.0.1" ? 0 : $2 ~ /^wlan/ ? 1 : $2 ~ /^tailscale/ ? 2 : 3
                 print r, $4, $2 }' | sort -n -k1,1 -s | cut -d' ' -f2- |
        if [ "$only" = hotspot ]; then grep '^10\.42\.0\.1 '; else cat; fi
}

# A network's name in the link lists.
net_name() {                    # net_name ADDRESS INTERFACE
    case "$2" in
        wlan*) [ "$1" = 10.42.0.1 ] && echo hotspot || echo wi-fi ;;
        tailscale*) echo tailscale ;;
        qmap*|rmnet*|wwan*) echo mobile ;;
        *) echo "$2" ;;
    esac
}

# A browser stream's links, HTTPS then HTTP on each network, with SUFFIX
# (the key): "URL<tab>network  URL".
links() {                       # links [SUFFIX]
    if funnel_on && funnel_offered && n=$(funnel_name) && [ -n "$n" ]; then
        printf 'https://%s/%s\t%-10s https://%s/\n' "$n" "${1:-}" public "$n"
    fi
    networks |
        while read -r a dev; do
            net=$(net_name "$a" "$dev")
            u=$(tls_url "$a")
            printf '%s%s\t%-10s %s\n' "$u" "${1:-}" "$net" "$u"
            u="http://$a:$webrtc_port/"
            printf '%s%s\t%-10s %s\n' "$u" "${1:-}" "$net" "$u"
        done | awk -F'\t' '!seen[$1]++'
}

# A QR code for fzf's preview, as large as the preview allows (a cell
# being about 20x40 pixels).
# The QR code in half-block characters: it scales with the terminal's own
# cells, so it fits the pane wherever the menu shows (quick actions,
# SSH, tmux); sized as an image from the phone's focused window it
# overflowed elsewhere (author, 2026-11-20).  About 15% taller than wide
# in this font.
qr_preview() {
    # In quick actions' own window (foot draws sixel): chafa, which fits the
    # image to the preview's cells itself (the author's choice; sizing it
    # here from the window's pixels came out wrong).  Elsewhere (SSH,
    # tmux) text: sixel may not get through.
    case "${PRO1X_TOOL_SOCK:-}" in
        *quick-actions*)
            qrencode -t PNG -s 8 -m 2 -l L -o - "$1" |
                chafa -f sixel --animate=off --polite=on \
                      -s "${FZF_PREVIEW_COLUMNS:-40}x${FZF_PREVIEW_LINES:-20}" -
            return ;;
    esac
    qrencode -t UTF8 -m 1 -l L "$1"
}

# A running stream's links, the highlighted one's QR code beside it.
# The link list's header (author's words).
streaming_note() {              # streaming_note [KEY]
    echo "Streaming is now on${1:+ with key '$1'}."
    echo "Stream URLs are listed above, with QR codes."
    echo "Quick actions can be closed (Super+q or Esc);"
    echo "the stream keeps running."
}
show_links() {                  # show_links HEADER [SUFFIX]
    links "${2:-}" | show_urls "$1" >/dev/null
}
# Lines of "URL<tab>shown" from stdin, the highlighted one's QR code beside
# them; the URL picked with Enter on stdout, nothing for Esc or Left.
show_urls() {                   # show_urls HEADER
    { printf 'back\t← back\n'; cat; } |
    fzf --listen="$sock" --delimiter='\t' --with-nth=2 --prompt="links > " \
        --bind='load:pos(2)' \
        --header="$1" --layout=reverse-list --no-info --cycle --margin=1,2 \
        --color=16,gutter:-1 --preview="$0 --qr {1}" --bind='left:abort' --bind='right:accept' \
        --preview-window=right,50%,border-left | cut -f1 | sed '/^back$/d'
}

# The devices seen on the local networks: hotspot clients by name.
devices() {
    leases=$($admin leases 2>/dev/null)
    for ip in $(ip -4 neigh show | awk '/lladdr/ && !/FAILED/ { print $1 }' | sort -uV); do
        name=$(printf '%s\n' "$leases" | awk -v i="$ip" '$3 == i { print $4 }')
        [ -n "$name" ] && [ "$name" != "*" ] || name=device
        printf '%s\t%-20s %s\n' "$ip" "$name" "$ip"
    done
    printf 'type\tType an address\n'
}

send_udp() {                    # send_udp [ADDRESS]
    ip=${1:-}
    pick_source || return
    if [ -z "$ip" ]; then
        ip=$(devices | pick "to")
        [ -n "$ip" ] || return
        if [ "$ip" = type ]; then
            ip=$(ask address "The other device's address; Enter, or Esc to go back.")
            [ -n "$ip" ] || return
        fi
    fi
    url="udp://@:$udp_port"
    started=$(printf '%s\t%-10s %s\n' "$url" vlc "$url" |
        show_urls "In VLC on the other device, open the URL above (its QR code on the right).
Then Enter starts sending to $ip; Esc goes back.")
    [ -n "$started" ] || return
    stop_stream
    go_to_source
    if [ -n "${use_hw:-}" ]; then
        hw_source
        setsid pro1x-stream-webrtc udp "$ip" "$udp_port" "$hw_size" \
            wf-recorder "${area[@]}" "${hw_capture[@]}" >/dev/null 2>&1 </dev/null &
    else
        mapfile -t scale < <(scale_args "$(out_size)")
        setsid wf-recorder "${area[@]}" "${scale[@]}" -r "$(fps)" -m mpegts -c libx264 \
            -p preset=ultrafast -p tune=zerolatency -f "udp://$ip:$udp_port" \
            >/dev/null 2>&1 </dev/null &
    fi
    echo $! > "$pid_file"
    echo "VLC to $ip" > "$to_file"
    echo "udp $ip" > "$kind_file"
    sleep 1
    streaming || { rm -f "$pid_file" "$to_file"; notice "Could not start."; return; }
    keep_awake "$(cat "$pid_file")"
    leave_menu
}

simple_links() {
    networks | while read -r a dev; do
        printf 'http://%s:%s/\t%-10s http://%s:%s/\n' "$a" "$http_port" "$(net_name "$a" "$dev")" "$a" "$http_port"
    done | show_urls "$(streaming_note)" >/dev/null
}

# TESTS: numbered ways for a car on a hotspot the phone does not run to
# reach the stream (author, 2026-11-20; the phone's own hotspot and its
# HTTPS name work already).  Each writes a marked section to
# ~/.local/state/pro1x/stream-tests.log (the phone's addresses, routes and
# Wi-Fi connection), and starts the interactive stream with
# PRO1X_STREAM_TEST=N: the server logs every connection, request and
# failure (refused TLS handshakes too), and the page which way WebRTC went,
# in ~/.local/state/pro1x/interactive-stream.log.
# State: written 2026-11-20, not yet run in a car.
tests_log=${XDG_STATE_HOME:-$HOME/.local/state}/pro1x/stream-tests.log
aaaa_file="$rt/pro1x-stream-aaaa"         # test 3: the name given an AAAA

# The phone's public IPv6 address on its Wi-Fi: not a temporary one (they
# change) nor a deprecated one.
global_v6() {
    ip -6 -o addr show dev wlan0 scope global 2>/dev/null |
        awk '!/temporary|deprecated|tentative/ { sub("/.*", "", $4); print $4; exit }'
}

https_setting() {               # https_setting KEY: its value in the HTTPS file
    sed -n "s/^[[:space:]]*$1=//p" "$https_file" 2>/dev/null | tail -1 |
        sed 's/^["'"'"']//; s/["'"'"']$//'
}

# The DNS provider's script, as this user, with only its own keys from the
# HTTPS file in its environment.
dns_hook() {                    # dns_hook COMMAND ARG...
    provider=$(https_setting DNS_PROVIDER)
    case "$provider" in ''|*[!a-z0-9]*) return 1 ;; esac
    command -v "pro1x-stream-dns-$provider" >/dev/null || return 1
    prefix=$(echo "$provider" | tr a-z A-Z)_
    (
        for name in $(sed -n "s/^[[:space:]]*\($prefix[A-Z0-9_]*\)=.*/\1/p" "$https_file" | sort -u); do
            export "$name=$(https_setting "$name")"
        done
        "pro1x-stream-dns-$provider" "$@"
    )
}

aaaa_clear() {
    [ -f "$aaaa_file" ] || return 0
    name=$(cat "$aaaa_file")
    rm -f "$aaaa_file"
    if dns_hook aaaa-clear "$name" >>"$tests_log" 2>&1; then
        echo "$(date '+%F %T') test 3: AAAA of $name cleared" >> "$tests_log"
    else
        echo "$(date '+%F %T') test 3: AAAA of $name NOT cleared" >> "$tests_log"
    fi
}

test_header() {                 # test_header N TEXT
    mkdir -p "${tests_log%/*}"
    {
        echo
        echo "=== $(date '+%F %T') test $1: $2"
        echo "--- addresses"; ip -o addr show dev wlan0 2>/dev/null | awk '{ print $3, $4, $NF }'
        echo "--- routes"; ip route show default 2>/dev/null; ip -6 route show default 2>/dev/null
        echo "--- connections"; nmcli -t -f TYPE,DEVICE,STATE c show --active 2>/dev/null
        echo "--- tailscale"; tailscale status --self --peers=false 2>/dev/null | head -2
    } >> "$tests_log" 2>&1
}

test_links() {                  # test_links N KEY
    k=$2
    case "$1" in
        1) printf 'https://%s/?k=%s&mode=video\t%-10s https://%s/  (VIDEO)\n' \
                  "$(funnel_name)" "$k" funnel "$(funnel_name)" ;;
        2) v6=$(global_v6)
           printf 'https://[%s]:%s/?k=%s\t%-10s https://[%s]:%s/\n' "$v6" "$tls_port" "$k" "IPv6" "$v6" "$tls_port"
           printf 'http://[%s]:%s/?k=%s\t%-10s http://[%s]:%s/\n' "$v6" "$webrtc_port" "$k" "IPv6 http" "$v6" "$webrtc_port" ;;
        3) name=$(https_setting STREAM_DOMAIN)
           printf 'https://%s:%s/?k=%s\t%-10s https://%s:%s/  (IPv6 by name)\n' \
                  "$name" "$tls_port" "$k" "$name" "$name" "$tls_port" ;;
    esac | show_urls "Test $1, key ${k:-none}: open the link in the car, wait a minute, touch the screen, then Stop stream.  Logged for later." >/dev/null
}

# Test 4: Bluetooth logs only (pro1x-bt-log, as root through sudo): the
# same entry starts and stops them.
bt_log_test() {
    bt_log="sudo -n /run/current-system/profile/bin/pro1x-bt-log"
    running=$($bt_log status 2>/dev/null)
    if [ -n "$running" ]; then
        dir=$($bt_log stop 2>/dev/null)
        echo "$(date '+%F %T') test 4: Bluetooth logs stopped: $dir" >> "$tests_log"
        notice "Test 4: logs stopped and kept in $dir."
    else
        test_header 4 "Tesla phone key, Waydroid Bluetooth (logs)"
        dir=$($bt_log start 2>/dev/null) || { notice "Test 4: the logs could not start."; return; }
        echo "$(date '+%F %T') test 4: Bluetooth logs in $dir" >> "$tests_log"
        notice "Test 4: logging (20 minutes at most).  Set up or use the phone key in the Tesla app, then choose Test 4 again to stop."
    fi
}

run_test() {                    # run_test N
    n=$1
    [ "$n" = 4 ] && { bt_log_test; return; }
    case "$n" in
        1) missing=$(funnel_missing)
           [ -z "$missing" ] || { notice "Test 1 needs Tailscale Funnel: $missing"; return; } ;;
        2|3) [ -n "$(global_v6)" ] ||
                 { notice "Test $n needs a public IPv6 address on the Wi-Fi: this network gives none."; return; } ;;
    esac
    if [ "$n" = 3 ]; then
        name=$(https_setting STREAM_DOMAIN)
        [ -n "$name" ] || { notice "Test 3 needs the HTTPS name (SETTINGS, HTTPS name)."; return; }
        aaaa_clear
        if dns_hook aaaa "$name" "$(global_v6)" >>"$tests_log" 2>&1; then
            echo "$name" > "$aaaa_file"
        else
            notice "Test 3: the name's AAAA record could not be set (see $tests_log)."
            return
        fi
    fi
    case "$n" in
        1) test_header 1 "Funnel, VIDEO (page by Tailscale, media by WebRTC)" ;;
        2) test_header 2 "IPv6 address $(global_v6), own certificate" ;;
        3) test_header 3 "IPv6 by name $(https_setting STREAM_DOMAIN) -> $(global_v6)" ;;
    esac
    export PRO1X_STREAM_TEST=$n
    visibility_override=$([ "$n" = 1 ] && echo wan || echo lan)
    quiet=1 send_interactive
    started=$?
    unset PRO1X_STREAM_TEST visibility_override
    [ "$started" = 0 ] ||
        { notice "Test $n: the stream did not start."; aaaa_clear; return; }
    k=$(key_on && current_key)
    echo "test$n ${k:-}" > "$kind_file"
    echo "$(date '+%F %T') test $n: stream started (key ${k:-none})" >> "$tests_log"
    test_links "$n" "$k"
    leave_menu
}

tests_menu() {
    choice=$(printf '%s\t%s\n' \
        1 "Test 1  Funnel, VIDEO: page by Tailscale, video and touch by WebRTC" \
        2 "Test 2  Another hotspot, the phone's IPv6 address (own certificate)" \
        3 "Test 3  Another hotspot, IPv6 by the HTTPS name (trusted certificate)" \
        4 "Test 4  Tesla phone key, Waydroid's Bluetooth: logs (start/stop)" |
        pick_info "tests" test)
    [ -n "$choice" ] && run_test "$choice"
}

# Moonlight: Sunshine, a Moonlight host, if the owner installed it (it is
# not part of the port: their home config, from a channel that packages it).
# It encodes in software (no Moonlight host uses Venus): hot, a fallback to
# the browser stream for Moonlight's own apps.  It asks a login once (its web
# page, where Moonlight's PIN is typed) and then runs until Stop stream.
# State: started by hand on the phone 2026-11-20; this entry untried.
sunshine_port=47990
moonlight_links() {
    networks | while read -r a dev; do
        printf 'https://%s:%s/	%-10s %s  (PIN page: https://%s:%s/)
' \
            "$a" "$sunshine_port" "$(net_name "$a" "$dev")" "$a" "$a" "$sunshine_port"
    done | show_urls "Moonlight: add this host by its address, then type the PIN Moonlight shows on the PIN page (Sunshine's login).
Software encoding: the phone gets hot.  Stop stream ends it." >/dev/null
}

# Sunshine's app that sizes the screen to the viewer's before its session
# (SUNSHINE_CLIENT_WIDTH, _HEIGHT, _FPS), added once to its apps.json.
sunshine_app() {
    apps=$HOME/.config/sunshine/apps.json
    [ -f "$apps" ] || echo '{"env": {}, "apps": []}' > "$apps"
    jq -e '.apps[] | select(.name == "Screen at the client'"'"'s size")' "$apps" >/dev/null 2>&1 && return
    jq '.apps += [{"name": "Screen at the client'"'"'s size", "image-path": "desktop.png",
                   "prep-cmd": [{"do": "sh -c \"pro1x-virtual-screen size ${SUNSHINE_CLIENT_WIDTH}x${SUNSHINE_CLIENT_HEIGHT} ${SUNSHINE_CLIENT_FPS}\"",
                                 "undo": ""}]}]' "$apps" > "$apps.new" && mv "$apps.new" "$apps"
}

send_moonlight() {
    if ! command -v sunshine >/dev/null; then
        notice "Moonlight needs Sunshine, a Moonlight host, which the port does not ship: add \"sunshine\" to your home packages (from a channel that packages it) and apply your home config."
        return
    fi
    if ! grep -qs '"username"' "$HOME/.config/sunshine/sunshine_state.json"; then
        user=$(ask "Sunshine login, name" "Sunshine's web page (where Moonlight's PIN goes) asks for it; once.")
        [ -n "$user" ] || return
        pass=$(ask "Sunshine login, password" "Shown as you type it.")
        [ -n "$pass" ] || return
        sunshine --creds "$user" "$pass" >/dev/null 2>&1 </dev/null
    fi
    shape=$(printf '%s\t%s\n' \
        client "The phone, at the client's size  the panel mirrors it (upright)" \
        multi  "A second screen for the client    the panel keeps its own" \
        panel  "The panel as it is                Sunshine shows it sideways" |
        pick_info "moonlight" moonlight)
    [ -n "$shape" ] || return
    stop_stream
    conf=$HOME/.config/sunshine/sunshine.conf
    mkdir -p "${conf%/*}"
    touch "$conf"
    sed -i '/^[[:space:]]*output_name[[:space:]]*=/d' "$conf"
    if [ "$shape" != panel ]; then
        # Sunshine finds its output by name, read once at its start: the
        # screen first, then Sunshine (src/platform/linux/wlgrab.cpp).
        name=$(pro1x-virtual-screen start "$shape") ||
            { notice "No screen of its own: $name"; return; }
        echo "output_name = $name" >> "$conf"
        sunshine_app
    fi
    setsid sunshine >"$rt/sunshine.log" 2>&1 </dev/null &
    echo $! > "$pid_file"
    echo "moonlight $shape" > "$kind_file"
    echo "moonlight, Sunshine on port $sunshine_port" > "$to_file"
    sleep 2
    streaming || { rm -f "$pid_file" "$to_file" "$kind_file"
                   notice "Sunshine did not start: $(tail -n 3 "$rt/sunshine.log")"; return; }
    keep_awake "$(cat "$pid_file")"
    run_hook started "$(cat "$pid_file")" moonlight
    moonlight_links
    leave_menu
}

# ffmpeg serves one viewer at a time, and stops when that one leaves: the loop
# is ready for the next.  At most 15 images a second keep the bandwidth bearable.
send_mjpeg() {
    pick_source || return
    ip=$(own_address)
    [ -n "$ip" ] || return
    stop_stream
    rate=$(fps); [ "$rate" -le 15 ] || rate=15
    mapfile -t scale < <(scale_args "$(out_size)")
    setsid bash -c '
        port=$1 rate=$2; shift 2
        while :; do
            wf-recorder "$@" -m mjpeg -c mjpeg -x yuvj420p -r "$rate" -f pipe:1 2>/dev/null |
                ffmpeg -nostdin -loglevel quiet -probesize 100000 \
                    -analyzeduration 0 -f mjpeg -i pipe:0 -c copy -f mpjpeg \
                    -content_type "multipart/x-mixed-replace;boundary=ffmpeg" \
                    -listen 1 "http://0.0.0.0:$port/"
            sleep 1
        done' _ "$http_port" "$rate" "${area[@]}" "${scale[@]}" >/dev/null 2>&1 </dev/null &
    echo $! > "$pid_file"
    keep_awake "$(cat "$pid_file")"
    url="http://$ip:$http_port/"
    echo "simple, $url" > "$to_file"
    echo mjpeg > "$kind_file"
    simple_links
    go_to_source
    leave_menu
}

# The capture starts when a viewer connects, and stops when it leaves.  The
# phone's encoder (1920 pixels at most); the whole screen through the
# ScreenCast portal, a window through wf-recorder.  VP8 in software is the
# fallback for browsers without H.264.
send_webrtc() {
    pick_source || return
    ip=$(main_address)
    [ -n "$ip" ] || { no_network; return; }
    key=() k=
    if key_on; then
        k=$(current_key)
        key=(--key "$k")
    fi
    https_wanted && https_check >/dev/null
    stop_stream
    hw_source
    rate=$(fps)
    mapfile -t scale < <(scale_args "$(out_size)")
    portal=()                   # see send_interactive
    [ -z "$target" ] && [ "${PRO1X_STREAM_PORTAL:-1}" != 0 ] && portal=(--portal "$turn")
    # -D -r: frames even on a still screen.  A viewer needs a keyframe sent
    # after it connects, and without frames none comes, so the picture stays
    # black.
    setsid pro1x-stream-webrtc --raw "$hw_size" "${key[@]}" --tls "$tls_port" \
        --visibility "$(visibility)" "${portal[@]}" "$webrtc_port" \
        wf-recorder "${area[@]}" "${hw_capture[@]}" -- \
        wf-recorder "${area[@]}" "${scale[@]}" -D -r "$rate" \
            -m ivf -c libvpx \
            -x yuv420p -p deadline=realtime -p cpu-used=8 -p threads=4 \
            -p b=4000000 -p g="$rate" -f pipe:1 \
        >/dev/null 2>&1 </dev/null &
    echo $! > "$pid_file"
    url=$(tls_url "$ip")
    echo "read-only, $url${k:+  key $k} (or http://$ip:$webrtc_port/)" > "$to_file"
    echo "webrtc $k" > "$kind_file"
    sleep 1
    streaming || { rm -f "$pid_file" "$to_file"; notice "Could not start."; return; }
    keep_awake "$(cat "$pid_file")"
    funnel_start "$(cat "$pid_file")"
    run_hook started "$(cat "$pid_file")" webrtc
    show_links "$(streaming_note "$k")" "${k:+?k=$k}"
    go_to_source
    leave_menu
}

# No address to stream on: none at all, or no hotspot with Visibility on
# Hotspot.
no_network() {
    if [ "$(visibility)" = hotspot ]; then
        notice "Visibility is Hotspot (SETTINGS), and the phone's hotspot is off."
    else
        notice "No network."
    fi
}

# Inside quick actions: once a stream is up and its links seen, quick
# actions hides, back at its first list.
leave_menu() {
    case "${PRO1X_TOOL_SOCK:-}" in
        *quick-actions*) sway-quick-actions --hide >/dev/null 2>&1; exit 0 ;;
    esac
}

# The interactive stream (docs/interactive-stream.md): the whole screen by
# hardware WebRTC, and the viewer's touches and keys back.
send_interactive() {
    area=() target=
    # The page asks for the key in a box; the QR code's link carries it.
    key=() k=
    if key_on; then
        k=$(current_key)
        key=(--key "$k")
    fi
    ip=${addr:-$(main_address)}
    [ -n "$ip" ] || { [ -n "${quiet:-}" ] || no_network; return 1; }
    if https_wanted; then
        https_check >/dev/null
    fi
    stop_stream
    hw_source
    rate=$(fps)
    mapfile -t scale < <(scale_args "$(out_size)")
    # The whole screen through the ScreenCast portal: half wf-recorder's
    # CPU, and cooler.  Its capture and encoder open once for the server
    # (they powered the phone off when opened for each viewer, 2026-11-18).
    # PRO1X_STREAM_PORTAL=0: wf-recorder instead.
    portal=()
    [ -z "$target" ] && [ "${PRO1X_STREAM_PORTAL:-1}" != 0 ] && portal=(--portal "$turn")
    setsid pro1x-stream-webrtc --raw "$hw_size" "${key[@]}" --tls "$tls_port" --screen "$(screen)" \
        --approve "$(approve)" --visibility "$(visibility)" \
        "${portal[@]}" --interactive "$webrtc_port" \
        wf-recorder "${hw_capture[@]}" -- \
        wf-recorder "${scale[@]}" -D -r "$rate" -m ivf -c libvpx \
            -x yuv420p -p deadline=realtime -p cpu-used=8 -p threads=4 \
            -p b=4000000 -p g="$rate" -f pipe:1 \
        >/dev/null 2>&1 </dev/null &
    echo $! > "$pid_file"
    url=$(tls_url "$ip")
    echo "interactive, $url${k:+  key $k} (or http://$ip:$webrtc_port/)" > "$to_file"
    echo "interactive $k" > "$kind_file"
    sleep 1
    streaming || { rm -f "$pid_file" "$to_file"
                   [ -n "${quiet:-}" ] && return 1
                   notice "Could not start."; return; }
    keep_awake "$(cat "$pid_file")"
    funnel_start "$(cat "$pid_file")"
    run_hook started "$(cat "$pid_file")" interactive
    [ -n "${quiet:-}" ] && return
    show_links "$(streaming_note "$k")" "${k:+?k=$k}"
    leave_menu
}

try_catt() {
    # The list fills as the scan finds them.
    name=$(catt scan 2>/dev/null | awk -F' - ' 'NF >= 2 { print $2 "\t" $2; fflush() }' |
               pick "chromecast" --header="Chromecasts on this network (looking…)")
    [ -n "$name" ] || return
    what=$(ask "video URL or file" "For $name; Enter sends it, Esc goes back.")
    [ -n "$what" ] || return
    err=$(catt -d "$name" cast "$what" 2>&1) || notice "Chromecast: ${err:-failed}"
}

# The portal hands Network Displays the panel's buffer as stored, sideways
# when the panel is turned (in software), and the turn apart, which it
# ignores: the TV got it sideways and squeezed (author, 2026-11-22).  Our
# patch turns it back (ND_VIDEO_FLIP), for the panel's turn when it starts.
network_displays() {
    swaymsg '[app_id="^quickactions$"] move scratchpad' >/dev/null 2>&1
    t=$(swaymsg -t get_outputs -r | jq -r '.[] | select(.name == "DSI-1") | .transform')
    case "$t" in
        90) flip=counterclockwise ;; 270) flip=clockwise ;; 180) flip=rotate-180 ;; *) flip= ;;
    esac
    swaymsg exec "pro1x-stream --network-displays $flip" >/dev/null 2>&1
}

# Network Displays aborts at start now and then, in libpulse ("Assertion
# 'c->callback' failed", about one start in two, 2026-11-22, the
# unpatched build too): started again, eight times at most, while it
# dies within its first 5 s.
[ "${1:-}" = --network-displays ] && {
    for _ in 1 2 3 4 5 6 7 8; do
        t0=$(date +%s)
        ND_VIDEO_FLIP=${2:-} gnome-network-displays && exit 0
        [ $(( $(date +%s) - t0 )) -lt 5 ] || exit 0
    done
    exit 1
}

[ "${1:-}" = --qr ] && { qr_preview "${2:-}"; exit; }
[ "${1:-}" = --info ] && { info "${2:-}" "${3:-}"; exit; }
# For scripts: start the interactive stream on ADDRESS without the menu, or stop.
[ "${1:-}" = --interactive ] && { addr=${2:-} quiet=1 send_interactive; exit; }
[ "${1:-}" = --stop ] && { stop_stream; exit; }
# The tests list alone: quick actions' Tests line (author: at its root).
[ "${1:-}" = --tests ] && { tests_menu; exit; }
# From Hotspot > Connected devices: this menu, VLC sending to that device.
to=
[ "${1:-}" = --to ] && to=${2:-}

# Settings: one line each, a list of choices for each (Esc comes back).
settings_menu() {
    while :; do
        lines=$(printf '%s\t%s\n' \
            screen "Screen mode          $(screen_label)" \
            fps "Capture rate         $(fps) fps, lower saves CPU" \
            size "Output size          $(out_size), long side" \
            approve "Connection approval  $(approve)" \
            visibility "Visibility           $(visibility)" \
            https "HTTPS name           $(https_state)" \
            key "Access key           $(key_on && echo "on, $(current_key)" || echo off) (for streams except Browser simple and VLC)" \
            renew "Renew access key")
        case "$(printf '%s\n' "$lines" | pick "settings")" in
            screen) pick_screen ;;
            fps) pick_fps ;;
            size) pick_size ;;
            key) pick_key ;;
            approve) pick_approve ;;
            visibility) pick_visibility ;;
            https) https_setup ;;
            renew) new_key ;;
            *) return ;;
        esac
    done
}

while :; do
    lines=$(
        if streaming; then printf 'stop\tStop stream\n'; fi
        printf '%s\t%s\n' \
            interactive "Browser, interactive  lowest latency; screen, sound, touch and keys (approval recommended)" \
            webrtc "Browser, read-only    lowest latency; screen and sound, no input" \
            mjpeg "Browser, simple       no sound, any browser; heavy on bandwidth" \
            udp "VLC                   ${to:+to $to; }needs VLC on the client" \
            moonlight "Moonlight             Sunshine host for Moonlight's apps; software, hot" \
            catt "Chromecast            sends a video URL or file; the client plays it itself" \
            miracast "Miracast              mirrors to a Miracast or Chromecast display" \
            settings "SETTINGS              screen mode, rate, size, key, approval, visibility, HTTPS" |
            # The running stream's line: "active: show links" (author).
            awk -F'\t' -v k="$(running_kind)" '$1 == k { print $1 "\t" substr($2, 1, 22) "active: show links"; next } { print }')
    choice=$(printf '%s\n' "$lines" | pick "stream")
    # The running stream's own line: its links, not a restart.
    [ -n "$choice" ] && [ "$choice" = "$(running_kind)" ] && choice=links
    case "$choice" in
        links) running_links; leave_menu ;;
        stop) stop_stream ;;
        # The phone's encoder up to 1920 pixels, software above.
        udp) if [ "$(limited "$(out_size)" 1921)" -le 1920 ]; then
                 use_hw=1 send_udp "$to"
             else
                 send_udp "$to"
             fi ;;
        mjpeg) send_mjpeg ;;
        moonlight) send_moonlight ;;
        webrtc) send_webrtc ;;
        interactive) send_interactive ;;
        settings) settings_menu ;;
        catt) try_catt ;;
        miracast) network_displays; break ;;
        *) break ;;
    esac
done
: > "$rt/pro1x-tool.done"
