#!/bin/sh
# pro1x-wifi-powersave — Wi-Fi power saving, as root (sudoers in
# system/mobile.scm; reading it needs no root: iw dev wlan0 get power_save).
#
#   on | off   set it now, and for the connected network from then on
#              (NetworkManager's powersave; quick actions' Wi-Fi line)
#   hold       off for now, what it was kept (pro1x-stream-webrtc, while a
#              stream runs)
#   release    back to what it was before hold
#
# Power saving delays and drops what the phone sends: during a stream, pings
# to the router took 640 ms on average with it on (2026-11-19), and the
# viewer lost frames.  Without power saving the Wi-Fi uses more battery.
#
# State: hold, release and get used on the phone (2026-11-19).

PATH=/run/current-system/profile/bin:/run/current-system/profile/sbin:$PATH
iface=wlan0
held=/run/pro1x/wifi-powersave-held

now() { iw dev "$iface" get power_save 2>/dev/null | awk '{ print $3 }'; }
set_now() { iw dev "$iface" set power_save "$1" 2>/dev/null; }

case "${1:-}" in
    on|off)
        set_now "$1"
        con=$(nmcli -g GENERAL.CONNECTION device show "$iface" 2>/dev/null)
        # 3: enabled, 2: disabled.
        [ -n "$con" ] &&
            nmcli connection modify "$con" 802-11-wireless.powersave \
                  "$([ "$1" = on ] && echo 3 || echo 2)"
        rm -f "$held" ;;
    hold)
        mkdir -p "${held%/*}"
        [ -e "$held" ] || now > "$held"
        set_now off ;;
    release)
        [ -e "$held" ] || exit 0
        [ "$(cat "$held")" = on ] && set_now on
        rm -f "$held" ;;
    *) echo "usage: pro1x-wifi-powersave on|off|hold|release" >&2; exit 2 ;;
esac
exit 0
