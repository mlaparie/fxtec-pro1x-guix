#!/bin/sh
# pro1x-call-watch — let Calls answer an incoming call over the Sway lock
#
# Nothing can be drawn above Sway's lock screen (ext-session-lock), so an
# incoming call could not be answered while locked (author, 2026-10-30).
# This follows ModemManager's CallAdded and CallDeleted signals on the
# system bus.  For an incoming call (Call Direction 1) while locked, it
# unlocks (pro1x-lock --app-unlock) and lights the panel; Calls
# then shows its window fullscreen (Sway config rule).  When that call is
# deleted (hung up, rejected or missed), it locks again (pro1x-lock).
# Meanwhile the phone is unlocked for as long as the call lasts: the price
# of answering from the lock screen here.  Started by the Sway config; ends
# with Sway (socket gone).
#
# During any call (incoming or outgoing, from CallAdded until the last
# CallDeleted) it also follows the proximity sensor (monitor-sensor
# --proximity, iio-sensor-proxy): near the face the panel goes off and touch
# input is disabled, so the cheek cannot press anything; away from it both
# come back.  Phosh does its own.
#
# State: written 2026-10-30, not yet run on the phone (needs a call).

rt="${XDG_RUNTIME_DIR:-/tmp}"
LOCK_SCREEN_APPS=org.gnome.Calls
[ -r /etc/pro1x/apps.conf ] && . /etc/pro1x/apps.conf
flag="$rt/pro1x-call-unlocked"        # path of the call we unlocked for
calls="$rt/pro1x-calls"               # paths of the calls in progress
proxpid="$rt/pro1x-call-proximity.pid"

# A stream showing the panel, with Keep screen on: the ear does not blank
# it while it rings (pro1x-pocket does the same and tells it once).  Once
# the call is picked up the stream pauses (stream_pause), and the ear
# blanks as usual.  Only the panel goes off, so a stream's own screen goes
# on.
paused="$rt/pro1x-call-paused"
panel_streamed() {
    [ ! -e "$paused" ] &&
        [ "$(cat "$rt/pro1x-caffeine" 2>/dev/null)" = on ] &&
        { { [ -f "$rt/pro1x-stream.pid" ] && kill -0 "$(cat "$rt/pro1x-stream.pid")" 2>/dev/null; } ||
          { [ -f "$rt/wl-cast.pid" ] && kill -0 "$(cat "$rt/wl-cast.pid")" 2>/dev/null; }; } &&
        ! swaymsg -t get_outputs -r | jq -e 'any(.[]; .name | startswith("HEADLESS-"))' >/dev/null
}

# The stream paused while a call is picked up: privacy (its sound would
# carry the call) and the phone's power (author, 2026-11-21).
stream_pause() {                      # stream_pause USR1|USR2
    p=$(cat "$rt/pro1x-stream.pid" 2>/dev/null) && kill -"$1" "$p" 2>/dev/null
    # wl-cast, tried beside pro1x-stream: the same signals (wl-cast pause).
    p=$(cat "$rt/wl-cast.pid" 2>/dev/null) && kill -"$1" "$p" 2>/dev/null
}

near() {                              # near 1|0
    echo "$1" > "$rt/pro1x-call-near"
    if [ "$1" = 1 ]; then
        panel_streamed && return
        swaymsg 'input 1046:9286:Goodix_Capacitive_TouchScreen events disabled' >/dev/null
        swaymsg 'output DSI-1 power off' >/dev/null
    else
        swaymsg 'output DSI-1 power on' >/dev/null
        swaymsg 'input 1046:9286:Goodix_Capacitive_TouchScreen events enabled' >/dev/null
    fi
}

proximity_start() {
    [ -f "$proxpid" ] && kill -0 "$(cat "$proxpid")" 2>/dev/null && return
    ( monitor-sensor --proximity 2>/dev/null |
          while IFS= read -r l; do
              case "$l" in
                  *"value changed: 1"*) near 1 ;;
                  *"value changed: 0"*) near 0 ;;
              esac
          done ) &
    echo $! > "$proxpid"
}

proximity_stop() {
    if [ -f "$proxpid" ]; then
        pkill -P "$(cat "$proxpid")" 2>/dev/null
        kill "$(cat "$proxpid")" 2>/dev/null
        rm -f "$proxpid"
    fi
    near 0
}

rm -f "$calls"; touch "$calls"

incoming() {                          # incoming <call object path>
    gdbus call --system --dest org.freedesktop.ModemManager1 \
        --object-path "$1" \
        --method org.freedesktop.DBus.Properties.Get \
        org.freedesktop.ModemManager1.Call Direction 2>/dev/null |
        grep -q '<1>'
}

if [ -n "${SWAYSOCK:-}" ]; then
    # Sway's exec double-forks: stop when its IPC socket goes away.  The
    # whole process group (kill 0), not only this shell: gdbus monitor and
    # the loop kept an old copy alive after a logout (2026-10-30).
    # A Sway that died can leave its socket behind (2026-11-06: a stale
    # watcher of a dead Sway fought the live one over an incoming call),
    # so also check the Sway PID in the socket name.
    swaypid=${SWAYSOCK%.sock}; swaypid=${swaypid##*.}
    ( while [ -S "$SWAYSOCK" ] && kill -0 "$swaypid" 2>/dev/null; do sleep 10; done; proximity_stop; kill 0 ) &
fi

# Lines such as
#   /org/freedesktop/ModemManager1/Modem/0: org.freedesktop.ModemManager1.Modem.Voice.CallAdded (objectpath '/org/freedesktop/ModemManager1/Call/1',)
gdbus monitor --system --dest org.freedesktop.ModemManager1 2>/dev/null |
    while IFS= read -r line; do
        call=$(printf '%s\n' "$line" | sed -n "s/.*objectpath '\([^']*\)'.*/\1/p")
        case "$line" in
            *Modem.Voice.CallAdded*)
                [ -n "$call" ] && echo "$call" >> "$calls" && proximity_start
                # Only when Calls may open over the lock screen
                # (lock-screen-apps in config.scm).
                if [ -n "$call" ] && incoming "$call" &&
                   case " $LOCK_SCREEN_APPS " in *" org.gnome.Calls "*) true ;; *) false ;; esac &&
                   pro1x-lock --locked; then
                    echo "$call" > "$flag"
                    pro1x-lock --app-unlock
                    swaymsg 'output * power on' >/dev/null
                    swaymsg 'input 1046:9286:Goodix_Capacitive_TouchScreen events enabled' >/dev/null
                    pro1x-dim restore 2>/dev/null
                fi ;;
            *Call.StateChanged*)
                # MMCallState 4: active, the call picked up.  Already at
                # the ear: blank now that the stream no longer holds it.
                case "$line" in
                    *"StateChanged ("*", 4, "*)
                        if [ ! -e "$paused" ]; then
                            touch "$paused"
                            stream_pause USR1
                            [ "$(cat "$rt/pro1x-call-near" 2>/dev/null)" = 1 ] && near 1
                        fi ;;
                esac ;;
            *Modem.Voice.CallDeleted*)
                grep -v -x -F "$call" "$calls" > "$calls.new"; mv "$calls.new" "$calls"
                if ! [ -s "$calls" ]; then
                    proximity_stop
                    [ -e "$paused" ] && rm -f "$paused" && stream_pause USR2
                fi
                if [ -f "$flag" ] && [ "$(cat "$flag")" = "$call" ]; then
                    rm -f "$flag"
                    swaymsg exec pro1x-lock >/dev/null
                fi ;;
        esac
    done
