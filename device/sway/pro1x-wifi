#!/usr/bin/env bash
# pro1x-wifi — pick a Wi-Fi network with fzf and connect, asking for the
# password of a new one (nmcli -a).  The author's nmcli-fzf script
# (mlaparie's guix-config, .config/sway/scripts/nmcli-fzf), opened by
# Right on the Wi-Fi line of sway-quick-actions.  Cosmetic changes only
# (author, 2026-11-02): the SSID right after the in-use mark, the IN-USE
# header and its padding gone (the * alone marks the active network),
# Mbit/s shortened to Mb/s (padded, columns stay aligned).

# fzf runs its binds and previews with $SHELL -c: with fish as the login
# shell each took 1.6 s to start, and fish cannot parse the sh in them
# (2026-11-06).  The user's own fzf in a terminal keeps $SHELL.
export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:+$FZF_DEFAULT_OPTS }--with-shell='sh -c'"

err=0
ssid=$(nmcli -f 'bssid,in-use,ssid,signal,bars,freq,rate,security' \
    --color yes device wifi list --rescan yes \
    | sed -E 's/^(BSSID +)IN-USE  /\1  /;
              s/^(\x1b\[[0-9;]*m[^\x1b]*\x1b\[0m  \x1b\[[0-9;]*m.\x1b\[0m) {6}/\1/;
              s/ Mbit\/s/ Mb\/s  /' \
    | fzf --ansi \
          --with-nth=2.. \
          --reverse \
          --cycle \
	  --print-query \
          --header-lines=1 \
	  --margin='1,2,1,2' \
          --color='16,gutter:-1' \
    | sed 's/^ *\*//' \
    | awk '{print $1}')
echo "Please wait while connecting to network $ssid…"
nmcli device wifi connect ${ssid} 2> /dev/null || err=1
if [[ "$err" = 1 ]]; then
  printf "SSID "
  nmcli -a device wifi connect ${ssid}
fi
printf "Press any key to close.\n" && read -n1

