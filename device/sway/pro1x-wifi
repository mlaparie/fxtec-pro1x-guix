#!/usr/bin/env bash
# pro1x-wifi — pick a Wi-Fi network with fzf and connect, asking for the
# password of a new one (nmcli -a).  After the author's nmcli-fzf script
# (mlaparie's guix-config, .config/sway/scripts/nmcli-fzf), opened from the
# Wi-Fi line of sway-quick-actions (networks…), floating.
#
# Columns (author, 2026-11-02): the SSID first, "*" before the one in use
# (no in-use column), then signal, bars, band, rate in Mb/s, security; the
# BSSID rides along hidden, so two networks of one name stay apart.  A name
# typed with nothing selected is tried as a hidden network.

tab=$'\t'
list() {
    # Terse output: colons inside fields come escaped (\:); kept apart
    # from the separators while splitting.
    nmcli -t -f 'in-use,ssid,signal,bars,freq,rate,security,bssid' \
          device wifi list --rescan yes |
        sed 's/\\:/\x01/g' |
        awk -F: -v OFS='\t' '{
            for (i = 1; i <= NF; i++) gsub("\x01", ":", $i)
            sub(/ Mbit\/s/, " Mb/s", $6)
            printf "%s %-24.24s\t%3s\t%s\t%s\t%s\t%s\t%s\n",
                   ($1 == "*" ? "*" : " "), ($2 == "" ? "(hidden)" : $2),
                   $3, $4, $5, $6, $7, $8
        }'
}

out=$(list |
      fzf --delimiter="$tab" --with-nth=1..6 \
          --reverse --cycle --print-query --prompt='Wi-Fi > ' \
          --margin='1,2,1,2' --color='16,gutter:-1')
query=$(printf '%s\n' "$out" | sed -n 1p)
pick=$(printf '%s\n' "$out" | sed -n 2p)
if [ -n "$pick" ]; then
    target=$(printf '%s\n' "$pick" | cut -f7)
    name=$(printf '%s\n' "$pick" | cut -f1 | sed 's/^. //; s/ *$//')
else
    target=$query name=$query
fi
[ -n "$target" ] || exit 0
echo "Connecting to $name…"
if ! nmcli device wifi connect "$target" 2>/dev/null; then
    nmcli -a device wifi connect "$target"
fi
printf "Press any key to close.\n" && read -rn1
