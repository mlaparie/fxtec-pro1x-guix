rpmsg: glink-smem: Wake the system for the modem's messages.

The GLINK SMEM interrupt is IRQF_NO_SUSPEND: in s2idle it is handled,
but it reports no wakeup event, so user space stays frozen and
ModemManager never sees an incoming call or SMS.  The edge labelled
"mpss" (the modem) now takes a hard wakeup event for each message, held
1 s; the ADSP and CDSP edges do not (the ADSP talks all the time).
User space decides whether to stay awake (pro1x-sleep: a call or not).

Ours (fxtec-pro1x-guix, 2026-11-01).  Untested.

--- a/drivers/rpmsg/qcom_glink_smem.c	2026-11-01 12:52:47.477953251 +0100
+++ b/drivers/rpmsg/qcom_glink_smem.c	2026-11-01 12:52:47.561955984 +0100
@@ -10,6 +10,7 @@
 #include <linux/of_irq.h>
 #include <linux/interrupt.h>
 #include <linux/platform_device.h>
+#include <linux/pm_wakeup.h>
 #include <linux/mailbox_client.h>
 #include <linux/mfd/syscon.h>
 #include <linux/slab.h>
@@ -45,6 +46,9 @@
 	struct mbox_chan *mbox_chan;
 
 	u32 remote_pid;
+
+	/* The modem's edge: its messages wake a suspended system. */
+	struct wakeup_source *ws;
 };
 
 struct glink_smem_pipe {
@@ -205,6 +209,15 @@
 {
 	struct qcom_glink_smem *smem = data;
 
+	/*
+	 * A message from the modem (an incoming call, an SMS) wakes a system
+	 * in s2idle, so that ModemManager can read it: the interrupt is
+	 * IRQF_NO_SUSPEND, handled while suspended, but without a wakeup
+	 * event user space stayed frozen and the call went unanswered.
+	 */
+	if (smem->ws)
+		pm_wakeup_ws_event(smem->ws, 1000, true);
+
 	qcom_glink_native_rx(smem->glink);
 
 	return IRQ_HANDLED;
@@ -256,6 +269,14 @@
 
 	smem->remote_pid = remote_pid;
 
+	{
+		const char *label;
+
+		if (!of_property_read_string(node, "label", &label) &&
+		    !strcmp(label, "mpss"))
+			smem->ws = wakeup_source_register(NULL, "glink-modem");
+	}
+
 	rx_pipe = devm_kzalloc(dev, sizeof(*rx_pipe), GFP_KERNEL);
 	tx_pipe = devm_kzalloc(dev, sizeof(*tx_pipe), GFP_KERNEL);
 	if (!rx_pipe || !tx_pipe) {
@@ -369,6 +390,7 @@
 	qcom_glink_native_remove(glink);
 
 	mbox_free_channel(smem->mbox_chan);
+	wakeup_source_unregister(smem->ws);
 	device_unregister(&smem->dev);
 }
 EXPORT_SYMBOL_GPL(qcom_glink_smem_unregister);
