From: fxtec-pro1x-guix
Subject: [PATCH] nfc: nxp-nci: send the board's start-up settings after CORE_INIT

NXP NCI controllers lose their board settings (clock source, antenna
supply TVDD, RF register tuning) at every power cycle; the Android HAL
sends them after CORE_INIT each time.  nxp-nci sends none, so on a board
that needs them the controller senses a reader's field but sends none of
its own, and reads no card.

A new device-tree property, nxp,init-cmds, holds raw NCI control commands
sent one by one, each answered before the next, from a post_setup hook
(after CORE_INIT, at every power-up).  NXP's proprietary 2F 02 answers
through a prop_ops entry.  The list may end with a CORE_RESET that keeps
the configuration and a CORE_INIT, as the HAL does; the core's own reset
clears the configuration, so it is not used for that.

The F(x)tec Pro1X's list is the stock HAL's start-up, as captured by
moWerk (github.com/moWerk/nfcd-nxp-i2c-plugin bb567df,
config/nxp-i2c-init.hex, BSD): proprietary extensions on, crystal clock,
TVDD config 2 (DC-DC 5 V; the stock libnfc-nxp.conf's config 1 gives the
transmitter no supply), the RF register blocks and NCI parameters, its
configuration reads left out.  Sent by hand over i2c-dev with the driver
not loaded (2026-11-27), with a reset keeping the configuration and a
CORE_INIT after: a card was read (RF_INTF_ACTIVATED_NTF, NFC-A ISO-DEP).

Ours (fxtec-pro1x-guix, 2026-11-27).  The driver change is not yet built.

---
--- a/drivers/nfc/nxp-nci/core.c
+++ b/drivers/nfc/nxp-nci/core.c
@@ -13,6 +13,7 @@
 #include <linux/delay.h>
 #include <linux/module.h>
 #include <linux/nfc.h>
+#include <linux/property.h>
 
 #include <net/nfc/nci_core.h>
 
@@ -123,6 +124,53 @@
 	},
 };
 
+/* NXP's proprietary commands (2F xx) answer with a status byte first. */
+static int nxp_nci_prop_rsp(struct nci_dev *ndev, struct sk_buff *skb)
+{
+	nci_req_complete(ndev, skb->len ? skb->data[0] : NCI_STATUS_SYNTAX_ERROR);
+	return 0;
+}
+
+static const struct nci_driver_ops nxp_nci_prop_ops[] = {
+	{
+		.opcode = nci_opcode_pack(NCI_GID_PROPRIETARY, 0x02),
+		.rsp = nxp_nci_prop_rsp,
+	},
+};
+
+/*
+ * The board's start-up settings (clock, antenna supply, RF tuning), which
+ * the controller loses at every power cycle: raw NCI control commands from
+ * the device tree, each answered before the next is sent.
+ */
+static int nxp_nci_post_setup(struct nci_dev *ndev)
+{
+	struct nxp_nci_info *info = nci_get_drvdata(ndev);
+	const u8 *p = info->init_cmds;
+	size_t left = info->init_len;
+	int r;
+
+	while (left) {
+		size_t n;
+
+		if (left < 3 || (p[0] & 0xe0) != 0x20 || left < 3 + p[2]) {
+			nfc_err(&ndev->nfc_dev->dev, "malformed init command\n");
+			return -EINVAL;
+		}
+		n = 3 + p[2];
+		r = nci_core_cmd(ndev, nci_opcode_pack(p[0] & 0x0f, p[1] & 0x3f),
+				 p[2], p + 3);
+		if (r) {
+			nfc_err(&ndev->nfc_dev->dev,
+				"init command %02x %02x failed: %d\n", p[0], p[1], r);
+			return r;
+		}
+		p += n;
+		left -= n;
+	}
+	return 0;
+}
+
 static const struct nci_ops nxp_nci_ops = {
 	.open = nxp_nci_open,
 	.close = nxp_nci_close,
@@ -130,6 +178,9 @@
 	.fw_download = nxp_nci_fw_download,
 	.core_ops = nxp_nci_core_ops,
 	.n_core_ops = ARRAY_SIZE(nxp_nci_core_ops),
+	.prop_ops = nxp_nci_prop_ops,
+	.n_prop_ops = ARRAY_SIZE(nxp_nci_prop_ops),
+	.post_setup = nxp_nci_post_setup,
 };
 
 int nxp_nci_probe(void *phy_id, struct device *pdev,
@@ -152,6 +203,19 @@
 	init_completion(&info->fw_info.cmd_completion);
 	mutex_init(&info->info_lock);
 
+	r = device_property_count_u8(pdev, "nxp,init-cmds");
+	if (r > 0) {
+		info->init_cmds = devm_kmalloc(pdev, r, GFP_KERNEL);
+		if (!info->init_cmds)
+			return -ENOMEM;
+		info->init_len = r;
+		r = device_property_read_u8_array(pdev, "nxp,init-cmds",
+						  info->init_cmds,
+						  info->init_len);
+		if (r)
+			return r;
+	}
+
 	if (info->phy_ops->set_mode) {
 		r = info->phy_ops->set_mode(info->phy_id, NXP_NCI_MODE_COLD);
 		if (r < 0)
--- a/drivers/nfc/nxp-nci/nxp-nci.h
+++ b/drivers/nfc/nxp-nci/nxp-nci.h
@@ -62,6 +62,10 @@
 	struct mutex info_lock;
 
 	struct nxp_nci_fw_info fw_info;
+
+	/* NCI commands from the device tree, sent after CORE_INIT. */
+	u8 *init_cmds;
+	size_t init_len;
 };
 
 int nxp_nci_fw_download(struct nci_dev *ndev, const char *firmware_name);
--- a/arch/arm64/boot/dts/qcom/sm6115-fxtec-pro1x.dts
+++ b/arch/arm64/boot/dts/qcom/sm6115-fxtec-pro1x.dts
