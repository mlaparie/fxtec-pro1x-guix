# Options the 7.3 series needs beyond config.aarch64 (appended before
# olddefconfig): the SMP2P sleep state driver (0032), RPM master stats
# (0037: which master blocks XO shutdown, debugfs).
CONFIG_QCOM_SMP2P_SLEEPSTATE=m
CONFIG_QCOM_RPM_MASTER_STATS=m
# The rear camera's flash LED as a V4L2 subdevice: 0027 lists it in the sensor's
# flash-leds, and the camera's media device waits for it (moWerk's sfos.fragment
# sets this too).  Off here on 7.3: both sensors with 0 media links, "No camera
# found" (2026-11-03).
CONFIG_V4L2_FLASH_LED_CLASS=m
# Bluetooth LE mice and keyboards (HID over GATT): BlueZ creates their input
# devices through /dev/uhid, and without it "input-hog profile accept failed"
# (an Elecom Relacon, 2026-11-08).  Built in, so the node exists from boot.
CONFIG_UHID=y
# Elecom's quirks, the Relacon's extra buttons among them.
CONFIG_HID_ELECOM=m
# A 5 GHz hotspot: the Wi-Fi chip's board data names no country (ath world
# regpair 0x6c), so every 5 GHz channel is "no IR" (no access point) whatever
# country is set.  With these, the country set by `iw reg set' (pro1x-timezone,
# from the time zone) replaces it, any country, not only the US and Japan
# (CERT_TESTING), and its non-DFS channels allow an access point.  DFS channels
# stay passive (ath always keeps them so).
# CERTIFICATION_ONUS is only offered with EXPERT.
CONFIG_EXPERT=y
CONFIG_CFG80211_CERTIFICATION_ONUS=y
CONFIG_ATH_REG_DYNAMIC_USER_REG_HINTS=y
CONFIG_ATH_REG_DYNAMIC_USER_CERT_TESTING=y
# Hibernation debugging (pro1x-hibernate-debug): the console log and crash
# dumps of the previous boot in /sys/fs/pstore, from the ramoops area in the
# device tree; built in, to record from the start.
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
# USB display adapters with free drivers, for an external screen: the SoC
# has no DisplayPort (rag-notes display, 2026-11-22).  GUD: a Raspberry Pi
# Zero or Pico with the GUD gadget firmware as a USB-to-HDMI adapter; UDL:
# old DisplayLink USB 2.0 adapters (DL-1x5).  Modules, loaded on plug-in.
CONFIG_DRM_GUD=m
CONFIG_DRM_UDL=m
