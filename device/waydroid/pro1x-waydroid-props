#!/bin/sh
# pro1x-waydroid-props tiled|untiled msaa|nomsaa [PACKAGE]... — Mesa's
# rendering options in Waydroid's Android (gpu-tiling?, gpu-multisample? and
# untiled-apps in config.scm), as root at boot, before Android starts.
#
# Mesa on Android reads its environment options from properties too:
# MESA_EXTENSION_OVERRIDE is mesa.extension.override, FD_MESA_DEBUG is
# mesa.fd.mesa.debug, each also with a debug. prefix (src/util/os_misc.c).
#
# nomsaa: the extension GL_EXT_multisampled_render_to_texture is hidden from
# every app.  The Adreno 610 has 132 KB of tile memory, so a multisampled pass
# is cut into hundreds of tiles (a 1048x1032 view: 289 tiles at 4 samples,
# 81 without) and the whole scene's vertex work runs again for each.  The
# Tesla app's 3D car (Godot 3.2, 4x MSAA through that extension) took 0.6 s a
# frame on average and up to 11 s; with the extension hidden Godot reports
# "MSAA not supported" and renders at 60 Hz (2026-11-27, phone, logcat with
# FD_MESA_DEBUG=msgs).  Android's own UI (hwui) multisampled a 3816x2092
# layer the same way: 7920 tiles a pass.  Apps lose multisampling, or fall
# back to multisampled renderbuffers, which cost the same tiles as before.
# msaa: the extension stays visible.
#
# untiled: FD_MESA_DEBUG=sysmem, the freedreno driver renders straight to
# memory, no tiles.  A multisampled-render-to-texture pass then draws
# nothing (freedreno only implements it in tile memory): untiled, the Tesla
# app was fast but its car was not drawn, and some launcher icons were not
# drawn either (2026-11-17).  With nomsaa it should rarely be needed.
# tiled: Mesa's default.
#
# PACKAGE...: apps untiled while the rest stays tiled.  Each gets the
# property wrap.PACKAGE = "env FD_MESA_DEBUG=sysmem": Android starts the app
# through that command, and Mesa reads the variable when no property sets
# the mode.  Tested 2026-11-18: the app fast, its process alone with the
# variable, the launcher's icons drawn; it works without ro.debuggable.  The
# app starts a little slower (not from Android's preloaded zygote).  With
# untiled, the packages change nothing.
#
# The settings go into the [properties] of /var/lib/waydroid/waydroid.cfg,
# which Waydroid copies into Android's properties when it rebuilds them
# (waydroid upgrade --offline, run here only when the settings changed).
# Nothing happens before Waydroid is set up (sudo waydroid init).

set -u
cfg=/var/lib/waydroid/waydroid.cfg
[ -f "$cfg" ] || exit 0
usage() { echo "usage: pro1x-waydroid-props tiled|untiled msaa|nomsaa [PACKAGE]..." >&2; exit 2; }
case "${1:-}" in
    tiled) mode= ;;
    untiled) mode=sysmem ;;
    *) usage ;;
esac
case "${2:-}" in
    msaa) override= ;;
    nomsaa) override=-GL_EXT_multisampled_render_to_texture ;;
    *) usage ;;
esac
shift 2
wrap="env FD_MESA_DEBUG=sysmem"

# The lines this script owns in [properties], as they should be.
want=$(
    {
        if [ -n "$mode" ]; then
            echo "mesa.fd.mesa.debug = $mode"
            echo "debug.mesa.fd.mesa.debug = $mode"
        else
            for app in "$@"; do echo "wrap.$app = $wrap"; done
        fi
        if [ -n "$override" ]; then
            echo "mesa.extension.override = $override"
            echo "debug.mesa.extension.override = $override"
        fi
    } | sort)

# Doubled backslashes: awk -v reads escapes.
owned='^((debug\\.)?mesa\\.(fd\\.mesa\\.debug|extension\\.override)|wrap\\.[^ =]+) *= *'
have=$(awk -v owned="$owned" -v wrap="$wrap" '
    /^\[/ { section = $0; next }
    section == "[properties]" && $0 ~ owned {
        if ($0 !~ /^wrap\./ || index($0, wrap)) print }' "$cfg" |
       sed 's/ *= */ = /' | sort)
[ "$have" = "$want" ] && exit 0

tmp=$cfg.pro1x
awk -v owned="$owned" -v wrap="$wrap" -v want="$want" '
    function add() {
        if (want != "") print want
        done = 1
    }
    /^\[/ {
        if (section == "[properties]" && !done) add()
        section = $0; print; next
    }
    # Only the wrap lines it wrote itself; others are left alone.
    section == "[properties]" && $0 ~ owned &&
        ($0 !~ /^wrap\./ || index($0, wrap)) { next }
    { print }
    END {
        if (section == "[properties]" && !done) add()
        else if (!done && want != "") { print "[properties]"; add() }
    }' "$cfg" > "$tmp" && mv "$tmp" "$cfg" || exit 1
if [ -n "$mode" ]; then shown=untiled; else shown="tiled${*:+, untiled: $*}"; fi
if [ -n "$override" ]; then shown="$shown; multisampled render to texture hidden"; fi
logger -t pro1x-waydroid-props "Mesa rendering: $shown"
waydroid upgrade --offline >/dev/null 2>&1 ||
    logger -t pro1x-waydroid-props "waydroid upgrade --offline failed"
exit 0
