#!/bin/sh
# pro1x-waydroid-props tiled|untiled [PACKAGE]... — Mesa's rendering mode in
# Waydroid's Android (gpu-tiling? and untiled-apps in config.scm), as root at
# boot, before Android starts.
#
# tiled: Mesa's default (the freedreno driver renders the screen in tiles).
# untiled: FD_MESA_DEBUG=sysmem, which Mesa reads on Android from the
# properties mesa.fd.mesa.debug and debug.mesa.fd.mesa.debug.  Worth a try
# when an Android app with 3D elements is very slow: an app whose shaders
# read back what is already drawn took 6-10 s a frame tiled, each read-back
# flushing every tile; untiled it was usable, though its 3D model was not
# drawn (a freedreno bug; 2026-11-17).  Untiled for all of Android, some
# launcher icons were not drawn either.
#
# PACKAGE...: apps untiled while the rest stays tiled.  Each gets the
# property wrap.PACKAGE = "env FD_MESA_DEBUG=sysmem": Android starts the app
# through that command, and Mesa reads the variable when no property sets
# the mode.  Tested 2026-11-18: the app fast, its process alone with the
# variable, the launcher's icons drawn; it works without ro.debuggable.  The
# app starts a little slower (not from Android's preloaded zygote).  With
# untiled, the packages change nothing.
#
# The settings go into the [properties] of /var/lib/waydroid/waydroid.cfg,
# which Waydroid copies into Android's properties when it rebuilds them
# (waydroid upgrade --offline, run here only when the settings changed).
# Nothing happens before Waydroid is set up (sudo waydroid init).
#
# Also: Android may not keep the phone awake.  Its system_server waits on a
# timer with EPOLLWAKEUP, which holds a kernel wakeup source while the timer
# has fired and is unread; that aborted every hibernation (2026-11-18:
# "Freezing remaining freezable tasks aborted", two [timerfd] wakeup sources
# active, held by system_server).  The kernel ignores EPOLLWAKEUP without
# CAP_BLOCK_SUSPEND, so block_suspend is taken out of the container's
# lxc.cap.keep (Waydroid's init and upgrade write it back; this runs after
# them, and pro1x-waydroid-admin does the same).  From Android's next start.

set -u
cfg=/var/lib/waydroid/waydroid.cfg
lxc=/var/lib/waydroid/lxc/waydroid/config
no_block_suspend() {
    [ -f "$lxc" ] && grep -q '^lxc.cap.keep.* block_suspend' "$lxc" &&
        sed -i '/^lxc.cap.keep/s/ block_suspend//g' "$lxc" &&
        logger -t pro1x-waydroid-props "Android may no longer block sleep"
    return 0
}
trap no_block_suspend EXIT
[ -f "$cfg" ] || exit 0
case "${1:-}" in
    tiled) mode= ;;
    untiled) mode=sysmem ;;
    *) echo "usage: pro1x-waydroid-props tiled|untiled [PACKAGE]..." >&2; exit 2 ;;
esac
shift
wrap="env FD_MESA_DEBUG=sysmem"

# The lines this script owns in [properties], as they should be.
want=$(
    if [ -n "$mode" ]; then
        echo "mesa.fd.mesa.debug = $mode"
        echo "debug.mesa.fd.mesa.debug = $mode"
    else
        for app in "$@"; do echo "wrap.$app = $wrap"; done
    fi | sort)

# Doubled backslashes: awk -v reads escapes.
owned='^((debug\\.)?mesa\\.fd\\.mesa\\.debug|wrap\\.[^ =]+) *= *'
have=$(awk -v owned="$owned" -v wrap="$wrap" '
    /^\[/ { section = $0; next }
    section == "[properties]" && $0 ~ owned {
        if ($0 !~ /^wrap\./ || index($0, wrap)) print }' "$cfg" |
       sed 's/ *= */ = /' | sort)
[ "$have" = "$want" ] && exit 0

tmp=$cfg.pro1x
awk -v owned="$owned" -v wrap="$wrap" -v want="$want" '
    function add() {
        if (want != "") print want
        done = 1
    }
    /^\[/ {
        if (section == "[properties]" && !done) add()
        section = $0; print; next
    }
    # Only the wrap lines it wrote itself; others are left alone.
    section == "[properties]" && $0 ~ owned &&
        ($0 !~ /^wrap\./ || index($0, wrap)) { next }
    { print }
    END {
        if (section == "[properties]" && !done) add()
        else if (!done && want != "") { print "[properties]"; add() }
    }' "$cfg" > "$tmp" && mv "$tmp" "$cfg" || exit 1
if [ -n "$mode" ]; then shown=untiled; else shown="tiled${*:+, untiled: $*}"; fi
logger -t pro1x-waydroid-props "Mesa rendering: $shown"
waydroid upgrade --offline >/dev/null 2>&1 ||
    logger -t pro1x-waydroid-props "waydroid upgrade --offline failed"
exit 0
