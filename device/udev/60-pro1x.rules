# libcamera's software ISP allocates frame buffers from these dma-buf providers.
SUBSYSTEM=="dma_heap", GROUP="video", MODE="0660"
KERNEL=="udmabuf", GROUP="video", MODE="0660"
# Vibration motor: feedbackd (group feedbackd) drives it.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="aw86224-haptics", ENV{FEEDBACKD_TYPE}="vibra", GROUP="feedbackd", MODE="0660"
# Keyboard slider switch (SW_KEYPAD_SLIDE, used by SXMO's keyboard autorotate): readable by
# the input group, and with a stable name because the eventN number changes between boots.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="gpio-keys", GROUP="input", MODE="0660", SYMLINK+="input/pro1x-slider"
# IPA rmnet interface: tag for ModemManager's qcom-soc plugin.
# The qcom-soc plugin matches a QRTR control port + a net port with ID_MM_PHYSDEV_UID=qcom-soc.
# rmnet_ipa0 is created by the IPA driver (5840000.ipa) and carries LTE data.
KERNEL=="rmnet_ipa*", SUBSYSTEM=="net", ENV{ID_MM_CANDIDATE}="1", ENV{ID_MM_PHYSDEV_UID}="qcom-soc"

# rfkill (Wi-Fi, Bluetooth, modem radios): writable by netdev.  Without
# logind there are no per-seat ACLs, and gsd-rfkill (Phosh's Bluetooth and
# airplane-mode state) could not switch radios as the user.
KERNEL=="rfkill", SUBSYSTEM=="misc", GROUP="netdev", MODE="0664"

# xremap, started by Sway as the user: virtual input devices for members of
# input, as on the author's PC (they can already read every input device).
KERNEL=="uinput", GROUP="input", MODE="0660"

# Venus (the video encoder and decoder) kept powered: when it powered down
# idle during a stream and woke for the next frame, the phone hard-hung
# (six times on 2026-11-20, each seconds after a stream viewer connected
# with the stream's steady off; none in five tries with this, and no
# measurable cost at idle: 850-1010 mA either way).
ACTION=="add", SUBSYSTEM=="platform", KERNEL=="5a00000.video-codec*", ATTR{power/control}="on"
